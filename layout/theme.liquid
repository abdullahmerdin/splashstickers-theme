<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        // Inline header height and menu style calculations to prevent layout shift
        // Note: Updates in calculateHeaderGroupHeight(), updateTransparentHeaderOffset() and setHeaderMenuStyle() utilities.js should be kept in sync with this function
        (function setHeaderHeighCustomProperties() {
          /*
           * Header calculation functions for maintaining CSS variables
           * Mimic calculateHeaderGroupHeight() in utilities.js
           */
          const header = document.querySelector('header-component');
          const headerGroup = document.querySelector('#header-group');
          const hasHeaderSection = headerGroup?.querySelector('.header-section');

          if (!header || !headerGroup) return;

          const headerTopRow = header.querySelector('.header__row--top');
          const headerHeight = header.offsetHeight;

          // Calculate the total height of the header group
          let headerGroupHeight = 0;
          const children = headerGroup.children;
          for (let i = 0; i < children.length; i++) {
            const element = children[i];
            if (element === header || !(element instanceof HTMLElement)) continue;
            headerGroupHeight += element.offsetHeight;
          }

          // Check for transparent header special case
          if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
            headerGroupHeight += headerHeight;
          }

          // Set CSS variables
          document.body.style.setProperty('--header-height', `${headerHeight}px`);
          document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

          if (headerTopRow) {
            window.requestAnimationFrame(function () {
              document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
            });
          }

          /**
           * Updates CSS custom properties for transparent header offset calculation
           * Mimic updateTransparentHeaderOffset() in utilities.js
           */

          if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '0');
            return;
          }

          const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');

          const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
          document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent?.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <div id="sticker-urls" style="display:none;" data-cherry="{{ 'cherry.svg' | asset_url }}" data-bear="{{ 'bear.svg' | asset_url }}" data-deer="{{ 'deer.svg' | asset_url }}"></div>

    <script>
    (function() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      var urlDiv = document.getElementById('sticker-urls');
      var SVG_URLS = [
        urlDiv ? urlDiv.dataset.cherry : '/assets/cherry.svg',
        urlDiv ? urlDiv.dataset.bear : '/assets/bear.svg',
        urlDiv ? urlDiv.dataset.deer : '/assets/deer.svg'
      ];

      var ropeCanvas, rctx;
      window.addEventListener('resize', function() {
        if (ropeCanvas) {
          var r = ropeCanvas.parentElement.getBoundingClientRect();
          ropeCanvas.width = r.width;
          ropeCanvas.height = r.height;
        }
      });

      // ─── Rope physics ───
      function makeRope(a, b, segs, len) {
        var pts = [];
        for (var i = 0; i <= segs; i++) {
          var t = i / segs;
          pts.push({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t + 40, pinned: i === 0 || i === segs, ox: 0, oy: 0 });
        }
        return { a: a, b: b, pts: pts, segs: segs, restLen: len || 180 };
      }

      var ropes = [];
      var ropeReady = false;

      function updateRopes() {
        if (!ropeReady || ropes.length < 2) return;
        rctx.clearRect(0, 0, ropeCanvas.width, ropeCanvas.height);

        for (var r = 0; r < ropes.length; r++) {
          var rope = ropes[r];
          var a = rope.a, b = rope.b;
          var segs = rope.segs;
          var dx = b.x - a.x, dy = b.y - a.y;
          var dist = Math.sqrt(dx*dx + dy*dy) || 1;
          var ropeLen = dist * 1.2;
          var segLen = ropeLen / segs;

          // Pin endpoints (anchor or sticker center)
          var off = rope.a.ax !== undefined ? [rope.a.x + 48, rope.a.y + 48] : [rope.a.x, rope.a.y];
          rope.pts[0].x = off[0]; rope.pts[0].y = off[1];
          rope.pts[segs].x = b.x + 48; rope.pts[segs].y = b.y + 48;

          // Verlet iterations
          for (var iter = 0; iter < 8; iter++) {
            for (var i = 0; i < segs; i++) {
              var p1 = rope.pts[i], p2 = rope.pts[i + 1];
              var pdx = p2.x - p1.x, pdy = p2.y - p1.y;
              var d = Math.sqrt(pdx*pdx + pdy*pdy);
              if (d < 0.001) continue;
              var diff = (d - segLen) / d * 0.5;
              if (!p1.pinned) { p1.x += pdx * diff; p1.y += pdy * diff; }
              if (!p2.pinned) { p2.x -= pdx * diff; p2.y -= pdy * diff; }
            }
            // Gravity on non-pinned nodes
            for (var i = 1; i < segs; i++) {
              if (!rope.pts[i].pinned) rope.pts[i].y += 0.6;
            }
          }

          // Draw rope as a smooth curve
          rctx.beginPath();
          rctx.moveTo(rope.pts[0].x, rope.pts[0].y);
          for (var i = 1; i < rope.pts.length; i++) {
            rctx.lineTo(rope.pts[i].x, rope.pts[i].y);
          }
          rctx.strokeStyle = 'rgba(255,255,255,0.12)';
          rctx.lineWidth = 2.5;
          rctx.stroke();

          // Second pass: thinner brighter line on top
          rctx.beginPath();
          rctx.moveTo(rope.pts[0].x, rope.pts[0].y);
          for (var i = 1; i < rope.pts.length; i++) {
            rctx.lineTo(rope.pts[i].x, rope.pts[i].y);
          }
          rctx.strokeStyle = 'rgba(255,255,255,0.06)';
          rctx.lineWidth = 1;
          rctx.stroke();
        }
      }

      // Physics loop
      function ropeLoop() {
        updateRopes();
        requestAnimationFrame(ropeLoop);
      }
      var emojis = ['🍒', '🐻', '🦌'];
      var items = [];
      var ropes = [];
      var ropeReady = false;

      function initStickers() {
      if (items.length > 0) return;
      var cta = document.querySelector('.splash-cta-section') || document.querySelector('.splash-cta');
      if (!cta) { setTimeout(initStickers, 500); return; }
      cta.style.position = 'relative';
      var bounds = cta.getBoundingClientRect();
      var W = bounds.width, H = bounds.height;
      // Find heading text as anchor point
      var anchor = cta.querySelector('h2') || cta.querySelector('.page-width');
      var anchorBounds = anchor ? anchor.getBoundingClientRect() : bounds;
      var anchorX = (anchorBounds.left - bounds.left) + anchorBounds.width / 2;
      var anchorY = (anchorBounds.top - bounds.top) + anchorBounds.height / 2;
      // Rope canvas inside CTA
      ropeCanvas = document.createElement('canvas');
      ropeCanvas.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none;z-index:40;';
      cta.appendChild(ropeCanvas);
      rctx = ropeCanvas.getContext('2d');
      ropeCanvas.width = W;
      ropeCanvas.height = H;

      emojis.forEach(function(e, i) {
        var el = document.createElement('img');
        el.src = SVG_URLS[i];
        el.draggable = false;
        el.style.cssText = 'position:absolute;width:96px;height:96px;cursor:grab;z-index:50;user-select:none;touch-action:none;pointer-events:auto;';
        el.onerror = (function(idx) { return function() { this.src = 'data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><text y=\"70\" font-size=\"70\">' + ['🍒','🐻','🦌'][idx] + '<\/text><\/svg>'; }; })(i);

        var rx = 20 + Math.random() * (W - 100);
        var ry = 20 + Math.random() * (H - 100);
        el.style.left = rx + 'px';
        el.style.top = ry + 'px';
        cta.appendChild(el);

        var item = { el: el, x: rx, y: ry, dragging: false, ox: 0, oy: 0, ax: anchorX, ay: anchorY };
        items.push(item);

        el.addEventListener('mousedown', function(ev) {
          item.dragging = true;
          var er = item.el.getBoundingClientRect();
          item.ox = ev.clientX - er.left;
          item.oy = ev.clientY - er.top;
          el.style.cursor = 'grabbing';
          // Peel: curl from one corner
          el.style.transition = 'transform 0.15s ease-out, filter 0.15s ease-out';
          el.style.transform = 'perspective(120px) rotateX(12deg) scale(0.92)';
          el.style.filter = 'drop-shadow(4px 6px 12px rgba(0,0,0,0.3))';
          setTimeout(function() {
            if (item.dragging) {
              el.style.transition = 'transform 0.1s ease-out';
              el.style.transform = 'perspective(120px) rotateX(4deg) scale(0.96) translateY(-2px)';
            }
          }, 100);
          ev.preventDefault();
        });

        el.addEventListener('touchstart', function(ev) {
          var t = ev.touches[0];
          item.dragging = true;
          var er = item.el.getBoundingClientRect();
          item.ox = t.clientX - er.left;
          item.oy = t.clientY - er.top;
          el.style.transition = 'transform 0.15s ease-out, filter 0.15s ease-out';
          el.style.transform = 'perspective(120px) rotateX(12deg) scale(0.92)';
          el.style.filter = 'drop-shadow(4px 6px 12px rgba(0,0,0,0.3))';
          setTimeout(function() {
            if (item.dragging) {
              el.style.transform = 'perspective(120px) rotateX(4deg) scale(0.96) translateY(-2px)';
            }
          }, 100);
          ev.preventDefault();
        });
      });

      document.addEventListener('mousemove', function(ev) {
        items.forEach(function(item) {
          if (item.dragging) {
            var b = cta.getBoundingClientRect();
            var cx = ev.clientX - b.left - item.ox;
            var cy = ev.clientY - b.top - item.oy;
            // Within section bounds
            item.x = Math.max(0, Math.min(b.width - 96, cx));
            item.y = Math.max(0, Math.min(b.height - 96, cy));
            item.el.style.left = item.x + 'px';
            item.el.style.top = item.y + 'px';
          }
        });
      });

      document.addEventListener('mouseup', function() {
        items.forEach(function(item) {
          if (item.dragging) {
            item.dragging = false;
            item.el.style.cursor = 'grab';
            // Stick: curl down smoothly from one edge
            item.el.style.transition = 'transform 0.12s ease-in, filter 0.15s ease-out';
            item.el.style.transform = 'perspective(120px) rotateX(-6deg) scale(0.96)';
            item.el.style.filter = 'drop-shadow(0 1px 2px rgba(0,0,0,0.06))';
            setTimeout(function() {
              item.el.style.transition = 'transform 0.15s ease-out';
              item.el.style.transform = 'perspective(120px) rotateX(2deg) scale(0.99)';
              setTimeout(function() {
                item.el.style.transition = 'transform 0.1s ease-out';
                item.el.style.transform = 'perspective(120px) rotateX(0) scale(1)';
              }, 80);
            }, 80);
          }
        });
      });

      document.addEventListener('touchmove', function(ev) {
        items.forEach(function(item) {
          if (item.dragging) {
            var b = cta.getBoundingClientRect();
            var t = ev.touches[0];
            var cx = t.clientX - b.left - item.ox;
            var cy = t.clientY - b.top - item.oy;
            item.x = Math.max(0, Math.min(b.width - 96, cx));
            item.y = Math.max(0, Math.min(b.height - 96, cy));
            item.el.style.left = item.x + 'px';
            item.el.style.top = item.y + 'px';
          }
        });
      }, { passive: false });

      document.addEventListener('touchend', function() {
        items.forEach(function(item) {
          if (item.dragging) {
            item.dragging = false;
            item.el.style.transition = 'transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.15s ease-out';
            item.el.style.transform = 'perspective(200px) rotateX(3deg) rotateY(-2deg) scale(0.96)';
            item.el.style.filter = 'drop-shadow(0 2px 4px rgba(0,0,0,0.08))';
            setTimeout(function() {
              item.el.style.transform = 'perspective(200px) rotateX(0) rotateY(0) scale(1)';
              setTimeout(function() {
                item.el.style.transform = 'perspective(200px) rotateX(1deg) scale(0.99)';
                setTimeout(function() { item.el.style.transform = 'perspective(200px) rotateX(0) scale(1)'; }, 80);
              }, 120);
            }, 100);
          }
        });
      });

      setTimeout(function() {
        if (items.length >= 3) {
          // Each sticker gets a rope from anchor point
          ropes.push(makeRope({ x: anchorX, y: anchorY }, items[0], 12, 200));
          ropes.push(makeRope({ x: anchorX, y: anchorY }, items[1], 12, 200));
          ropes.push(makeRope({ x: anchorX, y: anchorY }, items[2], 12, 200));
          // Also connect stickers to each other
          ropes.push(makeRope(items[0], items[1], 10, 160));
          ropes.push(makeRope(items[1], items[2], 10, 160));
          ropeReady = true;
        }
      }, 300);
      }
      initStickers();
    })();
    </script>

    <script>
    (function() {
      document.addEventListener('click', function(e) {
        var btn = e.target.closest('.btn, .btn-cta-gradient, .btn-cta-outline, button, a[href*="collections"], a[href*="products"]');
        if (!btn) return;
        var r = btn.getBoundingClientRect();
        var cx = e.clientX - r.left, cy = e.clientY - r.top;
        var ring = document.createElement('div');
        ring.style.cssText = 'position:absolute;width:6px;height:6px;border-radius:50%;border:2px solid rgba(255,255,255,0.6);pointer-events:none;top:'+(cy-3)+'px;left:'+(cx-3)+'px;z-index:999;opacity:0.7;transition:none;';
        btn.style.position = 'relative';
        btn.appendChild(ring);
        requestAnimationFrame(function() {
          ring.style.transition = 'all 0.5s cubic-bezier(0.22,1,0.36,1)';
          ring.style.width = '100px';
          ring.style.height = '100px';
          ring.style.top = (cy - 50) + 'px';
          ring.style.left = (cx - 50) + 'px';
          ring.style.borderWidth = '1px';
          ring.style.opacity = '0';
        });
        setTimeout(function() { if (ring.parentNode) ring.remove(); }, 600);
      });
    })();
    </script>
  </body>
</html>
