{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splashstickers.com/schemas/design-manifest.v1.json",
  "title": "Splash Stickers DesignManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sheet", "quantity", "items"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "shop": { "type": "object", "additionalProperties": false, "required": ["domain"], "properties": { "domain": { "type": "string", "minLength": 1, "maxLength": 253 } } },
    "source": { "type": "object", "additionalProperties": false, "properties": { "productId": { "type": "string", "maxLength": 128 }, "variantId": { "type": "string", "maxLength": 128 } } },
    "sheet": {
      "type": "object", "additionalProperties": false,
      "required": ["widthMm", "heightMm", "unit", "gapMm", "background"],
      "properties": {
        "widthMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "heightMm": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "unit": { "const": "mm" },
        "gapMm": { "type": "number", "minimum": 0, "maximum": 100 },
        "background": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 999 },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "placement"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "kind": { "enum": ["image", "text"] },
          "assetRef": { "type": "string", "minLength": 1, "maxLength": 2048, "not": { "pattern": "^(?:data|blob):" } },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "style": { "type": "object", "additionalProperties": false },
          "placement": {
            "type": "object", "additionalProperties": false,
            "required": ["xMm", "yMm", "widthMm", "heightMm", "rotation", "flipX", "flipY", "zIndex"],
            "properties": {
              "xMm": { "type": "number" }, "yMm": { "type": "number" },
              "widthMm": { "type": "number", "exclusiveMinimum": 0 },
              "heightMm": { "type": "number", "exclusiveMinimum": 0 },
              "rotation": { "type": "number" }, "flipX": { "type": "boolean" },
              "flipY": { "type": "boolean" }, "zIndex": { "type": "integer" }
            }
          }
        }
      }
    },
    "pricing": { "type": "object", "additionalProperties": false, "required": ["currency", "unitPriceCents"], "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "unitPriceCents": { "type": "integer", "minimum": 0 }, "totalPriceCents": { "type": "integer", "minimum": 0 } } },
    "timestamps": { "type": "object", "additionalProperties": false, "properties": { "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" } } }
  }
}
