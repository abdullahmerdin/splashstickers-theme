  /* ── Export ── */
  function renderToCanvas() {
    var cw=CANVAS_W, ch=CANVAS_H;
    var c = document.createElement('canvas');
    c.width=cw*2; c.height=ch*2;
    var ctx=c.getContext('2d');
    ctx.scale(2,2);
    ctx.fillStyle='#fff'; ctx.fillRect(0,0,cw,ch);
    items.forEach(function(it){
      ctx.save();
      ctx.translate(it.x+it.w/2,it.y+it.h/2);
      ctx.rotate(it.rotation*Math.PI/180);
      ctx.scale(it.scaleX,it.scaleY);
      ctx.translate(-it.w/2,-it.h/2);
      var img=it.el.querySelector('img');
      if(img) ctx.drawImage(img,0,0,it.w,it.h);
      else if(it.text){
        ctx.fillStyle='#2D3436'; ctx.font=(it.fontSize||16)+'px sans-serif';
        ctx.textAlign='center'; ctx.textBaseline='middle';
        ctx.fillText(it.text,it.w/2,it.h/2);
      }
      ctx.restore();
    });
    return c;
  }
  exportBtn.addEventListener('click',function(){
    var expCanvas=renderToCanvas();
    expCanvas.toBlob(function(blob){
      if(!blob) return;
      var fr=new FileReader();
      fr.onload=function(){
        var imgData=fr.result;
        var script=document.createElement('script');
        script.src='https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        script.onload=function(){
          var doc=new jspdf.jsPDF({orientation:'landscape',unit:'mm',format:[297,210]});
          var mmPerPx=210/ch;
          doc.addImage(imgData,'PNG',0,0,cw*mmPerPx,ch*mmPerPx);
          doc.save('sticker-sheet.pdf');
        };
        script.onerror=function(){alert('Could not load PDF library. Check internet connection.');};
        document.head.appendChild(script);
      };
      fr.readAsDataURL(blob);
    },'image/png');
  });

  /* ── Text edit on double-click ── */
