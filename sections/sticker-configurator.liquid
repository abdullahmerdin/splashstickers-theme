  /* ── Text tool ── */
  textBtn.addEventListener('click',function(){textToolActive=!textToolActive;textBtn.classList.toggle('active',textToolActive);});
  document.addEventListener('keydown',function(e){
    if(e.key==='t'||e.key==='T'){textToolActive=!textToolActive;textBtn.classList.toggle('active',textToolActive);}
    if((e.ctrlKey||e.metaKey)&&e.key==='z'){if(e.shiftKey) redo(); else undo(); e.preventDefault();}
    if(e.key==='Delete'||e.key==='Backspace'){if(selectedIds.length){delBtn.click();e.preventDefault();}}
    if(e.key==='Escape'){selectedIds=[];updateSelection();}
  });

  /* ── Undo/Redo ── */
  function undo(){if(historyIdx<=0)return;historyIdx--;restoreState(history[historyIdx]);updateHistoryBtns();updateCount();updatePrice();}
  function redo(){if(historyIdx>=history.length-1)return;historyIdx++;restoreState(history[historyIdx]);updateHistoryBtns();updateCount();updatePrice();}
  function updateHistoryBtns(){undoBtn.disabled=historyIdx<=0;redoBtn.disabled=historyIdx>=history.length-1;}

  undoBtn.addEventListener('click',undo);
