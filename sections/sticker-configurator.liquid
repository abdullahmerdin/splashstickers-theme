    var el=document.createElement('div');
    el.className='canvas-item'; el.dataset.itemId=id;
    el.style.left=((CANVAS_W-w)/2)+'px'; el.style.top=((CANVAS_H-h)/2)+'px';
    el.style.width=w+'px'; el.style.height=h+'px';
