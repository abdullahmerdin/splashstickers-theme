{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.bg_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
.product-information__media { display: none !important; }
.product-information {
  display: grid !important;
  grid-template-columns: 1fr min(50vw, var(--sidebar-width, 400px)) !important;
  gap: var(--gap, 40px) !important;
  align-items: start !important;
}
.product-information product-component { grid-column: 2 !important; width: 100% !important; }

/* ─── Canvas Editor ─── */
.sticker-config-{{ section.id }} {
  grid-column: 1 !important; grid-row: 1 !important;
  background: {{ bg_color }};
  border-radius: 20px; padding: 24px; position: sticky; top: 100px;
}
.sticker-config-{{ section.id }} .editor-wrap {
  display: flex; flex-direction: column; gap: 12px;
}
.sticker-config-{{ section.id }} .toolbar {
  display: flex; gap: 4px; flex-wrap: wrap;
}
.sticker-config-{{ section.id }} .toolbar button {
  width: 36px; height: 36px; border-radius: 8px; border: 1px solid #DFE6E9;
  background: #fff; cursor: pointer; font-size: 16px; display: flex;
  align-items: center; justify-content: center; transition: all 0.15s;
  color: #636E72;
}
.sticker-config-{{ section.id }} .toolbar button:hover { border-color: #00CEC9; color: #00CEC9; }
.sticker-config-{{ section.id }} .toolbar button:disabled { opacity: 0.3; cursor: default; }
.sticker-config-{{ section.id }} .canvas-area {
  position: relative; width: 100%; aspect-ratio: 3 / 2;
  background: #fff; border: 2px solid #DFE6E9; border-radius: 12px;
  overflow: hidden; cursor: default; user-select: none;
}
.sticker-config-{{ section.id }} .canvas-area .grid-bg {
  position: absolute; inset: 0;
  background-image: 
    linear-gradient(rgba(0,0,0,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,0,0,0.03) 1px, transparent 1px);
  background-size: 20px 20px; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item {
  position: absolute; cursor: grab; user-select: none;
  transition: box-shadow 0.15s;
}
.sticker-config-{{ section.id }} .canvas-item:hover { box-shadow: 0 0 0 2px #00CEC944; }
.sticker-config-{{ section.id }} .canvas-item.selected {
  box-shadow: 0 0 0 2px #00CEC9, 0 0 12px rgba(0,206,201,0.25);
  z-index: 100 !important;
}
.sticker-config-{{ section.id }} .canvas-item img {
  width: 100%; height: 100%; object-fit: contain; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item .rot-handle {
  position: absolute; bottom: -20px; left: 50%; margin-left: -8px;
  width: 16px; height: 16px; border-radius: 50%; background: #00CEC9;
  border: 2px solid #fff; cursor: grab; display: none;
}
.sticker-config-{{ section.id }} .canvas-item.selected .rot-handle { display: block; }
.sticker-config-{{ section.id }} .canvas-size-label {
  font-size: 0.7rem; color: #B2BEC3; text-align: right; padding-right: 4px;
}
.sticker-config-{{ section.id }} .canvas-hint {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  color: #DFE6E9; font-size: 0.9rem; text-align: center;
  pointer-events: none; font-weight: 500;
}
.sticker-config-{{ section.id }} .upload-btn-area {
  display: flex; gap: 8px; align-items: center;
}
.sticker-config-{{ section.id }} .upload-btn-area button {
  padding: 8px 20px; border: 2px dashed #DFE6E9; border-radius: 10px;
  background: transparent; cursor: pointer; font-size: 0.85rem; color: #636E72;
  transition: all 0.2s; flex: 1;
}
.sticker-config-{{ section.id }} .upload-btn-area button:hover {
  border-color: #00CEC9; color: #00CEC9; background: #f0fdfd;
}
@media (max-width: 768px) {
  .sticker-config-{{ section.id }} {
    position: static; padding: 16px;
  }
}
{% endstyle %}

<div class="sticker-config-{{ section.id }}">
  <div class="editor-wrap">
    <div class="toolbar">
      <button title="Delete selected" id="del-btn-{{ section.id }}" disabled>&#x1F5D1;</button>
      <button title="Duplicate selected" id="dup-btn-{{ section.id }}" disabled>&#x1F4DD;</button>
      <button title="Flip horizontal" id="flip-h-{{ section.id }}" disabled>&#x2194;&#xFE0F;</button>
      <button title="Flip vertical" id="flip-v-{{ section.id }}" disabled>&#x2195;&#xFE0F;</button>
      <button title="Bring to front" id="front-btn-{{ section.id }}" disabled>&#x2B06;&#xFE0F;</button>
      <button title="Send to back" id="back-btn-{{ section.id }}" disabled>&#x2B07;&#xFE0F;</button>
    </div>
    <div style="font-size:0.75rem;color:#B2BEC3;display:flex;justify-content:space-between;">
      <span>60 cm workspace</span>
      <span id="item-count-{{ section.id }}">0 items</span>
    </div>
    <div class="canvas-area" id="canvas-{{ section.id }}">
      <div class="grid-bg"></div>
      <div class="canvas-hint" id="hint-{{ section.id }}">Upload a design to start</div>
    </div>
    <div class="upload-btn-area">
      <button id="add-btn-{{ section.id }}">&#x2795; Add design</button>
      <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" id="file-input-{{ section.id }}" style="display:none;">
      <button id="qty-down-{{ section.id }}" style="width:32px;height:32px;border-radius:50%;border:1px solid #DFE6E9;background:#fff;">&minus;</button>
      <span id="qty-display-{{ section.id }}" style="font-weight:700;min-width:30px;text-align:center;">10</span>
      <button id="qty-up-{{ section.id }}" style="width:32px;height:32px;border-radius:50%;border:1px solid #DFE6E9;background:#fff;">+</button>
      <span style="font-size:0.8rem;color:#636E72;">pieces</span>
    </div>
    <button id="submit-{{ section.id }}" style="width:100%;padding:12px;border:none;border-radius:12px;background:linear-gradient(135deg,#00CEC9,#00A8A3);color:#fff;font-size:1rem;font-weight:700;cursor:pointer;margin-top:4px;">
      Add to Cart &mdash; <span id="price-display-{{ section.id }}">$0.00</span>
    </button>
  </div>
</div>

<script>
(function() {
  var sid = '{{ section.id }}';
  var canvas = document.getElementById('canvas-' + sid);
  var hint = document.getElementById('hint-' + sid);
  var fileInput = document.getElementById('file-input-' + sid);
  var countEl = document.getElementById('item-count-' + sid);
  var qtyEl = document.getElementById('qty-display-' + sid);
  var priceEl = document.getElementById('price-display-' + sid);

  var items = [];
  var selectedId = null;
  var nextId = 1;
  var dragState = null;
  var basePrice = 2.5;

  // Toolbar buttons
  var delBtn = document.getElementById('del-btn-'+sid);
  var dupBtn = document.getElementById('dup-btn-'+sid);
  var flipHBtn = document.getElementById('flip-h-'+sid);
  var flipVBtn = document.getElementById('flip-v-'+sid);
  var frontBtn = document.getElementById('front-btn-'+sid);
  var backBtn = document.getElementById('back-btn-'+sid);

  function selectItem(id) {
    deselectAll();
    selectedId = id;
    var el = document.querySelector('[data-item-id="'+id+'"]');
    if (el) el.classList.add('selected');
    updateToolbar();
  }

  function deselectAll() {
    selectedId = null;
    canvas.querySelectorAll('.canvas-item.selected').forEach(function(el) { el.classList.remove('selected'); });
    updateToolbar();
  }

  function updateToolbar() {
    var has = selectedId !== null;
    delBtn.disabled = !has;
    dupBtn.disabled = !has;
    flipHBtn.disabled = !has;
    flipVBtn.disabled = !has;
    frontBtn.disabled = !has;
    backBtn.disabled = !has;
  }

  function addItem(src) {
    var id = nextId++;
    var w = 80 + Math.random() * 60;
    var h = w * (0.7 + Math.random() * 0.6);
    var el = document.createElement('div');
    el.className = 'canvas-item';
    el.dataset.itemId = id;
    el.style.cssText = 'left:'+(20+Math.random()*(canvas.clientWidth-w-40))+'px;top:'+(20+Math.random()*(canvas.clientHeight-h-40))+'px;width:'+w+'px;height:'+h+'px;';

    var img = document.createElement('img');
    img.src = src;
    img.draggable = false;
    el.appendChild(img);

    var rot = document.createElement('div');
    rot.className = 'rot-handle';
    el.appendChild(rot);

    canvas.appendChild(el);
    hint.style.display = 'none';

    var item = {
      id: id, el: el, x: parseFloat(el.style.left), y: parseFloat(el.style.top),
      w: w, h: h, rotation: 0, scaleX: 1, scaleY: 1
    };
    items.push(item);
    if (items.length === 1) selectItem(id);

    // Select on click
    el.addEventListener('mousedown', function(e) {
      if (e.target === rot) return;
      selectItem(id);
      startDrag(e, id);
    });

    // Rotation handle
    rot.addEventListener('mousedown', function(e) {
      e.stopPropagation();
      selectItem(id);
      startRotate(e, id);
    });

    updateCount();
    updatePrice();
    return item;
  }

  function startDrag(e, id) {
    var item = items.find(function(i) { return i.id === id; });
    if (!item) return;
    dragState = { type: 'move', id: id, ox: e.clientX - item.x, oy: e.clientY - item.y };
    item.el.style.cursor = 'grabbing';
    e.preventDefault();
  }

  function startRotate(e, id) {
    var item = items.find(function(i) { return i.id === id; });
    if (!item) return;
    var r = item.el.getBoundingClientRect();
    dragState = { type: 'rotate', id: id, cx: r.left + r.width/2, cy: r.top + r.height/2, startAngle: Math.atan2(e.clientY - (r.top + r.height/2), e.clientX - (r.left + r.width/2)) - item.rotation * Math.PI / 180 };
    e.preventDefault();
  }

  document.addEventListener('mousemove', function(e) {
    if (!dragState) return;
    var item = items.find(function(i) { return i.id === dragState.id; });
    if (!item) return;

    if (dragState.type === 'move') {
      var cw = canvas.clientWidth, ch = canvas.clientHeight;
      item.x = Math.max(0, Math.min(cw - item.w, e.clientX - dragState.ox));
      item.y = Math.max(0, Math.min(ch - item.h, e.clientY - dragState.oy));
      item.el.style.left = item.x + 'px';
      item.el.style.top = item.y + 'px';
    } else if (dragState.type === 'rotate') {
      var angle = Math.atan2(e.clientY - dragState.cy, e.clientX - dragState.cx) - dragState.startAngle;
      item.rotation = angle * 180 / Math.PI;
      applyTransform(item);
    }
  });

  document.addEventListener('mouseup', function() {
    if (dragState) {
      var item = items.find(function(i) { return i.id === dragState.id; });
      if (item) item.el.style.cursor = 'grab';
      dragState = null;
    }
  });

  function applyTransform(item) {
    item.el.style.transform = 'rotate('+item.rotation+'deg) scaleX('+item.scaleX+') scaleY('+item.scaleY+')';
  }

  // ── Toolbar actions ──
  delBtn.addEventListener('click', function() {
    if (selectedId === null) return;
    var idx = items.findIndex(function(i) { return i.id === selectedId; });
    if (idx === -1) return;
    var item = items[idx];
    item.el.remove();
    items.splice(idx, 1);
    selectedId = null;
    updateCount(); updatePrice(); updateToolbar();
    if (items.length === 0) hint.style.display = '';
  });

  dupBtn.addEventListener('click', function() {
    if (selectedId === null) return;
    var src = items.find(function(i) { return i.id === selectedId; });
    if (!src) return;
    var img = src.el.querySelector('img');
    if (!img) return;
    var newItem = addItem(img.src);
    newItem.x = src.x + 20;
    newItem.y = src.y + 20;
    newItem.w = src.w;
    newItem.h = src.h;
    newItem.el.style.left = newItem.x + 'px';
    newItem.el.style.top = newItem.y + 'px';
    newItem.el.style.width = newItem.w + 'px';
    newItem.el.style.height = newItem.h + 'px';
    selectItem(newItem.id);
  });

  flipHBtn.addEventListener('click', function() {
    if (selectedId === null) return;
    var item = items.find(function(i) { return i.id === selectedId; });
    if (!item) return;
    item.scaleX *= -1;
    applyTransform(item);
  });

  flipVBtn.addEventListener('click', function() {
    if (selectedId === null) return;
    var item = items.find(function(i) { return i.id === selectedId; });
    if (!item) return;
    item.scaleY *= -1;
    applyTransform(item);
  });

  frontBtn.addEventListener('click', function() {
    if (selectedId === null) return;
    var el = canvas.querySelector('[data-item-id="'+selectedId+'"]');
    if (!el) return;
    el.style.zIndex = Math.max.apply(null, items.map(function(i) { return parseInt(i.el.style.zIndex) || 0; })) + 1;
  });

  backBtn.addEventListener('click', function() {
    if (selectedId === null) return;
    var el = canvas.querySelector('[data-item-id="'+selectedId+'"]');
    if (!el) return;
    el.style.zIndex = Math.min.apply(null, items.map(function(i) { return parseInt(i.el.style.zIndex) || 0; })) - 1;
  });

  // ── Upload ──
  function handleFile(file) {
    if (!file.type.match('image.*')) return;
    var reader = new FileReader();
    reader.onload = function(e) {
      // Add 3 items at once for gang sheet feel
      addItem(e.target.result);
      addItem(e.target.result);
      addItem(e.target.result);
    };
    reader.readAsDataURL(file);
  }

  document.getElementById('add-btn-'+sid).addEventListener('click', function() { fileInput.click(); });
  fileInput.addEventListener('change', function() { if (this.files.length) handleFile(this.files[0]); });

  canvas.addEventListener('drop', function(e) {
    e.preventDefault();
    if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
  });
  canvas.addEventListener('dragover', function(e) { e.preventDefault(); });

  // Deselect on canvas background click
  canvas.addEventListener('mousedown', function(e) {
    if (e.target === canvas || e.target.classList.contains('grid-bg')) deselectAll();
  });

  // ── Quantity ──
  document.getElementById('qty-down-'+sid).addEventListener('click', function() {
    var q = parseInt(qtyEl.textContent) || 1;
    if (q > 1) qtyEl.textContent = q - 1;
    updatePrice();
  });
  document.getElementById('qty-up-'+sid).addEventListener('click', function() {
    qtyEl.textContent = (parseInt(qtyEl.textContent) || 1) + 1;
    updatePrice();
  });

  function updateCount() { countEl.textContent = items.length + ' items'; }
  function updatePrice() {
    var qty = parseInt(qtyEl.textContent) || 1;
    var count = items.length || 1;
    priceEl.textContent = '$' + (basePrice * count * qty).toFixed(2);
  }
  updatePrice();
  updateToolbar();
})();
</script>

{% schema %}
{
  "name": "Sticker Configurator",
  "tag": "section",
  "class": "sticker-configurator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design Your Sticker Sheet" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Arrange your stickers on a 60cm workspace" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#F8F9FA" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 48 }
  ],
  "presets": [
    {
      "name": "Sticker Configurator",
      "category": "Custom"
    }
  ]
}
{% endschema %}
