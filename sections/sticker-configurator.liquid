  /* ── Interaction ── */
  function startDrag(e, id) {
    var item=items.find(function(i){return i.id===id;}); if(!item) return;
    dragState={type:'move',ids:selectedIds.slice(),ox:e.clientX,oy:e.clientY,startPos:{},guides:{}};
    getSelected().forEach(function(i){dragState.startPos[i.id]={x:i.x,y:i.y};});
    item.el.style.cursor='grabbing'; e.preventDefault();
  }
  function startResize(e,id,handle){
    var item=items.find(function(i){return i.id===id;}); if(!item) return;
    dragState={type:'resize',id:id,handle:handle,ox:e.clientX,oy:e.clientY,sw:item.w,sh:item.h,sx:item.x,sy:item.y};
    e.preventDefault();
  }
  function startRotate(e,id){
    var item=items.find(function(i){return i.id===id;}); if(!item) return;
    var r=item.el.getBoundingClientRect();
    dragState={type:'rotate',id:id,cx:r.left+r.width/2,cy:r.top+r.height/2,
      startAngle:Math.atan2(e.clientY-(r.top+r.height/2),e.clientX-(r.left+r.width/2))-item.rotation*Math.PI/180};
    e.preventDefault();
  }
  function applyTransform(item) {
    item.el.style.transform='rotate('+item.rotation+'deg) scaleX('+item.scaleX+') scaleY('+item.scaleY+')';
  }
  function rectsOverlap(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;}

  /* ── Alignment guides + pan/zoom ── */
  function updateGuides(item, items) {
    var gH=guideH, gV=guideV;
    gH.style.display='none'; gV.style.display='none';
    if (!item) return;
    var SNAP_DIST = 6;
    var edges = ['t','b','c','l','r','m'];
    var ie = { t: item.y, b: item.y+item.h, c: item.y+item.h/2, l: item.x, r: item.x+item.w, m: item.x+item.w/2 };
    items.forEach(function(other) {
      if (other.id===item.id) return;
      var oe = { t: other.y, b: other.y+other.h, c: other.y+other.h/2, l: other.x, r: other.x+other.w, m: other.x+other.w/2 };
      edges.forEach(function(iee) { edges.forEach(function(oee) {
        if ((iee==='t'||iee==='b'||iee==='c') && (oee==='t'||oee==='b'||oee==='c')) {
          var d = Math.abs(ie[iee]-oe[oee]);
          if (d < SNAP_DIST) {
            var snapY = oe[oee];
            if (dragState && dragState.type==='move') {
              dragState.ids.forEach(function(did) {
                var di = items.find(function(i){return i.id==did;});
                if (di) { var sp=dragState.startPos[did]; if(sp) di.y = sp.y + (snapY - ie[iee]); }
              });
            }
            var wrapRect = wrap.getBoundingClientRect();
            gH.style.display='block'; gH.style.top=snapY+'px';
          }
        }
        if ((iee==='l'||iee==='r'||iee==='m') && (oee==='l'||oee==='r'||oee==='m')) {
          var d = Math.abs(ie[iee]-oe[oee]);
          if (d < SNAP_DIST) {
            var snapX = oe[oee];
            if (dragState && dragState.type==='move') {
              dragState.ids.forEach(function(did) {
                var di = items.find(function(i){return i.id==did;});
                if (di) { var sp=dragState.startPos[did]; if(sp) di.x = sp.x + (snapX - ie[iee]); }
              });
            }
            gV.style.display='block'; gV.style.left=snapX+'px';
          }
        }
      });});
    });
  }

  /* ── Zoom / Pan ── */
  var CANVAS_W=wrap.clientWidth, CANVAS_H=wrap.clientHeight;
  function clampPan() {
    var vw=wrap.clientWidth, vh=wrap.clientHeight;
    var maxX=CANVAS_W*zoom-vw;
    panX=Math.min(0,Math.max(-maxX,panX));
    panY=Math.min(0,Math.max(-(CANVAS_H*zoom-vh),panY));
  }
  function updateCanvasWH() {
    CANVAS_W=wrap.clientWidth; CANVAS_H=Math.max(wrap.clientHeight, canvas.offsetHeight);
  }
  function growCanvas() {
    var maxB=0;
    items.forEach(function(i){var b=i.y+i.h;if(b>maxB)maxB=b;});
    maxB=Math.max(maxB, CANVAS_H);
    if(maxB>CANVAS_H){
      CANVAS_H=maxB+40;
      canvas.style.height=CANVAS_H+'px';
      drawGrid();
    }
  }
  function applyZoom() {
    zoom=Math.max(1,Math.min(5,zoom));
    updateCanvasWH();
    clampPan();
    canvas.style.transform='scale('+zoom+') translate('+panX+'px,'+panY+'px)';
    zoomDisplay.textContent=Math.round(zoom*100)+'%';
    drawGrid();
  }
  function drawGrid() {
    var gc=document.getElementById('grid-canvas-'+sid);
    if(!gc) return;
    gc.width=CANVAS_W; gc.height=CANVAS_H;
    gc.style.height='';
    var ctx=gc.getContext('2d');
    var gs=20;
    ctx.strokeStyle='rgba(0,0,0,0.03)'; ctx.lineWidth=1;
    ctx.beginPath();
    for(var x=0; x<CANVAS_W; x+=gs){ctx.moveTo(x,0);ctx.lineTo(x,CANVAS_H);}
    for(var y=0; y<CANVAS_H; y+=gs){ctx.moveTo(0,y);ctx.lineTo(CANVAS_W,y);}
    ctx.stroke();
  }

  function zoomToFit() {
    if(items.length===0){zoom=1;panX=0;panY=0;applyZoom();return;}
    updateCanvasWH();
    var minX=1/0,minY=1/0,maxX=-1/0,maxY=-1/0;
    items.forEach(function(i){if(i.x<minX)minX=i.x;if(i.y<minY)minY=i.y;if(i.x+i.w>maxX)maxX=i.x+i.w;if(i.y+i.h>maxY)maxY=i.y+i.h;});
    var zw=CANVAS_W/(maxX-minX+40), zh=CANVAS_H/(maxY-minY+40);
    zoom=Math.min(zw,zh,2); zoom=Math.max(zoom,1);
    var cx=(minX+maxX)/2, cy=(minY+maxY)/2;
    panX=CANVAS_W/2/zoom-cx; panY=CANVAS_H/2/zoom-cy;
    applyZoom();
  }

  /* ── Layer panel ── */
  function updateLayerPanel() {
    var existing=layerPanel.querySelectorAll('.layer-item:not(.layer-header)');
    existing.forEach(function(e){e.remove();});
    if(!layerOpen) return;
    items.slice().reverse().forEach(function(item){
      var div=document.createElement('div');
      div.className='layer-item'+(selectedIds.indexOf(item.id)!==-1?' active':'');
      var thumb=document.createElement('div'); thumb.className='thumb';
      var img=item.el.querySelector('img');
      if(img) {var ti=document.createElement('img');ti.src=img.src;thumb.appendChild(ti);}
      else thumb.textContent='T';
      div.appendChild(thumb);
      var name=document.createElement('span'); name.className='lname';
      name.textContent=img?'Design #'+item.id:(item.text||'Text');
      div.appendChild(name);
      div.onclick=function(){selectedIds=[item.id];updateSelection();};
      layerPanel.appendChild(div);
    });
  }

  /* ── Mouse events ── */
  function getCanvasXY(e) {
    var cr=canvas.getBoundingClientRect();
    return { x: (e.clientX-cr.left)/zoom, y: (e.clientY-cr.top)/zoom };
  }

  canvas.addEventListener('mousedown',function(e){updateCanvasWH();
    var itemEl=e.target.closest('.canvas-item');
    if(itemEl){
      var cid=parseInt(itemEl.dataset.itemId);
      if(e.target.classList.contains('resize-handle')){if(selectedIds.indexOf(cid)===-1){selectedIds=[cid];updateSelection();}startResize(e,cid,e.target.dataset.handle);return;}
      if(e.target.classList.contains('rot-handle')){if(selectedIds.indexOf(cid)===-1){selectedIds=[cid];updateSelection();}startRotate(e,cid);return;}
      if(e.ctrlKey||e.metaKey){toggleSelect(cid,true);return;}
      selectedIds=[cid];updateSelection();
      if(e.button===1){panX+=e.clientX;panY+=e.clientY;dragState={type:'pan',ox:e.clientX,oy:e.clientY};return;}
      startDrag(e,cid);return;
    }
    if(e.button===1||e.altKey){
      dragState={type:'pan',ox:e.clientX,oy:e.clientY};return;
    }
    if(textToolActive&&(e.target===canvas||e.target.classList.contains('grid-bg'))){
      var xy=getCanvasXY(e);
      addTextItem('Text',16,false);return;
    }
    if(!(e.ctrlKey||e.metaKey)){selectedIds=[];updateSelection();}
    var xy=getCanvasXY(e);
    dragState={type:'selbox',sx:xy.x,sy:xy.y};
  });

  document.addEventListener('mousemove',function(e){
    if(!dragState) return;
    if(dragState.type==='pan'){var dx=e.clientX-dragState.ox,dy=e.clientY-dragState.oy;panX+=dx;panY+=dy;dragState.ox=e.clientX;dragState.oy=e.clientY;applyZoom();return;}
    if(dragState.type==='move'){
      var dx=(e.clientX-dragState.ox)/zoom, dy=(e.clientY-dragState.oy)/zoom;
      dragState.ids.forEach(function(id){
        var item=items.find(function(i){return i.id==id;}); if(!item) return;
        var sp=dragState.startPos[id]; if(!sp) return;
        item.x=Math.max(0,Math.min(CANVAS_W-item.w,sp.x+dx));
        item.y=Math.max(0,sp.y+dy);
        var snap=document.getElementById('snap-toggle-'+sid).checked;
        var gridPx=snap?Math.round(CANVAS_W/600*5):0;
        if(gridPx>0){item.x=snapVal(item.x,gridPx);item.y=snapVal(item.y,gridPx);}
        item.el.style.left=item.x+'px'; item.el.style.top=item.y+'px';
      });
      guideH.style.display='none';guideV.style.display='none';
      var primary=items.find(function(i){return i.id==dragState.ids[0];}); if(primary) updateGuides(primary,items);
      return;
    }
    if(dragState.type==='resize'){
      var item=items.find(function(i){return i.id===dragState.id;}); if(!item) return;
      var dx=(e.clientX-dragState.ox)/zoom, dy=(e.clientY-dragState.oy)/zoom, h=dragState.handle, minS=30, cw=CANVAS_W, ch=CANVAS_H;
      if(h.includes('e')) item.w=Math.max(minS,dragState.sw+dx);
      if(h.includes('w')){var nw=Math.max(minS,dragState.sw-dx);item.x=dragState.sx+dragState.sw-nw;item.w=nw;}
      if(h.includes('s')) item.h=Math.max(minS,dragState.sh+dy);
      if(h.includes('n')){var nh=Math.max(minS,dragState.sh-dy);item.y=dragState.sy+dragState.sh-nh;item.h=nh;}
      item.x=Math.max(0,Math.min(CANVAS_W-item.w,item.x));item.y=Math.max(0,item.y);
      item.el.style.left=item.x+'px';item.el.style.top=item.y+'px';
      item.el.style.width=item.w+'px';item.el.style.height=item.h+'px';
      updateSizeInfo(item); return;
    }
    if(dragState.type==='rotate'){
      var item=items.find(function(i){return i.id===dragState.id;}); if(!item) return;
      item.rotation=(Math.atan2(e.clientY-dragState.cy,e.clientX-dragState.cx)-dragState.startAngle)*180/Math.PI;
      applyTransform(item); return;
    }
    if(dragState.type==='selbox'){
      var xy=getCanvasXY(e);
      var l=Math.min(dragState.sx,xy.x),r=Math.max(dragState.sx,xy.x),t=Math.min(dragState.sy,xy.y),b=Math.max(dragState.sy,xy.y);
      selBox.style.display='block';selBox.style.left=l+'px';selBox.style.top=t+'px';
      selBox.style.width=(r-l)+'px';selBox.style.height=(b-t)+'px';
    }
  });

  document.addEventListener('mouseup',function(){
    if(!dragState) return;
    if(dragState.type==='selbox'){
      selBox.style.display='none';
      var sw=parseFloat(selBox.style.width)||0, sh=parseFloat(selBox.style.height)||0;
      selBox.style.width='0px';selBox.style.height='0px';
      if(sw>3||sh>3) selectAllInRect(parseFloat(selBox.style.left),parseFloat(selBox.style.top),parseFloat(selBox.style.left)+sw,parseFloat(selBox.style.top)+sh);
    } else if(dragState.type==='move'){guideH.style.display='none';guideV.style.display='none';
      // Revert to last valid position if still overlapping
      dragState.ids.forEach(function(id){
        var dragged=items.find(function(i){return i.id===id;}); if(!dragged)return;
        var valid=items.every(function(o){return o.id===id||!rectsOverlap(dragged,o);});
        if(!valid){
          var sp=dragState.startPos[id]; if(!sp)return;
          dragged.x=sp.x; dragged.y=sp.y;
          dragged.el.style.left=sp.x+'px'; dragged.el.style.top=sp.y+'px';
          dragged.el.style.opacity=''; dragged.el.style.outline='';
        } else {
          dragged.el.style.opacity=''; dragged.el.style.outline='';
        }
      });
      saveState();growCanvas();
      var item=items.find(function(i){return i.id===dragState.ids[0];}); if(item){item.el.style.cursor='grab';}
    } else if(dragState.type==='resize'||dragState.type==='rotate'){saveState();growCanvas();
      var item=items.find(function(i){return i.id===dragState.id;}); if(item) item.el.style.cursor='grab';
    }
    dragState=null;
  });

  /* ── Zoom / Pan via wheel ── */
  wrap.addEventListener('wheel',function(e){
    if(!e.ctrlKey&&!e.metaKey) return;
    e.preventDefault();
    var rect=wrap.getBoundingClientRect();
    var mx=(e.clientX-rect.left-20)/zoom-panX, my=(e.clientY-rect.top-40)/zoom-panY;
    var f=e.deltaY>0?0.9:1.1;
