<!-- Preload CSS for above-the-fold paint (non-blocking) -->
{{ 'sticker-configurator.css' | asset_url | stylesheet_tag }}
<!-- Defer JS — component renders in connectedCallback, no render-blocking needed -->
<script src="{{ 'sticker-configurator.js' | asset_url }}" defer></script>
<script src="{{ 'sticker-configurator-experience.js' | asset_url }}" defer></script>

<style>
  #shopify-section-{{ section.id }} {
    --cfg-padding-top: {{ section.settings.padding_top }}px;
    --cfg-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .shopify-section.sticker-configurator > sticker-configurator { position: relative; }
  .shopify-section.sticker-configurator > sticker-configurator.is-loading {
    min-height: min(720px, calc(100svh - var(--header-group-height, 64px)));
  }
  .shopify-section.sticker-configurator > sticker-configurator.is-loading > :not(.cfg-loading-skeleton) {
    visibility: hidden;
  }
  .cfg-loading-skeleton {
    position: absolute;
    z-index: 100;
    inset: 0;
    display: grid;
    grid-template-rows: auto auto minmax(180px, 1fr) auto auto;
    gap: 12px;
    padding: clamp(12px, 2vw, 24px);
    overflow: hidden;
    background: #fff;
  }
</style>

{%- liquid
  assign bg_color = section.settings.bg_color
  assign base_price = section.settings.base_price
  assign configurator_product = section.settings.product | default: product
  assign heading = configurator_product.title | default: section.settings.heading
  assign configurator_variant = configurator_product.selected_or_first_available_variant
  assign unit_price_cents = configurator_variant.price
  if unit_price_cents == blank
    assign unit_price_cents = base_price | times: 100 | round
  endif
-%}

{% if configurator_product != blank %}
  <script type="application/ld+json">
    {{ configurator_product | structured_data }}
  </script>
{% endif %}

<sticker-configurator
  data-section-id="{{ section.id }}"
  data-heading="{{ heading | escape }}"
  data-bg-color="{{ bg_color }}"
  data-base-price="{{ base_price }}"
  data-unit-price-cents="{{ unit_price_cents }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency | escape }}"
  data-variant-id="{{ configurator_variant.id }}"
  data-product-id="{{ configurator_product.id }}"
  data-product-title="{{ configurator_product.title | escape }}"
  data-variant-available="{{ configurator_variant.available | default: false }}"
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}"
  data-grid-size="{{ section.settings.grid_size }}"
  data-snap-enabled="{{ section.settings.snap_enabled }}"
  data-gap-mm="{{ section.settings.gap_mm | default: 3 }}"
  data-clipboard-enabled="{{ section.settings.enable_clipboard }}"
  data-undo-enabled="{{ section.settings.enable_undo_redo }}"
  data-auto-arrange-enabled="{{ section.settings.enable_auto_arrange }}"
  data-export-enabled="{{ section.settings.enable_export }}"
  data-export-dpi="{{ section.settings.export_dpi }}"
  data-jspdf-url="{{ 'jspdf.umd.min.js' | asset_url }}"
  data-max-file-mb="{{ section.settings.max_file_mb }}"
  data-redirect-to-cart="{{ section.settings.redirect_to_cart }}"
  data-track-enabled="{{ section.settings.enable_analytics }}"
  data-onboarding-version="1"
  data-resolution-low="{{ section.settings.resolution_low_text | escape }}"
  data-resolution-success="{{ section.settings.resolution_success_text | escape }}"
  aria-busy="true"
  role="region"
  aria-label="{{ 'sections.sticker-configurator.editor_aria_label' | t | escape }}"
  {% unless heading == blank %}aria-labelledby="cfg-heading-{{ section.id }}"{% endunless %}
  class="splash-configurator is-loading"
  style="
    --cfg-bg: {{ bg_color }};
  "
>
  <script type="application/json" data-configurator-copy>
    {
      "add_design_error": {{ 'sections.sticker-configurator.add_design_error' | t | json }},
      "product_variant_missing": {{ 'sections.sticker-configurator.product_variant_missing' | t | json }},
      "variant_unavailable": {{ 'sections.sticker-configurator.variant_unavailable' | t | json }},
      "adding_to_cart": {{ 'sections.sticker-configurator.adding_to_cart' | t | json }},
      "design_added": {{ 'sections.sticker-configurator.design_added' | t | json }},
      "design_add_failed": {{ 'sections.sticker-configurator.design_add_failed' | t | json }},
      "cart_add_failed": {{ 'sections.sticker-configurator.cart_add_failed' | t | json }},
      "choose_or_drop_design": {{ 'sections.sticker-configurator.choose_or_drop_design' | t | json }},
      "file_type_error": {{ 'sections.sticker-configurator.file_type_error' | t | json }},
      "file_size_error": {{ 'sections.sticker-configurator.file_size_error' | t: max_file_mb: section.settings.max_file_mb | json }},
      "design_selected": {{ 'sections.sticker-configurator.design_selected' | t | json }},
      "pdf_library_error": {{ 'sections.sticker-configurator.pdf_library_error' | t | json }},
      "pdf_page_error": {{ 'sections.sticker-configurator.pdf_page_error' | t | json }},
      "pdf_image_error": {{ 'sections.sticker-configurator.pdf_image_error' | t | json }},
      "pdf_generate_error": {{ 'sections.sticker-configurator.pdf_generate_error' | t | json }},
      "sticker_alt": {{ 'sections.sticker-configurator.sticker_alt' | t | json }},
      "sticker_item_aria": {{ 'sections.sticker-configurator.sticker_item_aria' | t | json }},
      "text_aria_prefix": {{ 'sections.sticker-configurator.text_aria_prefix' | t | json }},
      "too_wide": {{ 'sections.sticker-configurator.too_wide' | t | json }},
      "resolution_too_large": {{ 'sections.sticker-configurator.resolution_too_large' | t | json }},
      "close": {{ 'sections.sticker-configurator.close' | t | json }},
      "cancel": {{ 'sections.sticker-configurator.cancel' | t | json }},
      "save": {{ 'sections.sticker-configurator.save' | t | json }},
      "ok": {{ 'sections.sticker-configurator.ok' | t | json }},
      "bold": {{ 'sections.sticker-configurator.bold' | t | json }},
      "italic": {{ 'sections.sticker-configurator.italic' | t | json }},
      "align_left": {{ 'sections.sticker-configurator.align_left' | t | json }},
      "align_center": {{ 'sections.sticker-configurator.align_center' | t | json }},
      "align_right": {{ 'sections.sticker-configurator.align_right' | t | json }},
      "edit_text_title": {{ 'sections.sticker-configurator.edit_text_title' | t | json }},
      "size_label": {{ 'sections.sticker-configurator.size_label' | t | json }},
      "color_label": {{ 'sections.sticker-configurator.color_label' | t | json }},
      "bg_label": {{ 'sections.sticker-configurator.bg_label' | t | json }},
      "items": {{ 'sections.sticker-configurator.items' | t | json }},
      "selected": {{ 'sections.sticker-configurator.selected' | t | json }},
      "area_unit": {{ 'sections.sticker-configurator.area_unit' | t | json }},
      "multi_select": {{ 'sections.sticker-configurator.multi_select' | t | json }},
      "multi_select_exit": {{ 'sections.sticker-configurator.multi_select_exit' | t | json }}
    }
  </script>
  <div class="cfg-loading-skeleton" role="status" aria-live="polite">
    <div class="cfg-skeleton-heading"><span></span><span></span></div>
    <div class="cfg-skeleton-toolbar"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
    <div class="cfg-skeleton-canvas"><span></span></div>
    <div class="cfg-skeleton-actions"><span></span><span></span><span></span></div>
    <div class="cfg-loading-status">
      <span>{{ 'sections.sticker-configurator.loading_status' | t | escape }}</span>
      <span class="cfg-loading-progress"><i></i></span>
    </div>
  </div>
  <div
    class="cfg-export-overlay"
    id="export-overlay-{{ section.id }}"
    role="status"
    aria-live="polite"
    aria-hidden="true"
    hidden
  >
    <div class="cfg-export-loader">
      <span class="cfg-export-spinner" aria-hidden="true"></span>
      <span>{{ 'sections.sticker-configurator.export_loading' | t | escape }}</span>
    </div>
  </div>
  {%- unless heading == blank -%}
    <div class="cfg-header">
      <h2 class="cfg-heading" id="cfg-heading-{{ section.id }}">{{ heading | escape }}</h2>
    </div>
  {%- endunless -%}

  {% if section.settings.show_quick_start %}
    <aside class="cfg-onboarding" id="onboarding-{{ section.id }}" aria-labelledby="onboarding-title-{{ section.id }}">
      <div class="cfg-onboarding-copy">
        <h3 id="onboarding-title-{{ section.id }}">{{ section.settings.quick_start_heading | escape }}</h3>
        <ol>
          <li><span aria-hidden="true">1</span>{{ section.settings.quick_start_step_1 | escape }}</li>
          <li><span aria-hidden="true">2</span>{{ section.settings.quick_start_step_2 | escape }}</li>
          <li><span aria-hidden="true">3</span>{{ section.settings.quick_start_step_3 | escape }}</li>
        </ol>
      </div>
      <button type="button" class="cfg-onboarding-dismiss" data-configurator-dismiss aria-label="{{ section.settings.quick_start_dismiss | escape }}">{{ section.settings.quick_start_dismiss | escape }}</button>
    </aside>
  {% endif %}

  <div class="editor-wrap splash-configurator__editor">
    <div class="toolbar" role="toolbar" aria-label="{{ 'sections.sticker-configurator.toolbar_aria_label' | t | escape }}">
      <!-- Toolbar buttons generated via JS delegation (data-action) -->
      {% if section.settings.enable_undo_redo %}
        <button title="{{ 'sections.sticker-configurator.undo' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.undo' | t | escape }}" data-action="undo" id="undo-btn-{{ section.id }}" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        </button>
        <button title="{{ 'sections.sticker-configurator.redo' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.redo' | t | escape }}" data-action="redo" id="redo-btn-{{ section.id }}" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
        </button>
        <span class="toolbar-divider"></span>
      {% endif %}
      {% if section.settings.enable_auto_arrange %}
        <button title="{{ 'sections.sticker-configurator.auto_arrange' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.auto_arrange' | t | escape }}" data-action="auto-arrange" id="auto-btn-{{ section.id }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        </button>
      {% endif %}
      <button title="{{ 'sections.sticker-configurator.delete_selected' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.delete_selected_aria' | t | escape }}" data-action="delete" id="del-btn-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
      </button>
      {% if section.settings.enable_export %}
        <button title="{{ 'sections.sticker-configurator.export_pdf' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.export_aria' | t | escape }}" data-action="export-pdf" id="export-btn-{{ section.id }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </button>
      {% endif %}
      <details class="cfg-toolbar-more">
        <summary title="{{ 'sections.sticker-configurator.more_tools' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.more_tools' | t | escape }}">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><circle cx="5" cy="12" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="19" cy="12" r="1.8"/></svg>
        </summary>
        <div class="cfg-toolbar-more-controls">
          <button title="{{ 'sections.sticker-configurator.duplicate' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.duplicate_selected' | t | escape }}" data-action="duplicate" id="dup-btn-{{ section.id }}" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          </button>
          <span class="toolbar-divider"></span>
          <button title="{{ 'sections.sticker-configurator.flip_h' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.flip_horizontal' | t | escape }}" data-action="flip-h" id="flip-h-{{ section.id }}" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><polyline points="7 8 3 12 7 16"/><polyline points="17 8 21 12 17 16"/></svg>
          </button>
          <button title="{{ 'sections.sticker-configurator.flip_v' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.flip_vertical' | t | escape }}" data-action="flip-v" id="flip-v-{{ section.id }}" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18"/><polyline points="8 7 12 3 16 7"/><polyline points="8 17 12 21 16 17"/></svg>
          </button>
          <span class="toolbar-divider"></span>
          <button title="{{ 'sections.sticker-configurator.add_text' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.add_text' | t | escape }}" data-action="add-text" id="text-btn-{{ section.id }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
          </button>
          <button title="{{ 'sections.sticker-configurator.zoom_to_fit' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.zoom_to_fit' | t | escape }}" data-action="zoom-fit" id="zoom-fit-{{ section.id }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="11" y1="8" x2="11" y2="14"/></svg>
          </button>
          <span class="toolbar-divider"></span>
          <button title="{{ 'sections.sticker-configurator.lock' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.lock_selected' | t | escape }}" data-action="lock" id="lock-btn-{{ section.id }}" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </button>
          <button title="{{ 'sections.sticker-configurator.mobile' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.toggle_mobile' | t | escape }}" data-action="mobile" id="mobile-btn-{{ section.id }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </button>
          <button title="{{ 'sections.sticker-configurator.multi_select' | t | escape }}" aria-label="{{ 'sections.sticker-configurator.toggle_multi_select' | t | escape }}" data-action="multi-select" id="multi-select-btn-{{ section.id }}" aria-pressed="false">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="11" height="11" rx="2"/><path d="M9 20h9a2 2 0 0 0 2-2V9"/></svg>
          </button>
        </div>
      </details>
      <span class="zoom-display" id="zoom-display-{{ section.id }}">100%</span>
    </div>

    <div class="cfg-info-bar">
      <span id="item-count-{{ section.id }}" aria-live="polite" aria-atomic="true">0 {{ 'sections.sticker-configurator.items_count' | t | escape }}</span>
      <span id="sel-size-{{ section.id }}" aria-live="polite" aria-atomic="true">&nbsp;</span>
      <span id="hint-text-{{ section.id }}">
        <span class="hint-desktop">{{ 'sections.sticker-configurator.hint_text_desktop' | t | escape }}</span>
        <span class="hint-mobile">{{ 'sections.sticker-configurator.hint_text_mobile' | t | escape }}</span>
      </span>
    </div>

    <div class="size-inputs" id="size-inputs-{{ section.id }}">
      <label for="w-input-{{ section.id }}">{{ 'sections.sticker-configurator.w_label' | t | escape }}:</label>
      <input id="w-input-{{ section.id }}" type="number" min="10" max="600" step="1" class="cfg-inline-input">
      <label for="h-input-{{ section.id }}">{{ 'sections.sticker-configurator.h_label' | t | escape }}:</label>
      <input id="h-input-{{ section.id }}" type="number" min="10" max="600" step="1" class="cfg-inline-input">
      <span class="size-unit">{{ 'sections.sticker-configurator.mm' | t | escape }}</span>
    </div>

    <div class="canvas-wrap" id="canvas-wrap-{{ section.id }}" role="region" aria-label="{{ 'sections.sticker-configurator.canvas' | t | escape }}">
      <div class="canvas-stage" id="canvas-stage-{{ section.id }}">
        <div class="canvas-area" id="canvas-{{ section.id }}">
          <canvas class="grid-bg" id="grid-canvas-{{ section.id }}"></canvas>
          <div class="canvas-hint" id="hint-{{ section.id }}">{{ 'sections.sticker-configurator.canvas_hint' | t | escape }}</div>
          <div class="sel-box" aria-hidden="true"></div>
          <div class="guide-line h" id="guide-h-{{ section.id }}"></div>
          <div class="guide-line v" id="guide-v-{{ section.id }}"></div>
        </div>
      </div>
    </div>
  </div>

    <div class="cfg-controls splash-configurator__controls">
      <input type="file" accept="image/png,image/jpeg,image/webp" id="file-input-{{ section.id }}" aria-label="{{ 'sections.sticker-configurator.choose_design' | t | escape }}" hidden>
      {% if configurator_product != blank and configurator_product.has_only_default_variant == false %}
        <label class="cfg-variant-field" for="variant-select-{{ section.id }}">
          <span>{{ 'sections.sticker-configurator.product_option' | t | escape }}</span>
          <select id="variant-select-{{ section.id }}">
            {% for variant in configurator_product.variants %}
              <option
                value="{{ variant.id }}"
                data-price-cents="{{ variant.price }}"
                data-available="{{ variant.available }}"
                {% if variant.id == configurator_variant.id %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title | escape }} — {{ variant.price | money_with_currency }}
              </option>
            {% endfor %}
          </select>
        </label>
      {% endif %}
      <div class="upload-btn-area">
        <button id="add-btn-{{ section.id }}" class="cfg-add-design" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          {{ 'sections.sticker-configurator.add_design' | t | escape }}
        </button>
        <div class="qty-group" role="group" aria-label="{{ 'sections.sticker-configurator.quantity' | t | escape }}">
          <button id="qty-down-{{ section.id }}" type="button" aria-label="{{ 'sections.sticker-configurator.decrease_quantity' | t | escape }}">&minus;</button>
          <span class="qty-val" id="qty-display-{{ section.id }}" aria-live="polite" aria-atomic="true">1</span>
          <button id="qty-up-{{ section.id }}" type="button" aria-label="{{ 'sections.sticker-configurator.increase_quantity' | t | escape }}">+</button>
        </div>
        <span class="qty-label">{{ 'sections.sticker-configurator.pieces' | t | escape }}</span>
      </div>
      <button
        id="submit-{{ section.id }}"
        class="cfg-btn-submit"
        type="button"
        disabled
      >
        {{ 'sections.sticker-configurator.add_to_cart' | t | escape }} &mdash; <span id="price-display-{{ section.id }}">$0.00</span>
      </button>
      <p id="cart-status-{{ section.id }}" class="cfg-cart-status" role="status" aria-live="polite"></p>

      <details class="bottom-extra">
        <summary>
          <span>{{ 'sections.sticker-configurator.options' | t | escape }}</span>
          <span class="bottom-extra-chevron" aria-hidden="true"></span>
        </summary>
        <div class="be-row">
          <span class="be-label">{{ 'sections.sticker-configurator.snap' | t | escape }}</span>
          <input
            type="checkbox"
            id="snap-btm-{{ section.id }}"
            {% if section.settings.snap_enabled %}checked{% endif %}
          >
          <span class="be-unit">{{ 'sections.sticker-configurator.grid' | t | escape }}</span>
          <input
            type="number"
            id="grid-size-{{ section.id }}"
            value="{{ section.settings.grid_size }}"
            min="5"
            max="100"
            step="5"
            class="cfg-inline-sm"
          >
          <span class="be-unit">{{ 'sections.sticker-configurator.mm' | t | escape }}</span>
          <span class="be-label">{{ 'sections.sticker-configurator.gap' | t | escape }}</span>
          <input type="number" id="gap-size-{{ section.id }}" value="3" min="3" max="50" step="1" class="cfg-inline-sm">
          <span class="be-unit">{{ 'sections.sticker-configurator.mm' | t | escape }}</span>
        </div>
        <div class="be-row">
          <span id="stats-{{ section.id }}" class="cfg-text-muted"></span>
          <label class="visually-hidden" for="bg-color-{{ section.id }}">{{ 'sections.sticker-configurator.sheet_background' | t | escape }}</label>
          <input type="color" id="bg-color-{{ section.id }}" value="#FFFFFF">
          <button class="be-btn danger" id="clear-btn-{{ section.id }}" type="button">{{ 'sections.sticker-configurator.clear_all' | t | escape }}</button>
        </div>
      </details>
    </div>

    <dialog id="modal-{{ section.id }}" class="cfg-modal" aria-modal="true" aria-labelledby="modal-title-{{ section.id }}">
      <div class="cfg-modal-box">
        <div class="cfg-modal-title-row">
          <div>
            <h3 class="cfg-modal-title" id="modal-title-{{ section.id }}">{{ 'sections.sticker-configurator.add_design_modal_title' | t | escape }}</h3>
          </div>
        </div>
        <div class="cfg-modal-zone" id="modal-zone-{{ section.id }}" role="button" tabindex="0" aria-controls="file-input-{{ section.id }}" aria-label="{{ 'sections.sticker-configurator.choose_or_drop_design' | t | escape }}">
          <div class="cfg-modal-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5"/><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
          </div>
          <div class="cfg-modal-text">{{ 'sections.sticker-configurator.choose_or_drop_design' | t | escape }}</div>
          <div class="cfg-modal-note">
            {{ 'sections.sticker-configurator.file_types_note' | t: max_file_mb: section.settings.max_file_mb | escape }}
          </div>
          <div class="cfg-modal-fname" id="modal-fname-{{ section.id }}"></div>
          <p class="cfg-resolution-warning" id="resolution-warning-{{ section.id }}" role="status" aria-live="polite"></p>
        </div>
        <div class="cfg-modal-fields">
          <div class="cfg-modal-row">
            <label for="modal-w-{{ section.id }}">{{ 'sections.sticker-configurator.width' | t | escape }}</label>
            <input type="number" id="modal-w-{{ section.id }}" value="50" min="10" max="600" step="1">
            <span>{{ 'sections.sticker-configurator.mm' | t | escape }}</span>
          </div>
          <div class="cfg-modal-row">
            <label for="modal-h-{{ section.id }}">{{ 'sections.sticker-configurator.height' | t | escape }}</label>
            <input type="number" id="modal-h-{{ section.id }}" value="50" min="10" max="600" step="1">
            <span>{{ 'sections.sticker-configurator.mm' | t | escape }}</span>
          </div>
          <div class="cfg-modal-row">
            <label for="modal-qty-{{ section.id }}">{{ 'sections.sticker-configurator.copies_label' | t | escape }}</label>
            <input type="number" id="modal-qty-{{ section.id }}" value="3" min="1" max="50" step="1">
            <span>{{ 'sections.sticker-configurator.pieces_unit' | t | escape }}</span>
          </div>
        </div>
        <div class="cfg-modal-actions">
          <button id="modal-cancel-{{ section.id }}" class="cfg-btn-sec" type="button">{{ 'sections.sticker-configurator.cancel' | t | escape }}</button>
          <button id="modal-add-{{ section.id }}" class="cfg-btn-pry" type="button" disabled>{{ 'sections.sticker-configurator.add_to_canvas' | t | escape }}</button>
        </div>
      </div>
    </dialog>
</sticker-configurator>

