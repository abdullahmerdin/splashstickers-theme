{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.bg_color
  assign accent_color = section.settings.accent_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
.sticker-config-{{ section.id }} {
  background: {{ bg_color }};
  padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  position: relative;
  overflow: hidden;
}

.sticker-config-{{ section.id }} .config-inner {
  max-width: 1000px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: start;
}

.sticker-config-{{ section.id }} .preview-area {
  position: sticky;
  top: 100px;
  aspect-ratio: 1;
  max-width: 400px;
  width: 100%;
  margin: 0 auto;
  background: {{ bg_color | color_darken: 5 }};
  border-radius: 20px;
  border: 2px dashed {{ accent_color }}40;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
  color: {{ accent_color }}40;
  overflow: hidden;
}

.sticker-config-{{ section.id }} .preview-area img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: 20px;
}

.sticker-config-{{ section.id }} .config-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.sticker-config-{{ section.id }} .config-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.sticker-config-{{ section.id }} .config-group label {
  font-size: 0.9rem;
  font-weight: 600;
  color: #2D3436;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.sticker-config-{{ section.id }} .option-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.sticker-config-{{ section.id }} .option-btn {
  padding: 10px 20px;
  border: 2px solid #DFE6E9;
  border-radius: 10px;
  background: #fff;
  cursor: pointer;
  font-size: 0.85rem;
  font-weight: 500;
  transition: all 0.2s ease;
  color: #636E72;
}

.sticker-config-{{ section.id }} .option-btn:hover {
  border-color: {{ accent_color }};
  color: {{ accent_color }};
}

.sticker-config-{{ section.id }} .option-btn.active {
  border-color: {{ accent_color }};
  background: {{ accent_color }}15;
  color: {{ accent_color }};
  font-weight: 600;
}

.sticker-config-{{ section.id }} .upload-zone {
  border: 2px dashed {{ accent_color }}40;
  border-radius: 16px;
  padding: 32px;
  text-align: center;
  cursor: pointer;
  transition: all 0.3s ease;
  background: {{ accent_color }}08;
}

.sticker-config-{{ section.id }} .upload-zone:hover {
  border-color: {{ accent_color }};
  background: {{ accent_color }}12;
}

.sticker-config-{{ section.id }} .upload-zone.dragover {
  border-color: {{ accent_color }};
  background: {{ accent_color }}18;
  transform: scale(1.02);
}

.sticker-config-{{ section.id }} .upload-zone input {
  display: none;
}

.sticker-config-{{ section.id }} .upload-zone .upload-icon {
  font-size: 2.5rem;
  margin-bottom: 8px;
}

.sticker-config-{{ section.id }} .upload-zone .upload-text {
  font-size: 0.9rem;
  color: #636E72;
}

.sticker-config-{{ section.id }} .upload-zone .upload-hint {
  font-size: 0.75rem;
  color: #B2BEC3;
  margin-top: 4px;
}

.sticker-config-{{ section.id }} .qty-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.sticker-config-{{ section.id }} .qty-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 2px solid #DFE6E9;
  background: #fff;
  cursor: pointer;
  font-size: 1.1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  color: #636E72;
}

.sticker-config-{{ section.id }} .qty-btn:hover {
  border-color: {{ accent_color }};
  color: {{ accent_color }};
}

.sticker-config-{{ section.id }} .qty-value {
  font-size: 1.2rem;
  font-weight: 700;
  min-width: 40px;
  text-align: center;
  color: #2D3436;
}

.sticker-config-{{ section.id }} .config-submit {
  padding: 14px 32px;
  border: none;
  border-radius: 12px;
  background: linear-gradient(135deg, {{ accent_color }}, {{ accent_color | color_darken: 15 }});
  color: #fff;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 8px;
}

.sticker-config-{{ section.id }} .config-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px {{ accent_color }}30;
}

@media (max-width: 768px) {
  .sticker-config-{{ section.id }} .config-inner {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .sticker-config-{{ section.id }} .preview-area {
    position: static;
    max-width: 300px;
  }
}
{% endstyle %}

<div class="sticker-config-{{ section.id }}">
  <div class="page-width">
    {% if heading != blank %}
      <div style="text-align:center;padding:0 20px 24px;">
        <h2 style="margin:0;">{{ heading }}</h2>
        {% if subtext != blank %}
          <p style="color:#636E72;margin:4px 0 0;">{{ subtext }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="config-inner">
      <!-- Preview -->
      <div class="preview-area" id="preview-{{ section.id }}">
        <span id="preview-icon-{{ section.id }}">🖼️</span>
        <img id="preview-img-{{ section.id }}" style="display:none;" alt="Preview">
      </div>

      <!-- Form -->
      <div class="config-form" id="config-form-{{ section.id }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'size' %}
              <div class="config-group" {{ block.shopify_attributes }}>
                <label>{{ block.settings.heading | default: 'Size' }}</label>
                <div class="option-row" data-option="size">
                  {% for opt in block.settings.options | split: ',' %}
                    <button class="option-btn{% if forloop.first %} active{% endif %}" data-value="{{ opt | strip }}">{{ opt | strip }}</button>
                  {% endfor %}
                </div>
              </div>

            {% when 'material' %}
              <div class="config-group" {{ block.shopify_attributes }}>
                <label>{{ block.settings.heading | default: 'Material' }}</label>
                <div class="option-row" data-option="material">
                  {% for opt in block.settings.options | split: ',' %}
                    <button class="option-btn{% if forloop.first %} active{% endif %}" data-value="{{ opt | strip }}">{{ opt | strip }}</button>
                  {% endfor %}
                </div>
              </div>

            {% when 'quantity' %}
              <div class="config-group" {{ block.shopify_attributes }}>
                <label>{{ block.settings.heading | default: 'Quantity' }}</label>
                <div class="qty-row">
                  <button class="qty-btn" data-qty="dec">−</button>
                  <span class="qty-value" id="qty-{{ section.id }}">{{ block.settings.default_qty | default: 10 }}</span>
                  <button class="qty-btn" data-qty="inc">+</button>
                  <span style="font-size:0.85rem;color:#636E72;margin-left:8px;">{{ block.settings.unit | default: 'pieces' }}</span>
                </div>
              </div>

            {% when 'upload' %}
              <div class="config-group" {{ block.shopify_attributes }}>
                <label>{{ block.settings.heading | default: 'Upload Your Design' }}</label>
                <div class="upload-zone" id="upload-zone-{{ section.id }}">
                  <div class="upload-icon">📁</div>
                  <div class="upload-text">{{ block.settings.upload_text | default: 'Click or drag to upload your artwork' }}</div>
                  <div class="upload-hint">{{ block.settings.hint | default: 'PNG, JPG, SVG · Max 10MB' }}</div>
                  <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" id="file-input-{{ section.id }}">
                </div>
              </div>

          {% endcase %}
        {% endfor %}

        <button class="config-submit" id="submit-{{ section.id }}">
          Add to Cart — <span id="price-display-{{ section.id }}">$0.00</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var sid = {{ section.id | json }};
  var form = document.getElementById('config-form-' + sid);
  if (!form) return;

  var selections = {};
  var qtyEl = document.getElementById('qty-' + sid);
  var previewImg = document.getElementById('preview-img-' + sid);
  var previewIcon = document.getElementById('preview-icon-' + sid);
  var priceEl = document.getElementById('price-display-' + sid);

  // Option buttons
  form.querySelectorAll('.option-row').forEach(function(row) {
    var key = row.dataset.option;
    row.querySelectorAll('.option-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        row.querySelector('.active') && row.querySelector('.active').classList.remove('active');
        this.classList.add('active');
        selections[key] = this.dataset.value;
        updatePrice();
      });
      if (btn.classList.contains('active')) selections[key] = btn.dataset.value;
    });
  });

  // Quantity
  form.querySelectorAll('.qty-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var qty = parseInt(qtyEl.textContent) || 1;
      if (this.dataset.qty === 'inc') qty += 1;
      else if (this.dataset.qty === 'dec' && qty > 1) qty -= 1;
      qtyEl.textContent = qty;
      updatePrice();
    });
  });

  // Upload
  var uploadZone = document.getElementById('upload-zone-' + sid);
  var fileInput = document.getElementById('file-input-' + sid);

  uploadZone.addEventListener('click', function() { fileInput.click(); });

  uploadZone.addEventListener('dragover', function(e) {
    e.preventDefault();
    this.classList.add('dragover');
  });
  uploadZone.addEventListener('dragleave', function() {
    this.classList.remove('dragover');
  });
  uploadZone.addEventListener('drop', function(e) {
    e.preventDefault();
    this.classList.remove('dragover');
    if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]);
  });

  fileInput.addEventListener('change', function() {
    if (this.files.length) handleFile(this.files[0]);
  });

  function handleFile(file) {
    if (!file.type.match('image.*')) return;
    var reader = new FileReader();
    reader.onload = function(e) {
      previewImg.src = e.target.result;
      previewImg.style.display = 'block';
      previewIcon.style.display = 'none';
      uploadZone.querySelector('.upload-text').textContent = file.name;
      uploadZone.querySelector('.upload-icon').textContent = '✅';
    };
    reader.readAsDataURL(file);
  }

  // Simple pricing
  var basePrice = {{ section.settings.base_price | default: 5 | json }};
  function updatePrice() {
    var qty = parseInt(qtyEl.textContent) || 1;
    var sizeMultiplier = 1;
    var size = selections.size || '';
    if (size.toLowerCase().includes('large') || size.toLowerCase().includes('xl') || size.toLowerCase().includes('xxl')) sizeMultiplier = 1.5;
    if (size.toLowerCase().includes('small')) sizeMultiplier = 0.8;
    var matMultiplier = 1;
    var mat = selections.material || '';
    if (mat.toLowerCase().includes('holographic') || mat.toLowerCase().includes('premium')) matMultiplier = 1.3;
    if (mat.toLowerCase().includes('weatherproof')) matMultiplier = 1.2;
    var total = basePrice * sizeMultiplier * matMultiplier * qty;
    priceEl.textContent = '$' + total.toFixed(2);
  }
  updatePrice();
})();
</script>

{% schema %}
{
  "name": "Sticker Configurator",
  "tag": "section",
  "class": "sticker-configurator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Configure Your Sticker"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext"
    },
    {
      "type": "range",
      "id": "base_price",
      "label": "Base price ($)",
      "min": 1,
      "max": 50,
      "step": 0.5,
      "default": 5
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#00CEC9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size options",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Size"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Options (comma-separated)",
          "default": "Small (2\"), Medium (3\"), Large (5\"), XL (7\")",
          "info": "First option is default"
        }
      ]
    },
    {
      "type": "material",
      "name": "Material options",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Options (comma-separated)",
          "default": "Matte, Glossy, Transparent, Holographic",
          "info": "First option is default"
        }
      ]
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Quantity"
        },
        {
          "type": "number",
          "id": "default_qty",
          "label": "Default quantity",
          "default": 10
        },
        {
          "type": "text",
          "id": "unit",
          "label": "Unit label",
          "default": "pieces"
        }
      ]
    },
    {
      "type": "upload",
      "name": "File upload",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Upload Your Design"
        },
        {
          "type": "text",
          "id": "upload_text",
          "label": "Upload area text",
          "default": "Click or drag to upload your artwork"
        },
        {
          "type": "text",
          "id": "hint",
          "label": "Hint text",
          "default": "PNG, JPG, SVG · Max 10MB"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticker Configurator",
      "category": "Custom",
      "blocks": [
        { "type": "size" },
        { "type": "material" },
        { "type": "quantity" },
        { "type": "upload" }
      ]
    }
  ]
}
{% endschema %}
