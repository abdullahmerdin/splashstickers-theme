<!-- Preload CSS for above-the-fold paint (non-blocking) -->
<link rel="preload" href="{{ 'sticker-configurator.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'sticker-configurator.css' | asset_url }}"></noscript>
<!-- Defer JS — component renders in connectedCallback, no render-blocking needed -->
<script src="{{ 'sticker-configurator.js' | asset_url }}" defer></script>

{%- liquid
  assign bg_color = section.settings.bg_color
  assign heading = section.settings.heading
  assign base_price = section.settings.base_price
-%}

<sticker-configurator
  data-section-id="{{ section.id }}"
  data-heading="{{ heading | escape }}"
  data-bg-color="{{ bg_color }}"
  data-base-price="{{ base_price }}"
  data-gap-mm="{{ section.settings.gap_mm | default: 3 }}"
  style="--cfg-bg: {{ bg_color }};"
>
  {%- unless heading == blank -%}
    <div class="cfg-header">
      <span class="cfg-eyebrow">Gangsheet Studio</span>
      <h2 class="cfg-heading">{{ heading | escape }}</h2>
    </div>
  {%- endunless -%}

  <div class="editor-wrap">
    <div class="toolbar" role="toolbar" aria-label="Canvas tools">
      <!-- Toolbar buttons generated via JS delegation (data-action) -->
      <button title="Undo" data-action="undo" id="undo-btn-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
      </button>
      <button title="Redo" data-action="redo" id="redo-btn-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
      </button>
      <span class="toolbar-divider"></span>
      <button title="Auto arrange" data-action="auto-arrange" id="auto-btn-{{ section.id }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
      </button>
      <button title="Delete selected" data-action="delete" id="del-btn-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
      </button>
      <button title="Duplicate" data-action="duplicate" id="dup-btn-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      </button>
      <span class="toolbar-divider"></span>
      <button title="Flip H" data-action="flip-h" id="flip-h-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><polyline points="7 8 3 12 7 16"/><polyline points="17 8 21 12 17 16"/></svg>
      </button>
      <button title="Flip V" data-action="flip-v" id="flip-v-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18"/><polyline points="8 7 12 3 16 7"/><polyline points="8 17 12 21 16 17"/></svg>
      </button>
      <span class="toolbar-divider"></span>
      <button title="Align left" data-action="align-left" id="align-left-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="10" x2="14" y2="10"/><line x1="4" y1="14" x2="18" y2="14"/><line x1="4" y1="18" x2="10" y2="18"/></svg>
      </button>
      <button title="Align center H" data-action="align-h" id="align-h-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="6" y1="14" x2="18" y2="14"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
      </button>
      <button title="Align right" data-action="align-right" id="align-right-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="10" y1="10" x2="20" y2="10"/><line x1="6" y1="14" x2="20" y2="14"/><line x1="14" y1="18" x2="20" y2="18"/></svg>
      </button>
      <button title="Align top" data-action="align-top" id="align-top-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="4" x2="18" y2="4"/><line x1="10" y1="8" x2="14" y2="8"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
      </button>
      <button title="Align center V" data-action="align-v" id="align-v-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="4" x2="18" y2="4"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="8" y1="16" x2="16" y2="16"/></svg>
      </button>
      <button title="Align bottom" data-action="align-bot" id="align-bot-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="4" x2="18" y2="4"/><line x1="10" y1="8" x2="14" y2="8"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
      </button>
      <span class="toolbar-divider"></span>
      <button title="Distribute H" data-action="distribute-h" id="dist-h-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="7" y1="10" x2="17" y2="10"/><line x1="3" y1="14" x2="21" y2="14"/><line x1="7" y1="18" x2="17" y2="18"/></svg>
      </button>
      <button title="Distribute V" data-action="distribute-v" id="dist-v-{{ section.id }}" disabled>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="3" x2="6" y2="21"/><line x1="10" y1="7" x2="10" y2="17"/><line x1="14" y1="3" x2="14" y2="21"/><line x1="18" y1="7" x2="18" y2="17"/></svg>
      </button>
      <span class="toolbar-divider"></span>
      <button title="Add text" data-action="add-text" id="text-btn-{{ section.id }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
      </button>
      <button title="Zoom to fit" data-action="zoom-fit" id="zoom-fit-{{ section.id }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="11" y1="8" x2="11" y2="14"/></svg>
      </button>
      <button title="Export PDF" data-action="export-pdf" id="export-btn-{{ section.id }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      </button>
      <span class="toolbar-divider"></span>
      <button title="Lock" data-action="lock" id="lock-btn-{{ section.id }}" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      </button>
      <button title="Mobile" data-action="mobile" id="mobile-btn-{{ section.id }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
      </button>
      <span class="zoom-display" id="zoom-display-{{ section.id }}">100%</span>
    </div>

    <div class="cfg-info-bar">
      <span id="item-count-{{ section.id }}">0 items</span>
      <span id="sel-size-{{ section.id }}">&nbsp;</span>
      <span id="hint-text-{{ section.id }}">
        <span class="hint-desktop">Ctrl/Cmd + scroll to zoom &middot; Space + drag to pan</span>
        <span class="hint-mobile">Pinch to zoom &middot; Drag empty space to pan</span>
      </span>
    </div>

    <div class="size-inputs" id="size-inputs-{{ section.id }}">
      <label>W:</label>
      <input id="w-input-{{ section.id }}" type="number" min="10" max="600" step="1" class="cfg-inline-input">
      <label>H:</label>
      <input id="h-input-{{ section.id }}" type="number" min="10" max="600" step="1" class="cfg-inline-input">
      <span class="size-unit">mm</span>
    </div>

    <div class="canvas-wrap" id="canvas-wrap-{{ section.id }}">
      <div class="canvas-stage" id="canvas-stage-{{ section.id }}">
        <div class="canvas-area" id="canvas-{{ section.id }}">
          <canvas class="grid-bg" id="grid-canvas-{{ section.id }}"></canvas>
          <div class="canvas-hint" id="hint-{{ section.id }}">Add a design or press T to add text</div>
          <div class="sel-box" aria-hidden="true"></div>
          <div class="guide-line h" id="guide-h-{{ section.id }}"></div>
          <div class="guide-line v" id="guide-v-{{ section.id }}"></div>
        </div>
      </div>
    </div>

    <div class="sticky-ctrls">
      <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" id="file-input-{{ section.id }}" hidden>
      <div class="upload-btn-area">
        <button id="add-btn-{{ section.id }}" class="cfg-add-design">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          Add design
        </button>
        <div class="qty-group">
          <button id="qty-down-{{ section.id }}">&minus;</button>
          <span class="qty-val" id="qty-display-{{ section.id }}">10</span>
          <button id="qty-up-{{ section.id }}">+</button>
        </div>
        <span class="qty-label">pieces</span>
      </div>
      <button id="submit-{{ section.id }}" class="cfg-btn-submit">
        Add to Cart &mdash; <span id="price-display-{{ section.id }}">$0.00</span>
      </button>

      <details class="bottom-extra" open>
        <summary>
          <span>Workspace settings</span>
          <span class="bottom-extra-chevron" aria-hidden="true"></span>
        </summary>
        <div class="be-row">
          <span class="be-label">Snap</span>
          <input type="checkbox" id="snap-btm-{{ section.id }}" checked>
          <span class="be-unit">Grid</span>
          <input type="number" id="grid-size-{{ section.id }}" value="20" min="5" max="100" step="5" class="cfg-inline-sm">
          <span class="be-unit">px</span>
          <span class="be-label">Gap</span>
          <input type="number" id="gap-size-{{ section.id }}" value="3" min="3" max="50" step="1" class="cfg-inline-sm">
          <span class="be-unit">mm</span>
        </div>
        <div class="be-row">
          <span id="stats-{{ section.id }}" class="cfg-text-muted"></span>
          <input type="color" id="bg-color-{{ section.id }}" value="#FFFFFF">
          <button class="be-btn danger" id="clear-btn-{{ section.id }}">Clear</button>
        </div>
      </details>
    </div>

    <dialog id="modal-{{ section.id }}" class="cfg-modal" aria-labelledby="modal-title-{{ section.id }}">
      <div class="cfg-modal-box">
        <div class="cfg-modal-title-row">
          <div>
            <span class="cfg-modal-kicker">New artwork</span>
            <h3 class="cfg-modal-title" id="modal-title-{{ section.id }}">Add Design</h3>
          </div>
        </div>
        <div class="cfg-modal-zone" id="modal-zone-{{ section.id }}" role="button" tabindex="0" aria-label="Choose or drop a design file">
          <div class="cfg-modal-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5"/><path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"/></svg>
          </div>
          <div class="cfg-modal-text">Choose a file or drop it here</div>
          <div class="cfg-modal-note">PNG, JPG, SVG or WebP</div>
          <div class="cfg-modal-fname" id="modal-fname-{{ section.id }}"></div>
        </div>
        <div class="cfg-modal-fields">
          <div class="cfg-modal-row">
            <label for="modal-w-{{ section.id }}">Width</label>
            <input type="number" id="modal-w-{{ section.id }}" value="50" min="10" max="600" step="1">
            <span>mm</span>
          </div>
          <div class="cfg-modal-row">
            <label for="modal-h-{{ section.id }}">Height</label>
            <input type="number" id="modal-h-{{ section.id }}" value="50" min="10" max="600" step="1">
            <span>mm</span>
          </div>
          <div class="cfg-modal-row">
            <label for="modal-qty-{{ section.id }}">Copies</label>
            <input type="number" id="modal-qty-{{ section.id }}" value="3" min="1" max="50" step="1">
            <span>pcs</span>
          </div>
        </div>
        <div class="cfg-modal-actions">
          <button id="modal-cancel-{{ section.id }}" class="cfg-btn-sec">Cancel</button>
          <button id="modal-add-{{ section.id }}" class="cfg-btn-pry" disabled>Add to Canvas</button>
        </div>
      </div>
    </dialog>
  </div>
</sticker-configurator>

{% schema %}
{
  "name": "Sticker Configurator",
  "tag": "section",
  "class": "sticker-configurator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design Your Sticker Sheet"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F8F9FA"
    },
    {
      "type": "number",
      "id": "base_price",
      "label": "Base price per sheet ($)",
      "default": 2.5,
      "info": "Base price used for dynamic pricing calculation"
    },
    {
      "type": "range",
      "id": "grid_size",
      "label": "Grid size (px)",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "snap_enabled",
      "label": "Snap to grid enabled by default",
      "default": true
    },
    {
      "type": "range",
      "id": "gap_mm",
      "label": "Default gap between items (mm)",
      "min": 3,
      "max": 50,
      "step": 1,
      "unit": "mm",
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Feature Toggles"
    },
    {
      "type": "checkbox",
      "id": "enable_clipboard",
      "label": "Enable clipboard (Ctrl+C/V)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_export",
      "label": "Enable PDF export",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_auto_arrange",
      "label": "Enable auto-arrange",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_undo_redo",
      "label": "Enable undo/redo",
      "default": true,
      "info": "50-step stack"
    }
  ],
  "presets": [
    {
      "name": "Sticker Configurator",
      "category": "Custom",
      "settings": {
        "heading": "Design Your Sticker Sheet",
        "bg_color": "#F8F9FA",
        "base_price": 2.5,
        "grid_size": 20,
        "snap_enabled": true,
        "gap_mm": 3,
        "enable_clipboard": true,
        "enable_export": true,
        "enable_auto_arrange": true,
        "enable_undo_redo": true,
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  ],
  "locales": {
    "en": {
      "heading": "Design Your Sticker Sheet",
      "undo": "Undo",
      "redo": "Redo",
      "auto_arrange": "Auto arrange",
      "delete_selected": "Delete selected",
      "duplicate": "Duplicate",
      "flip_h": "Flip H",
      "flip_v": "Flip V",
      "align_left": "Align left",
      "align_center_h": "Align center H",
      "align_right": "Align right",
      "align_top": "Align top",
      "align_center_v": "Align center V",
      "align_bottom": "Align bottom",
      "distribute_h": "Distribute H",
      "distribute_v": "Distribute V",
      "add_text": "Add text",
      "zoom_to_fit": "Zoom to fit",
      "export_pdf": "Export PDF",
      "lock": "Lock",
      "mobile": "Mobile",
      "add_design": "Add design",
      "pieces": "pieces",
      "add_to_cart": "Add to Cart",
      "add_design_modal_title": "Add Design",
      "cancel": "Cancel",
      "add_to_canvas": "Add to Canvas",
      "clear_canvas_confirm": "Clear all designs?",
      "clear_all": "Clear",
      "items": "items",
      "selected": "selected",
      "items_count": "items",
      "mm": "mm",
      "w_label": "W",
      "h_label": "H",
      "copies_label": "Copies",
      "snap_grid": "Grid",
      "gap": "Gap",
      "canvas_hint": "Add a design or press T to add text",
      "hint_text": "Ctrl/Cmd + scroll to zoom | Space + drag to pan",
      "pdf_load_error": "Could not load PDF library. Check internet connection.",
      "edit_text_title": "Edit Text",
      "size_label": "SIZE",
      "color_label": "COLOR",
      "bg_label": "BG",
      "save": "Save",
      "design_selected": "File selected",
      "choose_design": "Click to choose a design file"
    }
  }
}
{% endschema %}
