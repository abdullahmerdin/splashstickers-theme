<div style="padding:40px 20px;text-align:center;background:#f5f5f5;">
  <h2>{{ section.settings.heading | default: 'Configure Your Sticker' }}</h2>
  <p style="color:#666;">{{ section.settings.subtext }}</p>
  <div id="test-config-{{ section.id }}">Loading configurator...</div>
</div>

{% schema %}
{
  "name": "Sticker Config",
  "tag": "section",
  "class": "sticker-configurator",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Configure Your Sticker"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Customize your perfect sticker"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F8F9FA"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Sticker Config",
      "category": "Custom"
    }
  ]
}
{% endschema %}
