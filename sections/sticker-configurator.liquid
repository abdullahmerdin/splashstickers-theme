    m.querySelector('.cfg-btn-sec').onclick=function(){m.remove();}
    m.onclick=function(e){if(e.target===m)m.remove();}
  }

  /* ── Modal ── */
  var modalFile=null;
  var modalEl = document.getElementById('modal-{{ section.id }}');
  var modalZone=document.getElementById('modal-zone-'+sid),modalFname=document.getElementById('modal-fname-'+sid);
  var modalW=document.getElementById('modal-w-'+sid),modalH=document.getElementById('modal-h-'+sid);
  var modalQty=document.getElementById('modal-qty-'+sid),modalAddBtn=document.getElementById('modal-add-'+sid),modalCancel=document.getElementById('modal-cancel-'+sid);

  document.getElementById('add-btn-'+sid).addEventListener('click',function(){modalFile=null;modalW.value=50;modalH.value=50;modalQty.value=3;modalAddBtn.disabled=true;modalFname.style.display='none';modalZone.querySelector('.cfg-modal-text').textContent='Click to choose a design file';modalZone.querySelector('.cfg-modal-icon').innerHTML='&#x1F5BC;';modalEl.style.display='flex';fileInput.value='';});
  modalZone.addEventListener('click',function(){fileInput.click();});
  modalCancel.addEventListener('click',function(){modalEl.style.display='none';});
  fileInput.addEventListener('change',function(){if(this.files.length){modalFile=this.files[0];modalFname.textContent=modalFile.name;modalFname.style.display='block';modalZone.querySelector('.cfg-modal-text').textContent='File selected';modalZone.querySelector('.cfg-modal-icon').innerHTML='&#x2705;';modalAddBtn.disabled=false;}});
  modalAddBtn.addEventListener('click',function(){if(!modalFile)return;var reader=new FileReader(),qty=parseInt(modalQty.value)||1,wMm=parseInt(modalW.value)||50,hMm=parseInt(modalH.value)||50;modalEl.style.display='none';reader.onload=function(e){for(var i=0;i<qty;i++){var item=addImageItem(e.target.result,false);item.w=wMm/600*(CANVAS_W);item.h=hMm/600*(CANVAS_W);item.el.style.width=item.w+'px';item.el.style.height=item.h+'px';}growCanvas();saveState();document.getElementById('auto-btn-'+sid).click();};reader.readAsDataURL(modalFile);});
  function handleFile(f){if(!f.type.match('image.*'))return;modalFile=f;modalFname.textContent=f.name;modalFname.style.display='block';modalZone.querySelector('.cfg-modal-text').textContent='File selected';modalZone.querySelector('.cfg-modal-icon').innerHTML='&#x2705;';modalAddBtn.disabled=false;if(modalEl)modalEl.style.display='flex';}

  canvas.addEventListener('drop',function(e){e.preventDefault();if(e.dataTransfer.files.length)handleFile(e.dataTransfer.files[0]);});
  canvas.addEventListener('dragover',function(e){e.preventDefault();});

  /* ── Quantity ── */
  document.getElementById('qty-down-'+sid).addEventListener('click',function(){var q=parseInt(qtyEl.textContent)||1;if(q>1)qtyEl.textContent=q-1;updatePrice();});
  document.getElementById('qty-up-'+sid).addEventListener('click',function(){qtyEl.textContent=(parseInt(qtyEl.textContent)||1)+1;updatePrice();});

  /* ── Size inputs ── */
  document.getElementById('w-input-'+sid).addEventListener('input',function(){var id=parseInt(selectedIds[0]),item=items.find(function(i){return i.id===id;});if(!item)return;item.w=Math.max(20,mmToPx(parseInt(this.value)||50));item.el.style.width=item.w+'px';updateSizeInfo(item);updatePrice();});
  document.getElementById('h-input-'+sid).addEventListener('input',function(){var id=parseInt(selectedIds[0]),item=items.find(function(i){return i.id===id;});if(!item)return;item.h=Math.max(20,mmToPx(parseInt(this.value)||50));item.el.style.height=item.h+'px';updateSizeInfo(item);updatePrice();});
  document.getElementById('w-input-'+sid).addEventListener('change',function(){saveState();growCanvas();});
  document.getElementById('h-input-'+sid).addEventListener('change',function(){saveState();growCanvas();});

  function updateCount(){var sel=selectedIds.length;countEl.textContent=items.length+' items'+(sel?' ('+sel+' selected)':'');}
  function updatePrice(){var qty=parseInt(qtyEl.textContent)||1;priceEl.textContent='$'+(basePrice*(items.length||1)*qty).toFixed(2);}

  /* ── Mobile toggle ── */
  var mobile=false;
  mobileBtn.addEventListener('click',function(){
    mobile=!mobile;
    document.querySelector('.sticker-config-'+sid).classList.toggle('mobile-mode',mobile);
    if(mobile){wrap.style.height='';}
    else{canvas.style.height=CANVAS_H+'px';wrap.style.height=CANVAS_H+'px';}
    mobileBtn.innerHTML=mobile?'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>':'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>';
    setTimeout(function(){zoomToFit();},100);
  });





  /* ── Bottom panel ── */

  // Background color
  document.getElementById('bg-color-'+sid).addEventListener('input',function(){
    document.querySelector('.sticker-config-'+sid+' .grid-bg').style.background=this.value;
    canvas.style.background=this.value;
  });

  // Clear all
  document.getElementById('clear-btn-'+sid).addEventListener('click',function(){
    if(items.length===0)return;
    showConfirmModal('Clear all designs?',function(){
      saveState();
      items.slice().forEach(function(it){it.el.remove();});
      items.length=0; selectedIds=[]; updateSelection(); updateCount(); updatePrice(); saveState();
      hint.style.display='';
    });
  });
  // Bottom panel buttons
  document.getElementById('snap-btm-'+sid).addEventListener('change',function(){
    document.getElementById('snap-btm-'+sid).checked = this.checked;
  });

  document.getElementById('grid-size-'+sid).addEventListener('change',function(){ drawGrid(); });
  document.getElementById('gap-size-'+sid).addEventListener('change',function(){});

  function updateStats(){
    var el=document.getElementById('stats-'+sid);
    if(!el)return;
    var area=0; items.forEach(function(it){area+=it.w*it.h;});
    var areaCm=Math.round(area/CANVAS_W*600/CANVAS_W*600/100);
    el.textContent=items.length+' items · '+areaCm+' cm²';
  }
  // Patch updateCount/updatePrice to also call updateStats
  var origUC=updateCount; updateCount=function(){origUC();updateStats();};


  /* ── Touch events (mobile) ── */
  var touchStarted=null;
  canvas.addEventListener('touchstart',function(te){
    if(te.touches.length!==1) return;
    var t=te.touches[0]; updateCanvasWH();
    var itemEl=te.target.closest('.canvas-item');
    if(itemEl){
      var cid=parseInt(itemEl.dataset.itemId);
      if(te.target.classList.contains('resize-handle')){if(selectedIds.indexOf(cid)===-1){selectedIds=[cid];updateSelection();}startResize({clientX:t.clientX,clientY:t.clientY},cid,te.target.dataset.handle);return;}
      if(te.target.classList.contains('rot-handle')){if(selectedIds.indexOf(cid)===-1){selectedIds=[cid];updateSelection();}startRotate({clientX:t.clientX,clientY:t.clientY},cid);return;}
      if(selectedIds.indexOf(cid)===-1){selectedIds=[cid];updateSelection();touchStarted={ox:t.clientX,oy:t.clientY,type:'pan',sel:true};return;}
      startDrag({clientX:t.clientX,clientY:t.clientY},cid);return;
    }
    selectedIds=[];updateSelection();touchStarted={ox:t.clientX,oy:t.clientY,type:'pan'};
  },{passive:false});
  canvas.addEventListener('touchmove',function(te){
    if(te.touches.length===2){/* pinch handled elsewhere */return;}
    if(!dragState&&touchStarted&&te.touches.length===1){
      var t=te.touches[0];
      if(touchStarted.sel) return;
      var dx=t.clientX-touchStarted.ox,dy=t.clientY-touchStarted.oy;
      // Only pan if horizontal movement is significant AND the container can't scroll
      if(Math.abs(dx)<20) return; // let browser handle vertical/light movement
      if(Math.abs(dx)<Math.abs(dy)*1.5) return; // mostly vertical → let browser scroll
      te.preventDefault();
      panX+=dx;panY+=dy;touchStarted.ox=t.clientX;touchStarted.oy=t.clientY;touchStarted.oy=t.clientY;applyZoom();return;
    }
    if(!dragState||te.touches.length!==1) return;
    te.preventDefault();
    var t=te.touches[0];
    if(dragState.type==='move'){
      // Movement threshold to reduce jitter
      var mx=t.clientX-(dragState._lastX||dragState.ox), my=t.clientY-(dragState._lastY||dragState.oy);
      if(Math.abs(mx)<2&&Math.abs(my)<2){dragState._lastX=t.clientX;dragState._lastY=t.clientY;return;}
      dragState._lastX=t.clientX;dragState._lastY=t.clientY;
      var dx=(t.clientX-dragState.ox)/zoom, dy=(t.clientY-dragState.oy)/zoom;
      dragState.ids.forEach(function(id){
        var item=items.find(function(i){return i.id==id;});if(!item)return;
        var sp=dragState.startPos[id];if(!sp)return;
        item.x=Math.max(0,Math.min(CANVAS_W-item.w,sp.x+dx));item.y=Math.max(0,sp.y+dy);
      });
      for(var p=0;p<5;p++){var ov=false;for(var ai=0;ai<items.length;ai++){for(var bi=ai+1;bi<items.length;bi++){var a=items[ai],b=items[bi];if(rectsOverlap(a,b)){ov=true;var dx2=(a.x+a.w/2)-(b.x+b.w/2),dy2=(a.y+a.h/2)-(b.y+b.h/2);if(Math.abs(dx2)>Math.abs(dy2)){var push=dx2>0?4:-4;a.x+=push;b.x-=push;}else{var push=dy2>0?4:-4;a.y+=push;b.y-=push;}}}}if(!ov)break;}
      dragState.ids.forEach(function(id){
        var item=items.find(function(i){return i.id==id;});if(!item)return;
        item.x=Math.max(0,Math.min(CANVAS_W-item.w,item.x));item.y=Math.max(0,item.y);
        item.el.style.left=item.x+'px';item.el.style.top=item.y+'px';
        var valid=items.every(function(o){return o.id==id||!rectsOverlap(item,o);});
        item.el.style.opacity=valid?'':'0.4';item.el.style.outline=valid?'':'2px solid #FF4444';
      });
    } else if(dragState.type==='resize'){
      var item=items.find(function(i){return i.id===dragState.id;});if(!item)return;
      var dx=(t.clientX-dragState.ox)/zoom,dy=(t.clientY-dragState.oy)/zoom;
      if(dragState.handle.includes('e')) item.w=Math.max(30,dragState.sw+dx);
      if(dragState.handle.includes('w')){var nw=Math.max(30,dragState.sw-dx);item.x=dragState.sx+dragState.sw-nw;item.w=nw;}
      if(dragState.handle.includes('s')) item.h=Math.max(30,dragState.sh+dy);
      if(dragState.handle.includes('n')){var nh=Math.max(30,dragState.sh-dy);item.y=dragState.sy+dragState.sh-nh;item.h=nh;}
      item.x=Math.max(0,Math.min(CANVAS_W-item.w,item.x));item.y=Math.max(0,item.y);
      item.el.style.left=item.x+'px';item.el.style.top=item.y+'px';item.el.style.width=item.w+'px';item.el.style.height=item.h+'px';
      updateSizeInfo(item);
    }
  },{passive:false});
  canvas.addEventListener('touchend',function(te){
    if(dragState&&dragState.type==='move'){
      guideH.style.display='none';guideV.style.display='none';
      dragState.ids.forEach(function(id){
        var dragged=items.find(function(i){return i.id===id;});if(!dragged)return;
        var valid=items.every(function(o){return o.id===id||!rectsOverlap(dragged,o);});
        if(!valid){var sp=dragState.startPos[id];if(sp){dragged.x=sp.x;dragged.y=sp.y;dragged.el.style.left=sp.x+'px';dragged.el.style.top=sp.y+'px';}}
        dragged.el.style.opacity='';dragged.el.style.outline='';
      });
      saveState();growCanvas();
    } else if(dragState&&(dragState.type==='resize'||dragState.type==='rotate')){saveState();growCanvas();}
    dragState=null;touchStarted=null;
  },{passive:true});

  /* ── Clipboard ── */
  var clipboard = null;
  document.addEventListener('keydown',function(e){
    if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
    if((e.ctrlKey||e.metaKey)&&e.key==='c'&&selectedIds.length){
      e.preventDefault();
      var sel=getSelected();
      clipboard=sel.map(function(it){return {src:it.el.querySelector('img')?it.el.querySelector('img').src:null,isText:!!it.text,text:it.text||'',fontSize:it.fontSize||16,color:it.color||'#2D3436',bgColor:it.bgColor||'',fontWeight:it.fontWeight||'',fontStyle:it.fontStyle||'',textAlign:it.textAlign||'center',w:it.w,h:it.h};});
    }
    if((e.ctrlKey||e.metaKey)&&e.key==='v'&&clipboard){
      e.preventDefault(); saveState(); var autoBtn=document.getElementById('auto-btn-'+sid);
      clipboard.forEach(function(cd){
        if(cd.isText){
          var item=addTextItem(cd.text,cd.fontSize,true,cd.color,cd.bgColor,cd.fontWeight,cd.fontStyle,cd.textAlign);
          if(item){item.x+=20;item.y+=20;item.el.style.left=item.x+'px';item.el.style.top=item.y+'px';}
        } else if(cd.src){
          var img=new Image();
          img.onload=function(){
            var item=addImageItem(cd.src,true);
            item.w=cd.w;item.h=cd.h;
            item.el.style.width=cd.w+'px';item.el.style.height=cd.h+'px';
            if(item.el.querySelector('img')){item.el.querySelector('img').style.width=cd.w+'px';item.el.querySelector('img').style.height=cd.h+'px';}
            item.el.style.left=item.x+'px';item.el.style.top=item.y+'px';
            saveState();growCanvas();
            if(autoBtn) autoBtn.click();
          };
          img.src=cd.src;
          return;
        }
      });
      saveState();growCanvas();
      if(autoBtn) autoBtn.click();
    }
  });

  /* ── Lock / Unlock ── */
  var lockBtn=document.getElementById('lock-btn-'+sid);
  lockBtn.addEventListener('click',function(){
    var sel=getSelected();
    if(!sel.length) return;
    var allLocked=sel.every(function(it){return it.locked;});
    sel.forEach(function(it){it.locked=!allLocked;it.el.style.opacity=it.locked?'0.6':'1';it.el.style.cursor=it.locked?'default':'grab';});
    updateSelection();
  });
  // Update lock button state on selection
  var origUpdateSel=updateSelection;
  updateSelection=function(){
    origUpdateSel();
    var sel=getSelected();
    lockBtn.disabled=sel.length===0;
    if(sel.length===1){lockBtn.classList.toggle('active',!!sel[0].locked);}
  };

  /* ── Alignment tools ── */
  function alignItems(dir){
    var sel=getSelected(); if(sel.length<1) return;
    saveState();
    if(dir==='left'){var mx=Math.min.apply(null,sel.map(function(it){return it.x;}));sel.forEach(function(it){it.x=mx;});}
    else if(dir==='right'){var mx=Math.max.apply(null,sel.map(function(it){return it.x+it.w;}));sel.forEach(function(it){it.x=mx-it.w;});}
    else if(dir==='h'){var cx=0;sel.forEach(function(it){cx+=it.x+it.w/2;});cx/=sel.length;sel.forEach(function(it){it.x=cx-it.w/2;});}
    else if(dir==='top'){var my=Math.min.apply(null,sel.map(function(it){return it.y;}));sel.forEach(function(it){it.y=my;});}
    else if(dir==='bot'){var my=Math.max.apply(null,sel.map(function(it){return it.y+it.h;}));sel.forEach(function(it){it.y=my-it.h;});}
    else if(dir==='v'){var cy=0;sel.forEach(function(it){cy+=it.y+it.h/2;});cy/=sel.length;sel.forEach(function(it){it.y=cy-it.h/2;});}
    else if(dir==='dist-h'&&sel.length>2){
      var sorted=sel.slice().sort(function(a,b){return a.x-b.x;});
      var first=sorted[0],last=sorted[sorted.length-1];
      var totalW=0;sorted.forEach(function(it,i){if(i>0&&i<sorted.length-1)totalW+=it.w;});
      var gap=(last.x+last.w-first.x-totalW)/(sorted.length-1);
      var cx=first.x+first.w+gap;
      for(var i=1;i<sorted.length-1;i++){sorted[i].x=cx;cx+=sorted[i].w+gap;}
    }
    else if(dir==='dist-v'&&sel.length>2){
      var sorted=sel.slice().sort(function(a,b){return a.y-b.y;});
      var first=sorted[0],last=sorted[sorted.length-1];
      var totalH=0;sorted.forEach(function(it,i){if(i>0&&i<sorted.length-1)totalH+=it.h;});
      var gap=(last.y+last.h-first.y-totalH)/(sorted.length-1);
      var cy=first.y+first.h+gap;
      for(var i=1;i<sorted.length-1;i++){sorted[i].y=cy;cy+=sorted[i].h+gap;}
    }
    sel.forEach(function(it){it.el.style.left=it.x+'px';it.el.style.top=it.y+'px';});
    saveState();growCanvas();
  }
  ['left','right','h','top','bot','v'].forEach(function(d){
    var btn=document.getElementById('align-'+d+'-'+sid);
    if(btn) btn.addEventListener('click',function(){alignItems(d);});
  });

  // Prevent drag/select for locked items
  var origStartDrag=startDrag;
  startDrag=function(e,id){
    var item=items.find(function(i){return i.id===id;});
    if(item&&item.locked) return;
    origStartDrag(e,id);
  };
  var origStartResize=startResize;
  startResize=function(e,id,h){
    var item=items.find(function(i){return i.id===id;});
    if(item&&item.locked) return;
    origStartResize(e,id,h);
  };
  /* ── Init ── */
  saveState(); zoomToFit(); drawGrid(); updatePrice(); updateSelection();
  canvas.style.cursor = textToolActive ? 'crosshair' : 'default';
  // Auto-detect mobile: activate mobile mode for touch+small screens
  if(window.innerWidth<768||('ontouchstart' in window&&window.innerWidth<1024)){
    var isMobile=mobileBtn.getAttribute('data-auto')!=='false';
    if(isMobile) mobileBtn.click();
  }
  setInterval(function(){canvas.style.cursor=textToolActive?'crosshair':(selectedIds.length?'default':'default');},200);
})();
</script>

