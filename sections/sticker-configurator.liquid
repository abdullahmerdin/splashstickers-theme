    ['nw','ne','sw','se'].forEach(function(p){var h=document.createElement('div');h.className='resize-handle '+p;h.dataset.handle=p;el.appendChild(h);});
    var rot=document.createElement('div'); rot.className='rot-handle'; el.appendChild(rot);
    canvas.appendChild(el);
