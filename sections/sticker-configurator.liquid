{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.bg_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
.product-information__media { display: none !important; }
.product-information {
  display: grid !important;
  grid-template-columns: 1fr min(50vw, var(--sidebar-width, 400px)) !important;
  gap: var(--gap, 40px) !important;
  align-items: start !important;
}
.product-information product-component { grid-column: 2 !important; width: 100% !important; }

.sticker-config-{{ section.id }} {
  grid-column: 1 !important; grid-row: 1 !important;
  background: {{ bg_color }};
  border-radius: 20px; padding: 24px; position: sticky; top: 100px;
  overflow: hidden;
}
.sticker-config-{{ section.id }} .editor-wrap {
  display: flex; flex-direction: column; gap: 12px;
}
.sticker-config-{{ section.id }} .toolbar {
  display: flex; gap: 2px; flex-wrap: wrap; align-items: center;
  background: #f8f9fa; border-radius: 12px; padding: 4px;
}
.sticker-config-{{ section.id }} .toolbar button {
  width: 34px; height: 34px; border-radius: 8px; border: none;
  background: transparent; cursor: pointer; display: flex;
  align-items: center; justify-content: center; transition: all 0.12s;
  color: #636E72;
}
.sticker-config-{{ section.id }} .toolbar button svg { display: block; }
.sticker-config-{{ section.id }} .toolbar button:hover { background: #fff; color: #00CEC9; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.sticker-config-{{ section.id }} .toolbar button:disabled { opacity: 0.25; cursor: default; box-shadow: none; background: transparent; }
.sticker-config-{{ section.id }} .toolbar button.active { background: #00CEC910; color: #00CEC9; }
.sticker-config-{{ section.id }} .toolbar .toolbar-divider {
  width: 1px; height: 20px; background: #DFE6E9; margin: 0 4px;
}
.sticker-config-{{ section.id }} .canvas-wrap {
  position: relative; width: 100%; overflow: hidden; border-radius: 12px;
  border: 2px solid #DFE6E9; background: #fff; aspect-ratio: 3 / 2;
}
.sticker-config-{{ section.id }} .canvas-area {
  position: absolute; inset: 0; cursor: default; user-select: none;
  transform-origin: 0 0; overflow: hidden;
}
.sticker-config-{{ section.id }} .canvas-area .grid-bg {
  position: absolute; inset: 0; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item {
  position: absolute; cursor: grab; user-select: none;
  transition: box-shadow 0.15s;
}
.sticker-config-{{ section.id }} .canvas-item:hover { box-shadow: 0 0 0 2px #00CEC944; }
.sticker-config-{{ section.id }} .canvas-item.selected {
  outline: 2px solid #00CEC9; z-index: 100 !important;
}
.sticker-config-{{ section.id }} .canvas-item img, .canvas-item .text-content {
  width: 100%; height: 100%; object-fit: contain; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item .text-content {
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; color: #2D3436; word-break: break-word;
  text-align: center; padding: 4px;
}
.sticker-config-{{ section.id }} .canvas-item .resize-handle {
  position: absolute; width: 12px; height: 12px; border-radius: 2px;
  background: #00CEC9; border: 2px solid #fff; display: none; z-index: 10;
}
.sticker-config-{{ section.id }} .canvas-item.selected .resize-handle { display: block; }
.sticker-config-{{ section.id }} .resize-handle.nw { top: -6px; left: -6px; cursor: nw-resize; }
.sticker-config-{{ section.id }} .resize-handle.ne { top: -6px; right: -6px; cursor: ne-resize; }
.sticker-config-{{ section.id }} .resize-handle.sw { bottom: -6px; left: -6px; cursor: sw-resize; }
.sticker-config-{{ section.id }} .resize-handle.se { bottom: -6px; right: -6px; cursor: se-resize; }
.sticker-config-{{ section.id }} .rot-handle {
  position: absolute; bottom: -24px; left: 50%; margin-left: -8px;
  width: 16px; height: 16px; border-radius: 50%; background: #6C5CE7;
  border: 2px solid #fff; cursor: grab; display: none; z-index: 10;
}
.sticker-config-{{ section.id }} .canvas-item.selected .rot-handle { display: block; }
.sticker-config-{{ section.id }} .size-info {
  position: absolute; bottom: -28px; left: 50%; transform: translateX(-50%);
  background: #2D3436; color: #fff; font-size: 0.7rem; padding: 2px 8px;
  border-radius: 6px; white-space: nowrap; display: none; z-index: 20; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item.selected .size-info { display: block; }
.sticker-config-{{ section.id }} .size-inputs {
  display: flex; gap: 8px; align-items: center; height: 24px;
}
.sticker-config-{{ section.id }} .size-inputs input {
  width: 52px; padding: 4px 6px; border: 2px solid #DFE6E9; border-radius: 8px;
  font-size: 0.8rem; text-align: center; color: #2D3436; font-weight: 600;
  outline: none;
}
.sticker-config-{{ section.id }} .size-inputs input:focus { border-color: #00CEC9; }
.sticker-config-{{ section.id }} .size-inputs label { font-size: 0.7rem; color: #B2BEC3; }
.sticker-config-{{ section.id }} .sel-box {
  position: absolute; border: 1px solid #00CEC9; background: rgba(0,206,201,0.08);
  pointer-events: none; z-index: 999; display: none;
}
.sticker-config-{{ section.id }} .qty-group {
  display: flex; align-items: center; gap: 6px;
  background: #fff; border: 2px solid #DFE6E9; border-radius: 12px; padding: 2px;
}
.sticker-config-{{ section.id }} .qty-group button {
  width: 36px; height: 36px; border: none; border-radius: 10px;
  background: transparent; cursor: pointer; font-size: 1.2rem;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s; color: #636E72; font-weight: 600;
}
.sticker-config-{{ section.id }} .qty-group button:hover { background: #00CEC910; color: #00CEC9; }
.sticker-config-{{ section.id }} .qty-group .qty-val {
  font-size: 1.1rem; font-weight: 700; min-width: 36px;
  text-align: center; color: #2D3436;
}
.sticker-config-{{ section.id }} .canvas-hint {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  color: #DFE6E9; font-size: 0.9rem; text-align: center;
  pointer-events: none; font-weight: 500;
}
.sticker-config-{{ section.id }} .guide-line {
  position: absolute; pointer-events: none; z-index: 1000; display: none;
  background: #00CEC9;
}
.sticker-config-{{ section.id }} .guide-line.h { height: 1px; left: 0; right: 0; }
.sticker-config-{{ section.id }} .guide-line.v { width: 1px; top: 0; bottom: 0; }
.sticker-config-{{ section.id }} .layer-panel {
  position: absolute; right: -260px; top: 0; bottom: 0; width: 240px;
  background: #fff; border-left: 1px solid #DFE6E9; z-index: 200;
  transition: right 0.3s ease; padding: 12px; overflow-y: auto;
  box-shadow: -4px 0 20px rgba(0,0,0,0.06);
}
.sticker-config-{{ section.id }} .layer-panel.open { right: 0; }
.sticker-config-{{ section.id }} .layer-item {
  display: flex; align-items: center; gap: 6px; padding: 6px 8px;
  border-radius: 8px; cursor: pointer; font-size: 0.8rem; color: #636E72;
}
.sticker-config-{{ section.id }} .layer-item:hover { background: #f8f9fa; }
.sticker-config-{{ section.id }} .layer-item.active { background: #00CEC910; color: #00CEC9; }
.sticker-config-{{ section.id }} .layer-item .thumb {
  width: 24px; height: 24px; border-radius: 4px; overflow: hidden; flex-shrink: 0;
  background: #f0f0f0; display: flex; align-items: center; justify-content: center;
  font-size: 12px;
}
.sticker-config-{{ section.id }} .layer-item .thumb img { width: 100%; height: 100%; object-fit: contain; }
.sticker-config-{{ section.id }} .layer-item .lname { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sticker-config-{{ section.id }} .zoom-display {
  font-size: 0.7rem; color: #B2BEC3; margin-left: auto; white-space: nowrap;
}

@media (max-width: 768px) {
  .sticker-config-{{ section.id }} { position: static; padding: 16px; }
}
.sticker-config-{{ section.id }}.mobile-mode {
  position: fixed !important; inset: 0 !important; z-index: 99998 !important;
  border-radius: 0 !important; padding: 8px !important; top: 0 !important;
  display: flex !important; flex-direction: column !important; overflow: hidden;
}
.sticker-config-{{ section.id }}.mobile-mode .editor-wrap {
  flex: 1; display: flex; flex-direction: column; overflow: hidden;
}
.sticker-config-{{ section.id }}.mobile-mode .canvas-wrap {
  flex: 1; min-height: 0; border-radius: 8px; overflow: hidden;
}
.sticker-config-{{ section.id }}.mobile-mode .toolbar {
  padding: 4px; gap: 2px; overflow-x: auto; flex-wrap: wrap;
  justify-content: center; max-height: 120px;
}
.sticker-config-{{ section.id }}.mobile-mode .toolbar button {
  width: 38px; height: 38px; font-size: 16px; flex-shrink: 0;
}
.sticker-config-{{ section.id }}.mobile-mode .toolbar .toolbar-divider { display: none; }
.sticker-config-{{ section.id }}.mobile-mode .zoom-display { display: none; }
.sticker-config-{{ section.id }} .upload-btn-area {
  display: flex; gap: 8px; align-items: center;
}
.sticker-config-{{ section.id }} .upload-btn-area button {
  padding: 8px 20px; border: 2px dashed #DFE6E9; border-radius: 10px;
  background: transparent; cursor: pointer; font-size: 0.85rem; color: #636E72;
  transition: all 0.2s; flex: 1;
}
.sticker-config-{{ section.id }} .upload-btn-area button:hover {
  border-color: #00CEC9; color: #00CEC9; background: #f0fdfd;
}
{% endstyle %}

<div class="sticker-config-{{ section.id }}">
  <div class="editor-wrap">
    <div class="toolbar">
      <button title="Undo" id="undo-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg></button>
      <button title="Redo" id="redo-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Auto arrange" id="auto-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></button>
      <button title="Delete selected" id="del-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
      <button title="Duplicate" id="dup-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Flip H" id="flip-h-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><polyline points="7 8 3 12 7 16"/><polyline points="17 8 21 12 17 16"/></svg></button>
      <button title="Flip V" id="flip-v-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18"/><polyline points="8 7 12 3 16 7"/><polyline points="8 17 12 21 16 17"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Add text" id="text-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg></button>
      <button title="Zoom to fit" id="zoom-fit-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="11" y1="8" x2="11" y2="14"/></svg></button>
      <button title="Layers" id="layer-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg></button>
      <button title="Export PNG" id="export-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Mobile" id="mobile-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg></button>
      <button title="Reset zoom (100%)" id="zoom-reset-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg></button>
      <span class="zoom-display" id="zoom-display-{{ section.id }}">100%</span>
    </div>
    <div style="display:flex;align-items:center;gap:6px;font-size:0.75rem;color:#B2BEC3;">
      <input type="checkbox" id="snap-toggle-{{ section.id }}" style="accent-color:#00CEC9;cursor:pointer;">
      <label for="snap-toggle-{{ section.id }}" style="cursor:pointer;">Snap to grid</label>
    </div>
    <div style="font-size:0.75rem;color:#B2BEC3;display:flex;justify-content:space-between;">
      <span id="item-count-{{ section.id }}">0 items</span>
      <span id="sel-size-{{ section.id }}" style="display:none;">&nbsp;</span>
      <span id="hint-text-{{ section.id }}">Middle-click drag to pan | Scroll to zoom | T to add text</span>
    </div>
    <div class="size-inputs" id="size-inputs-{{ section.id }}" style="visibility:hidden;height:24px;">
      <label>W:</label><input id="w-input-{{ section.id }}" type="number" min="10" max="600" step="1">
      <label>H:</label><input id="h-input-{{ section.id }}" type="number" min="10" max="600" step="1">
      <label style="color:#B2BEC3;">mm</label>
    </div>
    <div class="canvas-wrap" id="canvas-wrap-{{ section.id }}">

      <div class="canvas-area" id="canvas-{{ section.id }}">
        <canvas class="grid-bg" id="grid-canvas-{{ section.id }}"></canvas>
        <div class="canvas-hint" id="hint-{{ section.id }}">Add a design or press T to add text</div>
      </div>
      <div class="guide-line h" id="guide-h-{{ section.id }}"></div>
      <div class="guide-line v" id="guide-v-{{ section.id }}"></div>
      <div class="layer-panel" id="layer-panel-{{ section.id }}"><div style="font-weight:600;font-size:0.85rem;margin-bottom:8px;">Layers</div></div>
    </div>
    <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" id="file-input-{{ section.id }}" style="display:none;">
    <div class="upload-btn-area">
      <button id="add-btn-{{ section.id }}">&#x2795; Add design</button>
      <div class="qty-group">
        <button id="qty-down-{{ section.id }}">&minus;</button>
        <span class="qty-val" id="qty-display-{{ section.id }}">10</span>
        <button id="qty-up-{{ section.id }}">+</button>
      </div>
      <span style="font-size:0.8rem;color:#636E72;">pieces</span>
    </div>
    <button id="submit-{{ section.id }}" style="width:100%;padding:12px;border:none;border-radius:12px;background:linear-gradient(135deg,#00CEC9,#00A8A3);color:#fff;font-size:1rem;font-weight:700;cursor:pointer;margin-top:4px;">
      Add to Cart &mdash; <span id="price-display-{{ section.id }}">$0.00</span>
    </button>
  </div>
</div>

<script>
(function() {
  var sid = '{{ section.id }}';
  var wrap = document.getElementById('canvas-wrap-'+sid);
  var canvas = document.getElementById('canvas-'+sid);
  var hint = document.getElementById('hint-'+sid);
  var fileInput = document.getElementById('file-input-'+sid);
  var countEl = document.getElementById('item-count-'+sid);
  var qtyEl = document.getElementById('qty-display-'+sid);
  var priceEl = document.getElementById('price-display-'+sid);

  var items = [];
  var selectedIds = [];
  var nextId = 1;
  var dragState = null;
  var basePrice = 2.5;
  var zoom = 1, panX = 0, panY = 0;
  var textToolActive = false;
  var layerOpen = false;

  var undoBtn = document.getElementById('undo-btn-'+sid);
  var redoBtn = document.getElementById('redo-btn-'+sid);
  var delBtn = document.getElementById('del-btn-'+sid);
  var dupBtn = document.getElementById('dup-btn-'+sid);
  var flipHBtn = document.getElementById('flip-h-'+sid);
  var flipVBtn = document.getElementById('flip-v-'+sid);
  var autoBtn = document.getElementById('auto-btn-'+sid);
  var mobileBtn = document.getElementById('mobile-btn-'+sid);
  var textBtn = document.getElementById('text-btn-'+sid);
  var zoomFitBtn = document.getElementById('zoom-fit-'+sid);
  var layerBtn = document.getElementById('layer-btn-'+sid);
  var exportBtn = document.getElementById('export-btn-'+sid);
  var zoomDisplay = document.getElementById('zoom-display-'+sid);
  // rulers removed
  var guideH = document.getElementById('guide-h-'+sid);
  var guideV = document.getElementById('guide-v-'+sid);
  var layerPanel = document.getElementById('layer-panel-'+sid);

  var selBox = document.createElement('div');
  selBox.className = 'sel-box';
  canvas.appendChild(selBox);

  /* ── History ── */
  var history = [], historyIdx = -1;
  function saveState() {
    historyIdx++; history.length = historyIdx;
    history.push(items.map(function(i) {
      var img = i.el.querySelector('img');
      return { id: i.id, src: img ? img.src : i.text||'', isText: !!i.text, text: i.text||'', fontSize: i.fontSize||16,
        x: i.x, y: i.y, w: i.w, h: i.h, rotation: i.rotation, scaleX: i.scaleX, scaleY: i.scaleY };
    }));
    if (history.length > 50) { history.shift(); historyIdx--; }
    updateHistoryBtns();
  }
  function restoreState(state) {
    var savedIds = state.map(function(s) { return s.id; });
    for (var ri = items.length-1; ri>=0; ri--) {
      if (savedIds.indexOf(items[ri].id)===-1) { items[ri].el.remove(); items.splice(ri,1); }
    }
    state.forEach(function(s) {
      var item = items.find(function(i) { return i.id===s.id; });
      if (!item) {
        if (s.isText) item = addTextItem(s.text, s.fontSize||16, true);
        else if (s.src) item = addImageItem(s.src, true);
        if (!item) return;
        item.id = s.id; item.el.dataset.itemId = s.id;
        item.rotation=s.rotation; item.scaleX=s.scaleX; item.scaleY=s.scaleY;
      }
      item.x=s.x; item.y=s.y; item.w=s.w; item.h=s.h;
      item.rotation=s.rotation; item.scaleX=s.scaleX; item.scaleY=s.scaleY;
      item.el.style.left=s.x+'px'; item.el.style.top=s.y+'px';
      item.el.style.width=s.w+'px'; item.el.style.height=s.h+'px';
      applyTransform(item); updateSizeInfo(item);
    });
    hint.style.display = items.length ? 'none' : '';
  }

  /* ── Selection ── */
  function toggleSelect(id, add) {
    if (add) { var idx=selectedIds.indexOf(id); idx!==-1?selectedIds.splice(idx,1):selectedIds.push(id); }
    else selectedIds=[id];
    updateSelection();
  }
  function selectAllInRect(x1,y1,x2,y2) {
    var l=Math.min(x1,x2),r=Math.max(x1,x2),t=Math.min(y1,y2),b=Math.max(y1,y2);
    selectedIds=[];
    items.forEach(function(it){var cx=it.x+it.w/2,cy=it.y+it.h/2; if(cx>=l&&cx<=r&&cy>=t&&cy<=b) selectedIds.push(it.id);});
    updateSelection();
  }
  function updateSelection() {
    var count=selectedIds.length;
    var mm3=Math.round(CANVAS_W/600*3);
    canvas.querySelectorAll('.canvas-item').forEach(function(el){
      el.classList.toggle('selected',selectedIds.indexOf(parseInt(el.dataset.itemId))!==-1);
      el.style.outlineOffset=el.classList.contains('selected')?mm3+'px':'';
    });
    delBtn.disabled=dupBtn.disabled=flipHBtn.disabled=flipVBtn.disabled=count===0;
    updateSizeInputs(); updateLayerPanel(); updateCount();
  }
  function getSelected(){return items.filter(function(i){return selectedIds.indexOf(i.id)!==-1;});}

  /* ── Unit conversion ── */
  function pxToMm(px){return Math.round(px/CANVAS_W*600);}
  function mmToPx(mm){return mm/600*CANVAS_W;}
  function snapVal(v,g){return g>0?Math.round(v/g)*g:v;}

  /* ── Add items ── */
  function addImageItem(src, silent) {
    var id=nextId++;
    var w=80+Math.random()*30, h=w*0.75;
    var el=document.createElement('div');
    el.className='canvas-item'; el.dataset.itemId=id;
    el.style.left=(20+Math.random()*(CANVAS_W-w-40))+'px';
    el.style.top=(20+Math.random()*(CANVAS_H-h-40))+'px';
    el.style.width=w+'px'; el.style.height=h+'px';
    var img=document.createElement('img'); img.src=src; img.draggable=false;
    el.appendChild(img);
    addItemHelpers(el, id);
    var item = finishItem(el, id, w, h);
