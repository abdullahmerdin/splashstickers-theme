{%- liquid
  assign bg_color = section.settings.bg_color
-%}

{% style %}
:root {
  --cfg-primary: #00CEC9;
  --cfg-accent: #6C5CE7;
  --cfg-pink: #FD79A8;
  --cfg-gold: #FDCB6E;
  --cfg-text: #2D3436;
  --cfg-muted: #636E72;
  --cfg-border: #DFE6E9;
  --cfg-bg: #F8F9FA;
}
.product-information__media { display: none !important; }
.product-information {
  display: grid !important;
  grid-template-columns: 1fr min(50vw, var(--sidebar-width, 400px)) !important;
  gap: var(--gap, 40px) !important;
  align-items: start !important;
}
.product-information product-component { grid-column: 2 !important; width: 100% !important; }

.sticker-config-{{ section.id }} {
  grid-column: 1; grid-row: 1;
  background: {{ bg_color }};
  border-radius: 0; padding: 0 24px 0 24px;
  display: flex; flex-direction: column;
  position: sticky; top: 100px;
}
.sticker-config-{{ section.id }} .editor-wrap {
  display: flex; flex-direction: column; gap: 12px;
  background: #f8f9fa;
}
.sticker-config-{{ section.id }} .toolbar {
  display: flex; gap: 2px; flex-wrap: wrap; align-items: center;
  background: #f8f9fa; border-radius: 0; padding: 4px;
}
.sticker-config-{{ section.id }} .toolbar button {
  width: 34px; height: 34px; border-radius: 8px; border: none;
  background: transparent; cursor: pointer; display: flex;
  align-items: center; justify-content: center; transition: all 0.12s;
  color: #636E72;
}
.sticker-config-{{ section.id }} .toolbar button svg { display: block; }
.sticker-config-{{ section.id }} .toolbar button:hover { background: #fff; color: var(--cfg-primary); box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.sticker-config-{{ section.id }} .toolbar button:disabled { opacity: 0.25; cursor: default; box-shadow: none; background: transparent; }
.sticker-config-{{ section.id }} .toolbar button.active { background: #00CEC910; color: #00CEC9; }
.sticker-config-{{ section.id }} .toolbar .toolbar-divider {
  width: 1px; height: 20px; background: #DFE6E9; margin: 0 4px;
}
.sticker-config-{{ section.id }} .canvas-wrap {
  position: relative; width: 100%; overflow: auto; border-radius: 12px;
  border: 2px solid #DFE6E9; background: #fff; flex-shrink: 0; min-height: 400px;
  touch-action: manipulation;
}
.sticker-config-{{ section.id }} .canvas-area {
  position: relative; width: 100%; height: 100%; cursor: default; user-select: none; touch-action: manipulation;
  transform-origin: 0 0; overflow: visible; z-index: 0;
}
.sticker-config-{{ section.id }} .canvas-area .grid-bg {
  position: absolute; inset: 0; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item {
  position: absolute; cursor: grab; user-select: none;
  transition: box-shadow 0.15s; z-index: 1;
}
.sticker-config-{{ section.id }} .canvas-item:hover { box-shadow: 0 0 0 2px #00CEC944; }
.sticker-config-{{ section.id }} .canvas-item.selected {
  box-shadow: inset 0 0 0 2px #00CEC9; z-index: 100 !important;
}
.sticker-config-{{ section.id }} .canvas-item img, .sticker-config-{{ section.id }} .canvas-item .text-content {
  width: 100%; height: 100%; object-fit: contain; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item .text-content {
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; color: #2D3436; word-break: break-word;
  text-align: center; padding: 4px;
}
.sticker-config-{{ section.id }} .canvas-item .resize-handle {
  position: absolute; width: 12px; height: 12px; border-radius: 2px;
  background: #00CEC9; border: 2px solid #fff; display: none; z-index: 10;
}
.sticker-config-{{ section.id }} .canvas-item.selected .resize-handle { display: block; }
.sticker-config-{{ section.id }} .resize-handle.nw { top: -4px; left: -4px; cursor: nw-resize; }
.sticker-config-{{ section.id }} .resize-handle.ne { top: -4px; right: -4px; cursor: ne-resize; }
.sticker-config-{{ section.id }} .resize-handle.sw { bottom: -4px; left: -4px; cursor: sw-resize; }
.sticker-config-{{ section.id }} .resize-handle.se { bottom: -4px; right: -4px; cursor: se-resize; }
.sticker-config-{{ section.id }} .rot-handle {
  position: absolute; bottom: -24px; left: 50%; margin-left: -8px;
  width: 16px; height: 16px; border-radius: 50%; background: #6C5CE7;
  border: 2px solid #fff; cursor: grab; display: none; z-index: 10;
}
.sticker-config-{{ section.id }} .canvas-item.selected .rot-handle { display: block; }
.sticker-config-{{ section.id }} .size-info {
  position: absolute; bottom: -28px; left: 50%; transform: translateX(-50%);
  background: #2D3436; color: #fff; font-size: 0.7rem; padding: 2px 8px;
  border-radius: 6px; white-space: nowrap; display: none; z-index: 20; pointer-events: none;
}
.sticker-config-{{ section.id }} .canvas-item.selected .size-info { display: block; }
.sticker-config-{{ section.id }} .size-inputs {
  display: flex; gap: 8px; align-items: center; height: 24px;
}
.sticker-config-{{ section.id }} .size-inputs input {
  width: 52px; padding: 4px 6px; border: 2px solid #DFE6E9; border-radius: 8px;
  font-size: 0.8rem; text-align: center; color: #2D3436; font-weight: 600;
  outline: none;
}
.sticker-config-{{ section.id }} .size-inputs input:focus { border-color: #00CEC9; }
.sticker-config-{{ section.id }} .size-inputs label { font-size: 0.7rem; color: #B2BEC3; }
.sticker-config-{{ section.id }} .sel-box {
  position: absolute; border: 1px solid #00CEC9; background: rgba(0,206,201,0.08);
  pointer-events: none; z-index: 999; display: none;
}
.sticker-config-{{ section.id }} .qty-group {
  display: flex; align-items: center; gap: 6px;
  background: #fff; border: 2px solid #DFE6E9; border-radius: 12px; padding: 2px;
}
.sticker-config-{{ section.id }} .qty-group button {
  width: 36px; height: 36px; border: none; border-radius: 10px;
  background: transparent; cursor: pointer; font-size: 1.2rem;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s; color: #636E72; font-weight: 600;
}
.sticker-config-{{ section.id }} .qty-group button:hover { background: #00CEC910; color: #00CEC9; }
.sticker-config-{{ section.id }} .qty-group .qty-val {
  font-size: 1.1rem; font-weight: 700; min-width: 36px;
  text-align: center; color: #2D3436;
}
.sticker-config-{{ section.id }} .canvas-hint {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  color: #DFE6E9; font-size: 0.9rem; text-align: center;
  pointer-events: none; font-weight: 500;
}
.sticker-config-{{ section.id }} .guide-line {
  position: absolute; pointer-events: none; z-index: 1000; display: none;
  background: #00CEC9;
}
.sticker-config-{{ section.id }} .guide-line.h { height: 1px; left: 0; right: 0; }
.sticker-config-{{ section.id }} .guide-line.v { width: 1px; top: 0; bottom: 0; }
.sticker-config-{{ section.id }} .zoom-display {
  font-size: 0.7rem; color: #B2BEC3; margin-left: auto; white-space: nowrap;
}


.sticker-config-{{ section.id }} .cfg-text-muted { color: #B2BEC3; font-size: 0.75rem; }
.sticker-config-{{ section.id }} .cfg-flex-center { display: flex; align-items: center; gap: 6px; }
.sticker-config-{{ section.id }} .cfg-inline-input { width: 52px; padding: 4px 6px; border: 2px solid #DFE6E9; border-radius: 8px; font-size: 0.8rem; text-align: center; color: #2D3436; font-weight: 600; outline: none; }
.sticker-config-{{ section.id }} .cfg-inline-input:focus { border-color: #00CEC9; }
.sticker-config-{{ section.id }} .cfg-inline-sm { width: 36px; padding: 2px 4px; border: 2px solid #DFE6E9; border-radius: 6px; font-size: 0.75rem; text-align: center; }
.sticker-config-{{ section.id }} .cfg-inline-sm:focus { border-color: #00CEC9; }
.sticker-config-{{ section.id }} .cfg-badge { font-size: 0.7rem; color: #B2BEC3; }
.sticker-config-{{ section.id }} .cfg-btn-submit { width: 100%; padding: 10px; border: none; border-radius: 10px; background: linear-gradient(135deg,var(--cfg-primary),#00A8A3); color: #fff; font-size: 1rem; font-weight: 700; cursor: pointer; margin-top: 4px; }
.sticker-config-{{ section.id }} .bottom-extra {
  padding: 8px 12px 20px 12px; display: flex; flex-direction: column; gap: 8px;
  font-size: 0.8rem;
}
.sticker-config-{{ section.id }} .bottom-extra .be-row {
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
}
.sticker-config-{{ section.id }} .bottom-extra .be-label {
  color: #B2BEC3; font-size: 0.7rem; font-weight: 600; min-width: 40px;
}
.sticker-config-{{ section.id }} .bottom-extra .be-btn {
  padding: 4px 12px; border: 1px solid #DFE6E9; border-radius: 8px;
  background: #fff; cursor: pointer; font-size: 0.75rem; color: #636E72;
  transition: all 0.12s;
}
.sticker-config-{{ section.id }} .bottom-extra .be-btn:hover {
  border-color: #00CEC9; color: #00CEC9; background: #f0fdfd;
}
.sticker-config-{{ section.id }} .bottom-extra .be-btn.danger {
  border-color: #FF4444; color: #FF4444;
}
.sticker-config-{{ section.id }} .bottom-extra .be-btn.danger:hover {
  background: #FFF0F0;
}

.sticker-config-{{ section.id }} .cfg-modal {
  position: fixed; inset: 0; z-index: 99999;
  background: rgba(0,0,0,0.4); display: none;
  align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
.sticker-config-{{ section.id }} .cfg-modal-box {
  background: #fff; border-radius: 20px; padding: 32px;
  max-width: 420px; width: 90%;
  box-shadow: 0 20px 60px rgba(0,0,0,0.15);
}
.sticker-config-{{ section.id }} .cfg-modal-title {
  margin: 0 0 20px; font-size: 1.1rem; color: var(--cfg-text);
}
.sticker-config-{{ section.id }} .cfg-modal-zone {
  border: 2px dashed var(--cfg-border); border-radius: 12px;
  padding: 24px; text-align: center; cursor: pointer; margin-bottom: 16px;
}
.sticker-config-{{ section.id }} .cfg-modal-zone .cfg-modal-icon {
  font-size: 2rem; margin-bottom: 4px;
}
.sticker-config-{{ section.id }} .cfg-modal-zone .cfg-modal-text {
  font-size: 0.85rem; color: var(--cfg-muted);
}
.sticker-config-{{ section.id }} .cfg-modal-fname {
  font-size: 0.8rem; color: var(--cfg-primary); margin-top: 4px; display: none;
}
.sticker-config-{{ section.id }} .cfg-modal-row {
  display: flex; gap: 12px; align-items: center; margin-bottom: 16px;
}
.sticker-config-{{ section.id }} .cfg-modal-row label {
  font-size: 0.85rem; font-weight: 600; color: var(--cfg-muted); min-width: 50px;
}
.sticker-config-{{ section.id }} .cfg-modal-row input {
  flex: 1; padding: 10px 12px; border: 2px solid var(--cfg-border);
  border-radius: 10px; font-size: 0.9rem; outline: none;
}
.sticker-config-{{ section.id }} .cfg-modal-row input:focus {
  border-color: var(--cfg-primary);
}
.sticker-config-{{ section.id }} .cfg-modal-row span {
  font-size: 0.8rem; color: #B2BEC3;
}
.sticker-config-{{ section.id }} .cfg-modal-actions {
  display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px;
}
.sticker-config-{{ section.id }} .cfg-btn-sec {
  padding: 10px 24px; border-radius: 10px; border: none;
  font-size: 0.9rem; font-weight: 600; cursor: pointer;
  background: #f5f5f5; color: var(--cfg-muted);
}
.sticker-config-{{ section.id }} .cfg-btn-pry {
  padding: 10px 24px; border-radius: 10px; border: none;
  font-size: 0.9rem; font-weight: 600; cursor: pointer;
  background: linear-gradient(135deg,var(--cfg-primary),#00A8A3); color: #fff;
}
.sticker-config-{{ section.id }} .cfg-btn-pry:disabled { opacity: 0.4; cursor: default; }
.sticker-config-{{ section.id }} .sticky-ctrls {
  background: {{ bg_color }}; padding: 8px 0; margin-top: -14px;
  position: sticky; bottom: 0; z-index: 50;
}
@media (max-width: 768px) {
  .sticker-config-{{ section.id }} { position: static; padding: 16px; }
  
  
}
.sticker-config-{{ section.id }}.mobile-mode {
}
}
.sticker-config-{{ section.id }}.mobile-mode .editor-wrap {
  display: flex; flex-direction: column; gap: 12px;
}
.sticker-config-{{ section.id }}.mobile-mode .toolbar {
  padding: 4px; gap: 2px; overflow-x: auto; flex-wrap: wrap;
  justify-content: center;
}
.sticker-config-{{ section.id }}.mobile-mode .canvas-wrap {
  overflow: auto; min-height: 300px;
}


.sticker-config-{{ section.id }}.mobile-mode .toolbar button {
  width: 38px; height: 38px; font-size: 16px; flex-shrink: 0;
}
.sticker-config-{{ section.id }}.mobile-mode .toolbar .toolbar-divider { display: none; }
.sticker-config-{{ section.id }}.mobile-mode .zoom-display { display: none; }

.sticker-config-{{ section.id }} .upload-btn-area button {
  padding: 6px 14px; border: 2px dashed #DFE6E9; border-radius: 8px;
  background: transparent; cursor: pointer; font-size: 0.78rem; color: #636E72;
  transition: all 0.2s;
}
.sticker-config-{{ section.id }} .upload-btn-area button:hover {
  border-color: #00CEC9; color: #00CEC9; background: #f0fdfd;
}
.sticker-config-{{ section.id }} .upload-btn-area {
  display: flex; gap: 6px; align-items: center;
}
{% endstyle %}

<div class="sticker-config-{{ section.id }}">
  <div class="editor-wrap">
    <div class="toolbar">
      <button title="Undo" id="undo-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg></button>
      <button title="Redo" id="redo-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Auto arrange" id="auto-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg></button>
      <button title="Delete selected" id="del-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg></button>
      <button title="Duplicate" id="dup-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Flip H" id="flip-h-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18"/><polyline points="7 8 3 12 7 16"/><polyline points="17 8 21 12 17 16"/></svg></button>
      <button title="Flip V" id="flip-v-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18"/><polyline points="8 7 12 3 16 7"/><polyline points="8 17 12 21 16 17"/></svg></button>
      <button title="Align left" id="align-left-{{ section.id }}" disabled><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="10" x2="14" y2="10"/><line x1="4" y1="14" x2="18" y2="14"/><line x1="4" y1="18" x2="10" y2="18"/></svg></button>
      <button title="Align center H" id="align-h-{{ section.id }}" disabled><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="6" y1="14" x2="18" y2="14"/><line x1="10" y1="18" x2="14" y2="18"/></svg></button>
      <button title="Align right" id="align-right-{{ section.id }}" disabled><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="10" y1="10" x2="20" y2="10"/><line x1="6" y1="14" x2="20" y2="14"/><line x1="14" y1="18" x2="20" y2="18"/></svg></button>
      <button title="Align top" id="align-top-{{ section.id }}" disabled><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="4" x2="18" y2="4"/><line x1="10" y1="8" x2="14" y2="8"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="10" y1="16" x2="14" y2="16"/></svg></button>
      <button title="Align center V" id="align-v-{{ section.id }}" disabled><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="4" x2="18" y2="4"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="8" y1="16" x2="16" y2="16"/></svg></button>
      <button title="Align bottom" id="align-bot-{{ section.id }}" disabled><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="4" x2="18" y2="4"/><line x1="10" y1="8" x2="14" y2="8"/><line x1="6" y1="12" x2="18" y2="12"/><line x1="10" y1="16" x2="14" y2="16"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Add text" id="text-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg></button>
      <button title="Zoom to fit" id="zoom-fit-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="11" y1="8" x2="11" y2="14"/></svg></button>
      <button title="Export PDF" id="export-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></button>
      <span class="toolbar-divider"></span>
      <button title="Lock" id="lock-btn-{{ section.id }}" disabled><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></button>
      <button title="Mobile" id="mobile-btn-{{ section.id }}"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg></button>
      <span class="zoom-display" id="zoom-display-{{ section.id }}" class="cfg-zoom-pct" style="cursor:pointer;border-bottom:1px dotted #B2BEC3;" title="Click to reset zoom to 100%">100%</span>
    </div>

    <div class="cfg-info-bar" style="font-size:0.75rem;color:#B2BEC3;display:flex;justify-content:space-between;">
      <span id="item-count-{{ section.id }}">0 items</span>
      <span id="sel-size-{{ section.id }}" style="display:none;">&nbsp;</span>
      <span id="hint-text-{{ section.id }}">Middle-click drag to pan | Scroll to zoom | T to add text</span>
    </div>
    <div class="size-inputs" id="size-inputs-{{ section.id }}" class="cfg-size-inputs" style="visibility:hidden;height:28px;display:flex;gap:8px;align-items:center;font-size:0.75rem;">
      <label class="cfg-badge">W:</label><input id="w-input-{{ section.id }}" type="number" min="10" max="600" step="1" class="cfg-inline-input">
      <label class="cfg-badge">H:</label><input id="h-input-{{ section.id }}" type="number" min="10" max="600" step="1" class="cfg-inline-input">
      <label style="color:#B2BEC3;">mm</label>
    </div>
    <div class="canvas-wrap" id="canvas-wrap-{{ section.id }}">

      <div class="canvas-area" id="canvas-{{ section.id }}">
        <canvas class="grid-bg" id="grid-canvas-{{ section.id }}"></canvas>
        <div class="canvas-hint" id="hint-{{ section.id }}">Add a design or press T to add text</div>
      </div>
      <div class="guide-line h" id="guide-h-{{ section.id }}"></div>
      <div class="guide-line v" id="guide-v-{{ section.id }}"></div>
    </div>
    <div class="sticky-ctrls">
    <input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" id="file-input-{{ section.id }}" style="display:none;">
    <div class="upload-btn-area">
      <button id="add-btn-{{ section.id }}">&#x2795; Add design</button>
      <div class="qty-group">
        <button id="qty-down-{{ section.id }}">&minus;</button>
        <span class="qty-val" id="qty-display-{{ section.id }}">10</span>
        <button id="qty-up-{{ section.id }}">+</button>
      </div>
      <span style="font-size:0.8rem;color:#636E72;">pieces</span>
    </div>
    <button id="submit-{{ section.id }}" class="cfg-btn-submit">
      Add to Cart &mdash; <span id="price-display-{{ section.id }}">$0.00</span>
    </button>
    <div id="modal-{{ section.id }}" class="cfg-modal">
      <div class="cfg-modal-box">
        <h3 class="cfg-modal-title">Add Design</h3>
        <div class="cfg-modal-zone" id="modal-zone-{{ section.id }}">
          <div class="cfg-modal-icon">&#x1F5BC;</div>
          <div class="cfg-modal-text">Click to choose a design file</div>
          <div class="cfg-modal-fname" id="modal-fname-{{ section.id }}"></div>
        </div>
        <div class="cfg-modal-row"><label>W</label><input type="number" id="modal-w-{{ section.id }}" value="50" min="10" max="600" step="1"><span>mm</span></div>
        <div class="cfg-modal-row"><label>H</label><input type="number" id="modal-h-{{ section.id }}" value="50" min="10" max="600" step="1"><span>mm</span></div>
        <div class="cfg-modal-row"><label>Copies</label><input type="number" id="modal-qty-{{ section.id }}" value="3" min="1" max="50" step="1"><span>pcs</span></div>
        <div class="cfg-modal-actions">
          <button id="modal-cancel-{{ section.id }}" class="cfg-btn-sec">Cancel</button>
          <button id="modal-add-{{ section.id }}" class="cfg-btn-pry" disabled>Add to Canvas</button>
        </div>
      </div>
    </div>
        <div class="bottom-extra">
      <div class="be-row">
        <span class="be-label">Snap</span>
        <input type="checkbox" id="snap-btm-{{ section.id }}" checked style="accent-color:var(--cfg-primary);cursor:pointer;">
        <span style="font-size:0.7rem;color:#B2BEC3;">Grid</span>
        <input type="number" id="grid-size-{{ section.id }}" value="20" min="5" max="100" step="5" class="cfg-inline-sm" style="width:40px;">
        <span style="font-size:0.7rem;color:#B2BEC3;">px</span>
        <span class="be-label" style="margin-left:4px;">Gap</span>
        <input type="number" id="gap-size-{{ section.id }}" value="3" min="3" max="50" step="1" class="cfg-inline-sm">
        <span style="font-size:0.7rem;color:#B2BEC3;">mm</span>
      </div>
      <div class="be-row">
        <span id="stats-{{ section.id }}" class="cfg-text-muted" style="color:#636E72;"></span>
        <input type="color" id="bg-color-{{ section.id }}" value="#FFFFFF" style="width:28px;height:28px;border:none;cursor:pointer;border-radius:5px;padding:0;margin-left:auto;">
        <button class="be-btn danger" id="clear-btn-{{ section.id }}" style="padding:2px 8px;font-size:0.7rem;">Clear</button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var sid = '{{ section.id }}';
  var CANVAS_W = 0, CANVAS_H = 0;
  var wrap = document.getElementById('canvas-wrap-'+sid);
  var canvas = document.getElementById('canvas-'+sid);
  CANVAS_W = wrap.clientWidth;
  CANVAS_H = Math.round(CANVAS_W * 400 / 600);
  canvas.style.width = CANVAS_W + 'px';
  wrap.style.height = CANVAS_H + 'px';
  var hint = document.getElementById('hint-'+sid);
  var fileInput = document.getElementById('file-input-'+sid);
  var countEl = document.getElementById('item-count-'+sid);
  var qtyEl = document.getElementById('qty-display-'+sid);
  var priceEl = document.getElementById('price-display-'+sid);

  var items = [];
  var selectedIds = [];
  var nextId = 1;
  var dragState = null;
  var basePrice = 2.5;
  var zoom = 1, panX = 0, panY = 0;
  var dpr = window.devicePixelRatio || 1;
  var textToolActive = false;

  var undoBtn = document.getElementById('undo-btn-'+sid);
  var redoBtn = document.getElementById('redo-btn-'+sid);
  var delBtn = document.getElementById('del-btn-'+sid);
  var dupBtn = document.getElementById('dup-btn-'+sid);
  var flipHBtn = document.getElementById('flip-h-'+sid);
  var flipVBtn = document.getElementById('flip-v-'+sid);
  var autoBtn = document.getElementById('auto-btn-'+sid);
  var mobileBtn = document.getElementById('mobile-btn-'+sid);
  var textBtn = document.getElementById('text-btn-'+sid);
  var zoomFitBtn = document.getElementById('zoom-fit-'+sid);
  var exportBtn = document.getElementById('export-btn-'+sid);
  var zoomDisplay = document.getElementById('zoom-display-'+sid);
  // rulers removed
  var guideH = document.getElementById('guide-h-'+sid);
  var guideV = document.getElementById('guide-v-'+sid);

  var selBox = document.createElement('div');
  selBox.className = 'sel-box';
  canvas.appendChild(selBox);

  /* ── History ── */
  var history = [], historyIdx = -1;
  function saveState() {
    historyIdx++; history.length = historyIdx;
    history.push(items.map(function(i) {
      var img = i.el.querySelector('img');
      return { id: i.id, src: img ? img.src : i.text||'', isText: !!i.text, text: i.text||'', fontSize: i.fontSize||16,
        x: i.x, y: i.y, w: i.w, h: i.h, rotation: i.rotation, scaleX: i.scaleX, scaleY: i.scaleY };
    }));
    if (history.length > 50) { history.shift(); historyIdx--; }
    updateHistoryBtns();
  }
  function restoreState(state) {
    var savedIds = state.map(function(s) { return s.id; });
    for (var ri = items.length-1; ri>=0; ri--) {
      if (savedIds.indexOf(items[ri].id)===-1) { items[ri].el.remove(); items.splice(ri,1); }
    }
    state.forEach(function(s) {
      var item = items.find(function(i) { return i.id===s.id; });
      if (!item) {
        if (s.isText) item = addTextItem(s.text, s.fontSize||16, true);
        else if (s.src) item = addImageItem(s.src, true);
        if (!item) return;
        item.id = s.id; item.el.dataset.itemId = s.id;
        item.rotation=s.rotation; item.scaleX=s.scaleX; item.scaleY=s.scaleY;
      }
      item.x=s.x; item.y=s.y; item.w=s.w; item.h=s.h;
      item.rotation=s.rotation; item.scaleX=s.scaleX; item.scaleY=s.scaleY;
      item.el.style.left=s.x+'px'; item.el.style.top=s.y+'px';
      item.el.style.width=s.w+'px'; item.el.style.height=s.h+'px';
      applyTransform(item); updateSizeInfo(item);
    });
    hint.style.display = items.length ? 'none' : '';
  }

  /* ── Selection ── */
  function toggleSelect(id, add) {
    if (add) { var idx=selectedIds.indexOf(id); idx!==-1?selectedIds.splice(idx,1):selectedIds.push(id); }
    else selectedIds=[id];
    updateSelection();
  }
  function selectAllInRect(x1,y1,x2,y2) {
    var l=Math.min(x1,x2),r=Math.max(x1,x2),t=Math.min(y1,y2),b=Math.max(y1,y2);
    selectedIds=[];
    items.forEach(function(it){var cx=it.x+it.w/2,cy=it.y+it.h/2; if(cx>=l&&cx<=r&&cy>=t&&cy<=b) selectedIds.push(it.id);});
    updateSelection();
  }
  function updateSelection() {
    var count=selectedIds.length;
    var mm3=Math.round(CANVAS_W/600*3);
    canvas.querySelectorAll('.canvas-item').forEach(function(el){
      el.classList.toggle('selected',selectedIds.indexOf(parseInt(el.dataset.itemId))!==-1);
      el.style.outlineOffset=el.classList.contains('selected')?mm3+'px':'';
    });
    delBtn.disabled=dupBtn.disabled=flipHBtn.disabled=flipVBtn.disabled=count===0;
    ['left','right','h','top','bot','v'].forEach(function(d){
      var btn=document.getElementById('align-'+d+'-'+sid);
      if(btn) btn.disabled=count<1;
    });
    updateSizeInputs(); updateCount();
  }
  function getSelected(){return items.filter(function(i){return selectedIds.indexOf(i.id)!==-1;});}

  /* ── Unit conversion ── */
  function pxToMm(px){return Math.round(px/CANVAS_W*600);}
  function mmToPx(mm){return mm/600*CANVAS_W;}
  function snapVal(v,g){return g>0?Math.round(v/g)*g:v;}

  /* ── Add items ── */
  function findNextSlot(w, h) {
    var gi=document.getElementById('gap-size-'+sid), gap=Math.round(CANVAS_W/600*(parseInt(gi?gi.value:0)||3)), pad=12;
    // Scan left-to-right, top-to-bottom
    for(var yy=pad; yy+h<=CANVAS_H; yy+=h+gap){
      for(var xx=pad; xx+w<=CANVAS_W; xx+=w+gap){
        var ok=true;
        for(var mi=0; mi<items.length; mi++){
          var o=items[mi];
          if(xx<o.x+o.w+w/2 && xx+w>o.x-w/2 && yy<o.y+o.h+h/2 && yy+h>o.y-h/2){ ok=false; break; }
        }
        if(ok) return {x:xx, y:yy};
      }
    }
    return {x:pad, y:CANVAS_H+10}; // below canvas if no fit
  }
  function addImageItem(src, silent) {
    var id=nextId++;
    var w=80+Math.random()*30, h=w*0.75;
    var slot=findNextSlot(w, h);
    var el=document.createElement('div');
    el.className='canvas-item'; el.dataset.itemId=id;
    el.style.left=slot.x+'px';
    el.style.top=slot.y+'px';
    el.style.width=w+'px'; el.style.height=h+'px';
    var img=document.createElement('img'); img.src=src; img.draggable=false;
    el.appendChild(img);
    addItemHelpers(el, id);
    var item = finishItem(el, id, w, h);
    if (!silent) { selectedIds=[id]; updateSelection(); saveState(); growCanvas(); }
    return item;
  }
  function addTextItem(text, fontSize, silent, color, bgColor, fontWeight, fontStyle, textAlign) {
    var id=nextId++;
    var w=120, h=40+fontSize;
    var slot=findNextSlot(w, h);
    var el=document.createElement('div');
    el.className='canvas-item'; el.dataset.itemId=id;
    el.style.left=slot.x+'px'; el.style.top=slot.y+'px';
    el.style.width=w+'px'; el.style.height=h+'px';
    var tc=document.createElement('div');
    tc.className='text-content'; tc.textContent=text;
    tc.style.fontSize=fontSize+'px';
    tc.style.color=color||'#2D3436';
    tc.style.fontWeight=fontWeight||'';
    tc.style.fontStyle=fontStyle||'';
    tc.style.textAlign=textAlign||'center';
    if(bgColor) tc.style.background=bgColor;
    el.appendChild(tc);
    addItemHelpers(el, id);
    var item = finishItem(el, id, w, h);
    item.text=text; item.fontSize=fontSize; item.color=color||'#2D3436';
    item.bgColor=bgColor||''; item.fontWeight=fontWeight||'';
    item.fontStyle=fontStyle||''; item.textAlign=textAlign||'center';
    if (!silent) { selectedIds=[id]; updateSelection(); saveState(); growCanvas(); }
    return item;
  }
  function addItemHelpers(el, id) {
    var si=document.createElement('div'); si.className='size-info'; si.id='size-info-'+id; el.appendChild(si);
    ['nw','ne','sw','se'].forEach(function(p){var h=document.createElement('div');h.className='resize-handle '+p;h.dataset.handle=p;el.appendChild(h);});
    var rot=document.createElement('div'); rot.className='rot-handle'; el.appendChild(rot);
    canvas.appendChild(el);
    hint.style.display='none';
  }
  function finishItem(el, id, w, h) {
    var item = {id:id,el:el,x:parseFloat(el.style.left),y:parseFloat(el.style.top),w:w,h:h,rotation:0,scaleX:1,scaleY:1};
    items.push(item);
    updateSizeInfo(item); updateCount(); updatePrice();
    return item;
  }

  function updateSizeInfo(item) {
    var si=document.getElementById('size-info-'+item.id);
    if(si) si.textContent=pxToMm(item.w)+'\u00D7'+pxToMm(item.h)+' mm';
  }
  function updateSizeInputs() {
    var sel=selectedIds.length===1, inputs=document.getElementById('size-inputs-'+sid), sl=document.getElementById('sel-size-'+sid);
    if(sel&&selectedIds.length>0){var id=parseInt(selectedIds[0]),item=items.find(function(i){return i.id===id;});
      if(item){inputs.style.visibility='visible';sl.style.display='none';
        document.getElementById('w-input-'+sid).value=pxToMm(item.w);
        document.getElementById('h-input-'+sid).value=pxToMm(item.h);return;}}
    inputs.style.visibility='hidden';sl.style.display='none';
  }

  /* ── Interaction ── */
  function startDrag(e, id) {
    var item=items.find(function(i){return i.id===id;}); if(!item) return;
    dragState={type:'move',ids:selectedIds.slice(),ox:e.clientX,oy:e.clientY,startPos:{},guides:{}};
    getSelected().forEach(function(i){dragState.startPos[i.id]={x:i.x,y:i.y};});
    item.el.style.cursor='grabbing'; e.preventDefault();
  }
  function startResize(e,id,handle){
    var item=items.find(function(i){return i.id===id;}); if(!item) return;
    dragState={type:'resize',id:id,handle:handle,ox:e.clientX,oy:e.clientY,sw:item.w,sh:item.h,sx:item.x,sy:item.y};
    e.preventDefault();
  }
  function startRotate(e,id){
    var item=items.find(function(i){return i.id===id;}); if(!item) return;
    var r=item.el.getBoundingClientRect();
    dragState={type:'rotate',id:id,cx:r.left+r.width/2,cy:r.top+r.height/2,
      startAngle:Math.atan2(e.clientY-(r.top+r.height/2),e.clientX-(r.left+r.width/2))-item.rotation*Math.PI/180};
    e.preventDefault();
  }
  function applyTransform(item) {
    item.el.style.transform='rotate('+item.rotation+'deg) scaleX('+item.scaleX+') scaleY('+item.scaleY+')';
  }
  function rectsOverlap(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y;}

  /* ── Alignment guides + pan/zoom ── */
  function updateGuides(item, items) {
    var gH=guideH, gV=guideV;
    gH.style.display='none'; gV.style.display='none';
    if (!item) return;
    var SNAP_DIST = 6;
    var edges = ['t','b','c','l','r','m'];
    var ie = { t: item.y, b: item.y+item.h, c: item.y+item.h/2, l: item.x, r: item.x+item.w, m: item.x+item.w/2 };
    items.forEach(function(other) {
      if (other.id===item.id) return;
      var oe = { t: other.y, b: other.y+other.h, c: other.y+other.h/2, l: other.x, r: other.x+other.w, m: other.x+other.w/2 };
      edges.forEach(function(iee) { edges.forEach(function(oee) {
        if ((iee==='t'||iee==='b'||iee==='c') && (oee==='t'||oee==='b'||oee==='c')) {
          var d = Math.abs(ie[iee]-oe[oee]);
          if (d < SNAP_DIST) {
            var snapY = oe[oee];
            if (dragState && dragState.type==='move') {
              dragState.ids.forEach(function(did) {
                var di = items.find(function(i){return i.id==did;});
                if (di) { var sp=dragState.startPos[did]; if(sp) di.y = sp.y + (snapY - ie[iee]); }
              });
            }
            var wrapRect = wrap.getBoundingClientRect();
            gH.style.display='block'; gH.style.top=snapY+'px';
          }
        }
        if ((iee==='l'||iee==='r'||iee==='m') && (oee==='l'||oee==='r'||oee==='m')) {
          var d = Math.abs(ie[iee]-oe[oee]);
          if (d < SNAP_DIST) {
            var snapX = oe[oee];
            if (dragState && dragState.type==='move') {
              dragState.ids.forEach(function(did) {
                var di = items.find(function(i){return i.id==did;});
                if (di) { var sp=dragState.startPos[did]; if(sp) di.x = sp.x + (snapX - ie[iee]); }
              });
            }
            gV.style.display='block'; gV.style.left=snapX+'px';
          }
        }
      });});
    });
  }

  /* ── Zoom / Pan ── */
  // CANVAS_W/H already set at init (wrap.clientWidth based)
  function clampPan() {
    var vw=CANVAS_W, vh=CANVAS_H;
    var maxX=CANVAS_W - vw/zoom;
    panX=Math.min(0,Math.max(-maxX,panX));
    panY=Math.min(0,Math.max(-(CANVAS_H - vh/zoom),panY));
  }
  function updateCanvasWH(){}
  
  function growCanvas() {
    var maxB=0;
    items.forEach(function(i){var b=i.y+i.h;if(b>maxB)maxB=b;});
    maxB=Math.max(maxB, CANVAS_H);
    if(maxB>CANVAS_H){
      CANVAS_H=maxB+40;
      canvas.style.height=CANVAS_H+'px';
      wrap.style.height=CANVAS_H+'px';
      drawGrid();
    }
  }
  function applyZoom() {
    zoom=Math.max(1,Math.min(5,zoom));
    updateCanvasWH();
    clampPan();
    canvas.style.transform='scale('+zoom+') translate('+panX+'px,'+panY+'px)';
    zoomDisplay.textContent=Math.round(zoom*100)+'%';
    drawGrid();
  }
  function drawGrid() {
    var gc=document.getElementById('grid-canvas-'+sid);
    if(!gc) return;
    var w=CANVAS_W, h=CANVAS_H;
    gc.width=w*dpr; gc.height=h*dpr;
    gc.style.width=w+'px'; gc.style.height=h+'px';
    var ctx=gc.getContext('2d');
    ctx.setTransform(dpr,0,0,dpr,0,0);
    var gs=parseInt((document.getElementById('grid-size-'+sid)||{}).value)||20;
    ctx.strokeStyle='rgba(0,0,0,0.03)'; ctx.lineWidth=1;
    ctx.beginPath();
    for(var x=0; x<w; x+=gs){ctx.moveTo(x,0);ctx.lineTo(x,CANVAS_H);}
    for(var y=0; y<h; y+=gs){ctx.moveTo(0,y);ctx.lineTo(CANVAS_W,y);}
    ctx.stroke();
  }

  function zoomToFit() {
    if(items.length===0){zoom=1;panX=0;panY=0;applyZoom();return;}
    updateCanvasWH();
    var minX=1/0,minY=1/0,maxX=-1/0,maxY=-1/0;
    items.forEach(function(i){if(i.x<minX)minX=i.x;if(i.y<minY)minY=i.y;if(i.x+i.w>maxX)maxX=i.x+i.w;if(i.y+i.h>maxY)maxY=i.y+i.h;});
    var zw=CANVAS_W/(maxX-minX+40), zh=CANVAS_H/(maxY-minY+40);
    zoom=Math.min(zw,zh,2); zoom=Math.max(zoom,1);
    var cx=(minX+maxX)/2, cy=(minY+maxY)/2;
    panX=CANVAS_W/2/zoom-cx; panY=CANVAS_H/2/zoom-cy;
    applyZoom();
  }

  /* ── Layer panel ── */


  /* ── Mouse events ── */
  function getCanvasXY(e) {
    var cr=canvas.getBoundingClientRect();
    return { x: (e.clientX-cr.left)/zoom, y: (e.clientY-cr.top)/zoom };
  }

  canvas.addEventListener('mousedown',function(e){updateCanvasWH();
    var itemEl=e.target.closest('.canvas-item');

    if(itemEl){
      var cid=parseInt(itemEl.dataset.itemId);
      if(e.target.classList.contains('resize-handle')){if(selectedIds.indexOf(cid)===-1){selectedIds=[cid];updateSelection();}startResize(e,cid,e.target.dataset.handle);return;}
      if(e.target.classList.contains('rot-handle')){if(selectedIds.indexOf(cid)===-1){selectedIds=[cid];updateSelection();}startRotate(e,cid);return;}
      if(e.ctrlKey||e.metaKey){toggleSelect(cid,true);return;}
      selectedIds=[cid];updateSelection();
      if(e.button===1){panX+=e.clientX;panY+=e.clientY;dragState={type:'pan',ox:e.clientX,oy:e.clientY};return;}
      startDrag(e,cid);return;
    }
    if(e.button===1||e.altKey){
      dragState={type:'pan',ox:e.clientX,oy:e.clientY};return;
    }
    if(textToolActive&&(e.target===canvas||e.target.classList.contains('grid-bg'))){
      var xy=getCanvasXY(e);
      addTextItem('Text',16,false);return;
    }
    if(!(e.ctrlKey||e.metaKey)){selectedIds=[];updateSelection();}
    var xy=getCanvasXY(e);
    dragState={type:'selbox',sx:xy.x,sy:xy.y};
  });

  document.addEventListener('mousemove',function(e){
    if(!dragState) return;
  document.addEventListener('touchmove',function(te){
    if(!dragState||te.touches.length!==1) return;
    var t=te.touches[0];
    var e={clientX:t.clientX,clientY:t.clientY,ctrlKey:false,metaKey:false,altKey:false,button:0,target:te.target};
    var handled=true;
    if(dragState.type==='pan'){var dx=t.clientX-dragState.ox,dy=t.clientY-dragState.oy;panX+=dx;panY+=dy;dragState.ox=t.clientX;dragState.oy=t.clientY;applyZoom();}
    else if(dragState.type==='move'){
      var dx2=(t.clientX-(dragState._touchOx||t.clientX))/zoom, dy2=(t.clientY-(dragState._touchOy||t.clientY))/zoom;
      if(!dragState._touchOx){dragState._touchOx=t.clientX;dragState._touchOy=t.clientY;}
      e.clientX=t.clientX; e.clientY=t.clientY;
      // re-dispatch to existing move logic below
      handled=false;
    }
    else if(dragState.type==='resize'){
      var item=items.find(function(i){return i.id===dragState.id;}); if(!item) return;
      var dx3=(t.clientX-dragState.ox)/zoom, dy3=(t.clientY-dragState.oy)/zoom;
      if(dragState.handle.includes('e')) item.w=Math.max(30,dragState.sw+dx3);
      if(dragState.handle.includes('w')){var nw=Math.max(30,dragState.sw-dx3);item.x=dragState.sx+dragState.sw-nw;item.w=nw;}
      if(dragState.handle.includes('s')) item.h=Math.max(30,dragState.sh+dy3);
      if(dragState.handle.includes('n')){var nh=Math.max(30,dragState.sh-dy3);item.y=dragState.sy+dragState.sh-nh;item.h=nh;}
      item.x=Math.max(0,Math.min(CANVAS_W-item.w,item.x));item.y=Math.max(0,item.y);
      item.el.style.left=item.x+'px';item.el.style.top=item.y+'px';item.el.style.width=item.w+'px';item.el.style.height=item.h+'px';
      updateSizeInfo(item);return;
    }
    else if(dragState.type==='rotate'){
      var item=items.find(function(i){return i.id===dragState.id;});if(!item)return;
      var dx4=(t.clientX-dragState.ox)/zoom,dy4=(t.clientY-dragState.oy)/zoom;
      item.rotation=Math.round(Math.atan2(dy4,dx4)*180/Math.PI);
      item.el.style.transform='translate(-50%,-50%) rotate('+item.rotation+'deg) scale('+item.scaleX+','+item.scaleY+')';return;
    }
