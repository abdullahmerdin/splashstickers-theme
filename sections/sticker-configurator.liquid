    panX=mx-mx*zoom/(zoom/f); panY=my-my*zoom/(zoom/f);
    updateCanvasWH();clampPan(); applyZoom();
  },{passive:false});

  /* ── Toolbar ── */
  delBtn.addEventListener('click',function(){var sel=getSelected();sel.forEach(function(it){it.el.remove();var idx=items.indexOf(it);if(idx!==-1)items.splice(idx,1);});selectedIds=[];updateSelection();updateCount();updatePrice();saveState();growCanvas();if(items.length===0)hint.style.display='';});
  dupBtn.addEventListener('click',function(){var sel=getSelected();if(!sel.length)return;saveState();sel.forEach(function(src){var img=src.el.querySelector('img');if(img){var n=addImageItem(img.src,true);n.x=src.x+25;n.y=src.y+25;n.w=src.w;n.h=src.h;n.el.style.left=n.x+'px';n.el.style.top=n.y+'px';n.el.style.width=n.w+'px';n.el.style.height=n.h+'px';}else if(src.text){addTextItem(src.text,src.fontSize||16,true);}});growCanvas();});
  flipHBtn.addEventListener('click',function(){saveState();getSelected().forEach(function(it){it.scaleX*=-1;applyTransform(it);});growCanvas();});
  flipVBtn.addEventListener('click',function(){saveState();getSelected().forEach(function(it){it.scaleY*=-1;applyTransform(it);});});
  autoBtn.addEventListener('click',function(){
    saveState(); var cw=CANVAS_W,ch=CANVAS_H,pad=12,gap=Math.round(cw/600*3);
    var packed=[],row=[],rowW=0,maxRowH=0;
    items.forEach(function(it,idx){if(row.length&&rowW+gap+it.w>cw-pad*2){packed.push({items:row,h:maxRowH});row=[];rowW=0;maxRowH=0;}row.push(idx);rowW+=gap+it.w;maxRowH=Math.max(maxRowH,it.h);});
    if(row.length) packed.push({items:row,h:maxRowH});
    var yy=pad; packed.forEach(function(p){var xx=pad; p.items.forEach(function(idx){var it=items[idx];it.x=xx;it.y=yy;it.rotation=0;it.el.style.left=xx+'px';it.el.style.top=yy+'px';applyTransform(it);updateSizeInfo(it);xx+=it.w+gap;});yy+=p.h+gap;});
