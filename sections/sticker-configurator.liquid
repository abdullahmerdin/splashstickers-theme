  function renderToCanvas() {
    var cw=CANVAS_W, ch=CANVAS_H;
    var c = document.createElement('canvas');
    c.width=cw*2; c.height=ch*2;
    var ctx=c.getContext('2d');
    ctx.scale(2,2);
    ctx.fillStyle='#fff'; ctx.fillRect(0,0,cw,ch);
    items.forEach(function(it){
      ctx.save();
      ctx.translate(it.x+it.w/2,it.y+it.h/2);
      ctx.rotate(it.rotation*Math.PI/180);
      ctx.scale(it.scaleX,it.scaleY);
      ctx.translate(-it.w/2,-it.h/2);
      var img=it.el.querySelector('img');
      if(img) ctx.drawImage(img,0,0,it.w,it.h);
      else if(it.text){
        ctx.fillStyle=it.color||'#2D3436'; ctx.font=(it.fontStyle||'')+' '+(it.fontWeight||'')+' '+(it.fontSize||16)+'px sans-serif';
        ctx.textAlign=it.textAlign||'center'; ctx.textBaseline='middle';
        if(it.bgColor){ctx.fillStyle=it.bgColor;ctx.fillRect(0,0,it.w,it.h);ctx.fillStyle=it.color||'#2D3436';}
        ctx.fillText(it.text,it.w/2,it.h/2);
      }
      ctx.restore();
    });
    return c;
  }
