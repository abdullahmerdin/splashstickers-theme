  modalEl.innerHTML='<div style="background:#fff;border-radius:20px;padding:32px;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.15);">'+
    '<h3 style="margin:0 0 20px;font-size:1.1rem;color:#2D3436;">Add Design</h3>'+
    '<div id="modal-zone-'+sid+'" style="border:2px dashed #DFE6E9;border-radius:12px;padding:24px;text-align:center;cursor:pointer;margin-bottom:16px;">'+
      '<div style="font-size:2rem;margin-bottom:4px;">&#x1F5BC;</div><div style="font-size:0.85rem;color:#636E72;">Click to choose a design file</div>'+
      '<div id="modal-fname-'+sid+'" style="font-size:0.8rem;color:#00CEC9;margin-top:4px;display:none;"></div></div>'+
    '<div style="display:flex;gap:12px;margin-bottom:16px;align-items:center;"><label style="font-size:0.85rem;font-weight:600;color:#636E72;min-width:50px;">W</label><input type="number" id="modal-w-'+sid+'" value="50" min="10" max="600" step="1" style="flex:1;padding:10px 12px;border:2px solid #DFE6E9;border-radius:10px;font-size:0.9rem;outline:none;"><span style="font-size:0.8rem;color:#B2BEC3;">mm</span></div>'+
    '<div style="display:flex;gap:12px;margin-bottom:16px;align-items:center;"><label style="font-size:0.85rem;font-weight:600;color:#636E72;min-width:50px;">H</label><input type="number" id="modal-h-'+sid+'" value="50" min="10" max="600" step="1" style="flex:1;padding:10px 12px;border:2px solid #DFE6E9;border-radius:10px;font-size:0.9rem;outline:none;"><span style="font-size:0.8rem;color:#B2BEC3;">mm</span></div>'+
    '<div style="display:flex;gap:12px;margin-bottom:16px;align-items:center;"><label style="font-size:0.85rem;font-weight:600;color:#636E72;min-width:50px;">Copies</label><input type="number" id="modal-qty-'+sid+'" value="3" min="1" max="50" step="1" style="flex:1;padding:10px 12px;border:2px solid #DFE6E9;border-radius:10px;font-size:0.9rem;outline:none;"><span style="font-size:0.8rem;color:#B2BEC3;">pcs</span></div>'+
    '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:20px;">'+
      '<button id="modal-cancel-'+sid+'" style="padding:10px 24px;border-radius:10px;border:none;font-size:0.9rem;font-weight:600;cursor:pointer;background:#f5f5f5;color:#636E72;">Cancel</button>'+
      '<button id="modal-add-'+sid+'" disabled style="padding:10px 24px;border-radius:10px;border:none;font-size:0.9rem;font-weight:600;cursor:pointer;background:linear-gradient(135deg,#00CEC9,#00A8A3);color:#fff;">Add to Canvas</button></div></div>';
  document.body.appendChild(modalEl);
  var modalZone=document.getElementById('modal-zone-'+sid),modalFname=document.getElementById('modal-fname-'+sid);
  var modalW=document.getElementById('modal-w-'+sid),modalH=document.getElementById('modal-h-'+sid);
  var modalQty=document.getElementById('modal-qty-'+sid),modalAddBtn=document.getElementById('modal-add-'+sid),modalCancel=document.getElementById('modal-cancel-'+sid);

  document.getElementById('add-btn-'+sid).addEventListener('click',function(){modalFile=null;modalW.value=50;modalH.value=50;modalQty.value=3;modalAddBtn.disabled=true;modalFname.style.display='none';modalZone.querySelector('div:not([id])').textContent='Click to choose a design file';modalZone.querySelector('div:first-child').innerHTML='&#x1F5BC;';modalEl.style.display='flex';fileInput.value='';});
  modalZone.addEventListener('click',function(){fileInput.click();});
  modalCancel.addEventListener('click',function(){modalEl.style.display='none';});
  fileInput.addEventListener('change',function(){if(this.files.length){modalFile=this.files[0];modalFname.textContent=modalFile.name;modalFname.style.display='block';modalZone.querySelector('div:not([id])').textContent='File selected';modalZone.querySelector('div:first-child').innerHTML='&#x2705;';modalAddBtn.disabled=false;}});
  modalAddBtn.addEventListener('click',function(){if(!modalFile)return;var reader=new FileReader(),qty=parseInt(modalQty.value)||1,wMm=parseInt(modalW.value)||50,hMm=parseInt(modalH.value)||50;modalEl.style.display='none';reader.onload=function(e){for(var i=0;i<qty;i++){var item=addImageItem(e.target.result,false);item.w=wMm/600*(CANVAS_W);item.h=hMm/600*(CANVAS_W);item.el.style.width=item.w+'px';item.el.style.height=item.h+'px';}};reader.readAsDataURL(modalFile);growCanvas();});
  function handleFile(f){if(!f.type.match('image.*'))return;modalFile=f;modalFname.textContent=f.name;modalFname.style.display='block';modalZone.querySelector('div:not([id])').textContent='File selected';modalZone.querySelector('div:first-child').innerHTML='&#x2705;';modalAddBtn.disabled=false;if(modalEl)modalEl.style.display='flex';}

  canvas.addEventListener('drop',function(e){e.preventDefault();if(e.dataTransfer.files.length)handleFile(e.dataTransfer.files[0]);});
  canvas.addEventListener('dragover',function(e){e.preventDefault();});

  /* ── Quantity ── */
  document.getElementById('qty-down-'+sid).addEventListener('click',function(){var q=parseInt(qtyEl.textContent)||1;if(q>1)qtyEl.textContent=q-1;updatePrice();});
  document.getElementById('qty-up-'+sid).addEventListener('click',function(){qtyEl.textContent=(parseInt(qtyEl.textContent)||1)+1;updatePrice();});

  /* ── Size inputs ── */
  document.getElementById('w-input-'+sid).addEventListener('change',function(){saveState();var id=parseInt(selectedIds[0]),item=items.find(function(i){return i.id===id;});if(!item)return;item.w=Math.max(20,mmToPx(parseInt(this.value)||50));item.el.style.width=item.w+'px';updateSizeInfo(item);updatePrice();growCanvas();});
  document.getElementById('h-input-'+sid).addEventListener('change',function(){saveState();var id=parseInt(selectedIds[0]),item=items.find(function(i){return i.id===id;});if(!item)return;item.h=Math.max(20,mmToPx(parseInt(this.value)||50));item.el.style.height=item.h+'px';updateSizeInfo(item);updatePrice();growCanvas();});

  function updateCount(){var sel=selectedIds.length;countEl.textContent=items.length+' items'+(sel?' ('+sel+' selected)':'');}
  function updatePrice(){var qty=parseInt(qtyEl.textContent)||1;priceEl.textContent='$'+(basePrice*(items.length||1)*qty).toFixed(2);}

  /* ── Mobile toggle ── */
  var mobile=false;
  mobileBtn.addEventListener('click',function(){
    mobile=!mobile;mobile?wrap.requestFullscreen?.():document.fullscreenElement&&document.exitFullscreen?.();
    document.querySelector('.sticker-config-'+sid).classList.toggle('mobile-mode',mobile);
    mobileBtn.innerHTML=mobile?'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>':'<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>';
    setTimeout(function(){zoomToFit();},100);
  });

  /* ── Init ── */
  saveState(); zoomToFit(); drawGrid(); updatePrice(); updateSelection();
  canvas.style.cursor = textToolActive ? 'crosshair' : 'default';
  setInterval(function(){canvas.style.cursor=textToolActive?'crosshair':(selectedIds.length?'default':'default');},200);
})();
</script>

