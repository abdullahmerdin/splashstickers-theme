{% liquid
  assign current_collection = collection | default: closest.collection
  assign hero_heading = section.settings.heading | default: current_collection.title
%}

<section
  class="sticker-collection-hero sticker-collection-hero--{{ section.settings.layout }}"
  style="--collection-bg: {{ section.settings.background_color }}; --collection-primary: {{ section.settings.primary_color }}; --collection-secondary: {{ section.settings.secondary_color }}; --collection-pad-top: {{ section.settings.padding_top }}px; --collection-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="sticker-collection-hero__inner">
    <div class="sticker-collection-hero__content">
      <div class="sticker-collection-hero__brand" aria-label="AllTheStickers">
        <span class="sticker-collection-hero__brand-mark" aria-hidden="true"></span>
        <span>ALLTHESTICKERS</span>
      </div>

      {% if hero_heading != blank %}
        <h1>{{ hero_heading | escape }}</h1>
      {% endif %}
    </div>

    <div class="sticker-collection-hero__art" aria-hidden="true">
      <span class="sticker-collection-hero__splash-word">SPLASH</span>
      <span class="sticker-collection-hero__sticker sticker-collection-hero__sticker--pink">STICKERS</span>
      <span class="sticker-collection-hero__sticker sticker-collection-hero__sticker--gold">MAKE IT STICK</span>
      <span class="sticker-collection-hero__sticker sticker-collection-hero__sticker--teal">ALL DAY</span>
      <span class="sticker-collection-hero__art-meta">STICKER STUDIO / EST. 2024</span>
      <span class="sticker-collection-hero__dot sticker-collection-hero__dot--one"></span>
      <span class="sticker-collection-hero__dot sticker-collection-hero__dot--two"></span>
      <span class="sticker-collection-hero__dot sticker-collection-hero__dot--three"></span>
    </div>
  </div>
</section>

{% stylesheet %}
  .sticker-collection-hero {
    position: relative;
    overflow: hidden;
    border-top: 4px solid transparent;
    border-image: linear-gradient(90deg, #6c5ce7, #fd79a8, #fdcb6e, #00cec9) 1;
    background: var(--collection-bg);
    color: #2d3436;
    padding-block: var(--collection-pad-top) var(--collection-pad-bottom);
  }

  .sticker-collection-hero__inner {
    display: grid;
    width: min(100% - (var(--page-margin, 16px) * 2), var(--normal-page-width, 120rem));
    min-height: clamp(24rem, 48vw, 38rem);
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.9fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: center;
  }

  .sticker-collection-hero--right .sticker-collection-hero__content {
    order: 2;
  }

  .sticker-collection-hero--right .sticker-collection-hero__art {
    order: 1;
  }

  .sticker-collection-hero__brand {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--collection-primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .sticker-collection-hero__brand-mark {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50% 50% 50% 0;
    background: var(--collection-secondary);
    transform: rotate(-45deg);
  }

  .sticker-collection-hero h1 {
    max-width: 8ch;
    margin: 1.25rem 0 0;
    color: #2d3436;
    font-size: clamp(3.8rem, 9vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.09em;
    line-height: 0.82;
    text-wrap: balance;
  }

  .sticker-collection-hero__art {
    position: relative;
    min-height: clamp(20rem, 38vw, 31rem);
    overflow: hidden;
    border-radius: 2rem 2rem 2rem 0.5rem;
    background: linear-gradient(135deg, #6c5ce7 0%, #8d5eea 42%, #fd79a8 100%);
    box-shadow: 1rem 1rem 0 #fdcb6e;
    isolation: isolate;
  }

  .sticker-collection-hero__art::before,
  .sticker-collection-hero__art::after {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    content: '';
  }

  .sticker-collection-hero__art::before {
    top: -18%;
    right: -12%;
    width: 58%;
    aspect-ratio: 1;
    background: #00cec9;
    opacity: 0.85;
  }

  .sticker-collection-hero__art::after {
    bottom: -28%;
    left: -18%;
    width: 65%;
    aspect-ratio: 1;
    background: #fdcb6e;
    opacity: 0.9;
  }

  .sticker-collection-hero__splash-word {
    position: absolute;
    top: 9%;
    left: 7%;
    color: #fff;
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 0.8;
    opacity: 0.92;
    transform: rotate(-8deg);
  }

  .sticker-collection-hero__sticker {
    position: absolute;
    display: inline-block;
    border: 0.45rem solid #fff;
    border-radius: 999px;
    padding: 0.8rem 1.1rem;
    box-shadow: 0.35rem 0.45rem 0 rgb(45 52 54 / 22%);
    color: #2d3436;
    font-size: clamp(0.7rem, 1.2vw, 1rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
  }

  .sticker-collection-hero__sticker--pink {
    top: 38%;
    left: 9%;
    background: #fd79a8;
    transform: rotate(-12deg);
  }

  .sticker-collection-hero__sticker--gold {
    top: 57%;
    right: 8%;
    background: #fdcb6e;
    transform: rotate(8deg);
  }

  .sticker-collection-hero__sticker--teal {
    bottom: 13%;
    left: 24%;
    background: #00cec9;
    transform: rotate(-5deg);
  }

  .sticker-collection-hero__art-meta {
    position: absolute;
    right: 8%;
    bottom: 7%;
    color: #fff;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .sticker-collection-hero__dot {
    position: absolute;
    width: 0.65rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
  }

  .sticker-collection-hero__dot--one { top: 24%; right: 22%; }
  .sticker-collection-hero__dot--two { top: 29%; right: 16%; width: 0.35rem; }
  .sticker-collection-hero__dot--three { top: 34%; right: 25%; width: 0.45rem; }

  @media screen and (max-width: 749px) {
    .sticker-collection-hero { padding-block: 32px 44px; }
    .sticker-collection-hero__inner { display: flex; min-height: 0; flex-direction: column; gap: 2.5rem; align-items: stretch; }
    .sticker-collection-hero--right .sticker-collection-hero__content,
    .sticker-collection-hero--right .sticker-collection-hero__art { order: initial; }
    .sticker-collection-hero h1 { max-width: 9ch; margin-top: 1rem; font-size: clamp(3.5rem, 18vw, 6rem); }
    .sticker-collection-hero__art { min-height: 21rem; border-radius: 1.5rem 1.5rem 1.5rem 0.5rem; box-shadow: 0.65rem 0.65rem 0 #fdcb6e; }
    .sticker-collection-hero__splash-word { font-size: clamp(3rem, 16vw, 5.5rem); }
    .sticker-collection-hero__art-meta { font-size: 0.52rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticker collection hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title." },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "left", "label": "Heading left" }, { "value": "right", "label": "Heading right" }], "default": "left" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "primary_color", "label": "Primary brand color", "default": "#6c5ce7" },
    { "type": "color", "id": "secondary_color", "label": "Secondary brand color", "default": "#fd79a8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Sticker collection hero" }]
}
{% endschema %}
