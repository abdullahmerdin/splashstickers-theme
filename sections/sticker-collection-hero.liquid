{% liquid
  assign current_collection = collection | default: closest.collection
  assign hero_heading = section.settings.heading | default: current_collection.title
  assign splash_word = section.settings.splash_word
  if splash_word == blank
    assign splash_word = 'SPLASH'
  endif
  assign sticker_1_text = section.settings.sticker_1_text
  if sticker_1_text == blank
    assign sticker_1_text = 'STICKERS'
  endif
  assign sticker_1_color = section.settings.sticker_1_color
  if sticker_1_color == blank
    assign sticker_1_color = 'pink'
  endif
  assign sticker_2_text = section.settings.sticker_2_text
  if sticker_2_text == blank
    assign sticker_2_text = 'BADGES'
  endif
  assign sticker_2_color = section.settings.sticker_2_color
  if sticker_2_color == blank
    assign sticker_2_color = 'gold'
  endif
  assign sticker_3_text = section.settings.sticker_3_text
  if sticker_3_text == blank
    assign sticker_3_text = 'TEXTILE'
  endif
  assign sticker_3_color = section.settings.sticker_3_color
  if sticker_3_color == blank
    assign sticker_3_color = 'teal'
  endif
  assign art_meta_text = section.settings.art_meta_text
  if art_meta_text == blank
    assign art_meta_text = 'EST. 2026'
  endif
%}

<section
  class="sticker-collection-hero sticker-collection-hero--{{ section.settings.layout }}"
  data-splash-card-copy-version="2026-08-03-r2"
  style="--collection-bg: {{ section.settings.background_color }}; --collection-primary: {{ section.settings.primary_color }}; --collection-secondary: {{ section.settings.secondary_color }}; --collection-art-bg: {{ section.settings.art_background_color }}; --collection-art-accent: {{ section.settings.art_accent_color }}; --collection-pattern: {{ section.settings.pattern_color }}; --collection-pad-top: {{ section.settings.padding_top }}px; --collection-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="sticker-collection-hero__inner">
    <div class="sticker-collection-hero__content">
      {% if section.settings.show_brand and section.settings.brand_text != blank %}
        <div class="sticker-collection-hero__brand" aria-label="{{ section.settings.brand_text | escape }}">
          <span class="sticker-collection-hero__brand-mark" aria-hidden="true"></span>
          <span>{{ section.settings.brand_text | escape }}</span>
        </div>
      {% endif %}

      {% if section.settings.show_heading and hero_heading != blank %}
        <h1>{{ hero_heading | escape }}</h1>
      {% endif %}
    </div>

    <div class="sticker-collection-hero__art" aria-hidden="true">
      {% if section.settings.pattern_style != 'none' %}
        <span class="sticker-collection-hero__pattern sticker-collection-hero__pattern--{{ section.settings.pattern_style }}"></span>
      {% endif %}

      <div class="sticker-collection-hero__copy-layer">
        <span class="sticker-collection-hero__splash-word">{{ splash_word | escape }}</span>

        <span class="sticker-collection-hero__sticker sticker-collection-hero__sticker--one sticker-collection-hero__sticker--{{ sticker_1_color }}">{{ sticker_1_text | escape }}</span>
        <span class="sticker-collection-hero__sticker sticker-collection-hero__sticker--two sticker-collection-hero__sticker--{{ sticker_2_color }}">{{ sticker_2_text | escape }}</span>
        <span class="sticker-collection-hero__sticker sticker-collection-hero__sticker--three sticker-collection-hero__sticker--{{ sticker_3_color }}">{{ sticker_3_text | escape }}</span>

        <span class="sticker-collection-hero__art-meta">{{ art_meta_text | escape }}</span>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
  .sticker-collection-hero {
    position: relative;
    overflow: hidden;
    background: var(--collection-bg);
    color: var(--splash-color-ink);
    padding-block: var(--collection-pad-top) var(--collection-pad-bottom);
  }

  .sticker-collection-hero__inner {
    display: grid;
    width: min(100% - (var(--page-margin, 16px) * 2), var(--normal-page-width, 120rem));
    min-height: clamp(24rem, 48vw, 38rem);
    margin-inline: auto;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.9fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: center;
  }

  .sticker-collection-hero--right .sticker-collection-hero__content { order: 2; }
  .sticker-collection-hero--right .sticker-collection-hero__art { order: 1; }

  .sticker-collection-hero__brand {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
    color: var(--collection-primary);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .sticker-collection-hero__brand-mark {
    display: block;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50% 50% 50% 0;
    background: var(--collection-secondary);
    transform: rotate(-45deg);
  }

  .sticker-collection-hero h1 {
    max-width: 8ch;
    margin: 1.25rem 0 0;
    color: var(--splash-color-ink);
    font-size: clamp(3.8rem, 9vw, 9rem);
    font-weight: 900;
    letter-spacing: -0.09em;
    line-height: 0.82;
    text-wrap: balance;
  }

  .sticker-collection-hero__art {
    position: relative;
    min-height: clamp(20rem, 38vw, 31rem);
    overflow: hidden;
    border-radius: 2rem 2rem 2rem 0.5rem;
    background: linear-gradient(135deg, var(--collection-art-bg), var(--collection-art-accent));
    box-shadow: 1rem 1rem 0 var(--splash-color-yellow);
    isolation: isolate;
    user-select: none;
    -webkit-user-select: none;
  }

  .sticker-collection-hero__art::before,
  .sticker-collection-hero__art::after {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    content: '';
  }

  .sticker-collection-hero__art::before {
    top: -18%;
    right: -12%;
    width: 58%;
    aspect-ratio: 1;
    background: var(--splash-color-teal);
    opacity: 0.85;
  }

  .sticker-collection-hero__art::after {
    bottom: -28%;
    left: -18%;
    width: 65%;
    aspect-ratio: 1;
    background: var(--splash-color-yellow);
    opacity: 0.9;
  }

  .sticker-collection-hero__pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.22;
  }

  .sticker-collection-hero__pattern--dots {
    background-image: radial-gradient(circle, var(--collection-pattern) 1px, transparent 1.5px);
    background-size: 18px 18px;
  }

  .sticker-collection-hero__pattern--grid {
    background-image: linear-gradient(var(--collection-pattern) 1px, transparent 1px), linear-gradient(90deg, var(--collection-pattern) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .sticker-collection-hero__pattern--bursts {
    background-image: repeating-conic-gradient(from 0deg, var(--collection-pattern) 0deg 8deg, transparent 8deg 18deg);
    mask-image: radial-gradient(circle at center, #000 0 55%, transparent 80%);
  }

  .sticker-collection-hero__copy-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .sticker-collection-hero__splash-word {
    position: absolute;
    top: 9%;
    left: 7%;
    z-index: 1;
    color: var(--splash-color-surface);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 900;
    letter-spacing: -0.1em;
    line-height: 0.8;
    opacity: 0.92;
    transform: rotate(-8deg);
  }

  .sticker-collection-hero__sticker {
    position: absolute;
    display: inline-block;
    border: 0.45rem solid var(--splash-color-surface);
    border-radius: 999px;
    padding: 0.8rem 1.1rem;
    box-shadow: 0.35rem 0.45rem 0 rgb(var(--splash-color-ink-rgb) / 22%);
    color: var(--splash-color-ink);
    font-size: clamp(0.7rem, 1.2vw, 1rem);
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    white-space: nowrap;
    z-index: 1;
    will-change: transform;
  }

  .sticker-collection-hero__sticker--pink { background: var(--splash-color-pink); }
  .sticker-collection-hero__sticker--gold { background: var(--splash-color-yellow); }
  .sticker-collection-hero__sticker--teal { background: var(--splash-color-teal); }
  .sticker-collection-hero__sticker--one { top: 38%; left: 9%; animation: sticker-float-one 5.5s ease-in-out infinite; }
  .sticker-collection-hero__sticker--two { top: 57%; right: 8%; animation: sticker-float-two 6.2s ease-in-out -1.6s infinite; }
  .sticker-collection-hero__sticker--three { bottom: 13%; left: 24%; animation: sticker-float-three 5.8s ease-in-out -0.8s infinite; }

  .sticker-collection-hero__art-meta {
    position: absolute;
    right: 8%;
    bottom: 7%;
    z-index: 1;
    color: var(--splash-color-surface);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  @keyframes sticker-float-one {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-12deg); }
    50% { transform: translate3d(0.45rem, -0.75rem, 0) rotate(-6deg); }
  }

  @keyframes sticker-float-two {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(8deg); }
    50% { transform: translate3d(-0.55rem, 0.65rem, 0) rotate(14deg); }
  }

  @keyframes sticker-float-three {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-5deg); }
    50% { transform: translate3d(0.4rem, -0.5rem, 0) rotate(2deg); }
  }

  @media screen and (max-width: 749px) {
    .sticker-collection-hero { padding-block: 32px 44px; }
    .sticker-collection-hero__inner { display: flex; min-height: 0; flex-direction: column; gap: 2.5rem; align-items: stretch; }
    .sticker-collection-hero--right .sticker-collection-hero__content,
    .sticker-collection-hero--right .sticker-collection-hero__art { order: initial; }
    .sticker-collection-hero h1 { max-width: 9ch; margin-top: 1rem; font-size: clamp(3.5rem, 18vw, 6rem); }
    .sticker-collection-hero__art { min-height: 21rem; border-radius: 1.5rem 1.5rem 1.5rem 0.5rem; box-shadow: 0.65rem 0.65rem 0 var(--splash-color-yellow); }
    .sticker-collection-hero__splash-word { font-size: clamp(3rem, 16vw, 5.5rem); }
    .sticker-collection-hero__art-meta { font-size: 0.52rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticker-collection-hero__sticker { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticker collection hero",
  "settings": [
    { "type": "checkbox", "id": "show_brand", "label": "Show brand lockup", "default": true },
    { "type": "text", "id": "brand_text", "label": "Brand text", "default": "Splash Stickers" },
    { "type": "checkbox", "id": "show_heading", "label": "Show collection heading", "default": true },
    { "type": "text", "id": "heading", "label": "Collection heading", "info": "Leave blank to use the collection title." },
    { "type": "header", "content": "Card text" },
    { "type": "checkbox", "id": "show_splash_word", "label": "Show accent word", "default": true },
    { "type": "text", "id": "splash_word", "label": "Accent word", "default": "" },
    { "type": "header", "content": "Sticker labels" },
    { "type": "checkbox", "id": "show_sticker_1", "label": "Show sticker 1", "default": true },
    { "type": "text", "id": "sticker_1_text", "label": "Sticker 1 text", "default": "STICKERS" },
    { "type": "select", "id": "sticker_1_color", "label": "Sticker 1 color", "options": [{ "value": "pink", "label": "Pink" }, { "value": "gold", "label": "Gold" }, { "value": "teal", "label": "Teal" }], "default": "pink" },
    { "type": "checkbox", "id": "show_sticker_2", "label": "Show sticker 2", "default": true },
    { "type": "text", "id": "sticker_2_text", "label": "Sticker 2 text", "default": "MAKE IT STICK" },
    { "type": "select", "id": "sticker_2_color", "label": "Sticker 2 color", "options": [{ "value": "pink", "label": "Pink" }, { "value": "gold", "label": "Gold" }, { "value": "teal", "label": "Teal" }], "default": "gold" },
    { "type": "checkbox", "id": "show_sticker_3", "label": "Show sticker 3", "default": true },
    { "type": "text", "id": "sticker_3_text", "label": "Sticker 3 text", "default": "ALL DAY" },
    { "type": "select", "id": "sticker_3_color", "label": "Sticker 3 color", "options": [{ "value": "pink", "label": "Pink" }, { "value": "gold", "label": "Gold" }, { "value": "teal", "label": "Teal" }], "default": "teal" },
    { "type": "checkbox", "id": "show_art_meta", "label": "Show card meta text", "default": true },
    { "type": "text", "id": "art_meta_text", "label": "Card meta text", "default": "" },
    { "type": "select", "id": "pattern_style", "label": "Card pattern", "options": [{ "value": "dots", "label": "Dots" }, { "value": "grid", "label": "Grid" }, { "value": "bursts", "label": "Bursts" }, { "value": "none", "label": "No pattern" }], "default": "dots" },
    { "type": "color", "id": "pattern_color", "label": "Pattern color", "default": "#ffffff" },
    { "type": "header", "content": "Layout and color" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "left", "label": "Heading left" }, { "value": "right", "label": "Heading right" }], "default": "left" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "primary_color", "label": "Primary brand color", "default": "#6c5ce7" },
    { "type": "color", "id": "secondary_color", "label": "Secondary brand color", "default": "#fd79a8" },
    { "type": "color", "id": "art_background_color", "label": "Card background", "default": "#6c5ce7" },
    { "type": "color", "id": "art_accent_color", "label": "Card accent", "default": "#fd79a8" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "Sticker collection hero" }]
}
{% endschema %}
