{% liquid
  assign current_collection = collection | default: closest.collection
  assign hero_heading = section.settings.heading | default: current_collection.title
  assign hero_description = section.settings.subtext | default: current_collection.description
  assign hero_link = section.settings.cta_link | default: current_collection.url
%}

<section class="sticker-collection-hero sticker-collection-hero--{{ section.settings.layout }}" style="--hero-bg: {{ section.settings.background_color }}; --hero-accent: {{ section.settings.accent_color }}; --hero-panel: {{ section.settings.panel_background_color }}; --hero-pad-top: {{ section.settings.padding_top }}px; --hero-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="sticker-collection-hero__inner page-width">
    <div class="sticker-collection-hero__content">
      {% if section.settings.status_label != blank %}<p class="sticker-collection-hero__status">{{ section.settings.status_label | escape }}</p>{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="sticker-collection-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if hero_heading != blank %}<h1>{{ hero_heading | escape }}</h1>{% endif %}
      {% if hero_description != blank %}<div class="sticker-collection-hero__description rte">{{ hero_description }}</div>{% endif %}

      <div class="sticker-collection-hero__chips">
        {% for index in (1..3) %}
          {% assign chip_id = 'chip_' | append: index %}
          {% if section.settings[chip_id] != blank %}<span>{{ section.settings[chip_id] | escape }}</span>{% endif %}
        {% endfor %}
      </div>
      {% if section.settings.cta_label != blank %}<a class="sticker-collection-hero__cta" href="{{ hero_link }}">{{ section.settings.cta_label | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
    </div>

    <div class="sticker-collection-hero__panel">
      {% if section.settings.panel_label != blank %}<p class="sticker-collection-hero__label">{{ section.settings.panel_label | escape }}</p>{% endif %}
      {% if section.settings.panel_heading != blank %}<h2>{{ section.settings.panel_heading | escape }}</h2>{% endif %}
      {% if section.settings.panel_text != blank %}<p>{{ section.settings.panel_text | escape }}</p>{% endif %}
      <div class="sticker-collection-hero__list">
        {% for index in (1..3) %}
          {% assign item_id = 'panel_item_' | append: index %}
          {% if section.settings[item_id] != blank %}<div><b>0{{ index }}</b><span>{{ section.settings[item_id] | escape }}</span></div>{% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .sticker-collection-hero { background: radial-gradient(circle at 90% 0%, color-mix(in srgb, var(--hero-accent) 18%, transparent), transparent 38%), var(--hero-bg); padding-block: var(--hero-pad-top) var(--hero-pad-bottom); }
  .sticker-collection-hero__inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(280px, .8fr); gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .sticker-collection-hero--right .sticker-collection-hero__content { order: 2; }
  .sticker-collection-hero--right .sticker-collection-hero__panel { order: 1; }
  .sticker-collection-hero__status, .sticker-collection-hero__eyebrow, .sticker-collection-hero__label { margin: 0 0 .75rem; color: var(--hero-accent); font-size: .72rem; font-weight: 700; letter-spacing: .16em; line-height: 1.2; text-transform: uppercase; }
  .sticker-collection-hero__status { display: inline-flex; border: 1px solid color-mix(in srgb, var(--hero-accent) 45%, transparent); border-radius: 999px; padding: .45rem .7rem; }
  .sticker-collection-hero h1 { max-width: 9ch; margin: 0; font-size: clamp(3.2rem, 8vw, 7.5rem); letter-spacing: -.08em; line-height: .88; }
  .sticker-collection-hero__description { max-width: 42rem; margin-top: 1.5rem; font-size: 1.08rem; }
  .sticker-collection-hero__chips { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; }
  .sticker-collection-hero__chips span { border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 999px; padding: .55rem .8rem; font-size: .78rem; }
  .sticker-collection-hero__cta { display: inline-flex; gap: .7rem; align-items: center; margin-top: 2rem; border-bottom: 1px solid currentColor; padding-bottom: .35rem; font-weight: 700; text-decoration: none; }
  .sticker-collection-hero__panel { border: 1px solid color-mix(in srgb, currentColor 18%, transparent); border-radius: 1.25rem; background: var(--hero-panel); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: 0 1.5rem 4rem color-mix(in srgb, var(--hero-accent) 10%, transparent); }
  .sticker-collection-hero__panel h2 { margin: 0; font-size: clamp(1.7rem, 3vw, 2.6rem); letter-spacing: -.05em; line-height: .95; }
  .sticker-collection-hero__panel > p:not(.sticker-collection-hero__label) { margin: 1rem 0 0; opacity: .72; }
  .sticker-collection-hero__list { margin-top: 2rem; }
  .sticker-collection-hero__list div { display: flex; gap: 1rem; align-items: baseline; border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent); padding: .85rem 0; font-size: .9rem; }
  .sticker-collection-hero__list b { color: var(--hero-accent); font-size: .7rem; letter-spacing: .12em; }
  @media screen and (max-width: 749px) { .sticker-collection-hero__inner { grid-template-columns: 1fr; gap: 2.5rem; } .sticker-collection-hero--right .sticker-collection-hero__content, .sticker-collection-hero--right .sticker-collection-hero__panel { order: initial; } .sticker-collection-hero h1 { max-width: 11ch; font-size: clamp(3.2rem, 17vw, 6rem); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticker collection hero",
  "settings": [
    { "type": "text", "id": "status_label", "label": "Status label", "default": "Built for the way you make" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the collection title." },
    { "type": "richtext", "id": "subtext", "label": "Description", "info": "Leave blank to use the collection description." },
    { "type": "text", "id": "chip_1", "label": "Highlight 1", "default": "Made to order" },
    { "type": "text", "id": "chip_2", "label": "Highlight 2", "default": "Low minimums" },
    { "type": "text", "id": "chip_3", "label": "Highlight 3", "default": "Fast proofing" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave blank to link to this collection." },
    { "type": "header", "content": "Side panel" },
    { "type": "text", "id": "panel_label", "label": "Panel label", "default": "At a glance" },
    { "type": "text", "id": "panel_heading", "label": "Panel heading", "default": "Choose the finish that fits the job." },
    { "type": "textarea", "id": "panel_text", "label": "Panel text", "default": "Start with the format, then dial in the details." },
    { "type": "text", "id": "panel_item_1", "label": "Panel item 1", "default": "Pick your surface" },
    { "type": "text", "id": "panel_item_2", "label": "Panel item 2", "default": "Set size and quantity" },
    { "type": "text", "id": "panel_item_3", "label": "Panel item 3", "default": "Approve your proof" },
    { "type": "header", "content": "Layout and color" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "left", "label": "Content left" }, { "value": "right", "label": "Content right" }], "default": "left" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f2eee7" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#d34f32" },
    { "type": "color", "id": "panel_background_color", "label": "Panel background", "default": "#fffaf2" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Sticker collection hero" }]
}
{% endschema %}
