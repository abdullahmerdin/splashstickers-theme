{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{% style %}
  .sticker-categories-section {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  .sticker-categories-section .sticker-categories-scroll {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    padding: 0;
  }

  .sticker-categories-section .sticker-category-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 18px;
    border: var(--splash-border-width) solid rgb(var(--splash-color-ink-rgb) / 0.12);
    border-radius: var(--splash-radius-control);
    background: rgb(var(--splash-color-surface-rgb) / 0.92);
    color: var(--splash-color-ink);
    text-decoration: none;
    transition: transform var(--splash-transition), border-color var(--splash-transition), box-shadow var(--splash-transition);
  }

  .sticker-categories-section .sticker-category-card:hover {
    transform: translateY(-1px);
    border-color: rgb(var(--splash-color-purple-rgb) / 0.35);
    box-shadow: 0 10px 24px rgb(var(--splash-color-ink-rgb) / 0.06);
  }

  .sticker-categories-section .sticker-category-dot {
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 999px;
    background: var(--splash-color-purple);
  }

  .sticker-categories-section .sticker-category-card--purple .sticker-category-dot {
    background: var(--splash-color-purple);
  }

  .sticker-categories-section .sticker-category-card--pink .sticker-category-dot {
    background: var(--splash-color-pink);
  }

  .sticker-categories-section .sticker-category-card--gold .sticker-category-dot {
    background: var(--splash-color-yellow);
  }

  .sticker-categories-section .sticker-category-card--teal .sticker-category-dot {
    background: var(--splash-color-teal);
  }

  .sticker-categories-section .sticker-category-label {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .sticker-categories-section .sticker-section-empty {
    padding: 32px 20px;
    color: var(--splash-color-muted);
    text-align: center;
  }

  .sticker-categories-section :is(.sticker-category-card, .sticker-category-card):focus-visible {
    outline: var(--splash-focus-width) solid var(--splash-color-focus);
    outline-offset: 4px;
  }

  @media (max-width: 749px) {
    .sticker-categories-section .sticker-categories-scroll {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 6px;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
    }

    .sticker-categories-section .sticker-category-card {
      scroll-snap-align: start;
      flex: 0 0 auto;
    }
  }
{% endstyle %}

<div class="sticker-categories-section color-custom-{{ section.id }}">
  {% # theme-check-disable-next-line ValidScopedCSSClass %}
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <header class="sticker-section-heading">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subtext != blank %}<p>{{ section.settings.subtext }}</p>{% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="sticker-categories-scroll" role="list">
        {% for block in section.blocks %}
          {% if block.settings.link != blank %}
            <a
              class="sticker-category-card sticker-category-card--{{ block.settings.color_style }}"
              href="{{ block.settings.link }}"
              aria-label="{{ block.settings.label | escape }}"
              role="listitem"
              {{ block.shopify_attributes }}
            >
              <span class="sticker-category-dot" aria-hidden="true"></span>
              {% if block.settings.label != blank %}
                <span class="sticker-category-label">{{ block.settings.label }}</span>
              {% endif %}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <p class="sticker-section-empty">Add categories in the theme editor to get started.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Category Links",
  "tag": "section",
  "class": "sticker-categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Find the format that fits your design." },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link", "info": "Link to a collection or page" },
        {
          "type": "select",
          "id": "color_style",
          "label": "Color style",
          "options": [
            { "value": "teal", "label": "Teal" },
            { "value": "purple", "label": "Purple" },
            { "value": "pink", "label": "Pink" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "teal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Links",
      "category": "Custom",
      "blocks": [
        { "type": "category", "settings": { "label": "Die Cut", "color_style": "purple" } },
        { "type": "category", "settings": { "label": "UV DTF", "color_style": "teal" } },
        { "type": "category", "settings": { "label": "UV", "color_style": "pink" } },
        { "type": "category", "settings": { "label": "Magnet", "color_style": "gold" } }
      ]
    }
  ]
}
{% endschema %}
