{%- liquid
  assign section_heading = section.settings.heading
  assign section_subtext = section.settings.subtext
  assign columns = section.settings.columns | times: 1
  assign circle_size = section.settings.circle_size | append: 'px'
  assign background_color = section.settings.background_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<div
  class="sticker-categories-section"
  style="background-color: {{ background_color }}; padding-top: {{ padding_top }}px; padding-bottom: {{ padding_bottom }}px;"
>
  <div class="page-width">
    {% if section_heading != blank %}
      <div style="text-align: center; padding: 0 20px 8px;">
        <h2>{{ section_heading }}</h2>
        {% if section_subtext != blank %}
          <p style="color: #636E72; margin: 4px 0 0;">{{ section_subtext }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="sticker-categories-scroll"
        style="justify-content: center; padding: 24px 20px 0; gap: {{ section.settings.gap }}px;"
      >
        {% for block in section.blocks %}
          {%- liquid
            assign icon = block.settings.icon
            assign label = block.settings.label
            assign link = block.settings.link
            assign color_style = block.settings.color_style
          -%}
          <div
            class="sticker-category-card"
            style="cursor: {% if link != blank %}pointer{% else %}default{% endif %};"
            {% if link != blank %}
              onclick="window.location.href='{{ link }}'"
              role="link"
              tabindex="0"
              onkeydown="if(event.key==='Enter')window.location.href='{{ link }}'"
            {% endif %}
          >
            <div class="sticker-category-circle {{ color_style }}" style="width: {{ circle_size }}; height: {{ circle_size }}; font-size: calc({{ circle_size }} * 0.4);">
              {{ icon }}
            </div>
            {% if label != blank %}
              <span class="sticker-category-label">{{ label }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div style="text-align: center; padding: 40px 20px; color: #636E72;">
        <p>Add categories in the theme editor to get started.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Sticker Categories",
  "tag": "section",
  "class": "sticker-categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Find your perfect sticker vibe"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "circle_size",
      "label": "Circle size (px)",
      "min": 60,
      "max": 140,
      "step": 10,
      "default": 100
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items (px)",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 16
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji / Icon",
          "default": "🐾",
          "info": "Use an emoji or short text"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Link to collection or page"
        },
        {
          "type": "select",
          "id": "color_style",
          "label": "Color style",
          "options": [
            { "value": "teal", "label": "Teal (primary)" },
            { "value": "purple", "label": "Purple" },
            { "value": "pink", "label": "Pink" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "teal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticker Categories",
      "category": "Custom",
      "blocks": [
        { "type": "category", "settings": { "icon": "🐾", "label": "Animals", "color_style": "teal" } },
        { "type": "category", "settings": { "icon": "🌸", "label": "Nature", "color_style": "pink" } },
        { "type": "category", "settings": { "icon": "✨", "label": "Quotes", "color_style": "gold" } },
        { "type": "category", "settings": { "icon": "🎨", "label": "Aesthetic", "color_style": "purple" } },
        { "type": "category", "settings": { "icon": "🎮", "label": "Gaming", "color_style": "teal" } }
      ]
    }
  ]
}
{% endschema %}
