{%- liquid
  assign circle_size = section.settings.circle_size | append: 'px'
-%}

<div
  class="sticker-categories-section"
  style="--category-size: {{ circle_size }}; --category-gap: {{ section.settings.gap }}px; background-color: {{ section.settings.background_color }}; padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <header class="sticker-section-heading">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subtext != blank %}<p>{{ section.settings.subtext }}</p>{% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="sticker-categories-scroll" role="list">
        {% for block in section.blocks %}
          {% if block.settings.link != blank %}
            <a
              class="sticker-category-card"
              href="{{ block.settings.link }}"
              aria-label="{{ block.settings.label | escape }}"
              role="listitem"
              {{ block.shopify_attributes }}
            >
          {% else %}
            <div class="sticker-category-card" role="listitem" {{ block.shopify_attributes }}>
          {% endif %}
            <div class="sticker-category-circle {{ block.settings.color_style }}">
              <span aria-hidden="true">{{ block.settings.icon }}</span>
            </div>
            {% if block.settings.label != blank %}
              <span class="sticker-category-label">{{ block.settings.label }}</span>
            {% endif %}
          {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}
        {% endfor %}
      </div>
    {% else %}
      <p class="sticker-section-empty">Add categories in the theme editor to get started.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Sticker Categories",
  "tag": "section",
  "class": "sticker-categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Find your perfect sticker vibe" },
    { "type": "range", "id": "circle_size", "label": "Circle size", "min": 60, "max": 140, "step": 10, "unit": "px", "default": 100 },
    { "type": "range", "id": "gap", "label": "Gap between items", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji / icon", "default": "🐾", "info": "Use an emoji or short text" },
        { "type": "text", "id": "label", "label": "Label", "default": "Category" },
        { "type": "url", "id": "link", "label": "Link", "info": "Link to a collection or page" },
        {
          "type": "select",
          "id": "color_style",
          "label": "Color style",
          "options": [
            { "value": "teal", "label": "Teal" },
            { "value": "purple", "label": "Purple" },
            { "value": "pink", "label": "Pink" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "teal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticker Categories",
      "category": "Custom",
      "blocks": [
        { "type": "category", "settings": { "icon": "🐾", "label": "Animals", "color_style": "teal" } },
        { "type": "category", "settings": { "icon": "🌸", "label": "Nature", "color_style": "pink" } },
        { "type": "category", "settings": { "icon": "✨", "label": "Quotes", "color_style": "gold" } },
        { "type": "category", "settings": { "icon": "🎨", "label": "Aesthetic", "color_style": "purple" } },
        { "type": "category", "settings": { "icon": "🎮", "label": "Gaming", "color_style": "teal" } }
      ]
    }
  ]
}
{% endschema %}
