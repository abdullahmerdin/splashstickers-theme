{% liquid
  assign layout = section.settings.layout | default: 'hub'
  assign guide_key = section.settings.guide_key | default: 'auto'
  assign current_page_handle = page.handle | default: ''
  assign product_guides = 'die_cut,magnet,uv_dtf,uv,emboss,textile' | split: ','
  assign site_guides = 'configurator,background_removal,browse_and_choose,cart_and_checkout,contact_and_help' | split: ','

  if layout == 'guide' and current_page_handle != blank
    assign page_guide_key = current_page_handle | remove_first: 'how-it-works-'
    if page_guide_key != current_page_handle
      assign guide_key = page_guide_key | replace: '-', '_'
    endif
  endif

  if layout == 'guide' and guide_key == 'auto'
    assign guide_key = 'configurator'
  endif

  assign is_product_guide = false
  if product_guides contains guide_key
    assign is_product_guide = true
  endif

  assign guide_kind = 'site'
  if is_product_guide
    assign guide_kind = 'products'
  endif

  assign has_directory_card_blocks = false
  assign has_guide_step_blocks = false
  assign has_visible_guide_step_blocks = false
  for block in section.blocks
    if block.type == 'directory_card'
      assign has_directory_card_blocks = true
    endif
    if block.type == 'guide_step'
      assign has_guide_step_blocks = true
      if block.settings.title != blank or block.settings.text != blank
        assign has_visible_guide_step_blocks = true
      endif
    endif
  endfor

  assign hub_eyebrow = section.settings.hub_eyebrow
  assign hub_title = section.settings.hub_title
  assign hub_intro = section.settings.hub_intro
  assign hub_products_label = section.settings.hub_products_label
  assign hub_products_title = section.settings.hub_products_title
  assign hub_products_text = section.settings.hub_products_text
  assign hub_products_url = section.settings.hub_products_url
  assign hub_site_label = section.settings.hub_site_label
  assign hub_site_title = section.settings.hub_site_title
  assign hub_site_text = section.settings.hub_site_text
  assign hub_site_url = section.settings.hub_site_url
  assign hub_card_link_label = section.settings.hub_card_link_label
  assign quick_eyebrow = section.settings.quick_eyebrow
  assign quick_title = section.settings.quick_title
  assign quick_text = section.settings.quick_text
  assign quick_step_one = section.settings.quick_step_one
  assign quick_step_two = section.settings.quick_step_two
  assign quick_step_three = section.settings.quick_step_three
%}

{{ 'how-it-works.css' | asset_url | stylesheet_tag }}

<section class="how-it-works how-it-works--{{ layout }}" data-how-it-works-layout="{{ layout }}">
  <div class="how-it-works__inner page-width">
    {% case layout %}
      {% when 'hub' %}
        {% if hub_eyebrow != blank or hub_title != blank or hub_intro != blank %}
          <header class="how-it-works__hero">
            {% if hub_eyebrow != blank %}
              <p class="how-it-works__eyebrow">{{ hub_eyebrow | escape }}</p>
            {% endif %}
            {% if hub_title != blank %}
              <h1>{{ hub_title | escape }}</h1>
            {% endif %}
            {% if hub_intro != blank %}
              <p class="how-it-works__intro">{{ hub_intro | escape }}</p>
            {% endif %}
          </header>
        {% endif %}

        {% if hub_products_label != blank or hub_products_title != blank or hub_products_text != blank or hub_card_link_label != blank or hub_site_label != blank or hub_site_title != blank or hub_site_text != blank %}
          <div class="how-it-works__hub-grid">
            {% if hub_products_label != blank or hub_products_title != blank or hub_products_text != blank or hub_card_link_label != blank %}
              <a class="how-it-works__hub-card"{% if hub_products_url != blank %} href="{{ hub_products_url | escape }}"{% endif %}>
                <span class="how-it-works__card-index" aria-hidden="true">01</span>
                {% if hub_products_label != blank %}
                  <span class="how-it-works__hub-card-label">{{ hub_products_label | escape }}</span>
                {% endif %}
                {% if hub_products_title != blank %}
                  <h2>{{ hub_products_title | escape }}</h2>
                {% endif %}
                {% if hub_products_text != blank %}
                  <p>{{ hub_products_text | escape }}</p>
                {% endif %}
                {% if hub_card_link_label != blank %}
                  <span class="how-it-works__card-link">{{ hub_card_link_label | escape }} <span aria-hidden="true">&rarr;</span></span>
                {% endif %}
              </a>
            {% endif %}

            {% if hub_site_label != blank or hub_site_title != blank or hub_site_text != blank or hub_card_link_label != blank %}
              <a class="how-it-works__hub-card how-it-works__hub-card--site"{% if hub_site_url != blank %} href="{{ hub_site_url | escape }}"{% endif %}>
                <span class="how-it-works__card-index" aria-hidden="true">02</span>
                {% if hub_site_label != blank %}
                  <span class="how-it-works__hub-card-label">{{ hub_site_label | escape }}</span>
                {% endif %}
                {% if hub_site_title != blank %}
                  <h2>{{ hub_site_title | escape }}</h2>
                {% endif %}
                {% if hub_site_text != blank %}
                  <p>{{ hub_site_text | escape }}</p>
                {% endif %}
                {% if hub_card_link_label != blank %}
                  <span class="how-it-works__card-link">{{ hub_card_link_label | escape }} <span aria-hidden="true">&rarr;</span></span>
                {% endif %}
              </a>
            {% endif %}
          </div>
        {% endif %}

        {% if quick_eyebrow != blank or quick_title != blank or quick_text != blank or quick_step_one != blank or quick_step_two != blank or quick_step_three != blank %}
          <div class="how-it-works__quick-path">
            {% if quick_eyebrow != blank or quick_title != blank or quick_text != blank %}
              <div>
                {% if quick_eyebrow != blank %}
                  <p class="how-it-works__eyebrow">{{ quick_eyebrow | escape }}</p>
                {% endif %}
                {% if quick_title != blank %}
                  <h2>{{ quick_title | escape }}</h2>
                {% endif %}
                {% if quick_text != blank %}
                  <p>{{ quick_text | escape }}</p>
                {% endif %}
              </div>
            {% endif %}
            {% if quick_step_one != blank or quick_step_two != blank or quick_step_three != blank %}
              <ol class="how-it-works__quick-list">
                {% if quick_step_one != blank %}
                  <li><span>01</span>{{ quick_step_one | escape }}</li>
                {% endif %}
                {% if quick_step_two != blank %}
                  <li><span>02</span>{{ quick_step_two | escape }}</li>
                {% endif %}
                {% if quick_step_three != blank %}
                  <li><span>03</span>{{ quick_step_three | escape }}</li>
                {% endif %}
              </ol>
            {% endif %}
          </div>
        {% endif %}

      {% when 'products', 'site' %}
        {% if layout == 'products' %}
          {% assign directory_items = product_guides %}
        {% else %}
          {% assign directory_items = site_guides %}
        {% endif %}

        {% assign directory_back_label = section.settings.directory_back_label %}
        {% assign directory_eyebrow = section.settings.directory_eyebrow %}
        {% assign directory_title = section.settings.directory_title %}
        {% assign directory_intro = section.settings.directory_intro %}
        {% if directory_back_label != blank or directory_eyebrow != blank or directory_title != blank or directory_intro != blank %}
          <header class="how-it-works__hero how-it-works__hero--directory">
            {% if directory_back_label != blank %}
              <a class="how-it-works__back-link" href="{{ routes.root_url }}pages/how-it-works">&larr; {{ directory_back_label | escape }}</a>
            {% endif %}
            {% if directory_eyebrow != blank %}
              <p class="how-it-works__eyebrow">{{ directory_eyebrow | escape }}</p>
            {% endif %}
            {% if directory_title != blank %}
              <h1>{{ directory_title | escape }}</h1>
            {% endif %}
            {% if directory_intro != blank %}
              <p class="how-it-works__intro">{{ directory_intro | escape }}</p>
            {% endif %}
          </header>
        {% endif %}

        <div class="how-it-works__directory-grid" role="list">
          {% if has_directory_card_blocks %}
            {% for block in section.blocks %}
              {% if block.type == 'directory_card' %}
                {% assign item = block.settings.guide_key %}
                {% assign item_art = '' %}
                {% case item %}
                  {% when 'die_cut' %}
                    {% assign item_art = 'splash-product-die-cut-sticker.png' %}
                  {% when 'magnet' %}
                    {% assign item_art = 'splash-product-magnet-fridge.png' %}
                  {% when 'uv_dtf' %}
                    {% assign item_art = 'splash-product-uv-dtf-mug.png' %}
                  {% when 'uv' %}
                    {% assign item_art = 'splash-product-uv-phone-case.png' %}
                  {% when 'emboss' %}
                    {% assign item_art = 'splash-product-emboss-notebook.png' %}
                  {% when 'textile' %}
                    {% assign item_art = 'splash-product-textile-t-shirt.png' %}
                {% endcase %}
                {% if directory_items contains item %}
                  {% assign item_title = block.settings.title %}
                  {% assign item_summary = block.settings.summary %}
                  {% assign item_link = block.settings.link %}
                  {% assign item_link_label = block.settings.link_label %}
                  {% if item_title != blank or item_summary != blank or item_link_label != blank %}
                    <a
                      class="how-it-works__directory-card{% if item_art != blank %} how-it-works__directory-card--has-art{% endif %}"
                      {% if item_link != blank %}href="{{ item_link | escape }}"{% endif %}
                      role="listitem"
                      {{ block.shopify_attributes }}
                    >
                      {% if item_art != blank %}
                        <img
                          class="how-it-works__directory-card-art"
                          src="{{ item_art | asset_url }}"
                          alt=""
                          width="1254"
                          height="1254"
                          loading="lazy"
                          decoding="async"
                          aria-hidden="true"
                        >
                      {% endif %}
                      {% if item_title != blank %}
                        <h2>{{ item_title | escape }}</h2>
                      {% endif %}
                      {% if item_summary != blank %}
                        <p>{{ item_summary | escape }}</p>
                      {% endif %}
                      {% if item_link_label != blank %}
                        <span class="how-it-works__card-link">{{ item_link_label | escape }} <span aria-hidden="true">&rarr;</span></span>
                      {% endif %}
                    </a>
                  {% endif %}
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

      {% when 'guide' %}
        {% assign guide_title = section.settings.guide_title %}
        {% assign guide_intro = section.settings.guide_intro %}
        {% assign guide_kind_label = section.settings.guide_kind_label %}
        {% assign guide_what_title = section.settings.guide_what_title %}
        {% assign guide_what_text = section.settings.guide_what_text %}
        {% assign guide_best_title = section.settings.guide_best_title %}
        {% assign guide_best_text = section.settings.guide_best_text %}
        {% assign guide_steps_eyebrow = section.settings.guide_steps_eyebrow %}
        {% assign guide_steps_title = section.settings.guide_steps_title %}
        {% assign guide_note_eyebrow = section.settings.guide_note_eyebrow %}
        {% assign guide_note_title = section.settings.guide_note_title %}
        {% assign guide_note_text = section.settings.guide_note_text %}
        {% assign guide_cta_label = section.settings.guide_cta_label %}
        {% assign guide_cta_url = section.settings.guide_cta_url %}
        {% assign guide_all_label = section.settings.guide_all_label %}
        {% assign guide_status_label = section.settings.guide_status_label %}
        {% if section.settings.guide_show_status == false %}
          {% assign guide_status_label = blank %}
        {% endif %}

        {% if guide_kind_label != blank or guide_title != blank or guide_intro != blank or guide_status_label != blank %}
          <header class="how-it-works__hero how-it-works__hero--guide">
            {% if guide_kind_label != blank or guide_title != blank %}
              <nav class="how-it-works__breadcrumbs" aria-label="{{ 'how_it_works.common.breadcrumb_label' | t }}">
                <a href="{{ routes.root_url }}pages/how-it-works">{{ 'how_it_works.common.eyebrow' | t }}</a>
                <span aria-hidden="true">/</span>
                {% if guide_kind_label != blank %}
                  <a href="{{ routes.root_url }}pages/how-it-works-{{ guide_kind }}">{{ guide_kind_label | escape }}</a>
                {% endif %}
                <span aria-hidden="true">/</span>
                {% if guide_title != blank %}
                  <span aria-current="page">{{ guide_title | escape }}</span>
                {% endif %}
              </nav>
            {% endif %}
            {% if guide_kind_label != blank or guide_status_label != blank %}
              <div class="how-it-works__guide-heading-line">
                {% if guide_kind_label != blank %}
                  <p class="how-it-works__eyebrow">{{ guide_kind_label | escape }}</p>
                {% endif %}
                {% if guide_key == 'background_removal' and guide_status_label != blank %}
                  <span class="how-it-works__status">{{ guide_status_label | escape }}</span>
                {% endif %}
              </div>
            {% endif %}
            {% if guide_title != blank %}
              <h1>{{ guide_title | escape }}</h1>
            {% endif %}
            {% if guide_intro != blank %}
              <p class="how-it-works__intro">{{ guide_intro | escape }}</p>
            {% endif %}
          </header>
        {% endif %}

        {% if guide_what_title != blank or guide_what_text != blank or guide_best_title != blank or guide_best_text != blank %}
          <div class="how-it-works__overview">
            {% if guide_what_title != blank or guide_what_text != blank %}
              <article class="how-it-works__overview-card">
                <span class="how-it-works__overview-label">01</span>
                {% if guide_what_title != blank %}
                  <h2>{{ guide_what_title | escape }}</h2>
                {% endif %}
                {% if guide_what_text != blank %}
                  <p>{{ guide_what_text | escape }}</p>
                {% endif %}
              </article>
            {% endif %}
            {% if guide_best_title != blank or guide_best_text != blank %}
              <article class="how-it-works__overview-card">
                <span class="how-it-works__overview-label">02</span>
                {% if guide_best_title != blank %}
                  <h2>{{ guide_best_title | escape }}</h2>
                {% endif %}
                {% if guide_best_text != blank %}
                  <p>{{ guide_best_text | escape }}</p>
                {% endif %}
              </article>
            {% endif %}
          </div>
        {% endif %}

        {% if guide_steps_eyebrow != blank or guide_steps_title != blank or has_visible_guide_step_blocks %}
          {% if guide_steps_title != blank %}
            <section class="how-it-works__steps" aria-labelledby="how-it-works-steps-{{ section.id }}">
          {% else %}
            <section class="how-it-works__steps">
          {% endif %}
            <div class="how-it-works__section-heading">
              {% if guide_steps_eyebrow != blank %}
                <p class="how-it-works__eyebrow">{{ guide_steps_eyebrow | escape }}</p>
              {% endif %}
              {% if guide_steps_title != blank %}
                <h2 id="how-it-works-steps-{{ section.id }}">{{ guide_steps_title | escape }}</h2>
              {% endif %}
            </div>
            <ol class="how-it-works__steps-grid">
              {% if has_guide_step_blocks %}
                {% for block in section.blocks %}
                  {% if block.type == 'guide_step' %}
                    {% assign step_index = block.settings.step_index | default: forloop.index %}
                    {% assign step_title = block.settings.title %}
                    {% assign step_text = block.settings.text %}
                    {% if step_title != blank or step_text != blank %}
                      <li class="how-it-works__step" {{ block.shopify_attributes }}>
                        <span class="how-it-works__step-number" aria-hidden="true">{{ step_index | prepend: '0' }}</span>
                        {% if step_title != blank %}
                          <h3>{{ step_title | escape }}</h3>
                        {% endif %}
                        {% if step_text != blank %}
                          <p>{{ step_text | escape }}</p>
                        {% endif %}
                      </li>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              {% endif %}
            </ol>
          </section>
        {% endif %}

        {% if guide_note_eyebrow != blank or guide_note_title != blank or guide_note_text != blank %}
          <aside class="how-it-works__note">
            <div>
              {% if guide_note_eyebrow != blank %}
                <p class="how-it-works__eyebrow">{{ guide_note_eyebrow | escape }}</p>
              {% endif %}
              {% if guide_note_title != blank %}
                <h2>{{ guide_note_title | escape }}</h2>
              {% endif %}
              {% if guide_note_text != blank %}
                <p>{{ guide_note_text | escape }}</p>
              {% endif %}
            </div>
            <span class="how-it-works__note-mark" aria-hidden="true">&#10022;</span>
          </aside>
        {% endif %}

        {% if guide_cta_label != blank and guide_cta_url != blank %}
          <div class="how-it-works__guide-actions">
            <a class="how-it-works__button" href="{{ guide_cta_url | escape }}">{{ guide_cta_label | escape }}</a>
            {% if guide_all_label != blank %}
              <a class="how-it-works__text-link" href="{{ routes.root_url }}pages/how-it-works-{{ guide_kind }}">{{ guide_all_label | escape }}</a>
            {% endif %}
          </div>
        {% elsif guide_all_label != blank %}
          <div class="how-it-works__guide-actions">
            <a class="how-it-works__text-link" href="{{ routes.root_url }}pages/how-it-works-{{ guide_kind }}">{{ guide_all_label | escape }}</a>
          </div>
        {% endif %}
    {% endcase %}
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "class": "how-it-works-section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Page layout",
      "options": [
        { "value": "hub", "label": "Hub" },
        { "value": "products", "label": "Products directory" },
        { "value": "site", "label": "Site directory" },
        { "value": "guide", "label": "Guide" }
      ],
      "default": "hub"
    },
    {
      "type": "select",
      "id": "guide_key",
      "label": "Guide fallback",
      "info": "Guide pages detect their content from the page handle. This value is used in the theme editor preview when no matching handle is available.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "die_cut", "label": "Die Cut" },
        { "value": "magnet", "label": "Magnet" },
        { "value": "uv_dtf", "label": "UV DTF" },
        { "value": "uv", "label": "UV" },
        { "value": "emboss", "label": "Emboss" },
        { "value": "textile", "label": "Textile" },
        { "value": "configurator", "label": "Configurator" },
        { "value": "background_removal", "label": "Background removal" },
        { "value": "browse_and_choose", "label": "Browse and choose" },
        { "value": "cart_and_checkout", "label": "Cart and checkout" },
        { "value": "contact_and_help", "label": "Contact and help" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Hub content"
    },
    {
      "type": "text",
      "id": "hub_eyebrow",
      "label": "Hub eyebrow",
      "info": "Leave blank to hide this child."
    },
    {
      "type": "text",
      "id": "hub_title",
      "label": "Hub title"
    },
    {
      "type": "textarea",
      "id": "hub_intro",
      "label": "Hub intro"
    },
    {
      "type": "text",
      "id": "hub_products_label",
      "label": "Products card label"
    },
    {
      "type": "text",
      "id": "hub_products_title",
      "label": "Products card title"
    },
    {
      "type": "textarea",
      "id": "hub_products_text",
      "label": "Products card text"
    },
    {
      "type": "url",
      "id": "hub_products_url",
      "label": "Products card link"
    },
    {
      "type": "text",
      "id": "hub_site_label",
      "label": "Site card label"
    },
    {
      "type": "text",
      "id": "hub_site_title",
      "label": "Site card title"
    },
    {
      "type": "textarea",
      "id": "hub_site_text",
      "label": "Site card text"
    },
    {
      "type": "url",
      "id": "hub_site_url",
      "label": "Site card link"
    },
    {
      "type": "text",
      "id": "hub_card_link_label",
      "label": "Hub card link label"
    },
    {
      "type": "text",
      "id": "quick_eyebrow",
      "label": "Quick path eyebrow"
    },
    {
      "type": "text",
      "id": "quick_title",
      "label": "Quick path title"
    },
    {
      "type": "textarea",
      "id": "quick_text",
      "label": "Quick path text"
    },
    {
      "type": "text",
      "id": "quick_step_one",
      "label": "Quick path step 1"
    },
    {
      "type": "text",
      "id": "quick_step_two",
      "label": "Quick path step 2"
    },
    {
      "type": "text",
      "id": "quick_step_three",
      "label": "Quick path step 3"
    },
    {
      "type": "header",
      "content": "Directory content"
    },
    {
      "type": "text",
      "id": "directory_back_label",
      "label": "Back link label"
    },
    {
      "type": "text",
      "id": "directory_eyebrow",
      "label": "Directory eyebrow"
    },
    {
      "type": "text",
      "id": "directory_title",
      "label": "Directory title"
    },
    {
      "type": "textarea",
      "id": "directory_intro",
      "label": "Directory intro"
    },
    {
      "type": "header",
      "content": "Guide content"
    },
    {
      "type": "text",
      "id": "guide_title",
      "label": "Guide title"
    },
    {
      "type": "textarea",
      "id": "guide_intro",
      "label": "Guide intro"
    },
    {
      "type": "text",
      "id": "guide_kind_label",
      "label": "Guide category label"
    },
    {
      "type": "text",
      "id": "guide_what_title",
      "label": "What it is title"
    },
    {
      "type": "textarea",
      "id": "guide_what_text",
      "label": "What it is text"
    },
    {
      "type": "text",
      "id": "guide_best_title",
      "label": "Good fit title"
    },
    {
      "type": "textarea",
      "id": "guide_best_text",
      "label": "Good fit text"
    },
    {
      "type": "text",
      "id": "guide_steps_eyebrow",
      "label": "Steps eyebrow"
    },
    {
      "type": "text",
      "id": "guide_steps_title",
      "label": "Steps title"
    },
    {
      "type": "text",
      "id": "guide_note_eyebrow",
      "label": "Note eyebrow"
    },
    {
      "type": "text",
      "id": "guide_note_title",
      "label": "Note title"
    },
    {
      "type": "textarea",
      "id": "guide_note_text",
      "label": "Note text"
    },
    {
      "type": "text",
      "id": "guide_cta_label",
      "label": "Primary CTA label"
    },
    {
      "type": "url",
      "id": "guide_cta_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "guide_all_label",
      "label": "All guides link label"
    },
    {
      "type": "text",
      "id": "guide_status_label",
      "label": "Planned status label",
      "info": "Leave blank to hide the planned status on Background removal."
    }
  ],
  "blocks": [
    {
      "type": "directory_card",
      "name": "Directory card",
      "settings": [
        {
          "type": "select",
          "id": "guide_key",
          "label": "Guide",
          "options": [
            { "value": "die_cut", "label": "Die Cut" },
            { "value": "magnet", "label": "Magnet" },
            { "value": "uv_dtf", "label": "UV DTF" },
            { "value": "uv", "label": "UV" },
            { "value": "emboss", "label": "Emboss" },
            { "value": "textile", "label": "Textile" },
            { "value": "configurator", "label": "Configurator" },
            { "value": "background_removal", "label": "Background removal" },
