{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign gradient_start = section.settings.gradient_start
  assign gradient_end = section.settings.gradient_end
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign button_style = section.settings.button_style
-%}

<div
  class="splash-cta-section"
  style="background: linear-gradient(135deg, {{ gradient_start }}, {{ gradient_end }}); padding: {{ padding_top }}px 20px {{ padding_bottom }}px; text-align: center; position: relative;"
>
  <splash-cta-stickers class="splash-cta-stickers" aria-hidden="true">
    <canvas data-sticker-ropes></canvas>
    <img
      src="{{ 'cherry.svg' | asset_url }}"
      class="splash-cta-sticker splash-cta-sticker--one"
      data-sticker
      data-x="0.06"
      data-y="0.18"
      alt=""
      draggable="false"
    >
    <img
      src="{{ 'bear.svg' | asset_url }}"
      class="splash-cta-sticker splash-cta-sticker--two"
      data-sticker
      data-x="0.78"
      data-y="0.48"
      alt=""
      draggable="false"
    >
    <img
      src="{{ 'deer.svg' | asset_url }}"
      class="splash-cta-sticker splash-cta-sticker--three"
      data-sticker
      data-x="0.35"
      data-y="0.70"
      alt=""
      draggable="false"
    >
  </splash-cta-stickers>

  <div class="page-width">
    {% if heading != blank %}
      <h2 style="font-size: 2.5rem; color: {{ heading_color }}; margin: 0 0 12px; line-height: 1.2;">
        {{ heading | escape }}
      </h2>
    {% endif %}

    {% if subtext != blank %}
      <p style="font-size: 1.1rem; color: {{ text_color }}; margin: 0 auto 32px; max-width: 500px;">
        {{ subtext | escape }}
      </p>
    {% endif %}

    {% if button_label != blank and button_link != blank %}
      <a
        href="{{ button_link }}"
        class="splash-cta-button splash-cta-button--{{ button_style }}"
      >
        {{ button_label | escape }}
      </a>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .splash-cta-section {
    overflow: hidden;
  }

  .splash-cta-section > .page-width {
    position: relative;
    z-index: 2;
  }

  .splash-cta-stickers {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    overflow: hidden;
    pointer-events: none;
  }

  .splash-cta-stickers canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .splash-cta-sticker {
    position: absolute;
    width: clamp(68px, 8vw, 96px);
    height: auto;
    cursor: grab;
    user-select: none;
    pointer-events: auto;
    touch-action: none;
    filter: drop-shadow(0 8px 10px rgb(31 41 55 / 18%));
    transform: rotate(-3deg);
    transition: filter 0.18s ease, transform 0.18s ease;
  }

  .splash-cta-sticker--one { animation: splash-cta-sticker-float-one 5.5s ease-in-out infinite; }
  .splash-cta-sticker--two { animation: splash-cta-sticker-float-two 6.2s ease-in-out -1.6s infinite; }
  .splash-cta-sticker--three { animation: splash-cta-sticker-float-three 5.8s ease-in-out -0.8s infinite; }

  .splash-cta-sticker:hover,
  .splash-cta-sticker.is-dragging {
    z-index: 3;
    cursor: grabbing;
    filter: drop-shadow(5px 8px 12px rgb(31 41 55 / 30%));
    transform: scale(0.96) rotate(5deg);
    animation-play-state: paused;
  }

  @keyframes splash-cta-sticker-float-one {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-8px) rotate(3deg); }
  }

  @keyframes splash-cta-sticker-float-two {
    0%, 100% { transform: translateY(0) rotate(4deg); }
    50% { transform: translateY(9px) rotate(-3deg); }
  }

  @keyframes splash-cta-sticker-float-three {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-7px) rotate(2deg); }
  }

  @media (max-width: 749px) {
    .splash-cta-sticker {
      width: clamp(58px, 18vw, 76px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-cta-sticker {
      animation: none;
      transition: none;
    }
  }
{% endstylesheet %}

<script src="{{ 'splash-cta-stickers.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Splash CTA Banner",
  "tag": "section",
  "class": "splash-cta",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create Your Own Sticker"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Upload any design and we'll turn it into a premium, die-cut sticker. Free proof included!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Designing"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid (white bg on gradient)" },
        { "value": "outline", "label": "Outline (transparent)" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "default": "#00CEC9"
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "default": "#6C5CE7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Splash CTA Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
