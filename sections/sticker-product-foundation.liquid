{% liquid
  assign current_product = product | default: closest.product
  assign mockup_image = section.settings.mockup_image | default: current_product.featured_image
  assign foundation_heading = section.settings.heading | default: current_product.title
  assign mockup_alt = mockup_image.alt | default: foundation_heading
%}

<section class="sticker-product-foundation sticker-product-foundation--{{ section.settings.layout }}" style="--foundation-bg: {{ section.settings.background_color }}; --foundation-accent: {{ section.settings.accent_color }}; --foundation-secondary: {{ section.settings.secondary_accent_color }}; --foundation-pad-top: {{ section.settings.padding_top }}px; --foundation-pad-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="sticker-product-foundation__inner page-width">
    <div class="sticker-product-foundation__mockup">
      {% if mockup_image != blank %}
        {{ mockup_image | image_url: width: 1400 | image_tag: loading: 'lazy', class: 'sticker-product-foundation__image', alt: mockup_alt }}
      {% else %}
        <div class="sticker-product-foundation__placeholder"><span>MOCKUP</span><span>{{ foundation_heading | escape }}</span></div>
      {% endif %}
      {% if section.settings.mockup_caption != blank %}<p class="sticker-product-foundation__caption">{{ section.settings.mockup_caption | escape }}</p>{% endif %}
    </div>

    <div class="sticker-product-foundation__content">
      {% if section.settings.status_label != blank %}<p class="sticker-product-foundation__status">{{ section.settings.status_label | escape }}</p>{% endif %}
      {% if section.settings.eyebrow != blank %}<p class="sticker-product-foundation__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if foundation_heading != blank %}<h2>{{ foundation_heading | escape }}</h2>{% endif %}
      {% if section.settings.subtext != blank %}<div class="sticker-product-foundation__intro rte">{{ section.settings.subtext }}</div>{% endif %}

      <div class="sticker-product-foundation__tutorial">
        <p class="sticker-product-foundation__label">{{ section.settings.tutorial_title | escape }}</p>
        <ol>
          {% for index in (1..3) %}
            {% assign step_id = 'tutorial_step_' | append: index %}
            {% if section.settings[step_id] != blank %}<li><span>0{{ index }}</span>{{ section.settings[step_id] | escape }}</li>{% endif %}
          {% endfor %}
        </ol>
      </div>

      <div class="sticker-product-foundation__options">
        <p class="sticker-product-foundation__label">{{ section.settings.options_title | escape }}</p>
        <div class="sticker-product-foundation__option-grid">
          {% for index in (1..3) %}
            {% assign title_id = 'option_' | append: index | append: '_title' %}
            {% assign text_id = 'option_' | append: index | append: '_text' %}
            {% if section.settings[title_id] != blank or section.settings[text_id] != blank %}<div class="sticker-product-foundation__option"><strong>{{ section.settings[title_id] | escape }}</strong><span>{{ section.settings[text_id] | escape }}</span></div>{% endif %}
          {% endfor %}
        </div>
      </div>

      {% if section.settings.sample_pack_title != blank or section.settings.sample_pack_text != blank %}
        <div class="sticker-product-foundation__sample-pack">
          <div><p class="sticker-product-foundation__label">Sample pack</p><h3>{{ section.settings.sample_pack_title | escape }}</h3><p>{{ section.settings.sample_pack_text | escape }}</p></div>
          {% if section.settings.sample_pack_button_label != blank %}<a href="{{ section.settings.sample_pack_button_link | default: '/collections/all' }}">{{ section.settings.sample_pack_button_label | escape }} <span aria-hidden="true">&rarr;</span></a>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .sticker-product-foundation { background: linear-gradient(135deg, var(--foundation-bg), color-mix(in srgb, var(--foundation-secondary) 10%, var(--foundation-bg))); padding-block: var(--foundation-pad-top) var(--foundation-pad-bottom); }
  .sticker-product-foundation__inner { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(2rem, 7vw, 7rem); align-items: start; }
  .sticker-product-foundation--right .sticker-product-foundation__mockup { order: 2; }
  .sticker-product-foundation--right .sticker-product-foundation__content { order: 1; }
  .sticker-product-foundation__mockup { position: sticky; top: 2rem; overflow: hidden; border-radius: 1.25rem; background: color-mix(in srgb, var(--foundation-secondary) 16%, transparent); }
  .sticker-product-foundation__image { display: block; width: 100%; aspect-ratio: 1 / 1.08; object-fit: cover; }
  .sticker-product-foundation__placeholder { display: grid; min-height: 24rem; place-content: center; gap: .75rem; padding: 2rem; color: var(--foundation-accent); text-align: center; }
  .sticker-product-foundation__placeholder span:first-child { font-size: .7rem; font-weight: 700; letter-spacing: .18em; }
  .sticker-product-foundation__placeholder span:last-child { font-size: clamp(1.5rem, 4vw, 3.25rem); font-weight: 700; letter-spacing: -.06em; line-height: .95; }
  .sticker-product-foundation__caption { margin: 0; padding: .8rem 1rem; font-size: .75rem; opacity: .7; }
  .sticker-product-foundation__status, .sticker-product-foundation__eyebrow, .sticker-product-foundation__label { margin: 0 0 .65rem; color: var(--foundation-accent); font-size: .72rem; font-weight: 700; letter-spacing: .15em; line-height: 1.2; text-transform: uppercase; }
  .sticker-product-foundation__status { display: inline-flex; border: 1px solid color-mix(in srgb, var(--foundation-accent) 45%, transparent); border-radius: 999px; padding: .45rem .7rem; }
  .sticker-product-foundation h2 { max-width: 12ch; margin: 0; font-size: clamp(2.5rem, 6vw, 5.5rem); letter-spacing: -.08em; line-height: .88; }
  .sticker-product-foundation__intro { max-width: 42rem; margin-top: 1.25rem; opacity: .78; }
  .sticker-product-foundation__tutorial, .sticker-product-foundation__options { margin-top: 2.5rem; }
  .sticker-product-foundation ol { display: grid; gap: .7rem; margin: 0; padding: 0; list-style: none; }
  .sticker-product-foundation li { display: flex; gap: 1rem; align-items: baseline; border-top: 1px solid color-mix(in srgb, currentColor 16%, transparent); padding: .85rem 0; }
  .sticker-product-foundation li span { min-width: 1.5rem; color: var(--foundation-accent); font-size: .7rem; font-weight: 700; letter-spacing: .12em; }
  .sticker-product-foundation__option-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
  .sticker-product-foundation__option { display: grid; gap: .5rem; min-height: 8rem; border: 1px solid color-mix(in srgb, currentColor 16%, transparent); border-radius: .8rem; padding: 1rem; }
  .sticker-product-foundation__option span { align-self: end; font-size: .78rem; opacity: .65; }
  .sticker-product-foundation__sample-pack { display: flex; gap: 1rem; align-items: end; justify-content: space-between; margin-top: 2.5rem; border-radius: .8rem; background: var(--foundation-secondary); color: var(--foundation-bg); padding: 1.25rem; }
  .sticker-product-foundation__sample-pack .sticker-product-foundation__label { color: inherit; opacity: .65; }
  .sticker-product-foundation__sample-pack h3, .sticker-product-foundation__sample-pack p { margin: 0; }
  .sticker-product-foundation__sample-pack h3 { font-size: 1.2rem; }
  .sticker-product-foundation__sample-pack p:not(.sticker-product-foundation__label) { margin-top: .35rem; font-size: .8rem; opacity: .72; }
  .sticker-product-foundation__sample-pack a { flex-shrink: 0; border-bottom: 1px solid currentColor; padding-bottom: .25rem; color: inherit; font-size: .8rem; font-weight: 700; text-decoration: none; }
  @media screen and (max-width: 749px) { .sticker-product-foundation__inner { grid-template-columns: 1fr; gap: 2rem; } .sticker-product-foundation--right .sticker-product-foundation__mockup, .sticker-product-foundation--right .sticker-product-foundation__content { order: initial; } .sticker-product-foundation__mockup { position: static; } .sticker-product-foundation__option-grid { grid-template-columns: 1fr; } .sticker-product-foundation__option { min-height: auto; } .sticker-product-foundation__sample-pack { align-items: start; flex-direction: column; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticker product foundation",
  "settings": [
    { "type": "image_picker", "id": "mockup_image", "label": "Mockup image", "info": "Leave blank to use the product featured image." },
    { "type": "text", "id": "mockup_caption", "label": "Mockup caption", "default": "Use this space for a real production or application image." },
    { "type": "text", "id": "status_label", "label": "Status label", "default": "Product playbook" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Know what you are ordering" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the product title." },
    { "type": "richtext", "id": "subtext", "label": "Intro", "default": "<p>A clear production brief helps you choose the right finish, size and quantity before you check out.</p>" },
    { "type": "header", "content": "Tutorial" },
    { "type": "text", "id": "tutorial_title", "label": "Tutorial label", "default": "How it works" },
    { "type": "text", "id": "tutorial_step_1", "label": "Step 1", "default": "Choose your material and finish" },
    { "type": "text", "id": "tutorial_step_2", "label": "Step 2", "default": "Upload artwork or send a brief" },
    { "type": "text", "id": "tutorial_step_3", "label": "Step 3", "default": "Approve the proof and we produce it" },
    { "type": "header", "content": "Options" },
    { "type": "text", "id": "options_title", "label": "Options label", "default": "Choose your setup" },
    { "type": "text", "id": "option_1_title", "label": "Option 1 title", "default": "Size" },
    { "type": "text", "id": "option_1_text", "label": "Option 1 text", "default": "Small to statement" },
    { "type": "text", "id": "option_2_title", "label": "Option 2 title", "default": "Quantity" },
    { "type": "text", "id": "option_2_text", "label": "Option 2 text", "default": "Samples to bulk" },
    { "type": "text", "id": "option_3_title", "label": "Option 3 title", "default": "Surface" },
    { "type": "text", "id": "option_3_text", "label": "Option 3 text", "default": "Pick your application" },
    { "type": "header", "content": "Sample pack" },
    { "type": "text", "id": "sample_pack_title", "label": "Sample pack title", "default": "Try the finishes first." },
    { "type": "textarea", "id": "sample_pack_text", "label": "Sample pack text", "default": "A low-risk way to compare materials, color and feel." },
    { "type": "text", "id": "sample_pack_button_label", "label": "Sample pack button", "default": "See sample packs" },
    { "type": "url", "id": "sample_pack_button_link", "label": "Sample pack link" },
    { "type": "header", "content": "Layout and color" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "left", "label": "Mockup left" }, { "value": "right", "label": "Mockup right" }], "default": "left" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f2eee7" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#d34f32" },
    { "type": "color", "id": "secondary_accent_color", "label": "Secondary accent", "default": "#253b35" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Sticker product foundation" }]
}
{% endschema %}
