<section class="asset-attribution-section">
  <div class="asset-attribution-section__inner page-width">
    <details class="asset-attribution">
      <summary>Icon attribution</summary>
      <div class="asset-attribution__content">
        <p>
          Hand swipe by Suncheli Project from
          <a
            href="https://thenounproject.com/icon/hand-swipe-4864496/"
            target="_blank"
            rel="noopener noreferrer"
          >Noun Project</a>
          (<a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener noreferrer">CC BY 3.0</a>).
        </p>
      </div>
    </details>
  </div>
</section>

{% stylesheet %}
  .asset-attribution-section {
    padding-block: 1.5rem 3rem;
  }

  .asset-attribution-section__inner {
    max-width: 52rem;
  }

  .asset-attribution {
    border-block: 1px solid rgb(31 41 55 / 16%);
  }

  .asset-attribution summary {
    display: flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.85rem;
    color: rgb(31 41 55 / 78%);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    list-style: none;
  }

  .asset-attribution summary::-webkit-details-marker {
    display: none;
  }

  .asset-attribution summary::after {
    content: '+';
    color: rgb(31 41 55 / 52%);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1;
  }

  .asset-attribution[open] summary::after {
    content: '-';
  }

  .asset-attribution__content {
    padding: 0 0 1rem;
    color: rgb(31 41 55 / 66%);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .asset-attribution__content p {
    margin: 0;
  }

  .asset-attribution__content a {
    color: inherit;
    text-underline-offset: 0.18em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Asset attribution",
  "tag": "section",
  "class": "asset-attribution",
  "settings": [],
  "presets": [
    {
      "name": "Asset attribution"
    }
  ]
}
{% endschema %}
