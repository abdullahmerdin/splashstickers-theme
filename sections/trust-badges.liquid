<div
  class="trust-badges-section"
  style="background-color: {{ section.settings.background_color }}; padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <header class="sticker-section-heading">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subtext != blank %}<p>{{ section.settings.subtext }}</p>{% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="trust-badges-grid" style="--trust-columns: {{ section.settings.columns_desktop }};">
        {% for block in section.blocks %}
          <article class="trust-badge" {{ block.shopify_attributes }}>
            <div class="trust-badge-icon {{ block.settings.color_style }}" aria-hidden="true">{{ block.settings.icon }}</div>
            <h3 class="trust-badge-title">{{ block.settings.title }}</h3>
            <div class="trust-badge-desc">{{ block.settings.description }}</div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <p class="sticker-section-empty">Add trust badges in the theme editor.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "trust-badges",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why choose us" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Everything you need for stickers that look great and last." },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji / icon", "default": "🎨" },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Short description of this feature" },
        {
          "type": "select",
          "id": "color_style",
          "label": "Icon color",
          "options": [
            { "value": "teal", "label": "Teal" },
            { "value": "purple", "label": "Purple" },
            { "value": "pink", "label": "Pink" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "teal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "category": "Custom",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🎨", "title": "Premium quality", "description": "Vibrant colors, durable vinyl and a weatherproof finish.", "color_style": "teal" } },
        { "type": "badge", "settings": { "icon": "⚡", "title": "Fast turnaround", "description": "Clear production updates from upload to dispatch.", "color_style": "pink" } },
        { "type": "badge", "settings": { "icon": "✂️", "title": "Custom shapes", "description": "Die-cut to fit your artwork and chosen size.", "color_style": "purple" } },
        { "type": "badge", "settings": { "icon": "🌍", "title": "Worldwide shipping", "description": "Delivery options shown clearly at checkout.", "color_style": "gold" } }
      ]
    }
  ]
}
{% endschema %}
