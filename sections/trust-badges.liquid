<div
  class="trust-badges-section"
  style="background-color: {{ section.settings.background_color }}; padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;"
>
  {% # theme-check-disable-next-line ValidScopedCSSClass %}
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <header class="sticker-section-heading">
        <h2>{{ section.settings.heading }}</h2>
        {% if section.settings.subtext != blank %}<p>{{ section.settings.subtext }}</p>{% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="trust-badges-grid" style="--trust-columns: {{ section.settings.columns_desktop }};">
        {% for block in section.blocks %}
          <article class="trust-badge trust-badge--{{ block.settings.color_style }}" {{ block.shopify_attributes }}>
            <h3 class="trust-badge-title">{{ block.settings.title }}</h3>
            <div class="trust-badge-desc">{{ block.settings.description }}</div>
          </article>
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <p class="sticker-section-empty">Add product details in the theme editor.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Product details",
  "tag": "section",
  "class": "trust-badges",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product options" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Choose the details that fit your order." },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Detail",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "" },
        {
          "type": "select",
          "id": "color_style",
          "label": "Accent",
          "options": [
            { "value": "teal", "label": "Teal" },
            { "value": "purple", "label": "Purple" },
            { "value": "pink", "label": "Pink" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "teal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product details",
      "category": "Custom",
      "blocks": [
        { "type": "badge", "settings": { "title": "Upload a design", "description": "Add a PNG, JPG or WebP file.", "color_style": "teal" } },
        { "type": "badge", "settings": { "title": "Choose size and quantity", "description": "Set dimensions, copies, and spacing.", "color_style": "pink" } },
        { "type": "badge", "settings": { "title": "Review before checkout", "description": "Check the order details before you add them to your cart.", "color_style": "purple" } }
      ]
    }
  ]
}
{% endschema %}
