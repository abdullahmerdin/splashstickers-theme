{%- liquid
  assign heading = section.settings.heading
  assign columns_desktop = section.settings.columns_desktop | times: 1
  assign background_color = section.settings.background_color
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

<div
  class="trust-badges-section"
  style="background-color: {{ background_color }}; padding: {{ padding_top }}px 20px {{ padding_bottom }}px;"
>
  <div class="page-width">
    {% if heading != blank %}
      <h2 style="text-align: center; margin: 0 0 32px;">{{ heading }}</h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div style="display: grid; grid-template-columns: repeat({{ columns_desktop }}, 1fr); gap: 24px;">
        {% for block in section.blocks %}
          {%- liquid
            assign icon = block.settings.icon
            assign title = block.settings.title
            assign description = block.settings.description
            assign color_style = block.settings.color_style
          -%}
          <div class="trust-badge">
            <div class="trust-badge-icon {{ color_style }}">{{ icon }}</div>
            <div class="trust-badge-title">{{ title }}</div>
            <div class="trust-badge-desc">{{ description }}</div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div style="text-align: center; padding: 20px; color: #636E72;">
        <p>Add trust badges in the theme editor.</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "trust-badges",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why SplashStickers"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji / Icon",
          "default": "🎨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Short description of this feature"
        },
        {
          "type": "select",
          "id": "color_style",
          "label": "Icon color",
          "options": [
            { "value": "teal", "label": "Teal" },
            { "value": "purple", "label": "Purple" },
            { "value": "pink", "label": "Pink" },
            { "value": "gold", "label": "Gold" }
          ],
          "default": "teal"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "category": "Custom",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🎨", "title": "Premium Quality", "description": "Vibrant colors, durable vinyl, weatherproof finish", "color_style": "teal" } },
        { "type": "badge", "settings": { "icon": "⚡", "title": "Fast Turnaround", "description": "Printed and shipped within 2-3 business days", "color_style": "pink" } },
        { "type": "badge", "settings": { "icon": "✂️", "title": "Custom Shapes", "description": "Die-cut to your exact design, any size", "color_style": "purple" } },
        { "type": "badge", "settings": { "icon": "🌍", "title": "Worldwide Shipping", "description": "We deliver to over 50 countries", "color_style": "gold" } }
      ]
    }
  ]
}
{% endschema %}
