{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
    opacity: 0;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} canvas { display: none; }
    .splash-hero-{{ section.id }} .splash-hero-content { opacity: 1; }
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" data-animated="false">
  {% if show_animation %}
    <canvas id="splash-canvas-{{ section.id }}"></canvas>
  {% endif %}

  <div class="splash-hero-content" id="splash-content-{{ section.id }}">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% if show_animation %}
<script>
(function() {
  'use strict';
  const sectionId = '{{ section.id }}';
  const canvas = document.getElementById('splash-canvas-' + sectionId);
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W, H, particles = [], stickers = [], animId;
  const PASTEL_COLORS = ['#FFB5C2','#FFD1DC','#C3AED6','#E6E6FA','#B5EAD7','#D4F5E2','#FFDAB9','#FFE8D6','#B5D8EB','#D4EAF5','#FFF5BA','#FFFDE0'];
  const STICKER_SYMBOLS = ['✦','♥','◆','♡','★','♪','✧','○','◇','☆'];

  function resize() {
    const rect = canvas.parentElement.getBoundingClientRect();
    W = canvas.width = rect.width * devicePixelRatio;
    H = canvas.height = rect.height * devicePixelRatio;
    canvas.style.width = rect.width + 'px';
    canvas.style.height = rect.height + 'px';
    ctx.scale(devicePixelRatio, devicePixelRatio);
  }

  function random(a, b) { return Math.random() * (b - a) + a; }

  function createParticle(x, y) {
    const angle = random(0, Math.PI * 2);
    const speed = random(2, 12);
    const size = random(3, 14);
    return {
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed - random(2, 6),
      size,
      color: PASTEL_COLORS[Math.floor(Math.random() * PASTEL_COLORS.length)],
      life: 1,
      decay: random(0.006, 0.02),
      gravity: random(0.05, 0.15),
      rotation: random(0, Math.PI * 2),
      rotSpeed: random(-0.05, 0.05),
      type: Math.random() > 0.6 ? 'drop' : 'circle'
    };
  }

  function createSticker(x, y) {
    const angle = random(0, Math.PI * 2);
    const speed = random(5, 15);
    const size = random(28, 42);
    return {
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed - random(3, 8),
      size,
      color: PASTEL_COLORS[Math.floor(Math.random() * PASTEL_COLORS.length)],
      symbol: STICKER_SYMBOLS[Math.floor(Math.random() * STICKER_SYMBOLS.length)],
      life: 1,
      decay: random(0.003, 0.008),
      gravity: random(0.03, 0.08),
      rotation: random(-0.3, 0.3),
      rotSpeed: random(-0.03, 0.03),
      type: 'sticker'
    };
  }

  function createSplash(cx, cy) {
    const count = Math.floor(random(80, 140));
    for (let i = 0; i < count; i++) {
      particles.push(createParticle(cx, cy));
    }
    const stickerCount = Math.floor(random(6, 10));
    for (let i = 0; i < stickerCount; i++) {
      stickers.push(createSticker(cx, cy));
    }
  }

  function drawParticle(p) {
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(p.rotation);
    ctx.globalAlpha = p.life;
    ctx.fillStyle = p.color;

    if (p.type === 'drop') {
      // Teardrop shape
      ctx.beginPath();
      ctx.moveTo(0, -p.size * 0.6);
      ctx.quadraticCurveTo(p.size * 0.6, p.size * 0.1, 0, p.size * 0.8);
      ctx.quadraticCurveTo(-p.size * 0.6, p.size * 0.1, 0, -p.size * 0.6);
      ctx.fill();
    } else {
      // Circle
      ctx.beginPath();
      ctx.arc(0, 0, p.size * 0.4, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  function drawSticker(s) {
    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.rotate(s.rotation);
    ctx.globalAlpha = s.life;

    // Pastel background
    ctx.fillStyle = s.color;
    ctx.shadowColor = 'rgba(0,0,0,0.08)';
    ctx.shadowBlur = 12;
    ctx.shadowOffsetY = 3;

    const r = s.size / 2;
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowColor = 'transparent';

    // Dashed border
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = 'rgba(255,255,255,0.6)';
    ctx.lineWidth = 2.5;
    ctx.stroke();
    ctx.setLineDash([]);

    // Peel corner highlight
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.beginPath();
    ctx.arc(r - 6, -r + 6, 8, 0, Math.PI * 2);
    ctx.fill();

    // Symbol
    ctx.fillStyle = 'rgba(255,255,255,0.9)';
    ctx.font = 'bold ' + (r * 0.8) + 'px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(s.symbol, 0, 1);
    ctx.restore();
  }

  function animate() {
    ctx.clearRect(0, 0, W / devicePixelRatio, H / devicePixelRatio);

    for (let i = particles.length - 1; i >= 0; i--) {
      const p = particles[i];
      p.x += p.vx;
      p.y += p.vy;
      p.vy += p.gravity;
      p.vx *= 0.98;
      p.life -= p.decay;
      p.rotation += p.rotSpeed;
      if (p.life <= 0 || p.y > H + 50) { particles.splice(i, 1); continue; }
      drawParticle(p);
    }

    for (let i = stickers.length - 1; i >= 0; i--) {
      const s = stickers[i];
      s.x += s.vx;
      s.y += s.vy;
      s.vy += s.gravity;
      s.vx *= 0.97;
      s.rotation += s.rotSpeed;
      s.life -= s.decay;
      if (s.life <= 0 || s.y > H + 50) { stickers.splice(i, 1); continue; }
      drawSticker(s);
    }

    if (particles.length > 0 || stickers.length > 0) {
      animId = requestAnimationFrame(animate);
    }
  }

  function init() {
    resize();
    const rect = canvas.parentElement.getBoundingClientRect();
    const cx = rect.width / 2;
    const cy = rect.height / 2;
    createSplash(cx, cy);
    animate();

    // Fade in content
    const content = document.getElementById('splash-content-' + sectionId);
    if (content) {
      content.style.transition = 'opacity 0.6s ease-out';
      content.style.opacity = '1';
    }

    window.addEventListener('resize', resize);
  }

  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F0E6FF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#5B4B6A" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "#7A6B8A" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" },
    { "type": "checkbox", "id": "show_animation", "label": "Show animation", "default": true }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#7A6B8A" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#7A6B8A" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#7A6B8A", "button_text": "#7A6B8A" } }
      ]
    }
  ]
}
{% endschema %}
