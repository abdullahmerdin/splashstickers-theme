{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }
  .splash-hero-{{ section.id }} canvas#ink-canvas-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
    opacity: 0;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} canvas#ink-canvas-{{ section.id }} { display: none; }
    .splash-hero-{{ section.id }} .splash-hero-content { opacity: 1; }
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <canvas id="ink-canvas-{{ section.id }}"></canvas>
  <div class="splash-hero-content" id="splash-content-{{ section.id }}">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% if show_animation %}
<script>
(function() {
  'use strict';
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('ink-canvas-' + id);
  var content = document.getElementById('splash-content-' + id);
  if (!canvas || !hero) return;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (content) content.style.opacity = '1';
    return;
  }

  var ctx = canvas.getContext('2d');
  var W, H, shots = [], splats = [], stickers = [], animId;

  var INK_COLORS = [
    { main: '#FF4381', light: '#FF7EB3' },  // Neon Pink
    { main: '#FF6B35', light: '#FF9B6B' },  // Neon Orange
    { main: '#FFD700', light: '#FFE44D' },  // Gold/Yellow
    { main: '#00E5A0', light: '#4CF0B8' },  // Neon Green
    { main: '#4D7CFF', light: '#7FA3FF' },  // Neon Blue
    { main: '#A855F7', light: '#C084FC' },  // Neon Purple
  ];

  function resize() {
    var r = hero.getBoundingClientRect();
    var dpr = window.devicePixelRatio || 1;
    W = canvas.width = r.width * dpr;
    H = canvas.height = r.height * dpr;
    canvas.style.width = r.width + 'px';
    canvas.style.height = r.height + 'px';
    ctx.scale(dpr, dpr);
    return r;
  }

  function rand(a, b) { return Math.random() * (b - a) + a; }

  // ─── SPLATOON INK SHOT ───
  function createInkShot(fromX, fromY, toX, toY, palette) {
    var dx = toX - fromX, dy = toY - fromY;
    var dist = Math.sqrt(dx*dx + dy*dy);
    var speed = rand(6, 14);
    return {
      x: fromX, y: fromY,
      vx: (dx/dist) * speed + rand(-0.5, 0.5),
      vy: (dy/dist) * speed + rand(-0.5, 0.5),
      size: rand(8, 18),
      color: palette.main,
      light: palette.light,
      trail: [],
      life: 1,
      decay: rand(0.003, 0.008),
      gravity: rand(0.02, 0.06),
      wobble: rand(0, Math.PI * 2),
      wobbleSpeed: rand(0.05, 0.15)
    };
  }

  // ─── INK SPLAT (on impact) ───
  function createInkSplat(x, y, color, light, size) {
    var points = [];
    var numPoints = Math.floor(rand(8, 16));
    for (var i = 0; i < numPoints; i++) {
      var angle = (i / numPoints) * Math.PI * 2 + rand(-0.2, 0.2);
      var r = size * rand(0.5, 1.5);
      points.push({ x: Math.cos(angle) * r, y: Math.sin(angle) * r });
    }
    return {
      x: x, y: y,
      points: points,
      color: color,
      light: light,
      size: size,
      life: 1,
      decay: rand(0.005, 0.012),
      rotation: rand(0, Math.PI * 2)
    };
  }

  // ─── SPAWN SPLAT + STICKERS ───
  function splatImpact(x, y, color, light) {
    var splatSize = rand(20, 50);
    // Central splat
    splats.push(createInkSplat(x, y, color, light, splatSize));
    // Secondary splatter
    for (var i = 0; i < rand(2, 4); i++) {
      var a = rand(0, Math.PI * 2);
      var d = rand(15, 35);
      splats.push(createInkSplat(
        x + Math.cos(a) * d, y + Math.sin(a) * d,
        color, light, rand(8, 20)
      ));
    }
    // Tiny droplets
    for (var i = 0; i < rand(5, 10); i++) {
      var a = rand(0, Math.PI * 2);
      var d = rand(5, 25);
      splats.push(createInkSplat(
        x + Math.cos(a) * d, y + Math.sin(a) * d,
        color, light, rand(3, 7)
      ));
    }
  }

  // ─── STICKERS ───
  function spawnStickers(x, y, color, count) {
    for (var i = 0; i < count; i++) {
      var a = rand(0, Math.PI * 2);
      var sp = rand(3, 10);
      var sz = rand(22, 38);
      stickers.push({
        x: x, y: y,
        vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - rand(1, 4),
        size: sz, color: color,
        life: 1, decay: rand(0.003, 0.007),
        gravity: rand(0.03, 0.07),
        rotation: rand(-0.3, 0.3), rotSpeed: rand(-0.03, 0.03)
      });
    }
  }

  // ─── DRAW SPLATOON INK SPLAT ───
  function drawSplat(s) {
    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.rotate(s.rotation);
    ctx.globalAlpha = s.life * 0.85;
    ctx.shadowColor = 'rgba(0,0,0,0.1)';
    ctx.shadowBlur = 10;
    // Organic ink shape using bezier
    ctx.beginPath();
    var pts = s.points;
    ctx.moveTo(pts[0].x, pts[0].y);
    for (var i = 1; i < pts.length; i += 2) {
      var next = pts[(i + 1) % pts.length];
      ctx.bezierCurveTo(pts[i].x, pts[i].y, next.x, next.y, next.x, next.y);
    }
    ctx.closePath();
    // Ink gradient
    var g = ctx.createRadialGradient(0, 0, 0, 0, 0, s.size);
    g.addColorStop(0, s.light);
    g.addColorStop(0.6, s.color);
    g.addColorStop(1, 'rgba(0,0,0,0.1)');
    ctx.fillStyle = g;
    ctx.fill();
    // Glossy highlight
    ctx.shadowColor = 'transparent';
    ctx.globalAlpha = s.life * 0.2;
    ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.ellipse(-s.size*0.15, -s.size*0.2, s.size*0.25, s.size*0.12, -0.3, 0, Math.PI*2);
    ctx.fill();
    ctx.restore();
  }

  // ─── DRAW STICKER ───
  function drawSticker(s) {
    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.rotate(s.rotation);
    ctx.globalAlpha = s.life;
    ctx.shadowColor = 'rgba(0,0,0,0.1)';
    ctx.shadowBlur = 12;
    ctx.shadowOffsetY = 3;
    var g = ctx.createRadialGradient(-3, -3, 2, 0, 0, s.size/2);
    g.addColorStop(0, '#FFFFFF');
    g.addColorStop(0.5, s.color);
    g.addColorStop(1, 'rgba(0,0,0,0.08)');
    ctx.fillStyle = g;
    var r = s.size / 2;
    ctx.beginPath(); ctx.arc(0, 0, r, 0, Math.PI*2); ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.setLineDash([3, 3]);
    ctx.strokeStyle = 'rgba(255,255,255,0.5)';
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.setLineDash([]);
    // Peel
    ctx.fillStyle = 'rgba(255,255,255,0.2)';
    ctx.beginPath(); ctx.arc(r-5, -r+5, 7, 0, Math.PI*2); ctx.fill();
    // Splat logo
    ctx.fillStyle = 'rgba(255,255,255,0.85)';
    ctx.font = 'bold ' + (r*0.6) + 'px sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('✦', 0, 1);
    ctx.restore();
  }

  // ─── DRAW INK SHOT ───
  function drawShot(s) {
    // Trail
    var wasG = ctx.globalAlpha;
    var wasC = ctx.shadowColor;
    for (var i = 0; i < s.trail.length; i++) {
      var t = s.trail[i];
      var alpha = (i / s.trail.length) * 0.6 * s.life;
      ctx.globalAlpha = alpha;
      ctx.fillStyle = s.color;
      ctx.beginPath();
      ctx.arc(t.x, t.y, s.size * (i / s.trail.length) * 0.3, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = s.life;
    ctx.shadowColor = 'rgba(255,255,255,0.3)';
    ctx.shadowBlur = 8;

    // Main ink ball with wobble
    var wobX = Math.sin(s.wobble) * 2;
    var wobY = Math.cos(s.wobble) * 2;
    var g = ctx.createRadialGradient(wobX - 3, wobY - 3, 2, wobX, wobY, s.size/2);
    g.addColorStop(0, s.light);
    g.addColorStop(0.7, s.color);
    g.addColorStop(1, 'rgba(0,0,0,0.15)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(s.x + wobX, s.y + wobY, s.size/2, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowColor = 'transparent';
    // Gloss
    ctx.globalAlpha = s.life * 0.35;
    ctx.fillStyle = '#FFFFFF';
    ctx.beginPath();
    ctx.ellipse(s.x + wobX - s.size*0.15, s.y + wobY - s.size*0.2, s.size*0.18, s.size*0.1, -0.5, 0, Math.PI*2);
    ctx.fill();
    ctx.globalAlpha = wasG;
    ctx.shadowColor = wasC;
  }

  // ─── ANIMATION ───
  var shotsFinished = false;
  var splatsDone = false;
  var finaleFired = false;

  function updateShot(s) {
    s.trail.push({ x: s.x, y: s.y });
    if (s.trail.length > 8) s.trail.shift();
    s.x += s.vx; s.y += s.vy;
    s.vy += s.gravity;
    s.wobble += s.wobbleSpeed;
    s.life -= s.decay;
    // Splat on wall impact
    var r = hero.getBoundingClientRect();
    if (s.x < 5 || s.x > r.w - 5 || s.y < 5 || s.y > r.h - 5 || s.life <= 0) {
      if (s.life > 0.3) splatImpact(s.x, s.y, s.color, s.light);
      return false; // remove
    }
    return true;
  }

  function updateSplat(s) {
    s.life -= s.decay;
    return s.life > 0;
  }

  function updateSticker(s) {
    s.x += s.vx; s.y += s.vy;
    s.vy += s.gravity; s.vx *= 0.97;
    s.rotation += s.rotSpeed;
    s.life -= s.decay;
    return s.life > 0;
  }

  function loop() {
    var r = hero.getBoundingClientRect();
    ctx.clearRect(0, 0, r.w, r.h);

    // Update shots
    for (var i = shots.length - 1; i >= 0; i--) {
      if (!updateShot(shots[i])) {
        var s = shots[i];
        spawnStickers(s.x, s.y, s.color, Math.floor(rand(2, 4)));
        shots.splice(i, 1);
      }
    }

    // Draw shots
    for (var i = 0; i < shots.length; i++) drawShot(shots[i]);

    // Update & draw splats
    for (var i = splats.length - 1; i >= 0; i--) {
      if (!updateSplat(splats[i])) { splats.splice(i, 1); continue; }
      drawSplat(splats[i]);
    }

    // Update & draw stickers
    for (var i = stickers.length - 1; i >= 0; i--) {
      if (!updateSticker(stickers[i])) { stickers.splice(i, 1); continue; }
      drawSticker(stickers[i]);
    }

    // Check if done
    if (shots.length === 0 && !shotsFinished) {
      shotsFinished = true;
    }

    if (shotsFinished && splats.length === 0 && stickers.length === 0 && !finaleFired) {
      finaleFired = true;
      // Final content fade
      setTimeout(function() {
        content.style.transition = 'opacity 0.5s ease-out';
        content.style.opacity = '1';
      }, 300);
      return;
    }

    animId = requestAnimationFrame(loop);
  }

  function init() {
    var r = resize();
    // Fire ink shots from random directions
    var palette;
    var cx = r.w / 2, cy = r.h / 2;

    // Shot volley 1: from left and right
    for (var wave = 0; wave < 3; wave++) {
      setTimeout(function() {
        for (var i = 0; i < 4; i++) {
          palette = INK_COLORS[Math.floor(Math.random() * INK_COLORS.length)];
          var side = Math.floor(Math.random() * 4);
          var fx, fy;
          if (side === 0) { fx = -20; fy = rand(50, r.h-50); } // left
          else if (side === 1) { fx = r.w + 20; fy = rand(50, r.h-50); } // right
          else if (side === 2) { fx = rand(50, r.w-50); fy = -20; } // top
          else { fx = rand(50, r.w-50); fy = r.h + 20; } // bottom
          shots.push(createInkShot(fx, fy, cx + rand(-100,100), cy + rand(-100,100), palette));
        }
      }, wave * 300);
    }

    loop();
    window.addEventListener('resize', resize);
  }

  if (document.readyState === 'complete') tryInit();
  else window.addEventListener('load', tryInit);

  function tryInit() {
    try { init(); }
    catch(e) {
      console.warn('Splash init error:', e);
      if (content) { content.style.transition = 'opacity 0.5s ease-out'; content.style.opacity = '1'; }
    }
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "rgba(255,255,255,0.8)" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" },
    { "type": "checkbox", "id": "show_animation", "label": "Show animation", "default": true }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#FFFFFF", "button_text": "#FFFFFF" } }
      ]
    }
  ]
}
{% endschema %}
