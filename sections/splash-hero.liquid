{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }

  {% if show_animation %}
  /* ─── Splash Strip Animations ─── */
  .splash-hero-{{ section.id }} .splash-strip {
    position: absolute;
    height: 6px;
    border-radius: 3px;
    opacity: 0;
    animation: stripSlide 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .splash-hero-{{ section.id }} .splash-strip:nth-child(1) {
    top: 10%;
    left: 0;
    width: 40%;
    background: linear-gradient(90deg, transparent, #FD79A8);
    animation-delay: 0.1s;
  }
  .splash-hero-{{ section.id }} .splash-strip:nth-child(2) {
    top: 20%;
    right: 0;
    width: 35%;
    background: linear-gradient(270deg, transparent, #FDCB6E);
    animation-delay: 0.3s;
  }
  .splash-hero-{{ section.id }} .splash-strip:nth-child(3) {
    top: 75%;
    left: 0;
    width: 50%;
    background: linear-gradient(90deg, transparent, #6C5CE7);
    animation-delay: 0.5s;
  }
  .splash-hero-{{ section.id }} .splash-strip:nth-child(4) {
    top: 85%;
    right: 0;
    width: 30%;
    background: linear-gradient(270deg, transparent, #00CEC9);
    animation-delay: 0.7s;
  }
  .splash-hero-{{ section.id }} .splash-strip:nth-child(5) {
    top: 30%;
    left: 15%;
    width: 20%;
    background: linear-gradient(90deg, transparent, #00CEC9);
    animation-delay: 0.2s;
  }
  .splash-hero-{{ section.id }} .splash-strip:nth-child(6) {
    top: 65%;
    right: 10%;
    width: 25%;
    background: linear-gradient(270deg, transparent, #FD79A8);
    animation-delay: 0.6s;
  }

  @keyframes stripSlide {
    0% { transform: translateX(var(--strip-start, -100%)); opacity: 0; }
    100% { transform: translateX(0); opacity: 0.7; }
  }

  .splash-hero-{{ section.id }} .splash-strip:nth-child(odd) {
    --strip-start: -100%;
  }
  .splash-hero-{{ section.id }} .splash-strip:nth-child(even) {
    --strip-start: 100%;
  }

  /* ─── Flying Stickers ─── */
  .splash-hero-{{ section.id }} .flying-sticker {
    position: absolute;
    font-size: 3rem;
    opacity: 0;
    animation: stickerThrow 2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.15));
    pointer-events: none;
  }

  .splash-hero-{{ section.id }} .flying-sticker:nth-child(7) {
    top: 5%;
    left: 5%;
    animation-delay: 0.6s;
    font-size: 2.5rem;
  }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(8) {
    top: 15%;
    right: 8%;
    animation-delay: 0.9s;
    font-size: 2rem;
  }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(9) {
    bottom: 15%;
    left: 10%;
    animation-delay: 1.1s;
    font-size: 3.5rem;
  }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(10) {
    bottom: 10%;
    right: 5%;
    animation-delay: 0.8s;
    font-size: 2.8rem;
  }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(11) {
    top: 40%;
    left: 2%;
    animation-delay: 1.3s;
    font-size: 2.2rem;
  }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(12) {
    top: 35%;
    right: 2%;
    animation-delay: 0.7s;
    font-size: 2.6rem;
  }

  @keyframes stickerThrow {
    0% {
      transform: translate(var(--throw-x, -100px), var(--throw-y, -100px)) scale(0) rotate(var(--throw-rotate, -45deg));
      opacity: 0;
    }
    40% {
      opacity: 1;
    }
    100% {
      transform: translate(0, 0) scale(1) rotate(0deg);
      opacity: 1;
    }
  }

  .splash-hero-{{ section.id }} .flying-sticker:nth-child(7) { --throw-x: -120px; --throw-y: -80px; --throw-rotate: -30deg; }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(8) { --throw-x: 100px; --throw-y: -60px; --throw-rotate: 25deg; }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(9) { --throw-x: -80px; --throw-y: 120px; --throw-rotate: 40deg; }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(10) { --throw-x: 90px; --throw-y: 80px; --throw-rotate: -35deg; }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(11) { --throw-x: -60px; --throw-y: 60px; --throw-rotate: 20deg; }
  .splash-hero-{{ section.id }} .flying-sticker:nth-child(12) { --throw-x: 70px; --throw-y: -40px; --throw-rotate: -20deg; }

  /* ─── Content ─── */
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 640px;
  }

  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    animation: fadeUp 0.8s ease-out 0.4s both;
  }

  .splash-hero-{{ section.id }} .splash-hero-heading .splash-highlight {
    background: linear-gradient(135deg, #FDCB6E, #FD79A8, #FDCB6E);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 4s ease-in-out infinite;
  }

  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.85;
    animation: fadeUp 0.8s ease-out 0.6s both;
  }

  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 0.8s ease-out 0.8s both;
  }

  @keyframes fadeUp {
    0% { transform: translateY(20px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  /* ─── Floating background circles ─── */
  .splash-hero-{{ section.id }} .splash-bg-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.08;
    animation: floatPulse 6s ease-in-out infinite;
  }

  .splash-hero-{{ section.id }} .splash-bg-circle:nth-child(13) {
    width: 300px; height: 300px;
    background: #FD79A8;
    top: -50px; right: -50px;
    animation-delay: 0s;
  }

  .splash-hero-{{ section.id }} .splash-bg-circle:nth-child(14) {
    width: 200px; height: 200px;
    background: #00CEC9;
    bottom: -40px; left: -40px;
    animation-delay: 2s;
  }

  .splash-hero-{{ section.id }} .splash-bg-circle:nth-child(15) {
    width: 150px; height: 150px;
    background: #6C5CE7;
    top: 30%; right: 20%;
    animation-delay: 4s;
  }

  @keyframes floatPulse {
    0%, 100% { transform: scale(1) translate(0, 0); }
    50% { transform: scale(1.1) translate(10px, -10px); }
  }

  /* ─── Reduced motion ─── */
  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} .splash-strip,
    .splash-hero-{{ section.id }} .flying-sticker,
    .splash-hero-{{ section.id }} .splash-hero-heading,
    .splash-hero-{{ section.id }} .splash-hero-subtext,
    .splash-hero-{{ section.id }} .splash-hero-buttons,
    .splash-hero-{{ section.id }} .splash-bg-circle {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .splash-hero-{{ section.id }} .splash-strip { opacity: 0.5; }
  }
  {% endif %}
{% endstyle %}

<div class="splash-hero-{{ section.id }}">
  {% if show_animation %}
    <!-- Splash strips -->
    <div class="splash-strip"></div>
    <div class="splash-strip"></div>
    <div class="splash-strip"></div>
    <div class="splash-strip"></div>
    <div class="splash-strip"></div>
    <div class="splash-strip"></div>

    <!-- Flying stickers -->
    <div class="flying-sticker">⭐</div>
    <div class="flying-sticker">🌈</div>
    <div class="flying-sticker">🎯</div>
    <div class="flying-sticker">💎</div>
    <div class="flying-sticker">🔥</div>
    <div class="flying-sticker">✨</div>

    <!-- Background circles -->
    <div class="splash-bg-circle"></div>
    <div class="splash-bg-circle"></div>
    <div class="splash-bg-circle"></div>
  {% endif %}

  <!-- Content -->
  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">
        {{ heading }}
      </h1>
    {% endif %}

    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}

    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a
            href="{{ block.settings.button_link }}"
            style="
              display: inline-block;
              padding: 14px 36px;
              border-radius: 50px;
              font-weight: 700;
              font-size: 1rem;
              text-decoration: none;
              background: {{ block.settings.button_bg }};
              color: {{ block.settings.button_text }};
              border: {% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};
              transition: transform 0.3s ease, box-shadow 0.3s ease;
            "
            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.15)'"
            onmouseout="this.style.transform='';this.style.boxShadow=''"
          >
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<!-- Splash wave divider -->
<div class="splash-wave-divider" aria-hidden="true">
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none">
    <path d="M0,20 C240,60 480,0 720,20 C960,40 1200,0 1440,20 L1440,60 L0,60 Z" fill="#00CEC9" opacity="0.08"></path>
    <path d="M0,35 C240,55 480,15 720,35 C960,55 1200,15 1440,35 L1440,60 L0,60 Z" fill="#6C5CE7" opacity="0.06"></path>
  </svg>
</div>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Splash Your <span class=\"splash-highlight\">Style</span>"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#00CEC9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (px)",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 550
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (px)",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "show_animation",
      "label": "Show splash animation",
      "default": true,
      "info": "Color strips, flying stickers, and background circles"
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Label",
          "default": "Shop Stickers"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        {
          "type": "color",
          "id": "button_bg",
          "label": "Background / Border color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "button_text",
          "label": "Text color",
          "default": "#00CEC9"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "button_label": "Shop Stickers",
            "button_link": "",
            "button_style": "solid",
            "button_bg": "#FFFFFF",
            "button_text": "#00CEC9"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Design Your Own",
            "button_link": "",
            "button_style": "outline",
            "button_bg": "#FFFFFF",
            "button_text": "#FFFFFF"
          }
        }
      ]
    }
  ]
}
{% endschema %}
