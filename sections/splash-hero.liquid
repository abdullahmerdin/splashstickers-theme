{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    position: relative;
    z-index: 25;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    position: relative;
    z-index: 25;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 25;
  }
  .splash-hero-{{ section.id }} .ink-count {
    position: absolute;
    bottom: 16px;
    right: 20px;
    z-index: 30;
    color: {{ text_color }};
    opacity: 0.3;
    font-size: 0.75rem;
    font-family: monospace;
    pointer-events: none;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <canvas id="ink-canvas-{{ section.id }}"></canvas>
  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="ink-count" id="ink-count-{{ section.id }}"></div>
</div>

<script>
(function() {
  'use strict';
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('ink-canvas-' + id);
  if (!canvas || !hero) return;

  var ctx = canvas.getContext('2d');
  var offscreen = document.createElement('canvas');
  var offCtx = offscreen.getContext('2d');
  var W, H, points = [];
  var fluidTimer = null;

  var COLORS = ['#FF4381','#FF6B35','#00E5A0','#4D7CFF','#A855F7','#FFD700'];

  function resize() {
    var r = hero.getBoundingClientRect();
    var dpr = window.devicePixelRatio || 1;
    W = canvas.width = r.width * dpr;
    H = canvas.height = r.height * dpr;
    canvas.style.width = r.width + 'px';
    canvas.style.height = r.height + 'px';
    // Offscreen canvas (same size)
    offscreen.width = canvas.width;
    offscreen.height = canvas.height;
  }

  function rand(a, b) { return Math.random() * (b - a) + a; }
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  // ─── FLUID RENDER (blur + merge) ───
  function renderFluid() {
    // 1. Clear main canvas with slight background transparency for trail fade
    ctx.clearRect(0, 0, W / (window.devicePixelRatio || 1), H / (window.devicePixelRatio || 1));
    // 2. Draw offscreen with slight fade (new strokes overlay old ones)
    offCtx.save();
    // Draw a near-transparent white over old ink to fade it very slowly
    offCtx.globalAlpha = 0.02;
    offCtx.fillStyle = '#1A1A2E';
    offCtx.fillRect(0, 0, offscreen.width, offscreen.height);
    offCtx.restore();
    // 3. Blur + threshold to merge nearby ink
    ctx.save();
    ctx.filter = 'blur(4px)';
    ctx.drawImage(offscreen, 0, 0);
    ctx.restore();
    // 4. Overlay with contrast boost for crisp edges
    ctx.save();
    ctx.filter = 'contrast(3) brightness(1.1)';
    ctx.drawImage(canvas, 0, 0);
    ctx.restore();
  }

  // ─── INK STROKE ───
  function inkStroke(x1, y1, x2, y2, speed) {
    var color = pick(COLORS);
    var width = Math.min(Math.max(8, 40 - speed * 1.5), 50);

    // Draw to offscreen canvas (the "pool")
    // Layer 1: Soft glow
    offCtx.save();
    offCtx.shadowColor = color;
    offCtx.shadowBlur = 20;
    offCtx.beginPath();
    offCtx.moveTo(x1, y1);
    offCtx.lineTo(x2, y2);
    offCtx.strokeStyle = color;
    offCtx.lineWidth = width + 15;
    offCtx.lineCap = 'round';
    offCtx.lineJoin = 'round';
    offCtx.globalAlpha = 0.12;
    offCtx.stroke();
    offCtx.restore();

    // Layer 2: Main ink
    offCtx.save();
    offCtx.beginPath();
    offCtx.moveTo(x1, y1);
    offCtx.lineTo(x2, y2);
    offCtx.strokeStyle = color;
    offCtx.lineWidth = width;
    offCtx.lineCap = 'round';
    offCtx.lineJoin = 'round';
    offCtx.globalAlpha = 0.85;
    offCtx.stroke();
    offCtx.restore();

    // Layer 3: Highlight
    offCtx.save();
    offCtx.beginPath();
    offCtx.moveTo(x1, y1);
    offCtx.lineTo(x2, y2);
    offCtx.strokeStyle = 'rgba(255,255,255,0.2)';
    offCtx.lineWidth = Math.max(3, width * 0.2);
    offCtx.lineCap = 'round';
    offCtx.lineJoin = 'round';
    offCtx.stroke();
    offCtx.restore();

    // Splatter
    if (speed > 4 && Math.random() > 0.5) {
      var num = Math.floor(Math.min(speed, 5));
      for (var i = 0; i < num; i++) {
        var a = rand(0, Math.PI * 2);
        var d = rand(5, 12 + speed * 2);
        offCtx.save();
        offCtx.globalAlpha = 0.25;
        offCtx.fillStyle = color;
        offCtx.beginPath();
        offCtx.arc(x2 + Math.cos(a) * d, y2 + Math.sin(a) * d, rand(2, 5), 0, Math.PI * 2);
        offCtx.fill();
        offCtx.restore();
      }
    }

    // Render to visible canvas periodically (not every stroke for perf)
    if (!fluidTimer) {
      fluidTimer = setTimeout(function() {
        renderFluid();
        fluidTimer = null;
      }, 16); // ~60fps throttle
    }
  }

  // ─── TAPERED DOT ───
  function taperedDot(x, y) {
    var color = pick(COLORS);
    offCtx.save();
    var g = offCtx.createRadialGradient(x, y, 0, x, y, 20);
    g.addColorStop(0, color);
    g.addColorStop(0.4, color);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    offCtx.fillStyle = g;
    offCtx.shadowColor = color;
    offCtx.shadowBlur = 12;
    offCtx.beginPath();
    offCtx.arc(x, y, 20, 0, Math.PI * 2);
    offCtx.fill();
    offCtx.restore();
    offCtx.save();
    var g2 = offCtx.createRadialGradient(x-2, y-2, 0, x, y, 10);
    g2.addColorStop(0, 'rgba(255,255,255,0.3)');
    g2.addColorStop(1, 'rgba(0,0,0,0)');
    offCtx.fillStyle = g2;
    offCtx.beginPath();
    offCtx.arc(x, y, 10, 0, Math.PI * 2);
    offCtx.fill();
    offCtx.restore();
    renderFluid();
  }

  // ─── MOUSE ───
  function getPos(e) {
    var r = hero.getBoundingClientRect();
    if (e.touches) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  function onMove(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;

    if (points.length > 0) {
      var last = points[points.length - 1];
      var dx = x - last.x, dy = y - last.y;
      var dist = Math.sqrt(dx*dx + dy*dy);

      if (dist > 2) {
        var speed = dist;
        inkStroke(last.x, last.y, x, y, speed);
        points.push({ x: x, y: y });
        if (points.length > 50) points.shift();
      }
    } else {
      taperedDot(x, y);
      points.push({ x: x, y: y });
    }
  }

  hero.addEventListener('mousemove', onMove);
  hero.addEventListener('touchmove', onMove);
  hero.addEventListener('touchstart', function(e) {
    var pos = getPos(e);
    points = [{ x: pos.x, y: pos.y }];
    taperedDot(pos.x, pos.y);
  });
  hero.addEventListener('mouseenter', function() { points = []; });

  // ─── WELCOME ───
  function welcomeSplat() {
    var r = hero.getBoundingClientRect();
    var cx = r.width / 2, cy = r.height / 2;
    // Starburst pattern
    for (var i = 0; i < 12; i++) {
      var a = (i / 12) * Math.PI * 2;
      var d = 20 + (i % 3) * 15;
      var fromX = cx + Math.cos(a) * d * 0.3;
      var fromY = cy + Math.sin(a) * d * 0.3;
      var toX = cx + Math.cos(a) * d;
      var toY = cy + Math.sin(a) * d;
      inkStroke(fromX, fromY, toX, toY, 8);
    }
    taperedDot(cx, cy);
  }

  function init() {
    resize();
    welcomeSplat();
    window.addEventListener('resize', resize);
  }

  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Move your mouse to paint" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "rgba(255,255,255,0.8)" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
