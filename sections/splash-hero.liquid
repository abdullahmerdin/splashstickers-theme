{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 16px;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #FFFFFF;
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <div class="splash-hero-content">
    {% if heading != blank %}<h1 class="splash-hero-heading">{{ heading }}</h1>{% endif %}
    {% if subtext != blank %}<p class="splash-hero-subtext">{{ subtext }}</p>{% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/pixi.js/7.3.2/pixi.min.js"></script>
<script>
(function() {
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  if (!hero) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var app = new PIXI.Application({
    resizeTo: hero,
    transparent: true,
    antialias: true,
    resolution: window.devicePixelRatio || 1,
    backgroundColor: 0x1A1A2E
  });
  hero.prepend(app.view);
  app.view.style.position = 'absolute';
  app.view.style.inset = '0';
  app.view.style.pointerEvents = 'none';
  app.view.style.width = '100%';
  app.view.style.height = '100%';

  // Gooey container - blurred version for edge merging
  var blurContainer = new PIXI.Container();
  app.stage.addChild(blurContainer);

  var blurFilter = new PIXI.BlurFilter();
  blurFilter.blur = 4;
  blurFilter.quality = 3;

  var colorMatrix = new PIXI.ColorMatrixFilter();
  colorMatrix.contrast(6, false);

  blurContainer.filters = [blurFilter, colorMatrix];

  // Sharp container - crisp ink drawn on top
  var sharpContainer = new PIXI.Container();
  app.stage.addChild(sharpContainer);

  var COLORS = [0xFF4381, 0xFF6B35, 0x00E5A0, 0x4D7CFF, 0xA855F7, 0xFFD700];
  function pick() { return COLORS[Math.floor(Math.random() * COLORS.length)]; }
  function rand(a,b) { return Math.random() * (b - a) + a; }

  var lastX = null, lastY = null;
  var items = [];

  // ─── Draw a segment ───
  function drawSegment(x1, y1, x2, y2, speed) {
    var color = pick();
    var width = Math.min(Math.max(10, 45 - speed * 1.5), 55);

    // Feather (soft spread) - only in blur container for merging
    var f1 = new PIXI.Graphics();
    f1.beginFill(color, 0.12);
    f1.drawCircle(x1, y1, width * 0.8);
    f1.drawCircle(x2, y2, width * 0.6);
    f1.endFill();
    blurContainer.addChild(f1);
    items.push(f1);

    // Main ink body - sharp line (in sharp container)
    var g = new PIXI.Graphics();
    g.lineStyle(width, color, 0.92);
    g.moveTo(x1, y1);
    g.lineTo(x2, y2);
    sharpContainer.addChild(g);
    items.push(g);

    // Blurred copy of main line for gooey edge merging
    var bg = new PIXI.Graphics();
    bg.lineStyle(width + 6, color, 0.15);
    bg.moveTo(x1, y1);
    bg.lineTo(x2, y2);
    blurContainer.addChild(bg);
    items.push(bg);

    // Splatter - add to both
    if (speed > 5 && Math.random() > 0.7) {
      var num = Math.floor(Math.min(speed * 0.5, 3));
      for (var i = 0; i < num; i++) {
        var a = Math.random() * Math.PI * 2;
        var d = rand(8, 15 + speed);
        var s = rand(2, 4);
        var dot = new PIXI.Graphics();
        dot.beginFill(color, 0.3);
        dot.drawCircle(x2 + Math.cos(a) * d, y2 + Math.sin(a) * d, s);
        dot.endFill();
        sharpContainer.addChild(dot);
        items.push(dot);
        var bdot = new PIXI.Graphics();
        bdot.beginFill(color, 0.1);
        bdot.drawCircle(x2 + Math.cos(a) * d, y2 + Math.sin(a) * d, s + 3);
        bdot.endFill();
        blurContainer.addChild(bdot);
        items.push(bdot);
      }
    }
  }

  // ─── Release splash ───
  function releaseSplash(x, y, speed) {
    var color = pick();
    speed = speed || 10;
    var num = Math.floor(Math.min(8 + speed, 20));
    for (var i = 0; i < num; i++) {
      var a = (Math.random() - 0.5) * 1.8 + 0.3;
      var d = rand(10, 25 + speed);
      var sz = rand(3, 7);
      var dot = new PIXI.Graphics();
      dot.beginFill(color, 0.5);
      dot.drawCircle(x + Math.cos(a) * d, y + Math.sin(a) * d, sz);
      dot.endFill();
      sharpContainer.addChild(dot);
      items.push(dot);
      var bdot = new PIXI.Graphics();
      bdot.beginFill(color, 0.15);
      bdot.drawCircle(x + Math.cos(a) * d, y + Math.sin(a) * d, sz + 2);
      bdot.endFill();
      blurContainer.addChild(bdot);
      items.push(bdot);
    }
    var burst = new PIXI.Graphics();
    burst.beginFill(color, 0.25);
    burst.drawCircle(x, y, 18);
    burst.endFill();
    sharpContainer.addChild(burst);
    items.push(burst);
    var bburst = new PIXI.Graphics();
    bburst.beginFill(color, 0.08);
    bburst.drawCircle(x, y, 24);
    bburst.endFill();
    blurContainer.addChild(bburst);
    items.push(bburst);
  }

  // ─── Mouse ───
  function getPos(e) {
    var r = hero.getBoundingClientRect();
    if (e.touches) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  function onMove(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;

    if (lastX !== null) {
      var dx = x - lastX, dy = y - lastY;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist > 2) {
        drawSegment(lastX, lastY, x, y, dist);
      }
    }
    lastX = x; lastY = y;
  }

  hero.addEventListener('mousemove', onMove);
  hero.addEventListener('touchmove', onMove);
  hero.addEventListener('mouseleave', function() { if (lastX !== null) { releaseSplash(lastX, lastY); lastX = null; } });
  hero.addEventListener('mouseup', function() { if (lastX !== null) { releaseSplash(lastX, lastY); lastX = null; } });
  hero.addEventListener('touchstart', function(e) { var p = getPos(e); lastX = p.x; lastY = p.y; });
  hero.addEventListener('touchend', function() { if (lastX !== null) { releaseSplash(lastX, lastY); lastX = null; } });

  // ─── Welcome ───
  function welcomeSplat() {
    var cx = app.screen.width / 2, cy = app.screen.height / 2;
    for (var i = 0; i < 12; i++) {
      var a = (i / 12) * Math.PI * 2;
      var d = 25 + (i % 3) * 18;
      var color = pick();
      var feather = new PIXI.Graphics();
      feather.beginFill(color, 0.06);
      feather.drawCircle(cx + Math.cos(a) * d * 0.4, cy + Math.sin(a) * d * 0.4, 25);
      feather.endFill();
      gooContainer.addChild(feather);
      items.push(feather);
      var line = new PIXI.Graphics();
      line.lineStyle(rand(12, 22), color, 0.9);
      line.moveTo(cx + Math.cos(a) * d * 0.3, cy + Math.sin(a) * d * 0.3);
      line.lineTo(cx + Math.cos(a) * d, cy + Math.sin(a) * d);
      gooContainer.addChild(line);
      items.push(line);
    }
  }
  setTimeout(welcomeSplat, 100);

  // ─── Fade after 4s ───
  setTimeout(function() {
    var ticker = new PIXI.Ticker();
    ticker.add(function() {
      var alive = false;
      for (var i = items.length - 1; i >= 0; i--) {
        if (items[i].alpha > 0) {
          items[i].alpha -= 0.005;
          alive = true;
        } else if (items[i].parent) {
          items[i].parent.removeChild(items[i]);
        }
      }
      if (!alive) ticker.stop();
    });
    ticker.start();
  }, 4000);
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Move your mouse to paint" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
