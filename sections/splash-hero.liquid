{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 16px;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #FFFFFF;
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <canvas id="ink-canvas-{{ section.id }}"></canvas>
  <div class="splash-hero-content">
    {% if heading != blank %}<h1 class="splash-hero-heading">{{ heading }}</h1>{% endif %}
    {% if subtext != blank %}<p class="splash-hero-subtext">{{ subtext }}</p>{% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function() {
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('ink-canvas-' + id);
  if (!canvas || !hero) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var ctx = canvas.getContext('2d');
  var W, H, dpr = window.devicePixelRatio || 1;

  function resize() {
    var r = hero.getBoundingClientRect();
    W = r.width; H = r.height;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    ctx.scale(dpr, dpr);
  }
  resize();
  window.addEventListener('resize', resize);

  var COLORS = ['#FF4381','#FF6B35','#00E5A0','#4D7CFF','#A855F7','#FFD700'];
  function pick() { return COLORS[Math.floor(Math.random() * COLORS.length)]; }
  function rand(a,b) { return Math.random() * (b - a) + a; }

  var lastX = null, lastY = null;

  function paintStroke(x1, y1, x2, y2, speed) {
    var color = pick();
    var width = Math.min(Math.max(12, 50 - speed * 1.5), 60);

    // Layer 1: soft bleed underneath (feather)
    ctx.save();
    ctx.globalAlpha = 0.12;
    ctx.strokeStyle = color;
    ctx.lineWidth = width + 16;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();

    // Layer 2: main paint body (solid)
    ctx.save();
    ctx.strokeStyle = color;
    ctx.lineWidth = width;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.globalAlpha = 0.95;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();

    // Layer 3: wet highlight (thin bright center)
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = Math.max(3, width * 0.25);
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();

    // Splatter dots only on fast moves
    if (speed > 6 && Math.random() > 0.65) {
      var num = Math.floor(Math.min(speed * 0.4, 4));
      for (var i = 0; i < num; i++) {
        var a = Math.random() * Math.PI * 2;
        ctx.save();
        ctx.fillStyle = color;
        ctx.globalAlpha = 0.35;
        ctx.beginPath();
        ctx.arc(x2 + Math.cos(a) * rand(8, 18 + speed), y2 + Math.sin(a) * rand(8, 18 + speed), rand(3, 6), 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }
  }

  // ─── Release splat ───
  function releaseSplat(x, y, speed) {
    speed = speed || 8;
    var color = pick();
    var num = Math.floor(rand(6, 12 + speed * 0.3));
    for (var i = 0; i < num; i++) {
      var a = Math.random() * Math.PI * 2;
      var d = rand(8, 20 + speed);
      ctx.save();
      ctx.fillStyle = color;
      ctx.globalAlpha = 0.4;
      ctx.beginPath();
      ctx.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, rand(3, 7), 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
    // Central burst
    ctx.save();
    var g = ctx.createRadialGradient(x-3, y-3, 0, x, y, 18);
    g.addColorStop(0, 'rgba(255,255,255,0.2)');
    g.addColorStop(0.5, color);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g;
    ctx.globalAlpha = 0.5;
    ctx.beginPath();
    ctx.arc(x, y, 18, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // ─── Mouse ───
  function getPos(e) {
    var r = hero.getBoundingClientRect();
    if (e.touches) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  hero.addEventListener('mousemove', function(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;
    if (lastX !== null) {
      var dx = x - lastX, dy = y - lastY;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist > 2) paintStroke(lastX, lastY, x, y, dist);
    }
    lastX = x; lastY = y;
  });
  hero.addEventListener('touchmove', function(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;
    if (lastX !== null) {
      var dx = x - lastX, dy = y - lastY;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist > 2) paintStroke(lastX, lastY, x, y, dist);
    }
    lastX = x; lastY = y;
  });
  hero.addEventListener('mouseleave', function() { if (lastX !== null) { releaseSplat(lastX, lastY); lastX = null; } });
  hero.addEventListener('mouseup', function() { if (lastX !== null) { releaseSplat(lastX, lastY); lastX = null; } });
  hero.addEventListener('touchstart', function(e) { var p = getPos(e); lastX = p.x; lastY = p.y; });
  hero.addEventListener('touchend', function() { if (lastX !== null) { releaseSplat(lastX, lastY); lastX = null; } });

  // ─── Welcome ───
  function welcome() {
    var cx = W/2, cy = H/2;
    for (var i = 0; i < 12; i++) {
      var a = (i / 12) * Math.PI * 2;
      var d = 20 + (i % 3) * 15;
      paintStroke(cx + Math.cos(a) * d * 0.3, cy + Math.sin(a) * d * 0.3, cx + Math.cos(a) * d, cy + Math.sin(a) * d, 6);
    }
    releaseSplat(cx, cy, 6);
  }
  setTimeout(welcome, 200);
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Draw with liquid ink" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
