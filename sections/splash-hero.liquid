{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <div class="splash-hero-content">
    {% if heading != blank %}<h1 class="splash-hero-heading" style="font-size:clamp(2.5rem,6vw,4.5rem);font-weight:900;color:#FFF;margin:0 0 16px;mix-blend-mode:difference;">{{ heading }}</h1>{% endif %}
    {% if subtext != blank %}<p class="splash-hero-subtext" style="font-size:clamp(1rem,2vw,1.2rem);color:#FFF;margin:0 0 32px;opacity:0.9;mix-blend-mode:difference;">{{ subtext }}</p>{% endif %}
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/curtainsjs/8.2.0/curtains.min.js"></script>
<script>
(function() {
  var hero = document.getElementById('splash-hero-{{ section.id }}');
  if (!hero || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  // ─── Drawing canvas (paint strokes) ───
  var drawCanvas = document.createElement('canvas');
  var ctx = drawCanvas.getContext('2d');
  var W, H, dpr = window.devicePixelRatio || 1;

  function resizeDraw() {
    var r = hero.getBoundingClientRect();
    W = r.width; H = r.height;
    drawCanvas.width = W * dpr;
    drawCanvas.height = H * dpr;
    drawCanvas.style.width = W + 'px';
    drawCanvas.style.height = H + 'px';
    ctx.scale(dpr, dpr);
  }
  resizeDraw();
  window.addEventListener('resize', resizeDraw);

  drawCanvas.style.position = 'absolute';
  drawCanvas.style.inset = '0';
  drawCanvas.style.pointerEvents = 'none';
  drawCanvas.style.zIndex = '1';
  hero.prepend(drawCanvas);

  var COLORS = ['#FF4381','#FF6B35','#00E5A0','#4D7CFF','#A855F7','#FFD700'];
  function pick() { return COLORS[Math.floor(Math.random() * COLORS.length)]; }
  function rand(a,b) { return Math.random() * (b - a) + a; }

  var lastX = null, lastY = null, lastColor = null;

  function paintStroke(x1, y1, x2, y2, speed) {
    var color = lastColor || pick();
    var nextColor = pick();
    var width = Math.min(Math.max(12, 50 - speed * 1.5), 60);

    // Bleed layer
    ctx.save();
    ctx.globalAlpha = 0.12;
    ctx.strokeStyle = color;
    ctx.lineWidth = width + 16;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();

    // Main body with gradient
    var dx = x2 - x1, dy = y2 - y1;
    var dist = Math.sqrt(dx*dx + dy*dy) || 1;
    var span = 0.5;
    var mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
    var nx = dx / dist, ny = dy / dist;
    var grad = ctx.createLinearGradient(mx - nx * dist * span/2, my - ny * dist * span/2, mx + nx * dist * span/2, my + ny * dist * span/2);
    grad.addColorStop(0, color);
    grad.addColorStop(1, nextColor);
    ctx.save();
    ctx.strokeStyle = grad;
    ctx.lineWidth = width;
    ctx.lineCap = 'round';
    ctx.globalAlpha = 0.95;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();

    // Highlight
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = Math.max(3, width * 0.25);
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.stroke();
    ctx.restore();

    lastColor = nextColor;

    // Splatter
    if (speed > 5 && Math.random() > 0.6) {
      var num = Math.floor(Math.min(speed * 0.45, 7));
      for (var i = 0; i < num; i++) {
        var a = Math.random() * Math.PI * 2;
        ctx.save();
        ctx.fillStyle = nextColor;
        ctx.globalAlpha = 0.35;
        ctx.beginPath();
        ctx.arc(x2 + Math.cos(a) * rand(10, 20 + speed * 1.2), y2 + Math.sin(a) * rand(10, 20 + speed * 1.2), rand(2, 4 + speed * 0.04), 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
    }
  }

  // ─── Curtains.js fluid plane ───
  try {
    var curtains = new Curtains({
      container: hero,
      pixelRatio: Math.min(dpr, 2),
      alpha: true,
      autoResize: false,
      production: true
    });

    var vs = `
      precision highp float;
      attribute vec3 aVertexPosition;
      attribute vec2 aTextureCoord;
      varying vec2 vTextureCoord;
      uniform mat4 uMVMatrix;
      void main() {
        gl_Position = uMVMatrix * vec4(aVertexPosition, 1.0);
        vTextureCoord = aTextureCoord;
      }
    `;

    var fs = `
      precision highp float;
      varying vec2 vTextureCoord;
      uniform vec2 uResolution;
      uniform float uTime;
      uniform vec2 uMouse;
      uniform float uMouseSpeed;
      uniform sampler2D uDrawTexture;

      void main() {
        vec2 uv = vTextureCoord;
        vec2 res = uResolution;
        float time = uTime;

        // Fluid displacement based on mouse
        vec2 center = vec2(0.5);
        vec2 mousePos = uMouse / res;
        vec2 dir = uv - mousePos;
        float dist = length(dir);
        float strength = uMouseSpeed * 0.08;

        // Ripple wave
        float ripple = sin(dist * 40.0 - time * 3.0) * 0.5 + 0.5;
        float falloff = exp(-dist * 6.0);
        vec2 offset = normalize(dir) * ripple * falloff * strength;

        // Sample with displacement
        vec2 sampleUV = uv + offset;

        // Edge clamp
        sampleUV = clamp(sampleUV, 0.0, 1.0);

        vec4 color = texture2D(uDrawTexture, sampleUV);

        // Subtle vortex swirl
        float angle = atan(dir.y, dir.x);
        float swirl = sin(time * 1.5 + dist * 10.0) * 0.003 * falloff * uMouseSpeed;
        vec2 swirlUV = uv;
        swirlUV.x += cos(angle + time) * swirl;
        swirlUV.y += sin(angle + time) * swirl;
        swirlUV = clamp(swirlUV, 0.0, 1.0);
        vec4 swirlColor = texture2D(uDrawTexture, swirlUV);

        // Mix original and displaced
        float mixFactor = clamp(falloff * uMouseSpeed * 0.3, 0.0, 0.6);
        gl_FragColor = mix(color, swirlColor, mixFactor);
        gl_FragColor.a = 1.0;
      }
    `;

    // Upload draw canvas as texture
    var drawTexture = curtains.createTexture({
      sampler: 'uDrawTexture',
      fromTexture: drawCanvas
    });

    var plane = curtains.addPlane(hero.querySelector('.splash-hero-content'), {
      vertexShader: vs,
      fragmentShader: fs,
      widthSegments: 1,
      heightSegments: 1,
      uniforms: {
        uResolution: {
          name: 'uResolution',
          type: '2f',
          value: [W, H]
        },
        uTime: {
          name: 'uTime',
          type: '1f',
          value: 0
        },
        uMouse: {
          name: 'uMouse',
          type: '2f',
          value: [W/2, H/2]
        },
        uMouseSpeed: {
          name: 'uMouseSpeed',
          type: '1f',
          value: 0
        }
      }
    });

    // Update draw texture and uniforms each frame
    var time = 0;
    plane.onRender(function() {
      time += 0.01;
      this.uniforms.uTime.value = time;
      // Update the draw texture with latest strokes
      drawTexture.fromTexture(drawCanvas);
    });

    // Mouse tracking for uniforms
    var mouseX = W/2, mouseY = H/2;
    var prevMouseX = mouseX, prevMouseY = mouseY;

    hero.addEventListener('mousemove', function(e) {
      var r = hero.getBoundingClientRect();
      mouseX = e.clientX - r.left;
      mouseY = e.clientY - r.top;

      var dx = mouseX - prevMouseX, dy = mouseY - prevMouseY;
      var speed = Math.sqrt(dx*dx + dy*dy);

      if (plane) {
        plane.uniforms.uMouse.value = [mouseX, H - mouseY];
        plane.uniforms.uMouseSpeed.value = Math.min(speed * 0.5, 15);
      }

      if (lastX !== null) {
        var dist = Math.sqrt((mouseX - lastX)*(mouseX - lastX) + (mouseY - lastY)*(mouseY - lastY));
        if (dist > 2) paintStroke(lastX, lastY, mouseX, mouseY, dist);
      }
      lastX = mouseX; lastY = mouseY;
      prevMouseX = mouseX; prevMouseY = mouseY;
    });

    hero.addEventListener('mouseleave', function() { lastX = null; if (plane) plane.uniforms.uMouseSpeed.value = 0; });
    hero.addEventListener('mouseup', function() { lastX = null; if (plane) plane.uniforms.uMouseSpeed.value = 0; });

    // Resize handler
    window.addEventListener('resize', function() {
      resizeDraw();
      if (plane) {
        var r = hero.getBoundingClientRect();
        plane.uniforms.uResolution.value = [r.width, r.height];
        curtains.resize();
      }
    });

    // Welcome stroke
    setTimeout(function() {
      var r = hero.getBoundingClientRect();
      var cx = r.width/2, cy = r.height/2;
      for (var i = 0; i < 12; i++) {
        var a = (i / 12) * Math.PI * 2;
        var d = 20 + (i % 3) * 15;
        paintStroke(cx + Math.cos(a) * d * 0.3, cy + Math.sin(a) * d * 0.3, cx + Math.cos(a) * d, cy + Math.sin(a) * d, 6);
      }
    }, 300);

  } catch(e) {
    console.warn('Curtains init error:', e);
  }
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Draw with liquid ink" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
