{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    position: relative;
    z-index: 25;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    position: relative;
    z-index: 25;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 25;
  }
  .splash-hero-{{ section.id }} .ink-count {
    position: absolute;
    bottom: 16px;
    right: 20px;
    z-index: 30;
    color: {{ text_color }};
    opacity: 0.3;
    font-size: 0.75rem;
    font-family: monospace;
    pointer-events: none;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <canvas id="ink-canvas-{{ section.id }}"></canvas>
  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="ink-count" id="ink-count-{{ section.id }}"></div>
</div>

<script>
(function() {
  'use strict';
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('ink-canvas-' + id);
  if (!canvas || !hero) return;

  var ctx = canvas.getContext('2d');
  var W, H, trails = [], pastX, pastY, inkCount = 0;

  // Splatoon neon palette
  var COLORS = ['#FF4381','#FF6B35','#00E5A0','#4D7CFF','#A855F7','#FFD700',
                '#FF7EB3','#FF9B6B','#4CF0B8','#7FA3FF','#C084FC','#FFE44D'];

  function resize() {
    var r = hero.getBoundingClientRect();
    var dpr = window.devicePixelRatio || 1;
    W = canvas.width = r.width * dpr;
    H = canvas.height = r.height * dpr;
    canvas.style.width = r.width + 'px';
    canvas.style.height = r.height + 'px';
    ctx.scale(dpr, dpr);
    // Redraw existing trails on resize
    redrawAll();
  }

  function rand(a, b) { return Math.random() * (b - a) + a; }
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  // ─── SPLATTER AT CURSOR ───
  function splatter(x, y) {
    var color = pick(COLORS);
    var numDots = Math.floor(rand(6, 16));
    inkCount += numDots;

    for (var i = 0; i < numDots; i++) {
      var angle = rand(0, Math.PI * 2);
      var dist = rand(3, 30);
      var size = rand(4, 16);
      var speed = rand(2, 6);

      trails.push({
        x: x + Math.cos(angle) * dist * 0.3,
        y: y + Math.sin(angle) * dist * 0.3,
        targetX: x + Math.cos(angle) * dist,
        targetY: y + Math.sin(angle) * dist,
        size: size,
        origSize: size,
        color: color,
        life: 1,
        speed: speed,
        progress: 0,
        type: Math.random() > 0.5 ? 'splat' : 'drip'
      });
    }

    // Main splash blob (larger central drop)
    trails.push({
      x: x - rand(5, 15), y: y + rand(-5, 5),
      targetX: x, targetY: y,
      size: rand(18, 35),
      origSize: rand(18, 35),
      color: color,
      life: 1,
      speed: 3,
      progress: 0,
      type: 'blob'
    });
  }

  // ─── DRAW ───
  function drawTrail(t) {
    ctx.save();
    ctx.globalAlpha = t.life * 0.85;

    if (t.type === 'blob') {
      // Large central blob with 3D gradient
      var g = ctx.createRadialGradient(t.x - t.size*0.15, t.y - t.size*0.15, 2, t.x, t.y, t.size/2);
      g.addColorStop(0, '#FFFFFF');
      g.addColorStop(0.3, t.color);
      g.addColorStop(1, 'rgba(0,0,0,0.1)');
      ctx.fillStyle = g;
      ctx.shadowColor = 'rgba(0,0,0,0.15)';
      ctx.shadowBlur = 12;
      ctx.beginPath();
      ctx.arc(t.x, t.y, t.size/2 * t.progress, 0, Math.PI * 2);
      ctx.fill();
    } else if (t.type === 'drip') {
      // Teardrop/drip shape
      ctx.fillStyle = t.color;
      ctx.shadowColor = 'rgba(0,0,0,0.08)';
      ctx.shadowBlur = 4;
      ctx.beginPath();
      ctx.moveTo(t.x, t.y - t.size * 0.5 * t.progress);
      ctx.quadraticCurveTo(t.x + t.size*0.4, t.y + t.size*0.1, t.x, t.y + t.size*0.6 * t.progress);
      ctx.quadraticCurveTo(t.x - t.size*0.4, t.y + t.size*0.1, t.x, t.y - t.size*0.5 * t.progress);
      ctx.fill();
    } else {
      // Circular splat dot
      ctx.fillStyle = t.color;
      ctx.shadowColor = 'rgba(0,0,0,0.06)';
      ctx.shadowBlur = 3;
      ctx.beginPath();
      ctx.arc(t.x, t.y, t.size/2 * t.progress, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.restore();
  }

  function redrawAll() {
    ctx.clearRect(0, 0, W / (window.devicePixelRatio || 1), H / (window.devicePixelRatio || 1));
    for (var i = 0; i < trails.length; i++) {
      drawTrail(trails[i]);
    }
  }

  // ─── ANIMATE TRAILS ───
  function animate() {
    for (var i = trails.length - 1; i >= 0; i--) {
      var t = trails[i];

      // Animate to target position
      t.progress = Math.min(t.progress + 0.08 * t.speed, 1);
      t.x += (t.targetX - t.x) * 0.08 * t.speed;
      t.y += (t.targetY - t.y) * 0.08 * t.speed;

      // Slow decay
      t.life -= 0.0002;

      if (t.life <= 0 || t.progress >= 1 && t.life < 0.5) {
        // Keep the dot but stop animating when fully splatted
        continue;
      }
    }

    // Limit trails to prevent memory issues
    if (trails.length > 2000) {
      trails.splice(0, trails.length - 2000);
    }

    // Redraw
    redrawAll();

    // Update counter
    var counter = document.getElementById('ink-count-' + id);
    if (counter) counter.textContent = '🖌️ ' + inkCount + ' splats';

    requestAnimationFrame(animate);
  }

  // ─── MOUSE / TOUCH EVENTS ───
  function getPos(e) {
    var r = hero.getBoundingClientRect();
    if (e.touches) {
      return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    }
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  function onMove(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;

    // Only splatter if moved enough
    if (pastX !== undefined) {
      var dx = x - pastX, dy = y - pastY;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist > 5) {
        // Splatter at current position
        splatter(x, y);
        // If moving fast, bigger splatter
        if (dist > 15) {
          splatter(x + rand(-5,5), y + rand(-5,5));
        }
        pastX = x; pastY = y;
      }
    } else {
      pastX = x; pastY = y;
      // Initial splatter on first move
      splatter(x, y);
    }
  }

  hero.addEventListener('mousemove', onMove);
  hero.addEventListener('touchmove', onMove);
  hero.addEventListener('touchstart', onMove);

  // ─── INIT ───
  function init() {
    resize();
    animate();

    // Initial welcome splatter in center
    setTimeout(function() {
      var r = hero.getBoundingClientRect();
      for (var i = 0; i < 3; i++) {
        setTimeout(function() { splatter(r.width/2 + rand(-30,30), r.height/2 + rand(-30,30)); }, i * 100);
      }
    }, 500);

    window.addEventListener('resize', resize);
  }

  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Move your mouse to paint" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "rgba(255,255,255,0.8)" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
