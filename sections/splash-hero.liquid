{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }

  {% if show_animation %}
  /* ─── PEACOCK SPLASH — color fan bursts from center ─── */
  .splash-hero-{{ section.id }} .peacock-splash {
    position: absolute;
    inset: -200px;
    opacity: 0;
    animation: peacockBurst 1.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .peacock-splash::before {
    content: '';
    position: absolute;
    inset: 0;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      rgba(0,206,201,0.12) 30deg,
      transparent 60deg,
      rgba(108,92,231,0.15) 90deg,
      transparent 120deg,
      rgba(253,121,168,0.12) 150deg,
      transparent 180deg,
      rgba(253,206,110,0.1) 210deg,
      transparent 240deg,
      rgba(0,206,201,0.1) 270deg,
      transparent 300deg,
      rgba(108,92,231,0.12) 330deg,
      transparent 360deg
    );
    animation: peacockRotate 8s linear infinite;
  }
  .splash-hero-{{ section.id }} .peacock-splash::after {
    content: '';
    position: absolute;
    inset: 30%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.15) 0%, transparent 70%);
  }

  @keyframes peacockBurst {
    0% { transform: scale(0.3); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  @keyframes peacockRotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* ─── SPLASH RINGS — expanding color rings ─── */
  .splash-hero-{{ section.id }} .splash-ring {
    position: absolute;
    border-radius: 50%;
    border: 2px solid;
    opacity: 0;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .splash-ring:nth-child(2) {
    width: 100px; height: 100px;
    border-color: rgba(253,121,168,0.4);
    animation: ringExpand 2s ease-out 0.3s forwards;
  }
  .splash-hero-{{ section.id }} .splash-ring:nth-child(3) {
    width: 200px; height: 200px;
    border-color: rgba(0,206,201,0.3);
    animation: ringExpand 2.5s ease-out 0.5s forwards;
  }
  .splash-hero-{{ section.id }} .splash-ring:nth-child(4) {
    width: 350px; height: 350px;
    border-color: rgba(108,92,231,0.2);
    animation: ringExpand 3s ease-out 0.7s forwards;
  }
  .splash-hero-{{ section.id }} .splash-ring:nth-child(5) {
    width: 500px; height: 500px;
    border-color: rgba(253,206,110,0.15);
    animation: ringExpand 3.5s ease-out 0.9s forwards;
  }

  @keyframes ringExpand {
    0% { transform: scale(0); opacity: 0.8; }
    100% { transform: scale(1); opacity: 0; }
  }

  /* ─── SPLASH DROPLETS ─── */
  .splash-hero-{{ section.id }} .droplet {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    animation: dropletFly 1.5s ease-out forwards;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .droplet:nth-child(6) { width: 12px; height: 12px; background: #FD79A8; top: 45%; left: 48%; animation-delay: 0.4s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(7) { width: 8px; height: 8px; background: #00CEC9; top: 40%; left: 52%; animation-delay: 0.5s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(8) { width: 10px; height: 10px; background: #FDCB6E; top: 55%; left: 45%; animation-delay: 0.6s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(9) { width: 6px; height: 6px; background: #6C5CE7; top: 50%; left: 55%; animation-delay: 0.45s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(10) { width: 14px; height: 14px; background: #FD79A8; top: 35%; left: 50%; animation-delay: 0.55s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(11) { width: 7px; height: 7px; background: #00CEC9; top: 60%; left: 48%; animation-delay: 0.65s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(12) { width: 9px; height: 9px; background: #6C5CE7; top: 42%; left: 44%; animation-delay: 0.7s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(13) { width: 5px; height: 5px; background: #FDCB6E; top: 53%; left: 56%; animation-delay: 0.5s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(14) { width: 11px; height: 11px; background: #FD79A8; top: 38%; left: 46%; animation-delay: 0.6s; }
  .splash-hero-{{ section.id }} .droplet:nth-child(15) { width: 6px; height: 6px; background: #00CEC9; top: 58%; left: 52%; animation-delay: 0.75s; }

  @keyframes dropletFly {
    0% { transform: translate(0, 0) scale(0); opacity: 1; }
    100% { transform: translate(var(--dx, 80px), var(--dy, -60px)) scale(0.5); opacity: 0; }
  }
  .splash-hero-{{ section.id }} .droplet:nth-child(6) { --dx: -120px; --dy: -100px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(7) { --dx: 100px; --dy: -140px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(8) { --dx: -80px; --dy: 120px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(9) { --dx: 140px; --dy: 40px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(10) { --dx: 60px; --dy: -180px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(11) { --dx: -60px; --dy: 160px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(12) { --dx: -160px; --dy: -40px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(13) { --dx: 180px; --dy: 80px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(14) { --dx: -40px; --dy: -160px; }
  .splash-hero-{{ section.id }} .droplet:nth-child(15) { --dx: 120px; --dy: 100px; }

  /* ─── STICKERS — carried by the splash ─── */
  .splash-hero-{{ section.id }} .splash-sticker {
    position: absolute;
    opacity: 0;
    animation: stickerLaunch 2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .splash-sticker .sticker-body {
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: rgba(255,255,255,0.9);
    position: relative;
  }
  /* Sticker circle with cut-edge (peel) effect */
  .splash-hero-{{ section.id }} .sticker-peel {
    width: 75px; height: 75px;
    border-radius: 50%;
    border: 3px solid rgba(255,255,255,0.5);
    box-shadow: 0 6px 20px rgba(0,0,0,0.12), inset 0 -4px 8px rgba(0,0,0,0.06);
    position: relative;
    overflow: hidden;
  }
  .splash-hero-{{ section.id }} .sticker-peel::after {
    content: '';
    position: absolute;
    top: -8px; right: -8px;
    width: 20px; height: 20px;
    background: rgba(255,255,255,0.3);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(255,255,255,0.2);
  }
  .splash-hero-{{ section.id }} .sticker-peel.pink { background: linear-gradient(135deg, #FD79A8, #fab1a0); }
  .splash-hero-{{ section.id }} .sticker-peel.teal { background: linear-gradient(135deg, #00CEC9, #81ecec); }
  .splash-hero-{{ section.id }} .sticker-peel.purple { background: linear-gradient(135deg, #6C5CE7, #a29bfe); }
  .splash-hero-{{ section.id }} .sticker-peel.gold { background: linear-gradient(135deg, #FDCB6E, #f6e58d); }

  /* Sticker diamond */
  .splash-hero-{{ section.id }} .sticker-diamond {
    width: 65px; height: 65px;
    transform: rotate(45deg);
    border: 3px solid rgba(255,255,255,0.4);
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    overflow: hidden;
  }
  .splash-hero-{{ section.id }} .sticker-diamond .sticker-body {
    transform: rotate(-45deg);
  }
  .splash-hero-{{ section.id }} .sticker-diamond.purple { background: linear-gradient(135deg, #6C5CE7, #a29bfe); }

  /* Sticker rounded-square */
  .splash-hero-{{ section.id }} .sticker-round {
    width: 70px; height: 70px;
    border-radius: 35%;
    border: 3px solid rgba(255,255,255,0.4);
    box-shadow: 0 6px 20px rgba(0,0,0,0.12);
  }
  .splash-hero-{{ section.id }} .sticker-round.teal { background: linear-gradient(135deg, #00CEC9, #81ecec); }
  .splash-hero-{{ section.id }} .sticker-round.gold { background: linear-gradient(135deg, #FDCB6E, #f6e58d); }

  /* Sticker positions — scattered outward from center */
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(16) { top: 8%; left: 12%; animation-delay: 0.6s; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(17) { top: 12%; right: 15%; animation-delay: 0.8s; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(18) { bottom: 15%; left: 8%; animation-delay: 1.0s; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(19) { bottom: 8%; right: 12%; animation-delay: 0.7s; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(20) { top: 35%; left: 4%; animation-delay: 1.1s; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(21) { top: 40%; right: 4%; animation-delay: 0.9s; }

  @keyframes stickerLaunch {
    0% { transform: translate(0, 0) scale(0) rotate(0deg); opacity: 0; }
    30% { opacity: 1; }
    60% { transform: translate(var(--sx, -60px), var(--sy, -80px)) scale(1.1) rotate(var(--sr, 15deg)); opacity: 1; }
    100% { transform: translate(var(--sx-end, -40px), var(--sy-end, -60px)) scale(1) rotate(var(--sr-end, 8deg)); opacity: 1; }
  }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(16) { --sx: -80px; --sy: -120px; --sr: -20deg; --sx-end: -50px; --sy-end: -90px; --sr-end: -10deg; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(17) { --sx: 100px; --sy: -100px; --sr: 25deg; --sx-end: 60px; --sy-end: -70px; --sr-end: 12deg; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(18) { --sx: -90px; --sy: 100px; --sr: 30deg; --sx-end: -50px; --sy-end: 70px; --sr-end: -8deg; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(19) { --sx: 80px; --sy: 110px; --sr: -25deg; --sx-end: 50px; --sy-end: 80px; --sr-end: 10deg; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(20) { --sx: -110px; --sy: -30px; --sr: 15deg; --sx-end: -70px; --sy-end: -20px; --sr-end: -5deg; }
  .splash-hero-{{ section.id }} .splash-sticker:nth-child(21) { --sx: 120px; --sy: -40px; --sr: -15deg; --sx-end: 80px; --sy-end: -30px; --sr-end: 6deg; }

  /* ─── CONTENT ─── */
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    animation: fadeUp 0.8s ease-out 0.5s both;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.85;
    animation: fadeUp 0.8s ease-out 0.7s both;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 0.8s ease-out 0.9s both;
  }
  @keyframes fadeUp {
    0% { transform: translateY(20px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} .peacock-splash,
    .splash-hero-{{ section.id }} .splash-ring,
    .splash-hero-{{ section.id }} .droplet,
    .splash-hero-{{ section.id }} .splash-sticker,
    .splash-hero-{{ section.id }} .splash-hero-heading,
    .splash-hero-{{ section.id }} .splash-hero-subtext,
    .splash-hero-{{ section.id }} .splash-hero-buttons {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .splash-hero-{{ section.id }} .peacock-splash { opacity: 0.4; }
    .splash-hero-{{ section.id }} .droplet { display: none; }
  }
  {% endif %}
{% endstyle %}

<div class="splash-hero-{{ section.id }}">
  {% if show_animation %}
    <!-- Peacock color fan (conic gradient) -->
    <div class="peacock-splash"></div>

    <!-- Expanding splash rings -->
    <div class="splash-ring"></div>
    <div class="splash-ring"></div>
    <div class="splash-ring"></div>
    <div class="splash-ring"></div>

    <!-- Splash droplets (scatter particles) -->
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>
    <div class="droplet"></div>

    <!-- Stickers launched by splash -->
    <div class="splash-sticker"><div class="sticker-body sticker-peel pink">♪</div></div>
    <div class="splash-sticker"><div class="sticker-body sticker-peel teal">✦</div></div>
    <div class="splash-sticker"><div class="sticker-body sticker-diamond purple">♥</div></div>
    <div class="splash-sticker"><div class="sticker-body sticker-round gold">★</div></div>
    <div class="splash-sticker"><div class="sticker-body sticker-peel gold">◆</div></div>
    <div class="splash-sticker"><div class="sticker-body sticker-round teal">●</div></div>
  {% endif %}

  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a
            href="{{ block.settings.button_link }}"
            style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;"
            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.15)'"
            onmouseout="this.style.transform='';this.style.boxShadow=''"
          >{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#00CEC9" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "#FFFFFF" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Section height (px)" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top (px)" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom (px)" },
    { "type": "checkbox", "id": "show_animation", "label": "Show splash animation", "default": true }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Background / Border", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#00CEC9" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#00CEC9" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#FFFFFF", "button_text": "#FFFFFF" } }
      ]
    }
  ]
}
{% endschema %}
