{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 16px;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #FFFFFF;
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <canvas id="ink-canvas-{{ section.id }}"></canvas>
  <div class="splash-hero-content">
    {% if heading != blank %}<h1 class="splash-hero-heading">{{ heading }}</h1>{% endif %}
    {% if subtext != blank %}<p class="splash-hero-subtext">{{ subtext }}</p>{% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function() {
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('ink-canvas-' + id);
  if (!canvas || !hero) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var ctx = canvas.getContext('2d');
  var offCanvas = document.createElement('canvas');
  var offCtx = offCanvas.getContext('2d');
  var tempCanvas = document.createElement('canvas');
  var tempCtx = tempCanvas.getContext('2d');
  var W, H, dpr = window.devicePixelRatio || 1;

  function resize() {
    var r = hero.getBoundingClientRect();
    W = r.width; H = r.height;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    offCanvas.width = canvas.width;
    offCanvas.height = canvas.height;
    tempCanvas.width = canvas.width;
    tempCanvas.height = canvas.height;
    ctx.scale(dpr, dpr);
    offCtx.scale(dpr, dpr);
    tempCtx.scale(dpr, dpr);
  }
  resize();
  window.addEventListener('resize', resize);

  var COLORS = ['#FF4381','#FF6B35','#00E5A0','#4D7CFF','#A855F7','#FFD700'];
  function pick() { return COLORS[Math.floor(Math.random() * COLORS.length)]; }
  function rand(a,b) { return Math.random() * (b - a) + a; }

  // ─── Particle physics ───
  var particles = [];
  var GRAVITY = 0.15;
  var DAMPING = 0.98;
  var FRICTION = 0.92;

  function spawnParticles(x, y, count, color, speed) {
    for (var i = 0; i < count; i++) {
      var angle = (Math.random() - 0.5) * Math.PI;
      var vel = rand(1, 3 + speed * 0.3);
      particles.push({
        x: x + rand(-3, 3),
        y: y + rand(-3, 3),
        vx: Math.cos(angle) * vel,
        vy: Math.sin(angle) * vel - 1,
        r: rand(4, 10 + speed * 0.15),
        color: color || pick(),
        life: 1
      });
    }
  }

  function physicsStep() {
    // 1. Clear offscreen canvas
    offCtx.clearRect(0, 0, W, H);

    // 2. Draw all particles to offscreen canvas
    for (var i = particles.length - 1; i >= 0; i--) {
      var p = particles[i];

      // Gravity
      p.vy += GRAVITY;
      p.vx *= DAMPING;
      p.vy *= DAMPING;
      p.x += p.vx;
      p.y += p.vy;

      // Bounce
      if (p.x - p.r < 0) { p.x = p.r; p.vx *= -FRICTION; }
      if (p.x + p.r > W) { p.x = W - p.r; p.vx *= -FRICTION; }
      if (p.y - p.r < 0) { p.y = p.r; p.vy *= -FRICTION; }
      if (p.y + p.r > H) { p.y = H - p.r; p.vy *= -FRICTION; }

      p.life -= 0.001;
      if (p.life <= 0 || p.r < 0.5) { particles.splice(i, 1); continue; }

      // Draw to offscreen (white circles with varied opacity = metaball input)
      offCtx.save();
      offCtx.globalAlpha = Math.min(1, p.life * 1.5);
      offCtx.fillStyle = '#FFFFFF';
      offCtx.shadowColor = '#FFFFFF';
      offCtx.shadowBlur = p.r * 0.3;
      offCtx.beginPath();
      offCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      offCtx.fill();
      offCtx.restore();
    }

    // 3. Merge nearby particles (mass-spring)
    for (var i = 0; i < particles.length; i++) {
      for (var j = i + 1; j < particles.length; j++) {
        var a = particles[i], b = particles[j];
        var dx = a.x - b.x, dy = a.y - b.y;
        var dist = Math.sqrt(dx*dx + dy*dy);
        var minDist = (a.r + b.r) * 0.5;
        if (dist < minDist && dist > 0) {
          if (a.r > b.r) {
            a.r = Math.sqrt(a.r*a.r + b.r*b.r);
            a.x = (a.x * a.r + b.x * b.r) / (a.r + b.r);
            a.y = (a.y * a.r + b.y * b.r) / (a.r + b.r);
            a.vx = (a.vx + b.vx) * 0.5;
            a.vy = (a.vy + b.vy) * 0.5;
            particles.splice(j, 1); j--;
          } else {
            b.r = Math.sqrt(a.r*a.r + b.r*b.r);
            b.x = (a.x * a.r + b.x * b.r) / (a.r + b.r);
            b.y = (a.y * a.r + b.y * b.r) / (a.r + b.r);
            b.vx = (a.vx + b.vx) * 0.5;
            b.vy = (a.vy + b.vy) * 0.5;
            particles.splice(i, 1); i--; break;
          }
        }
      }
    }

    // 4. METABALL RENDER: 3-stage pipeline
    // Stage 1: Blur white particles on temp canvas
    tempCtx.clearRect(0, 0, W, H);
    tempCtx.filter = 'blur(10px)';
    tempCtx.drawImage(offCanvas, 0, 0);
    tempCtx.filter = 'none';

    // Stage 2: Contrast threshold to main canvas → creates fluid shape
    ctx.clearRect(0, 0, W, H);
    ctx.filter = 'contrast(10) brightness(1.6)';
    ctx.drawImage(tempCanvas, 0, 0);
    ctx.filter = 'none';

    // Stage 3: Colorize the metaball shape
    ctx.globalCompositeOperation = 'source-atop';
    // Draw colored gradients inside the white metaball mask
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      var g = ctx.createRadialGradient(p.x - p.r*0.3, p.y - p.r*0.3, 0, p.x, p.y, p.r);
      g.addColorStop(0, 'rgba(255,255,255,0.4)');
      g.addColorStop(0.3, p.color);
      g.addColorStop(1, p.color);
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r * 1.5, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalCompositeOperation = 'source-over';

    // 6. Cap particles
    if (particles.length > 300) particles.splice(0, particles.length - 300);

    requestAnimationFrame(physicsStep);
  }

  // ─── Mouse ───
  var lastX = null, lastY = null;

  function getPos(e) {
    var r = hero.getBoundingClientRect();
    if (e.touches) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  function onMove(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;

    if (lastX !== null) {
      var dx = x - lastX, dy = y - lastY;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist > 3) {
        var count = Math.min(Math.floor(dist * 0.8), 8);
        var speed = dist;
        var color = pick();
        spawnParticles(x, y, count, color, speed);
        // Extra splash droplets on fast moves
        if (speed > 8) {
          spawnParticles(x + rand(-5,5), y + rand(-5,5), Math.floor(speed * 0.3), color, speed);
        }
      }
    }
    lastX = x; lastY = y;
  }

  hero.addEventListener('mousemove', onMove);
  hero.addEventListener('touchmove', onMove);
  hero.addEventListener('mouseleave', function() { lastX = null; });
  hero.addEventListener('mouseup', function() { lastX = null; });
  hero.addEventListener('touchstart', function(e) { var p = getPos(e); lastX = p.x; lastY = p.y; });
  hero.addEventListener('touchend', function() { lastX = null; });

  // ─── Welcome ───
  function welcome() {
    var cx = W/2, cy = H/2;
    for (var i = 0; i < 20; i++) {
      var a = (i / 20) * Math.PI * 2;
      var d = 30 + (i % 4) * 15;
      spawnParticles(cx + Math.cos(a) * d * 0.3, cy + Math.sin(a) * d * 0.3, 3, pick(), 8);
    }
    spawnParticles(cx, cy, 10, pick(), 5);
  }

  // ─── Start ───
  physicsStep();
  setTimeout(welcome, 100);

  // ─── Fade after 5s ───
  setTimeout(function() {
    var fade = setInterval(function() {
      var alive = false;
      for (var i = 0; i < particles.length; i++) {
        if (particles[i].r > 0.5) {
          particles[i].r *= 0.98;
          if (particles[i].r > 0.5) alive = true;
        }
      }
      if (!alive) { clearInterval(fade); particles = []; }
    }, 50);
  }, 5000);
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Draw with liquid ink" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
