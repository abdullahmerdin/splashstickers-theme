{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }
  .splash-hero-{{ section.id }} .blob-el {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 1;
    will-change: transform, opacity;
  }
  .splash-hero-{{ section.id }} .sticker-el {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2.5px dashed rgba(255,255,255,0.5);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    font-weight: 700;
    color: rgba(255,255,255,0.9);
    will-change: transform, opacity;
  }
  .splash-hero-{{ section.id }} .sticker-el::after {
    content: ''; position: absolute;
    top: -5px; right: -5px;
    width: 14px; height: 14px;
    background: rgba(255,255,255,0.3); border-radius: 50%;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
    opacity: 0;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} .blob-el { display: none; }
    .splash-hero-{{ section.id }} .sticker-el { display: none; }
    .splash-hero-{{ section.id }} .splash-hero-content { opacity: 1; }
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <div class="splash-hero-content" id="splash-content-{{ section.id }}">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% if show_animation %}
<script src="https://cdn.jsdelivr.net/npm/animejs@3.2.2/lib/anime.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1"></script>
<script>
(function() {
  'use strict';
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var content = document.getElementById('splash-content-' + id);
  if (!hero) return;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (content) content.style.opacity = '1';
    return;
  }

  var W = hero.offsetWidth;
  var H = hero.offsetHeight;
  var cx = W / 2, cy = H / 2;

  var COLORS = ['#FF4381','#FF6B35','#FFD700','#00E5A0','#4D7CFF','#A855F7'];
  var LIGHT = ['#FF7EB3','#FF9B6B','#FFE44D','#4CF0B8','#7FA3FF','#C084FC'];
  var SYMBOLS = ['✦','♥','◆','♡','★','♪','✧'];

  function rand(a, b) { return Math.random() * (b - a) + a; }
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  // ─── CREATE A BLOB ───
  function createBlob(x, y, size, colorIdx) {
    var el = document.createElement('div');
    el.className = 'blob-el';
    var s = size || rand(40, 90);
    el.style.width = s + 'px';
    el.style.height = s + 'px';
    el.style.background = 'radial-gradient(circle at 35% 35%, ' + LIGHT[colorIdx] + ', ' + COLORS[colorIdx] + ' 60%, rgba(0,0,0,0.1))';
    el.style.boxShadow = '0 8px 32px rgba(0,0,0,0.15), inset 0 -4px 8px rgba(0,0,0,0.05)';
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    el.dataset.colorIdx = colorIdx;
    el.dataset.size = s;
    hero.appendChild(el);
    return el;
  }

  // ─── BLOB ENTRY ───
  function blobEntry(el, tx, ty, delay) {
    return anime({
      targets: el,
      translateX: tx,
      translateY: ty,
      scale: [0.3, 1.1, 1],
      opacity: [0, 1],
      duration: rand(800, 1200),
      easing: 'easeOutElastic(1, 0.6)',
      delay: delay
    });
  }

  // ─── BLOB COLLISION ───
  function blobCollision(el1, el2, x, y) {
    // Push blobs apart
    anime({
      targets: [el1, el2],
      scale: [{ value: 1.3, duration: 200 }, { value: 1, duration: 400 }],
      easing: 'easeOutQuad'
    });

    // Confetti burst
    var normX = x / window.innerWidth;
    var normY = y / window.innerHeight;
    confetti({
      particleCount: 40,
      spread: 180,
      origin: { x: normX, y: normY },
      colors: [COLORS[parseInt(el1.dataset.colorIdx)], COLORS[parseInt(el2.dataset.colorIdx)], pick(COLORS)],
      ticks: 120,
      gravity: 0.6,
      scalar: 0.9,
      startVelocity: 22
    });

    // Spawn stickers
    var count = Math.floor(rand(3, 5));
    for (var i = 0; i < count; i++) {
      spawnSticker(x, y);
    }
  }

  // ─── SPAWN STICKER ───
  function spawnSticker(x, y) {
    var el = document.createElement('div');
    el.className = 'sticker-el';
    var s = rand(28, 42);
    var ci = Math.floor(rand(0, COLORS.length));
    el.style.width = s + 'px';
    el.style.height = s + 'px';
    el.style.left = x + 'px';
    el.style.top = y + 'px';
    el.style.background = 'radial-gradient(circle at 35% 35%, #FFF, ' + COLORS[ci] + ' 80%)';
    el.style.fontSize = (s * 0.4) + 'px';
    el.textContent = pick(SYMBOLS);
    hero.appendChild(el);

    var angle = rand(0, Math.PI * 2);
    var dist = rand(60, 180);

    anime({
      targets: el,
      translateX: Math.cos(angle) * dist,
      translateY: Math.sin(angle) * dist - 30,
      scale: [0, 1.1, 1],
      rotate: [rand(-90, 90), rand(-15, 15)],
      opacity: [0, 1, 0.85],
      duration: rand(1200, 2000),
      easing: 'easeOutCubic',
      complete: function() {
        // Fade out and remove after a while
        setTimeout(function() {
          anime({ targets: el, opacity: 0, duration: 500, easing: 'easeOutQuad', complete: function() { el.remove(); } });
        }, rand(2000, 4000));
      }
    });
  }

  // ─── FINALE ───
  var finalDone = false;
  function finale() {
    if (finalDone) return;
    finalDone = true;

    // Big confetti burst
    confetti({
      particleCount: 100,
      spread: 200,
      origin: { x: 0.5, y: 0.5 },
      colors: COLORS,
      ticks: 200,
      gravity: 0.4,
      scalar: 1.3,
      startVelocity: 35
    });

    // Spawn more stickers
    for (var i = 0; i < 8; i++) {
      setTimeout(function() { spawnSticker(cx + rand(-50,50), cy + rand(-50,50)); }, i * 100);
    }

    // Fade in content
    setTimeout(function() {
      anime({ targets: content, opacity: [0, 1], translateY: [20, 0], duration: 600, easing: 'easeOutQuad' });
    }, 300);
  }

  // ─── COLLISION DETECTION ───
  var blobEls = [];
  var collisionCount = 0;
  var totalCollisions = 5; // need 5 collisions for finale

  function checkCollisions() {
    for (var i = 0; i < blobEls.length; i++) {
      var a = blobEls[i];
      if (a._collided) continue;
      for (var j = i + 1; j < blobEls.length; j++) {
        var b = blobEls[j];
        if (b._collided) continue;

        var ax = parseFloat(a.style.left) + parseFloat(a.dataset.size)/2;
        var ay = parseFloat(a.style.top) + parseFloat(a.dataset.size)/2;
        var bx = parseFloat(b.style.left) + parseFloat(b.dataset.size)/2;
        var by = parseFloat(b.style.top) + parseFloat(b.dataset.size)/2;
        var dx = bx - ax, dy = by - ay;
        var dist = Math.sqrt(dx*dx + dy*dy);
        var minDist = (parseFloat(a.dataset.size) + parseFloat(b.dataset.size)) / 2;

        if (dist < minDist + 10) { // 10px tolerance
          a._collided = true;
          b._collided = true;
          collisionCount++;
          blobCollision(a, b, (ax+bx)/2, (ay+by)/2);
          if (collisionCount >= totalCollisions) finale();
        }
      }
    }
    if (!finalDone) requestAnimationFrame(checkCollisions);
  }

  // ─── INIT ───
  function init() {
    W = hero.offsetWidth;
    H = hero.offsetHeight;
    cx = W / 2; cy = H / 2;

    // Create 6 blobs entering from different sides
    var sides = [
      { x: -80, y: rand(100, H-100) },
      { x: W + 80, y: rand(100, H-100) },
      { x: rand(100, W-100), y: -80 },
      { x: rand(100, W-100), y: H + 80 },
      { x: -60, y: rand(50, H-50) },
      { x: W + 60, y: rand(50, H-50) },
    ];

    var tl = anime.timeline({ complete: function() {
      // Start collision detection after all blobs entered
      checkCollisions();
    }});

    for (var i = 0; i < sides.length; i++) {
      var el = createBlob(sides[i].x, sides[i].y, rand(45, 85), i % COLORS.length);
      blobEls.push(el);
      tl.add({
        targets: el,
        translateX: cx - sides[i].x - parseFloat(el.dataset.size)/2 + rand(-80, 80),
        translateY: cy - sides[i].y - parseFloat(el.dataset.size)/2 + rand(-80, 80),
        scale: [0.2, 1.15, 1],
        opacity: [0, 1],
        duration: rand(900, 1300),
        easing: 'easeOutElastic(1, 0.5)',
        delay: rand(0, 200)
      }, '-=400');
    }

    // Safety timeout: show content after 7s
    setTimeout(function() {
      if (!finalDone) finale();
    }, 7000);
  }

  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "rgba(255,255,255,0.8)" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" },
    { "type": "checkbox", "id": "show_animation", "label": "Show animation", "default": true }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
