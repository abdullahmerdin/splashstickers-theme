{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }

  {% if show_animation %}
  /* ─── SPLASH BURST RAYS ─── */
  .splash-hero-{{ section.id }} .splash-ray {
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    opacity: 0;
    animation: rayBurst 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .splash-ray-inner {
    width: 100%; height: 100%;
    position: absolute;
    top: 0; left: 0;
  }

  /* Ray 1 - pink, shoots up-right */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(1) { animation-delay: 0.05s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(1) .splash-ray-inner {
    background: #FFB5C2;
    clip-path: polygon(25% 100%, 50% 0%, 75% 100%);
    transform: translate(20px, -20px) rotate(-15deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }
  /* Ray 2 - lavender, shoots up */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(2) { animation-delay: 0.1s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(2) .splash-ray-inner {
    background: #C3AED6;
    clip-path: polygon(30% 100%, 50% 0%, 70% 100%);
    transform: translate(0px, -30px) rotate(0deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }
  /* Ray 3 - mint, shoots up-left */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(3) { animation-delay: 0.15s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(3) .splash-ray-inner {
    background: #B5EAD7;
    clip-path: polygon(20% 100%, 50% 0%, 80% 100%);
    transform: translate(-20px, -20px) rotate(15deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }
  /* Ray 4 - peach, shoots right */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(4) { animation-delay: 0.2s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(4) .splash-ray-inner {
    background: #FFDAB9;
    clip-path: polygon(0% 30%, 100% 50%, 0% 70%);
    transform: translate(30px, 0px) rotate(0deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }
  /* Ray 5 - baby blue, shoots down-right */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(5) { animation-delay: 0.25s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(5) .splash-ray-inner {
    background: #B5D8EB;
    clip-path: polygon(25% 0%, 50% 100%, 75% 0%);
    transform: translate(15px, 20px) rotate(10deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }
  /* Ray 6 - soft yellow, shoots down */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(6) { animation-delay: 0.3s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(6) .splash-ray-inner {
    background: #FFF5BA;
    clip-path: polygon(30% 0%, 50% 100%, 70% 0%);
    transform: translate(0px, 25px) rotate(0deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }
  /* Ray 7 - pink, shoots left */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(7) { animation-delay: 0.1s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(7) .splash-ray-inner {
    background: #FFB5C2;
    clip-path: polygon(100% 30%, 0% 50%, 100% 70%);
    transform: translate(-30px, -5px) rotate(0deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }
  /* Ray 8 - lavender, shoots down-left */
  .splash-hero-{{ section.id }} .splash-ray:nth-child(8) { animation-delay: 0.2s; }
  .splash-hero-{{ section.id }} .splash-ray:nth-child(8) .splash-ray-inner {
    background: #C3AED6;
    clip-path: polygon(20% 0%, 50% 100%, 80% 0%);
    transform: translate(-20px, 15px) rotate(-8deg);
    animation: raySettle 0.6s ease-out 0.3s forwards;
  }

  @keyframes rayBurst {
    0% { width: 0; height: 0; opacity: 0; }
    30% { width: 200px; height: 200px; opacity: 1; }
    100% { width: 200px; height: 200px; opacity: 1; }
  }
  @keyframes raySettle {
    0% { opacity: 0.9; }
    100% { opacity: 0.3; }
  }

  /* ─── SPLASH CROWN (top splash) ─── */
  .splash-hero-{{ section.id }} .splash-crown {
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    transform: translate(-50%, -50%);
    opacity: 0;
    animation: crownBurst 0.6s ease-out 0.15s forwards;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .splash-crown-inner {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: radial-gradient(ellipse at 50% 100%, rgba(255,181,194,0.6) 0%, transparent 70%);
    clip-path: polygon(0% 100%, 10% 60%, 20% 80%, 30% 40%, 40% 70%, 50% 20%, 60% 70%, 70% 40%, 80% 80%, 90% 60%, 100% 100%);
  }

  @keyframes crownBurst {
    0% { width: 0; height: 0; opacity: 0; }
    50% { width: 300px; height: 150px; opacity: 0.8; }
    100% { width: 300px; height: 150px; opacity: 0; }
  }

  /* ─── SPLASH DROPS ─── */
  .splash-hero-{{ section.id }} .splash-drop {
    position: absolute;
    width: 0; height: 0;
    opacity: 0;
    animation: dropFly 0.7s ease-out forwards;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .splash-drop-inner {
    width: 100%; height: 100%;
    border-radius: 50% 50% 50% 0;
  }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(9) { animation-delay: 0.1s; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(10) { animation-delay: 0.15s; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(11) { animation-delay: 0.2s; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(12) { animation-delay: 0.1s; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(13) { animation-delay: 0.25s; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(14) { animation-delay: 0.18s; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(15) { animation-delay: 0.12s; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(16) { animation-delay: 0.22s; }

  @keyframes dropFly {
    0% { transform: translate(0, 0) scale(0) rotate(0deg); opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(1) rotate(var(--dr)); opacity: 0; }
  }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(9)  { --dx: -80px;  --dy: -100px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(9) .splash-drop-inner  { background: #FFB5C2; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(10) { --dx: 60px;  --dy: -120px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(10) .splash-drop-inner { background: #C3AED6; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(11) { --dx: -50px; --dy: 90px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(11) .splash-drop-inner { background: #B5EAD7; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(12) { --dx: 90px;  --dy: 70px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(12) .splash-drop-inner { background: #FFDAB9; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(13) { --dx: -100px; --dy: 20px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(13) .splash-drop-inner { background: #B5D8EB; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(14) { --dx: 120px; --dy: -40px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(14) .splash-drop-inner { background: #FFF5BA; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(15) { --dx: -40px; --dy: 120px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(15) .splash-drop-inner { background: #FFB5C2; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(16) { --dx: 70px;  --dy: -80px; }
  .splash-hero-{{ section.id }} .splash-drop:nth-child(16) .splash-drop-inner { background: #C3AED6; }

  /* ─── STICKERS ─── */
  .splash-hero-{{ section.id }} .p-sticker {
    position: absolute;
    opacity: 0;
    animation: stickerPop 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .p-sticker .p-sticker-body {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; font-weight: 700;
    color: rgba(255,255,255,0.9);
    position: relative;
  }
  .splash-hero-{{ section.id }} .p-sticker-circle {
    width: 68px; height: 68px; border-radius: 50%;
    border: 2.5px dashed rgba(255,255,255,0.6);
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    position: relative; overflow: hidden;
  }
  .splash-hero-{{ section.id }} .p-sticker-circle::after {
    content: ''; position: absolute; top: -6px; right: -6px;
    width: 16px; height: 16px;
    background: rgba(255,255,255,0.3); border-radius: 50%;
  }
  .splash-hero-{{ section.id }} .p-sticker-circle.pink { background: linear-gradient(135deg, #FFB5C2, #FFD1DC); }
  .splash-hero-{{ section.id }} .p-sticker-circle.lavender { background: linear-gradient(135deg, #C3AED6, #E6E6FA); }
  .splash-hero-{{ section.id }} .p-sticker-circle.mint { background: linear-gradient(135deg, #B5EAD7, #D4F5E2); }
  .splash-hero-{{ section.id }} .p-sticker-circle.peach { background: linear-gradient(135deg, #FFDAB9, #FFE8D6); }
  .splash-hero-{{ section.id }} .p-sticker-circle.blue { background: linear-gradient(135deg, #B5D8EB, #D4EAF5); }
  .splash-hero-{{ section.id }} .p-sticker-square {
    width: 60px; height: 60px; border-radius: 12px;
    border: 2.5px dashed rgba(255,255,255,0.6);
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    transform: rotate(12deg);
  }
  .splash-hero-{{ section.id }} .p-sticker-square.yellow { background: linear-gradient(135deg, #FFF5BA, #FFFDE0); }

  .splash-hero-{{ section.id }} .p-sticker:nth-child(17) { top: 10%; left: 12%; animation-delay: 0.4s; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(18) { top: 6%; right: 14%; animation-delay: 0.55s; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(19) { bottom: 12%; left: 8%; animation-delay: 0.7s; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(20) { bottom: 8%; right: 10%; animation-delay: 0.45s; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(21) { top: 35%; left: 3%; animation-delay: 0.8s; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(22) { top: 40%; right: 3%; animation-delay: 0.6s; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(23) { top: 20%; left: 30%; animation-delay: 0.5s; }

  @keyframes stickerPop {
    0% { transform: translate(0, 0) scale(0) rotate(0deg); opacity: 0; }
    50% { transform: translate(var(--dx), var(--dy)) scale(1.2) rotate(var(--dr)); opacity: 1; }
    100% { transform: translate(var(--dx-end), var(--dy-end)) scale(1) rotate(var(--dr-end)); opacity: 0.95; }
  }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(17) { --dx: -50px; --dy: -80px; --dr: -20deg; --dx-end: -30px; --dy-end: -60px; --dr-end: -10deg; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(18) { --dx: 60px; --dy: -70px; --dr: 25deg; --dx-end: 40px; --dy-end: -50px; --dr-end: 12deg; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(19) { --dx: -60px; --dy: 70px; --dr: 30deg; --dx-end: -30px; --dy-end: 50px; --dr-end: -8deg; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(20) { --dx: 50px; --dy: 60px; --dr: -25deg; --dx-end: 30px; --dy-end: 40px; --dr-end: 10deg; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(21) { --dx: -70px; --dy: -10px; --dr: 15deg; --dx-end: -50px; --dy-end: -5px; --dr-end: -5deg; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(22) { --dx: 80px; --dy: -20px; --dr: -15deg; --dx-end: 50px; --dy-end: -10px; --dr-end: 8deg; }
  .splash-hero-{{ section.id }} .p-sticker:nth-child(23) { --dx: -40px; --dy: -60px; --dr: 10deg; --dx-end: -25px; --dy-end: -40px; --dr-end: -5deg; }

  /* ─── SPLASH RINGS (fast, snappy) ─── */
  .splash-hero-{{ section.id }} .pop-ring {
    position: absolute; top: 50%; left: 50%;
    border-radius: 50%;
    border: 3px solid;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }
  .splash-hero-{{ section.id }} .pop-ring:nth-child(24) {
    width: 40px; height: 40px;
    border-color: rgba(255,181,194,0.6);
    animation: popRing 0.6s ease-out 0.1s forwards;
  }
  .splash-hero-{{ section.id }} .pop-ring:nth-child(25) {
    width: 80px; height: 80px;
    border-color: rgba(195,174,214,0.5);
    animation: popRing 0.7s ease-out 0.2s forwards;
  }
  .splash-hero-{{ section.id }} .pop-ring:nth-child(26) {
    width: 130px; height: 130px;
    border-color: rgba(181,234,215,0.4);
    animation: popRing 0.8s ease-out 0.3s forwards;
  }
  .splash-hero-{{ section.id }} .pop-ring:nth-child(27) {
    width: 190px; height: 190px;
    border-color: rgba(255,218,185,0.3);
    animation: popRing 0.9s ease-out 0.4s forwards;
  }

  @keyframes popRing {
    0% { transform: translate(-50%, -50%) scale(0.3); opacity: 0.9; }
    100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
  }

  /* ─── CONTENT ─── */
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    animation: fadeUp 0.5s ease-out 0.3s both;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    animation: fadeUp 0.5s ease-out 0.45s both;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 0.5s ease-out 0.6s both;
  }
  @keyframes fadeUp {
    0% { transform: translateY(15px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} .splash-ray,
    .splash-hero-{{ section.id }} .splash-crown,
    .splash-hero-{{ section.id }} .splash-drop,
    .splash-hero-{{ section.id }} .p-sticker,
    .splash-hero-{{ section.id }} .pop-ring,
    .splash-hero-{{ section.id }} .splash-hero-heading,
    .splash-hero-{{ section.id }} .splash-hero-subtext,
    .splash-hero-{{ section.id }} .splash-hero-buttons {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .splash-hero-{{ section.id }} .splash-ray,
    .splash-hero-{{ section.id }} .splash-crown,
    .splash-hero-{{ section.id }} .splash-drop { display: none; }
  }
  {% endif %}
{% endstyle %}

<div class="splash-hero-{{ section.id }}">
  {% if show_animation %}
    <!-- Splash burst rays (clip-path triangles) -->
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>
    <div class="splash-ray"><div class="splash-ray-inner"></div></div>

    <!-- Splash crown -->
    <div class="splash-crown"><div class="splash-crown-inner"></div></div>

    <!-- Water drops -->
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>
    <div class="splash-drop"><div class="splash-drop-inner"></div></div>

    <!-- Pop rings -->
    <div class="pop-ring"></div>
    <div class="pop-ring"></div>
    <div class="pop-ring"></div>
    <div class="pop-ring"></div>

    <!-- Stickers -->
    <div class="p-sticker"><div class="p-sticker-body p-sticker-circle pink">✦</div></div>
    <div class="p-sticker"><div class="p-sticker-body p-sticker-circle lavender">♥</div></div>
    <div class="p-sticker"><div class="p-sticker-body p-sticker-circle mint">◆</div></div>
    <div class="p-sticker"><div class="p-sticker-body p-sticker-circle peach">♡</div></div>
    <div class="p-sticker"><div class="p-sticker-body p-sticker-circle blue">★</div></div>
    <div class="p-sticker"><div class="p-sticker-body p-sticker-square yellow">♪</div></div>
    <div class="p-sticker"><div class="p-sticker-body p-sticker-circle pink">✧</div></div>
  {% endif %}

  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F0E6FF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#5B4B6A" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "#7A6B8A" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" },
    { "type": "checkbox", "id": "show_animation", "label": "Show animation", "default": true }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
