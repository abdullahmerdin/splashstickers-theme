{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign draw_hint = section.settings.draw_hint | default: 'Swipe to draw'
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    display: flex;
    min-height: {{ section_height }}px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
    background: {{ bg_color }};
    color: #1f2937;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    touch-action: none;
    overscroll-behavior: none;
  }

  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: saturate(1.08) contrast(1.03);
  }

  .splash-hero-{{ section.id }} [data-ink-effects] {
    z-index: 2;
  }

  .splash-hero-{{ section.id }} > .page-width {
    position: relative;
    z-index: 20;
    width: 100%;
  }

  .splash-hero-{{ section.id }} .splash-hero-inner {
    display: grid;
    min-height: min({{ section_height }}px, 72svh);
    max-width: 760px;
    margin: 0 auto;
    align-content: center;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  .splash-hero-{{ section.id }} .splash-hero-touch-hint {
    display: none;
    min-height: 76px;
    margin: -4px 0 2px;
    align-items: center;
    justify-content: center;
  }

  .splash-hero-{{ section.id }} .splash-hero-kicker {
    margin: 0;
    color: #6c5ce7;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .splash-hero-{{ section.id }} .splash-hero-heading {
    margin: 0;
    font-size: clamp(2.4rem, 5.5vw, 4.8rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .splash-hero-{{ section.id }} .splash-hero-subtext {
    margin: 0;
    max-width: 48rem;
    color: rgba(31, 41, 55, 0.72);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.6;
  }

  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 8px;
  }

  .splash-hero-{{ section.id }} .splash-hero-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background-color 0.18s ease,
      border-color 0.18s ease, color 0.18s ease;
  }

  .splash-hero-{{ section.id }} .splash-hero-button--solid {
    background: var(--button-bg);
    border-color: var(--button-bg);
    color: var(--button-text);
    box-shadow: 0 12px 24px rgb(108 92 231 / 16%);
  }

  .splash-hero-{{ section.id }} .splash-hero-button--outline {
    background: rgb(255 255 255 / 72%);
    border-color: var(--button-bg);
    color: var(--button-text);
    backdrop-filter: blur(10px);
  }

  .splash-hero-{{ section.id }} .splash-hero-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 20px rgb(31 41 55 / 10%);
  }

  .splash-hero-{{ section.id }} .splash-hero-controls {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    display: grid;
    gap: 10px;
  }

  .splash-hero-{{ section.id }} .splash-hero-control {
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
    background: rgba(31, 41, 55, 0.42);
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    touch-action: manipulation;
    backdrop-filter: blur(8px);
  }

  .splash-hero-{{ section.id }} :is(.splash-hero-button, .splash-hero-control):focus-visible {
    outline: 3px solid #1f2937;
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .splash-hero-{{ section.id }} {
      padding-inline: 16px;
    }

    .splash-hero-{{ section.id }} .splash-hero-inner {
      min-height: min({{ section_height }}px, 64svh);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} .splash-hero-button {
      transition-duration: 0.01ms;
    }
  }
{% endstyle %}

<splash-ink-hero
  class="splash-hero-{{ section.id }}"
  id="splash-hero-{{ section.id }}"
  data-original-height="{{ section_height }}"
>
  <canvas data-ink-canvas aria-hidden="true"></canvas>
  <canvas data-ink-effects aria-hidden="true"></canvas>

  <div class="page-width">
    <div class="splash-hero-inner">
      <p class="splash-hero-kicker">AllTheStickers</p>
      {% if heading != blank %}
        <h1 class="splash-hero-heading">{{ heading }}</h1>
      {% endif %}
      {% if subtext != blank %}
        <p class="splash-hero-subtext">{{ subtext }}</p>
      {% endif %}

      <div class="splash-hero-touch-hint" data-ink-touch-hint>
        <span class="splash-ink-touch-visual" aria-hidden="true">
          <span class="splash-ink-touch-ring"></span>
          <span class="splash-ink-touch-finger">→</span>
        </span>
        <span class="splash-ink-touch-label">{{ draw_hint | escape }}</span>
      </div>

      <div class="splash-hero-buttons">
        {% for block in section.blocks %}
          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="splash-hero-button splash-hero-button--{{ block.settings.button_style }}"
              style="
                --button-bg: {{ block.settings.button_bg | default: '#6C5CE7' }};
                --button-text: {{ block.settings.button_text | default: '#FFFFFF' }};
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="splash-hero-controls" aria-label="Drawing controls">
    <button
      type="button"
      class="splash-hero-control"
      data-ink-expand
      aria-label="Expand drawing area"
      aria-pressed="false"
      title="Expand drawing area"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
      </svg>
    </button>
    <button
      type="button"
      class="splash-hero-control"
      data-ink-clear
      aria-label="Clear drawing"
      title="Clear drawing"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M8 6V4h8v2M6 6l1 15h10l1-15M10 10v7M14 10v7" />
      </svg>
    </button>
  </div>
</splash-ink-hero>

<script src="{{ 'splash-hero-ink.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Clean Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Vision, A Sticker" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom stickers, fast turnaround, and a clean ordering flow from first click to checkout." },
    { "type": "text", "id": "draw_hint", "label": "Touch drawing hint", "default": "Swipe to draw" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F9FA" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 520, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 72, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 72, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#6C5CE7" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clean Hero",
      "category": "Custom",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "button_label": "Shop Stickers",
            "button_style": "solid",
            "button_bg": "#6C5CE7",
            "button_text": "#FFFFFF"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Design Your Own",
            "button_style": "outline",
            "button_bg": "#6C5CE7",
            "button_text": "#6C5CE7"
          }
        }
      ]
    }
  ]
}
{% endschema %}
