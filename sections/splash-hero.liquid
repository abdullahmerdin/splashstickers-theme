{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background-color: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }

  {% if show_animation %}
  /* ─── SPLASH BLOBS — organic color flows from sides ─── */
  .splash-hero-{{ section.id }} .splash-blob {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    filter: blur(40px);
  }
  .splash-hero-{{ section.id }} .splash-blob:nth-child(1) {
    width: 500px; height: 500px;
    background: rgba(253,121,168,0.35);
    top: -100px; left: -200px;
    animation: blobInLeft 2s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
  }
  .splash-hero-{{ section.id }} .splash-blob:nth-child(2) {
    width: 400px; height: 400px;
    background: rgba(253,206,110,0.25);
    bottom: -80px; right: -150px;
    animation: blobInRight 2.2s cubic-bezier(0.22, 1, 0.36, 1) 0.3s forwards;
  }
  .splash-hero-{{ section.id }} .splash-blob:nth-child(3) {
    width: 350px; height: 350px;
    background: rgba(108,92,231,0.3);
    top: 40%; left: -100px;
    animation: blobInLeft 2.5s cubic-bezier(0.22, 1, 0.36, 1) 0.5s forwards;
  }
  .splash-hero-{{ section.id }} .splash-blob:nth-child(4) {
    width: 300px; height: 300px;
    background: rgba(0,206,201,0.3);
    top: 10%; right: -100px;
    animation: blobInRight 2.8s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards;
  }
  .splash-hero-{{ section.id }} .splash-blob:nth-child(5) {
    width: 250px; height: 250px;
    background: rgba(253,121,168,0.2);
    bottom: 5%; left: 10%;
    animation: blobInLeft 3s cubic-bezier(0.22, 1, 0.36, 1) 0.9s forwards;
  }

  @keyframes blobInLeft {
    0% { transform: translateX(-200px) scale(0.6); opacity: 0; }
    100% { transform: translateX(0) scale(1); opacity: 1; }
  }
  @keyframes blobInRight {
    0% { transform: translateX(200px) scale(0.6); opacity: 0; }
    100% { transform: translateX(0) scale(1); opacity: 1; }
  }

  /* ─── STICKERS — CSS-drawn sticker shapes ─── */
  .splash-hero-{{ section.id }} .sticker-shape {
    position: absolute;
    opacity: 0;
    animation: stickerFly 2.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  .splash-hero-{{ section.id }} .sticker-shape .sticker-inner {
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    position: relative;
  }

  /* Circle sticker with dashed border */
  .splash-hero-{{ section.id }} .sticker-circle {
    width: 80px; height: 80px;
    border-radius: 50%;
    border: 3px dashed rgba(255,255,255,0.6);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1), inset 0 0 20px rgba(255,255,255,0.1);
    backdrop-filter: blur(4px);
  }
  .splash-hero-{{ section.id }} .sticker-circle.pink { background: linear-gradient(135deg, #FD79A8, #fab1a0); }
  .splash-hero-{{ section.id }} .sticker-circle.teal { background: linear-gradient(135deg, #00CEC9, #81ecec); }
  .splash-hero-{{ section.id }} .sticker-circle.purple { background: linear-gradient(135deg, #6C5CE7, #a29bfe); }
  .splash-hero-{{ section.id }} .sticker-circle.gold { background: linear-gradient(135deg, #FDCB6E, #ffeaa7); }

  /* Star sticker using clip-path */
  .splash-hero-{{ section.id }} .sticker-star {
    width: 70px; height: 70px;
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
    border: 3px dashed rgba(255,255,255,0.5);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .splash-hero-{{ section.id }} .sticker-star.gold { background: linear-gradient(135deg, #FDCB6E, #fdcb6e); }

  /* Hexagon sticker */
  .splash-hero-{{ section.id }} .sticker-hex {
    width: 75px; height: 85px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    border: 3px dashed rgba(255,255,255,0.5);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .splash-hero-{{ section.id }} .sticker-hex.teal { background: linear-gradient(135deg, #00CEC9, #81ecec); }

  /* Squircle sticker */
  .splash-hero-{{ section.id }} .sticker-squircle {
    width: 65px; height: 65px;
    border-radius: 30%;
    border: 3px dashed rgba(255,255,255,0.5);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .splash-hero-{{ section.id }} .sticker-squircle.purple { background: linear-gradient(135deg, #6C5CE7, #a29bfe); }

  /* Sticker positions */
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(6) { top: 8%; left: 6%; animation-delay: 0.8s; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(7) { top: 5%; right: 10%; animation-delay: 1.0s; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(8) { bottom: 18%; left: 5%; animation-delay: 1.3s; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(9) { bottom: 8%; right: 6%; animation-delay: 0.9s; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(10) { top: 35%; left: 2%; animation-delay: 1.5s; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(11) { top: 45%; right: 3%; animation-delay: 1.1s; }

  @keyframes stickerFly {
    0% { transform: translate(var(--sx, -60px), var(--sy, -60px)) scale(0) rotate(var(--sr, -30deg)); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: translate(0, 0) scale(1) rotate(var(--sr-end, 0deg)); opacity: 1; }
  }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(6) { --sx: -100px; --sy: -80px; --sr: -40deg; --sr-end: -8deg; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(7) { --sx: 120px; --sy: -60px; --sr: 35deg; --sr-end: 12deg; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(8) { --sx: -80px; --sy: 100px; --sr: 50deg; --sr-end: -10deg; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(9) { --sx: 90px; --sy: 80px; --sr: -45deg; --sr-end: 8deg; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(10) { --sx: -60px; --sy: 50px; --sr: 25deg; --sr-end: -5deg; }
  .splash-hero-{{ section.id }} .sticker-shape:nth-child(11) { --sx: 70px; --sy: -50px; --sr: -20deg; --sr-end: 6deg; }

  /* ─── Content ─── */
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    animation: fadeUp 0.8s ease-out 0.4s both;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.85;
    animation: fadeUp 0.8s ease-out 0.6s both;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 0.8s ease-out 0.8s both;
  }
  @keyframes fadeUp {
    0% { transform: translateY(20px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} .splash-blob,
    .splash-hero-{{ section.id }} .sticker-shape,
    .splash-hero-{{ section.id }} .splash-hero-heading,
    .splash-hero-{{ section.id }} .splash-hero-subtext,
    .splash-hero-{{ section.id }} .splash-hero-buttons {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .splash-hero-{{ section.id }} .splash-blob { opacity: 0.5; }
  }
  {% endif %}
{% endstyle %}

<div class="splash-hero-{{ section.id }}">
  {% if show_animation %}
    <!-- Splash blobs (organic color flows) -->
    <div class="splash-blob"></div>
    <div class="splash-blob"></div>
    <div class="splash-blob"></div>
    <div class="splash-blob"></div>
    <div class="splash-blob"></div>

    <!-- CSS-drawn sticker shapes (no emojis) -->
    <div class="sticker-shape"><div class="sticker-inner sticker-circle pink">♪</div></div>
    <div class="sticker-shape"><div class="sticker-inner sticker-star gold">★</div></div>
    <div class="sticker-shape"><div class="sticker-inner sticker-hex teal">✦</div></div>
    <div class="sticker-shape"><div class="sticker-inner sticker-circle teal">◆</div></div>
    <div class="sticker-shape"><div class="sticker-inner sticker-squircle purple">♥</div></div>
    <div class="sticker-shape"><div class="sticker-inner sticker-circle gold">●</div></div>
  {% endif %}

  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a
            href="{{ block.settings.button_link }}"
            style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;"
            onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.15)'"
            onmouseout="this.style.transform='';this.style.boxShadow=''"
          >{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Splash Your Style"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#00CEC9"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Subtext color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 300, "max": 800, "step": 50, "default": 550,
      "label": "Section height (px)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 120, "step": 8, "default": 80,
      "label": "Padding top (px)"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 120, "step": 8, "default": 80,
      "label": "Padding bottom (px)"
    },
    {
      "type": "checkbox",
      "id": "show_animation",
      "label": "Show splash animation",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        {
          "type": "select", "id": "button_style", "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        { "type": "color", "id": "button_bg", "label": "Background / Border", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#00CEC9" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#00CEC9" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#FFFFFF", "button_text": "#FFFFFF" } }
      ]
    }
  ]
}
{% endschema %}
