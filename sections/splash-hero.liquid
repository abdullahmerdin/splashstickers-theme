{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign show_animation = section.settings.show_animation
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
  }
  .splash-hero-{{ section.id }} canvas#blob-canvas-{{ section.id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
    opacity: 0;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: {{ heading_color }};
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: {{ text_color }};
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  /* Sticker popup elements */
  .splash-hero-{{ section.id }} .sticker-pop {
    position: absolute;
    z-index: 15;
    pointer-events: none;
    opacity: 0;
  }
  .splash-hero-{{ section.id }} .sticker-pop-inner {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.6rem; font-weight: 700;
    color: rgba(255,255,255,0.92);
    border-radius: 50%;
    border: 2.5px dashed rgba(255,255,255,0.5);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    position: relative;
    overflow: hidden;
  }
  .splash-hero-{{ section.id }} .sticker-pop-inner::after {
    content: ''; position: absolute; top: -5px; right: -5px;
    width: 14px; height: 14px;
    background: rgba(255,255,255,0.3); border-radius: 50%;
  }
  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} canvas#blob-canvas-{{ section.id }} { display: none; }
    .splash-hero-{{ section.id }} .splash-hero-content { opacity: 1; }
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  {% if show_animation %}
    <canvas id="blob-canvas-{{ section.id }}"></canvas>
  {% endif %}

  <div class="splash-hero-content" id="splash-content-{{ section.id }}">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% if show_animation %}
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1"></script>
<script>
(function() {
  'use strict';
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('blob-canvas-' + id);
  var content = document.getElementById('splash-content-' + id);
  if (!canvas || !hero) return;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    if (content) content.style.opacity = '1';
    return;
  }

  var ctx = canvas.getContext('2d');
  var W, H, blobs = [], stickers = [], animId;
  var STICKER_SYMBOLS = ['✦','♥','◆','♡','★','♪','✧','○','◇','☆','⊛','✶'];
  var PASTEL_BLOBS = [
    { color: '#FFB5C2', highlight: '#FFD1DC' },
    { color: '#C3AED6', highlight: '#E6E6FA' },
    { color: '#B5EAD7', highlight: '#D4F5E2' },
    { color: '#FFDAB9', highlight: '#FFE8D6' },
    { color: '#B5D8EB', highlight: '#D4EAF5' },
    { color: '#FFF5BA', highlight: '#FFFDE0' },
  ];

  function resize() {
    var r = hero.getBoundingClientRect();
    var dpr = window.devicePixelRatio || 1;
    W = canvas.width = r.width * dpr;
    H = canvas.height = r.height * dpr;
    canvas.style.width = r.width + 'px';
    canvas.style.height = r.height + 'px';
    ctx.scale(dpr, dpr);
    return { w: r.width, h: r.height };
  }

  function rand(a, b) { return Math.random() * (b - a) + a; }

  function createBlob(palette, fromSide) {
    var r = { w: hero.getBoundingClientRect().width, h: hero.getBoundingClientRect().height };
    var size = rand(35, 70);
    var x, y;
    switch(fromSide) {
      case 0: x = -size; y = rand(0, r.h); break; // left
      case 1: x = r.w + size; y = rand(0, r.h); break; // right
      case 2: x = rand(0, r.w); y = -size; break; // top
      case 3: x = rand(0, r.w); y = r.h + size; break; // bottom
      default: x = -size; y = rand(0, r.h);
    }
    var angle = Math.atan2(r.h/2 - y, r.w/2 - x);
    var speed = rand(3, 8);
    return {
      x: x, y: y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed,
      size: size,
      color: palette.color,
      highlight: palette.highlight,
      rotation: rand(0, Math.PI * 2),
      rotSpeed: rand(-0.02, 0.02),
      entered: false,
      collided: false
    };
  }

  function spawnStickers(cx, cy, count) {
    for (var i = 0; i < count; i++) {
      var angle = rand(0, Math.PI * 2);
      var speed = rand(3, 10);
      var size = rand(20, 35);
      var p = PASTEL_BLOBS[Math.floor(Math.random() * PASTEL_BLOBS.length)];
      stickers.push({
        x: cx, y: cy,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed - rand(1, 3),
        size: size,
        color: p.color,
        symbol: STICKER_SYMBOLS[Math.floor(Math.random() * STICKER_SYMBOLS.length)],
        life: 1,
        decay: rand(0.003, 0.008),
        gravity: rand(0.04, 0.08),
        rotation: rand(-0.3, 0.3),
        rotSpeed: rand(-0.03, 0.03)
      });
    }
  }

  function checkCollisions() {
    for (var i = 0; i < blobs.length; i++) {
      for (var j = i + 1; j < blobs.length; j++) {
        var a = blobs[i], b = blobs[j];
        var dx = b.x - a.x, dy = b.y - a.y;
        var dist = Math.sqrt(dx * dx + dy * dy);
        var minDist = a.size / 2 + b.size / 2;
        if (dist < minDist && dist > 0 && !a.collided && !b.collided) {
          a.collided = true;
          b.collided = true;

          // Explosion confetti at collision point
          var cx = (a.x + b.x) / 2;
          var cy = (a.y + b.y) / 2;
          var normCx = cx / (hero.getBoundingClientRect().width || 1);
          var normCy = cy / (hero.getBoundingClientRect().height || 1);

          confetti({
            particleCount: 50,
            spread: 200,
            origin: { x: normCx, y: normCy },
            colors: [a.color, b.color, '#FFB5C2', '#C3AED6', '#B5EAD7'],
            ticks: 150,
            gravity: 0.6,
            scalar: 0.9,
            startVelocity: 25
          });

          // Spawn DOM stickers
          spawnStickers(cx, cy, Math.floor(rand(3, 6)));

          // Push blobs apart
          var overlap = minDist - dist;
          var nx = dx / dist, ny = dy / dist;
          a.x -= nx * overlap / 2;
          a.y -= ny * overlap / 2;
          b.x += nx * overlap / 2;
          b.y += ny * overlap / 2;
          a.vx = -a.vx * 0.5;
          a.vy = -a.vy * 0.5;
          b.vx = -b.vx * 0.5;
          b.vy = -b.vy * 0.5;
        }
      }
    }
  }

  function drawBlob(b) {
    ctx.save();
    ctx.translate(b.x, b.y);
    ctx.rotate(b.rotation);
    // 3D-like gradient
    var grad = ctx.createRadialGradient(-b.size*0.15, -b.size*0.15, b.size*0.1, 0, 0, b.size/2);
    grad.addColorStop(0, b.highlight);
    grad.addColorStop(0.6, b.color);
    grad.addColorStop(1, 'rgba(0,0,0,0.08)');
    ctx.fillStyle = grad;
    ctx.shadowColor = 'rgba(0,0,0,0.12)';
    ctx.shadowBlur = 16;
    ctx.shadowOffsetY = 4;
    ctx.beginPath();
    ctx.arc(0, 0, b.size/2, 0, Math.PI * 2);
    ctx.fill();
    // Specular highlight
    ctx.shadowColor = 'transparent';
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.beginPath();
    ctx.ellipse(-b.size*0.15, -b.size*0.2, b.size*0.2, b.size*0.12, -0.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  function drawSticker(s) {
    ctx.save();
    ctx.translate(s.x, s.y);
    ctx.rotate(s.rotation);
    ctx.globalAlpha = s.life;
    // Shadow
    ctx.shadowColor = 'rgba(0,0,0,0.08)';
    ctx.shadowBlur = 12;
    ctx.shadowOffsetY = 3;
    // Body
    var grad = ctx.createRadialGradient(-s.size*0.1, -s.size*0.1, 2, 0, 0, s.size/2);
    grad.addColorStop(0, '#FFFFFF');
    grad.addColorStop(1, s.color);
    ctx.fillStyle = grad;
    var r = s.size / 2;
    ctx.beginPath();
    ctx.arc(0, 0, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowColor = 'transparent';
    // Dashed border
    ctx.setLineDash([3, 3]);
    ctx.strokeStyle = 'rgba(255,255,255,0.5)';
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.setLineDash([]);
    // Peel
    ctx.fillStyle = 'rgba(255,255,255,0.2)';
    ctx.beginPath();
    ctx.arc(r - 5, -r + 5, 7, 0, Math.PI * 2);
    ctx.fill();
    // Symbol
    ctx.fillStyle = 'rgba(255,255,255,0.9)';
    ctx.font = 'bold ' + (r * 0.7) + 'px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(s.symbol, 0, 1);
    ctx.restore();
  }

  function updateBlob(b, r) {
    b.x += b.vx;
    b.y += b.vy;
    b.rotation += b.rotSpeed;
    // Bounce off walls
    if (b.x - b.size/2 < 0) { b.x = b.size/2; b.vx *= -0.5; }
    if (b.x + b.size/2 > r.w) { b.x = r.w - b.size/2; b.vx *= -0.5; }
    if (b.y - b.size/2 < 0) { b.y = b.size/2; b.vy *= -0.5; }
    if (b.y + b.size/2 > r.h) { b.y = r.h - b.size/2; b.vy *= -0.5; }
  }

  function updateSticker(s) {
    s.x += s.vx;
    s.y += s.vy;
    s.vy += s.gravity;
    s.vx *= 0.97;
    s.rotation += s.rotSpeed;
    s.life -= s.decay;
  }

  var allCollided = false;
  var allDoneFired = false;

  function loop() {
    var r = { w: hero.getBoundingClientRect().width, h: hero.getBoundingClientRect().height };
    ctx.clearRect(0, 0, r.w, r.h);

    // Check if all blobs have entered the frame
    var allEntered = true;
    for (var i = 0; i < blobs.length; i++) {
      var b = blobs[i];
      if (b.x >= 0 && b.x <= r.w && b.y >= 0 && b.y <= r.h) b.entered = true;
      if (!b.entered) allEntered = false;
    }

    // Collision detection
    checkCollisions();

    // Update and draw blobs
    for (var i = blobs.length - 1; i >= 0; i--) {
      updateBlob(blobs[i], r);
      drawBlob(blobs[i]);
    }

    // Update and draw stickers
    for (var i = stickers.length - 1; i >= 0; i--) {
      updateSticker(stickers[i]);
      if (stickers[i].life <= 0) { stickers.splice(i, 1); continue; }
      drawSticker(stickers[i]);
    }

    // Check if all collision events done
    allCollided = true;
    for (var i = 0; i < blobs.length; i++) {
      if (!blobs[i].collided) { allCollided = false; break; }
    }

    if (allEntered && allCollided && !allDoneFired) {
      allDoneFired = true;
      // Final big confetti burst
      confetti({
        particleCount: 80,
        spread: 180,
        origin: { x: 0.5, y: 0.5 },
        colors: ['#FFB5C2','#C3AED6','#B5EAD7','#FFDAB9','#B5D8EB','#FFF5BA'],
        ticks: 200,
        gravity: 0.5,
        scalar: 1.2,
        startVelocity: 30
      });
      // Fade in content
      setTimeout(function() {
        content.style.transition = 'opacity 0.6s ease-out';
        content.style.opacity = '1';
      }, 200);
      // Stop animation loop after stickers fade
      setTimeout(function() { if (animId) cancelAnimationFrame(animId); }, 4000);
      return;
    }

    animId = requestAnimationFrame(loop);
  }

  function init() {
    var r = resize();
    // Create blobs entering from different sides
    for (var i = 0; i < 6; i++) {
      blobs.push(createBlob(PASTEL_BLOBS[i % PASTEL_BLOBS.length], i % 4));
    }
    loop();
    window.addEventListener('resize', resize);
  }

  if (document.readyState === 'complete') init();
  else window.addEventListener('load', init);
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Premium custom stickers \u2014 Vibrant colors \u2014 Worldwide shipping" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F0E6FF" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#5B4B6A" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "#7A6B8A" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" },
    { "type": "checkbox", "id": "show_animation", "label": "Show animation", "default": true }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#7A6B8A" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#7A6B8A" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#7A6B8A", "button_text": "#7A6B8A" } }
      ]
    }
  ]
}
{% endschema %}
