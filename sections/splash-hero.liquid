{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    display: flex;
    min-height: {{ section_height }}px;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    overflow: hidden;
    isolation: isolate;
    background: {{ bg_color }};
    cursor: crosshair;
    touch-action: pan-y;
    transition: min-height 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: saturate(1.08) contrast(1.03);
  }

  .splash-hero-{{ section.id }} [data-ink-effects] {
    z-index: 2;
  }

  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    width: min(100%, 640px);
    text-align: center;
  }

  .splash-hero-{{ section.id }} .splash-hero-heading {
    margin: 0 0 16px;
    color: #ffffff;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 1.1;
    text-shadow: 0 4px 24px rgb(25 16 68 / 35%);
  }

  .splash-hero-{{ section.id }} .splash-hero-subtext {
    margin: 0 0 32px;
    color: #ffffff;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.5;
    opacity: 0.9;
    text-shadow: 0 2px 14px rgb(25 16 68 / 30%);
  }

  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  .splash-hero-{{ section.id }} .splash-hero-button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    padding: 12px 34px;
    border-radius: 999px;
    color: var(--splash-button-text);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .splash-hero-{{ section.id }} .splash-hero-button--solid {
    background: var(--splash-button-bg);
    border: 2px solid var(--splash-button-bg);
  }

  .splash-hero-{{ section.id }} .splash-hero-button--outline {
    background: rgb(255 255 255 / 10%);
    border: 2px solid var(--splash-button-bg);
    backdrop-filter: blur(8px);
  }

  .splash-hero-{{ section.id }} .splash-hero-button:hover {
    box-shadow: 0 8px 24px rgb(25 16 68 / 22%);
    transform: translateY(-2px);
  }

  .splash-hero-{{ section.id }} .splash-hero-controls {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    display: grid;
    gap: 10px;
  }

  .splash-hero-{{ section.id }} .splash-hero-control {
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
    background: rgb(255 255 255 / 12%);
    border: 1px solid rgb(255 255 255 / 35%);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }

  .splash-hero-{{ section.id }} .splash-hero-control:hover {
    background: rgb(255 255 255 / 25%);
    border-color: rgb(255 255 255 / 65%);
    transform: scale(1.05);
  }

  .splash-hero-{{ section.id }} :is(.splash-hero-button, .splash-hero-control):focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }},
    .splash-hero-{{ section.id }} :is(.splash-hero-button, .splash-hero-control) {
      transition-duration: 0.01ms;
    }
  }
{% endstyle %}

<splash-ink-hero
  class="splash-hero-{{ section.id }}"
  id="splash-hero-{{ section.id }}"
  data-original-height="{{ section_height }}"
>
  <canvas data-ink-canvas aria-hidden="true"></canvas>
  <canvas data-ink-effects aria-hidden="true"></canvas>

  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}

    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a
            href="{{ block.settings.button_link }}"
            class="splash-hero-button splash-hero-button--{{ block.settings.button_style }}"
            style="--splash-button-bg: {{ block.settings.button_bg }}; --splash-button-text: {{ block.settings.button_text }};"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="splash-hero-controls" aria-label="Drawing controls">
    <button
      type="button"
      class="splash-hero-control"
      data-ink-expand
      aria-label="Expand drawing area"
      aria-pressed="false"
      title="Expand drawing area"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
      </svg>
    </button>
    <button
      type="button"
      class="splash-hero-control"
      data-ink-clear
      aria-label="Clear drawing"
      title="Clear drawing"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M8 6V4h8v2M6 6l1 15h10l1-15M10 10v7M14 10v7" />
      </svg>
    </button>
  </div>
</splash-ink-hero>

<script src="{{ 'splash-hero-ink.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Draw with liquid ink" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "button_label": "Shop Stickers",
            "button_style": "solid",
            "button_bg": "#FFFFFF",
            "button_text": "#1A1A2E"
          }
        }
      ]
    }
  ]
}
{% endschema %}
