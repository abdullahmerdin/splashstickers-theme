{%- liquid
  assign heading = section.settings.heading
  assign draw_hint = section.settings.draw_hint | default: 'Swipe to draw'
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    display: flex;
    box-sizing: border-box;
    min-height: calc({{ section_height }}px + {{ padding_top }}px + {{ padding_bottom }}px);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    isolation: isolate;
    background: {{ bg_color }};
    color: var(--splash-color-ink);
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
    touch-action: auto;
    overscroll-behavior: auto;
    user-select: none;
    -webkit-user-select: none;
  }

  .splash-hero-{{ section.id }}[data-expanded] {
    height: 100svh;
    min-height: 100svh;
    max-height: 100svh;
  }

  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    filter: saturate(1.08) contrast(1.03);
  }

  .splash-hero-{{ section.id }} [data-ink-effects] {
    z-index: 2;
  }

  .splash-hero-{{ section.id }} > .page-width {
    position: relative;
    z-index: 20;
    width: 100%;
  }

  .splash-hero-{{ section.id }} .splash-hero-inner {
    display: grid;
    min-height: min({{ section_height }}px, 72svh);
    max-width: 760px;
    margin: 0 auto;
    align-content: center;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  .splash-hero-{{ section.id }} .splash-hero-touch-hint {
    display: none;
    position: relative;
    z-index: 21;
    margin: -4px 0 2px;
    align-items: center;
    justify-content: center;
    color: rgb(var(--splash-color-ink-rgb) / 0.72);
    font-size: 0.9rem;
    font-weight: 650;
    line-height: 1.3;
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
    white-space: nowrap;
  }

  .splash-hero-{{ section.id }} .splash-hero-heading {
    margin: 0;
    font-size: clamp(2.4rem, 5.5vw, 4.8rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    user-select: none;
    -webkit-user-select: none;
  }

  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 8px;
  }

  .splash-hero-{{ section.id }} .splash-hero-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border: 1px solid transparent;
    border-radius: var(--splash-radius-control);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--splash-transition), box-shadow var(--splash-transition),
      background-color var(--splash-transition), border-color var(--splash-transition),
      color var(--splash-transition);
  }

  .splash-hero-{{ section.id }} .splash-hero-button--solid {
    background: var(--button-bg);
    border-color: var(--button-bg);
    color: var(--button-text);
    box-shadow: 0 12px 24px rgb(var(--splash-color-purple-rgb) / 0.16);
  }

  .splash-hero-{{ section.id }} .splash-hero-button--outline {
    background: rgb(var(--splash-color-surface-rgb) / 0.72);
    border-color: var(--button-bg);
    color: var(--button-text);
    backdrop-filter: blur(10px);
  }

  .splash-hero-{{ section.id }} .splash-hero-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 20px rgb(var(--splash-color-ink-rgb) / 0.1);
  }

  .splash-hero-{{ section.id }} .splash-hero-controls {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 30;
    display: grid;
    gap: 10px;
  }

  .splash-hero-{{ section.id }} .splash-hero-control {
    display: grid;
    width: 42px;
    height: 42px;
    padding: 0;
    place-items: center;
    background: rgb(var(--splash-color-ink-rgb) / 0.42);
    border: 1px solid rgb(var(--splash-color-on-accent-rgb) / 0.45);
    border-radius: 50%;
    color: var(--splash-color-on-accent);
    cursor: pointer;
    touch-action: manipulation;
    backdrop-filter: blur(8px);
  }

  .splash-hero-{{ section.id }} :is(.splash-hero-button, .splash-hero-control):focus-visible {
    outline: var(--splash-focus-width) solid var(--splash-color-focus);
    outline-offset: 3px;
  }

  @media (max-width: 749px) {
    .splash-hero-{{ section.id }} {
      padding-inline: 16px;
      touch-action: pan-y;
      overscroll-behavior: auto;
    }

    .splash-hero-{{ section.id }} .splash-hero-inner {
      min-height: min({{ section_height }}px, 64svh);
    }

    .splash-hero-{{ section.id }} .splash-hero-touch-hint {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .splash-hero-{{ section.id }} .splash-hero-button {
      transition-duration: 0.01ms;
    }
  }
{% endstyle %}

<splash-ink-hero
  class="splash-hero-{{ section.id }}"
  id="splash-hero-{{ section.id }}"
  role="group"
  aria-label="Interactive drawing area"
  aria-describedby="splash-hero-hint-{{ section.id }}"
>
  <canvas data-ink-canvas aria-hidden="true"></canvas>
  <canvas data-ink-effects aria-hidden="true"></canvas>

  {% # theme-check-disable-next-line ValidScopedCSSClass %}
  <div class="page-width">
    <div class="splash-hero-inner">
      {% if heading != blank %}
        <h1 class="splash-hero-heading">{{ heading }}</h1>
      {% endif %}
      <p id="splash-hero-hint-{{ section.id }}" class="splash-hero-touch-hint">{{ draw_hint | escape }}</p>

      <div class="splash-hero-buttons">
        {% for block in section.blocks %}
          {% if block.settings.button_label != blank and block.settings.button_link != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="splash-hero-button splash-hero-button--{{ block.settings.button_style }}"
              style="
                --button-bg: {{ block.settings.button_bg | default: '#6C5CE7' }};
                --button-text: {{ block.settings.button_text | default: '#FFFFFF' }};
              "
              {{ block.shopify_attributes }}
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="splash-hero-controls" role="group" aria-label="Drawing controls">
    <button
      type="button"
      class="splash-hero-control"
      data-ink-expand
      aria-label="Expand drawing area"
      aria-expanded="false"
      title="Expand drawing area"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" />
      </svg>
    </button>
    <button
      type="button"
      class="splash-hero-control"
      data-ink-clear
      aria-label="Clear drawing"
      title="Clear drawing"
    >
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 6h18M8 6V4h8v2M6 6l1 15h10l1-15M10 10v7M14 10v7" />
      </svg>
    </button>
  </div>
</splash-ink-hero>

<script src="{{ 'splash-hero-ink.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "Splash Drawing Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Vision, A Sticker" },
    { "type": "text", "id": "draw_hint", "label": "Touch drawing hint", "default": "Swipe to draw" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F8F9FA" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 10, "default": 520, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 72, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 72, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" }
          ],
          "default": "solid"
        },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#6C5CE7" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#FFFFFF" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Drawing Hero",
      "category": "Custom",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "button_label": "Shop Stickers",
            "button_style": "solid",
            "button_bg": "#6C5CE7",
            "button_text": "#FFFFFF"
          }
        },
        {
          "type": "button",
          "settings": {
            "button_label": "Design Your Own",
            "button_style": "outline",
            "button_bg": "#6C5CE7",
            "button_text": "#6C5CE7"
          }
        }
      ]
    }
  ]
}
{% endschema %}
