{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    margin: 0 0 16px;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #FFFFFF;
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <canvas id="ink-canvas-{{ section.id }}"></canvas>
  <div class="splash-hero-content">
    {% if heading != blank %}<h1 class="splash-hero-heading">{{ heading }}</h1>{% endif %}
    {% if subtext != blank %}<p class="splash-hero-subtext">{{ subtext }}</p>{% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function() {
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('ink-canvas-' + id);
  if (!canvas || !hero) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var ctx = canvas.getContext('2d');
  var dotCanvas = document.createElement('canvas');
  var dotCtx = dotCanvas.getContext('2d');
  var W, H, dpr = window.devicePixelRatio || 1;

  function resize() {
    var r = hero.getBoundingClientRect();
    W = r.width; H = r.height;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = W + 'px';
    canvas.style.height = H + 'px';
    dotCanvas.width = W * dpr;
    dotCanvas.height = H * dpr;
    dotCanvas.style.width = W + 'px';
    dotCanvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    dotCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  canvas.style.position = 'absolute';
  canvas.style.inset = '0';
  canvas.style.pointerEvents = 'none';
  canvas.style.zIndex = '1';
  hero.prepend(canvas);

  dotCanvas.style.position = 'absolute';
  dotCanvas.style.inset = '0';
  dotCanvas.style.pointerEvents = 'none';
  dotCanvas.style.zIndex = '2';
  hero.prepend(dotCanvas);

  var COLORS = ['#FF4381','#FF6B35','#00E5A0','#4D7CFF','#A855F7','#FFD700'];
  function pick() { return COLORS[Math.floor(Math.random() * COLORS.length)]; }
  function rand(a,b) { return Math.random() * (b - a) + a; }

  var lastX = null, lastY = null, lastColor = null;
  var segments = [];
  function paintStroke(x1, y1, x2, y2, speed) {
    var color = lastColor || pick();
    var nextColor = pick();
    var width = Math.min(Math.max(8, 35 - speed * 1.2), 40);

    var seg = {
      x1: x1, y1: y1, x2: x2, y2: y2, w: width,
      colorFrom: color,
      colorTo: nextColor,
      ts: Date.now()
    };
    segments.push(seg);
    drawSegment(seg);
    lastColor = nextColor;

    // Splatter dots
    if (speed > 8 && Math.random() > 0.75) {
      var num = Math.floor(Math.min(speed * 0.45, 7));
      for (var i = 0; i < num; i++) {
        var a = Math.random() * Math.PI * 2;
        var d = rand(10, 20 + speed * 1.2);
        var dot = {
          sx: x2, sy: y2,            // source (where it spawns)
          ex: x2 + Math.cos(a) * d,   // end (where it lands)
          ey: y2 + Math.sin(a) * d,
          x: x2, y: y2,               // current position
          r: rand(2, 3 + speed * 0.03),
          color: nextColor,
          ts: Date.now(),
          progress: 0,                 // 0→1 animation
          delay: Math.random() * 100,
          speed: rand(0.02, 0.05)     // animation speed
        };
        segments.push(dot);
        drawDot(dot);
        animateDot(dot);
      }
    }
  }

  function drawDot(dot) {
    ctx.save();
    ctx.fillStyle = dot.color;
    ctx.globalAlpha = 0.35;
    ctx.beginPath();
    ctx.arc(dot.x, dot.y, dot.r, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
    dotCtx.save();
    dotCtx.fillStyle = dot.color;
    dotCtx.globalAlpha = 0.35;
    dotCtx.beginPath();
    dotCtx.arc(dot.x, dot.y, dot.r, 0, Math.PI * 2);
    dotCtx.fill();
    dotCtx.restore();
  }

  // ─── Animate dot splatter ───
  function animateDot(dot) {
    var start = Date.now();
    var dur = 800;
    (function step() {
      var el = Date.now() - start - dot.delay;
      if (el < 0) { requestAnimationFrame(step); return; }
      var p = Math.min(1, el / dur);
      var t = 1 - Math.pow(1 - p, 3);
      dot.x = dot.sx + (dot.ex - dot.sx) * t;
      dot.y = dot.sy + (dot.ey - dot.sy) * t;
      dot.progress = p;
      dotCtx.clearRect(0, 0, W, H);
      for (var i = 0; i < segments.length; i++) {
        var s = segments[i];
        if (s.r !== undefined) {
          dotCtx.save();
          dotCtx.fillStyle = s.color;
          dotCtx.globalAlpha = 0.35;
          dotCtx.beginPath();
          dotCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
          dotCtx.fill();
          dotCtx.restore();
        }
      }
      if (p < 1) requestAnimationFrame(step);
    })();
  }

  function drawSegment(seg) {
    // Gradient covers 50% of segment
    var dx = seg.x2 - seg.x1, dy = seg.y2 - seg.y1;
    var dist = Math.sqrt(dx*dx + dy*dy) || 1;
    var span = 0.5;
    var mx = (seg.x1 + seg.x2) / 2;
    var my = (seg.y1 + seg.y2) / 2;
    var nx = dx / dist, ny = dy / dist;
    var grad = ctx.createLinearGradient(mx - nx * dist * span/2, my - ny * dist * span/2, mx + nx * dist * span/2, my + ny * dist * span/2);
    grad.addColorStop(0, seg.colorFrom);
    grad.addColorStop(1, seg.colorTo);

    // Layer 1: bleed
    ctx.save();
    ctx.globalAlpha = 0.12;
    ctx.strokeStyle = grad;
    ctx.lineWidth = seg.w + 10;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(seg.x1, seg.y1);
    ctx.lineTo(seg.x2, seg.y2);
    ctx.stroke();
    ctx.restore();

    // Layer 2: main body
    ctx.save();
    ctx.strokeStyle = grad;
    ctx.lineWidth = seg.w;
    ctx.lineCap = 'round';
    ctx.globalAlpha = 0.95;
    ctx.beginPath();
    ctx.moveTo(seg.x1, seg.y1);
    ctx.lineTo(seg.x2, seg.y2);
    ctx.stroke();
    ctx.restore();

    // Layer 3: highlight (white on top, no gradient)
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,0.15)';
    ctx.lineWidth = Math.max(3, seg.w * 0.25);
    ctx.lineCap = 'round';
    ctx.globalAlpha = 1;
    ctx.beginPath();
    ctx.moveTo(seg.x1, seg.y1);
    ctx.lineTo(seg.x2, seg.y2);
    ctx.stroke();
    ctx.restore();
  }

  
  // ─── Redraw all visible segments ───
  function redrawAll() {
    ctx.clearRect(0, 0, W, H);
    for (var i = 0; i < segments.length; i++) {
      var seg = segments[i];
      if (seg.r !== undefined) drawDot(seg);
      else drawSegment(seg);
    }
  }

  // ─── Release splat ───
  function releaseSplat(x, y, speed) {
    speed = speed || 8;
    var color = lastColor || pick();
    lastColor = pick();
    var num = Math.floor(rand(6, 12 + speed * 0.3));
    for (var i = 0; i < num; i++) {
      var a = Math.random() * Math.PI * 2;
      var d = rand(8, 20 + speed);
      var dot = {
        x: x + Math.cos(a) * d,
        y: y + Math.sin(a) * d,
        r: rand(3, 7),
        color: color,
        ts: Date.now()
      };
      segments.push(dot);
      drawDot(dot);
      animateDot(dot);
    }
    // Central burst
    ctx.save();
    var g = ctx.createRadialGradient(x-3, y-3, 0, x, y, 18);
    g.addColorStop(0, 'rgba(255,255,255,0.2)');
    g.addColorStop(0.5, color);
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = g;
    ctx.globalAlpha = 0.5;
    ctx.beginPath();
    ctx.arc(x, y, 18, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // ─── Mouse ───
  function getPos(e) {
    var r = hero.getBoundingClientRect();
    if (e.touches) return { x: e.touches[0].clientX - r.left, y: e.touches[0].clientY - r.top };
    return { x: e.clientX - r.left, y: e.clientY - r.top };
  }

  hero.addEventListener('mousemove', function(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;
    if (lastX !== null) {
      var dx = x - lastX, dy = y - lastY;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist > 2) paintStroke(lastX, lastY, x, y, dist);
    }
    lastX = x; lastY = y;
      });
  hero.addEventListener('touchmove', function(e) {
    var pos = getPos(e);
    var x = pos.x, y = pos.y;
    if (lastX !== null) {
      var dx = x - lastX, dy = y - lastY;
      var dist = Math.sqrt(dx*dx + dy*dy);
      if (dist > 2) paintStroke(lastX, lastY, x, y, dist);
    }
    lastX = x; lastY = y;
      });
  hero.addEventListener('mouseleave', function() { if (lastX !== null) { releaseSplat(lastX, lastY); lastX = null; } });
  hero.addEventListener('mouseup', function() { if (lastX !== null) { releaseSplat(lastX, lastY); lastX = null; } });
  hero.addEventListener('touchstart', function(e) { var p = getPos(e); lastX = p.x; lastY = p.y; });
  hero.addEventListener('touchend', function() { if (lastX !== null) { releaseSplat(lastX, lastY); lastX = null; } });

  // ─── Welcome ───
  function welcome() {
    var cx = W/2, cy = H/2;
    for (var i = 0; i < 12; i++) {
      var a = (i / 12) * Math.PI * 2;
      var d = 20 + (i % 3) * 15;
      paintStroke(cx + Math.cos(a) * d * 0.3, cy + Math.sin(a) * d * 0.3, cx + Math.cos(a) * d, cy + Math.sin(a) * d, 6);
    }
    releaseSplat(cx, cy, 6);
  }
  setTimeout(welcome, 200);

  // Start dot animation loop
  // animateDot called per-dot in paintStroke
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Draw with liquid ink" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
