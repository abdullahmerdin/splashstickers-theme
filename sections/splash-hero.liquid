    10|{% style %}
    11|  .splash-hero-{{ section.id }} {
    12|    position: relative;
    13|    overflow: hidden;
    14|    background: {{ bg_color }};
    15|    min-height: {{ section_height }}px;
    16|    display: flex;
    17|    align-items: center;
    18|    justify-content: center;
    19|    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    20|    cursor: crosshair;
    21|  }
    22|  .splash-hero-{{ section.id }} canvas {
    23|    position: absolute;
    24|    inset: 0;
    25|    width: 100%;
    26|    height: 100%;
    27|    pointer-events: none;
    28|    z-index: 1;
    29|  }
    30|  .splash-hero-{{ section.id }} .splash-hero-content {
    31|    position: relative;
    32|    z-index: 20;
    33|    text-align: center;
    34|    max-width: 640px;
    35|  }
    36|  .splash-hero-{{ section.id }} .splash-hero-heading {
    37|    font-size: clamp(2.5rem, 6vw, 4.5rem);
    38|    font-weight: 900;
    39|    color: #FFFFFF;
    40|    line-height: 1.1;
    41|    margin: 0 0 16px;
    42|    mix-blend-mode: difference;
    43|  }
    44|  .splash-hero-{{ section.id }} .splash-hero-subtext {
    45|    font-size: clamp(1rem, 2vw, 1.2rem);
    46|    color: #FFFFFF;
    47|    margin: 0 0 32px;
    48|    line-height: 1.5;
    49|    opacity: 0.9;
    50|    mix-blend-mode: difference;
    51|  }
    52|  .splash-hero-{{ section.id }} .splash-hero-buttons {
    53|    display: flex;
    54|    gap: 16px;
    55|    justify-content: center;
    56|    flex-wrap: wrap;
    57|  }
    58|{% endstyle %}
    59|
    60|<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
    61|  <canvas id="ink-canvas-{{ section.id }}"></canvas>
    62|  <div class="splash-hero-content">
    63|    {% if heading != blank %}<h1 class="splash-hero-heading">{{ heading }}</h1>{% endif %}
    64|    {% if subtext != blank %}<p class="splash-hero-subtext">{{ subtext }}</p>{% endif %}
    65|    <div class="splash-hero-buttons">
    66|      {% for block in section.blocks %}
    67|        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
    68|          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
    69|        {% endif %}
    70|      {% endfor %}
    71|    </div>
    72|  </div>
    73|</div>
