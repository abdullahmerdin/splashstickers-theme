   382|{% schema %}
   383|{
   384|  "name": "Splash Hero",
   385|  "tag": "section",
   386|  "class": "splash-hero",
   387|  "settings": [
   388|    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
   389|    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Draw with liquid ink" },
   390|    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
   391|    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
   392|    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
   393|    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
   394|  ],
   395|  "blocks": [
   396|    {
   397|      "type": "button", "name": "Button", "limit": 3,
   398|      "settings": [
   399|        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
   400|        { "type": "url", "id": "button_link", "label": "Link" },
   401|        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
   402|        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
   403|        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
   404|      ]
   405|    }
   406|  ],
   407|  "presets": [
   408|    {
   409|      "name": "Splash Hero",
   410|      "category": "Custom",
   411|      "blocks": [
   412|        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
   413|      ]
   414|    }
   415|  ]
   416|}
   417|{% endschema %}
