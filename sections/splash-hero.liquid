{%- liquid
  assign heading = section.settings.heading
  assign subtext = section.settings.subtext
  assign bg_color = section.settings.background_color
  assign heading_color = section.settings.heading_color
  assign text_color = section.settings.text_color
  assign section_height = section.settings.section_height
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
-%}

{% style %}
  .splash-hero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background: {{ bg_color }};
    min-height: {{ section_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ padding_top }}px 20px {{ padding_bottom }}px;
    cursor: crosshair;
  }
  .splash-hero-{{ section.id }} canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }
  .splash-hero-{{ section.id }} .splash-hero-content {
    position: relative;
    z-index: 20;
    text-align: center;
    max-width: 640px;
  }
  .splash-hero-{{ section.id }} .splash-hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #FFFFFF;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    position: relative;
    z-index: 25;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-subtext {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #FFFFFF;
    margin: 0 0 32px;
    line-height: 1.5;
    opacity: 0.9;
    position: relative;
    z-index: 25;
    mix-blend-mode: difference;
  }
  .splash-hero-{{ section.id }} .splash-hero-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
    z-index: 25;
  }
{% endstyle %}

<div class="splash-hero-{{ section.id }}" id="splash-hero-{{ section.id }}">
  <canvas id="ink-canvas-{{ section.id }}" resize></canvas>
  <div class="splash-hero-content">
    {% if heading != blank %}
      <h1 class="splash-hero-heading">{{ heading }}</h1>
    {% endif %}
    {% if subtext != blank %}
      <p class="splash-hero-subtext">{{ subtext }}</p>
    {% endif %}
    <div class="splash-hero-buttons">
      {% for block in section.blocks %}
        {% if block.settings.button_label != blank and block.settings.button_link != blank %}
          <a href="{{ block.settings.button_link }}" style="display:inline-block;padding:14px 36px;border-radius:50px;font-weight:700;font-size:1rem;text-decoration:none;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};border:{% if block.settings.button_style == 'outline' %}2px solid {{ block.settings.button_bg }}{% else %}none{% endif %};transition:transform 0.3s ease,box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 6px 20px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">{{ block.settings.button_label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/paper.js/0.12.17/paper-full.min.js"></script>
<script>
(function() {
  'use strict';
  var id = '{{ section.id }}';
  var hero = document.getElementById('splash-hero-' + id);
  var canvas = document.getElementById('ink-canvas-' + id);
  if (!canvas || !hero) return;

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var COLORS = ['#FF4381','#FF6B35','#00E5A0','#4D7CFF','#A855F7','#FFD700'];
  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
  function rand(a, b) { return Math.random() * (b - a) + a; }

  var scope = new paper.PaperScope();
  scope.setup(canvas);

  var path = null;
  var lastPt = null;

  function onMouseMove(event) {
    if (!path) {
      // Start a new path
      path = new scope.Path();
      path.strokeColor = pick(COLORS);
      path.strokeWidth = 0;
      path.strokeCap = 'round';
      path.strokeJoin = 'round';
      path.add(event.point);
      return;
    }

    // Add point to path
    path.add(event.point);

    // Smooth the path
    path.smooth({ type: 'continuous' });

    // Vary stroke width by speed
    var speed = event.delta.length;
    var width = Math.min(Math.max(12, 45 - speed * 1.5), 55);
    path.strokeWidth = width;

    // Random color per segment change
    if (Math.random() > 0.3) {
      path.strokeColor = pick(COLORS);
    }

    if (speed > 5 && Math.random() > 0.6) {
      var num = Math.floor(Math.min(speed * 0.5, 3));
      for (var i = 0; i < num; i++) {
        var a = Math.random() * Math.PI * 2;
        var d = rand(10, 18 + speed);
        var dot = new scope.Path.Circle({
          center: [event.point.x + Math.cos(a) * d, event.point.y + Math.sin(a) * d],
          radius: rand(2, 4),
          fillColor: path.strokeColor,
          opacity: 0.3
        });
        scope.project.activeLayer.addChild(dot);
      }
    }

    scope.view.draw();
  }

  function endStroke() {
    if (path) {
      // Release splash at end point
      if (path.segments.length > 1) {
        var last = path.lastSegment.point;
        var color = path.strokeColor;
        var num = Math.floor(rand(8, 16));
        for (var i = 0; i < num; i++) {
          var a = Math.random() * Math.PI * 2;
          var d = rand(10, 30);
          var sz = rand(3, 7);
          var dot = new scope.Path.Circle({
            center: [last.x + Math.cos(a) * d, last.y + Math.sin(a) * d],
            radius: sz,
            fillColor: color,
            opacity: 0.4
          });
          scope.project.activeLayer.addChild(dot);
        }
        // Central burst
        var burst = new scope.Path.Circle({
          center: last,
          radius: 16,
          fillColor: color,
          opacity: 0.25
        });
        scope.project.activeLayer.addChild(burst);
        scope.view.draw();
      }
      path = null;
    }
  }

  // Paper.js tool for mouse handling
  var tool = new scope.Tool();
  tool.onMouseMove = onMouseMove;

  // Native DOM events for start/end
  canvas.addEventListener('mouseenter', function() { canvas.style.pointerEvents = 'auto'; });
  hero.addEventListener('mouseleave', endStroke);
  hero.addEventListener('mouseup', endStroke);
  hero.addEventListener('touchend', endStroke);

  // Welcome splat
  function welcomeSplat() {
    var cx = scope.view.center.x;
    var cy = scope.view.center.y;
    for (var i = 0; i < 12; i++) {
      var a = (i / 12) * Math.PI * 2;
      var d = 20 + (i % 3) * 15;
      var color = pick(COLORS);
      var line = new scope.Path();
      line.add([cx + Math.cos(a) * d * 0.3, cy + Math.sin(a) * d * 0.3]);
      line.add([cx + Math.cos(a) * d, cy + Math.sin(a) * d]);
      line.strokeColor = color;
      line.strokeWidth = rand(10, 20);
      line.strokeCap = 'round';
      line.opacity = 0.6;
      scope.project.activeLayer.addChild(line);
    }
    scope.view.draw();
  }

  scope.view.onResize = function() {
    // Redraw on resize
  };

  welcomeSplat();

  // Start fade after 5s
  setTimeout(function() {
    var fadeInterval = setInterval(function() {
      var items = scope.project.activeLayer.children;
      if (items.length === 0) { clearInterval(fadeInterval); return; }
      for (var i = items.length - 1; i >= 0; i--) {
        items[i].opacity -= 0.005;
        if (items[i].opacity <= 0) items[i].remove();
      }
      scope.view.draw();
    }, 100);
  }, 5000);
})();
</script>

{% schema %}
{
  "name": "Splash Hero",
  "tag": "section",
  "class": "splash-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Splash Your Style" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Move your mouse to paint" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1A1A2E" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Subtext color", "default": "rgba(255,255,255,0.8)" },
    { "type": "range", "id": "section_height", "min": 300, "max": 800, "step": 50, "default": 550, "label": "Height" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "default": 80, "label": "Padding bottom" }
  ],
  "blocks": [
    {
      "type": "button", "name": "Button", "limit": 3,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Label", "default": "Shop Stickers" },
        { "type": "url", "id": "button_link", "label": "Link" },
        { "type": "select", "id": "button_style", "label": "Style", "options": [{ "value": "solid", "label": "Solid" }, { "value": "outline", "label": "Outline" }], "default": "solid" },
        { "type": "color", "id": "button_bg", "label": "Button color", "default": "#FFFFFF" },
        { "type": "color", "id": "button_text", "label": "Text color", "default": "#1A1A2E" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splash Hero",
      "category": "Custom",
      "blocks": [
        { "type": "button", "settings": { "button_label": "Shop Stickers", "button_style": "solid", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } },
        { "type": "button", "settings": { "button_label": "Design Your Own", "button_style": "outline", "button_bg": "#FFFFFF", "button_text": "#1A1A2E" } }
      ]
    }
  ]
}
{% endschema %}
