SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://splash-gangsheet-builder.onrender.com
SCOPES=read_files,read_orders,read_products,write_app_proxy,write_files
# Supabase transaction pooler URL (port 6543) for app requests.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Supabase session pooler URL (port 5432) for Prisma migrations.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
