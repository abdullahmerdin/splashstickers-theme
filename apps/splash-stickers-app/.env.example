SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://splash-gangsheet-builder.onrender.com
SCOPES=read_files,read_orders,read_products,write_app_proxy,write_files
# Supabase session pooler URL (port 5432) for the persistent Render service.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?connection_limit=5
# The same IPv4-compatible session pooler is safe for Prisma migrations.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
