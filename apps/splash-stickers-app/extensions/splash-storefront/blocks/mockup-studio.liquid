<section
  class="splash-app-surface splash-studio"
  data-splash-studio
  data-proxy-base="{{ routes.root_url }}apps/splash-stickers/"
  data-scene-phone="{{ 'mockup-phone.jpg' | asset_url }}"
  data-scene-laptop="{{ 'mockup-laptop.jpg' | asset_url }}"
  data-scene-mailer="{{ 'mockup-mailer.jpg' | asset_url }}"
  {{ block.shopify_attributes }}
>
  <header class="splash-studio-hero">
    <span class="splash-studio-eyebrow">{{ block.settings.eyebrow | escape }}</span>
    <h1>{{ block.settings.heading | escape }}</h1>
    <p>{{ block.settings.body | escape }}</p>
  </header>

  <div class="splash-studio-upload" data-studio-dropzone>
    <input id="splash-studio-file-{{ block.id }}" data-studio-file type="file" accept="image/png,image/jpeg,image/webp">
    <label for="splash-studio-file-{{ block.id }}">
      <span class="splash-studio-upload__icon" aria-hidden="true">&#8599;</span>
      <strong>Upload your design</strong>
      <span>or browse a PNG, JPG or WebP up to 25 MB</span>
    </label>
  </div>

  <div class="splash-studio-section-heading">
    <h2>Select mockups</h2>
  </div>

  <div class="splash-studio-scenes">
    <article class="splash-studio-scene" data-scene-card data-scene="phone">
      <button class="splash-studio-scene__activate" type="button" data-scene-activate aria-pressed="true">
        <img src="{{ 'mockup-phone.jpg' | asset_url }}" alt="Blank phone case mockup" width="1000" height="1000">
        <span><strong>Phone case</strong></span>
      </button>
      <label class="splash-studio-scene__include" for="splash-studio-phone-{{ block.id }}">
        <input id="splash-studio-phone-{{ block.id }}" data-scene-choice type="checkbox" value="phone" checked>
        <i aria-hidden="true">&#10003;</i>
        <span class="splash-studio-visually-hidden">Include phone case in generated mockups</span>
      </label>
    </article>
    <article class="splash-studio-scene" data-scene-card data-scene="laptop">
      <button class="splash-studio-scene__activate" type="button" data-scene-activate aria-pressed="false">
        <img src="{{ 'mockup-laptop.jpg' | asset_url }}" alt="Blank laptop mockup" width="1000" height="1000">
        <span><strong>Laptop</strong></span>
      </button>
      <label class="splash-studio-scene__include" for="splash-studio-laptop-{{ block.id }}">
        <input id="splash-studio-laptop-{{ block.id }}" data-scene-choice type="checkbox" value="laptop">
        <i aria-hidden="true">&#10003;</i>
        <span class="splash-studio-visually-hidden">Include laptop in generated mockups</span>
      </label>
    </article>
    <article class="splash-studio-scene" data-scene-card data-scene="mailer">
      <button class="splash-studio-scene__activate" type="button" data-scene-activate aria-pressed="false">
        <img src="{{ 'mockup-mailer.jpg' | asset_url }}" alt="Blank shipping box mockup" width="1000" height="1000">
        <span><strong>Shipping box</strong></span>
      </button>
      <label class="splash-studio-scene__include" for="splash-studio-mailer-{{ block.id }}">
        <input id="splash-studio-mailer-{{ block.id }}" data-scene-choice type="checkbox" value="mailer">
        <i aria-hidden="true">&#10003;</i>
        <span class="splash-studio-visually-hidden">Include shipping box in generated mockups</span>
      </label>
    </article>
  </div>

  <template data-editor-template>
    <article class="splash-studio-editor" hidden>
      <div class="splash-studio-editor__heading">
        <h3 data-editor-title></h3>
      </div>
      <div class="splash-studio-workspace">
        <div class="splash-studio-canvas">
          <img class="splash-studio-plate" alt="" width="1000" height="1000">
          <span class="splash-studio-surface" aria-hidden="true"></span>
          <div class="splash-studio-print-area">
            <div class="splash-studio-artwork-frame" data-artwork-frame tabindex="0" role="group" aria-label="Uploaded design. Drag to move." hidden>
              <img class="splash-studio-artwork" alt="Your uploaded design" draggable="false" width="1000" height="1000">
              <button class="splash-studio-artwork-handle splash-studio-artwork-handle--rotate" type="button" data-rotate-handle aria-label="Rotate design">
                <span aria-hidden="true">&#8635;</span>
              </button>
              <button class="splash-studio-artwork-handle splash-studio-artwork-handle--resize" type="button" data-resize-handle aria-label="Resize design">
                <span aria-hidden="true">&#8599;</span>
              </button>
            </div>
          </div>
        </div>
        <div class="splash-studio-controls">
          <fieldset class="splash-studio-colors">
            <legend>Product color</legend>
            <div data-color-presets></div>
            <label class="splash-studio-custom-color"><input data-custom-color type="color"><span>Custom</span></label>
          </fieldset>
          <button class="splash-studio-reset" type="button" data-reset>Reset placement</button>
        </div>
      </div>
    </article>
  </template>
  <div class="splash-studio-editors" data-studio-editors></div>

  <footer class="splash-studio-actions">
    <p data-studio-status role="status" aria-live="polite" hidden></p>
    <button class="splash-app-button splash-studio-generate" type="button" data-studio-generate disabled>
      {{ block.settings.button_text | escape }}
    </button>
  </footer>

  <section class="splash-studio-results" data-studio-results hidden>
    <div class="splash-studio-section-heading">
      <div><span class="splash-studio-kicker">Ready to share</span><h2>Your mockups</h2></div>
    </div>
    <div class="splash-studio-result-grid" data-result-grid></div>
  </section>
</section>

{% schema %}
{
  "name": "Mockup studio",
  "target": "section",
  "enabled_on": { "templates": ["page"] },
  "stylesheet": "splash-storefront.css",
  "javascript": "mockup-studio.js",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Splash Mockup Studio" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Put your design into the real world." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Upload once, choose several products, then art-direct every mockup exactly the way you want it." },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Generate selected mockups" }
  ]
}
{% endschema %}
