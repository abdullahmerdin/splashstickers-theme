{%- assign mockup_product = block.settings.product | default: product -%}
<section
  class="splash-app-surface splash-mockup"
  data-splash-mockup
  data-product-id="{{ mockup_product.id }}"
  data-proxy-base="{{ routes.root_url }}apps/splash-stickers/"
  {{ block.shopify_attributes }}
>
  <div class="splash-app-heading-row">
    <h2 class="splash-app-heading">{{ block.settings.heading | escape }}</h2>
    <span class="splash-app-status" data-mockup-status role="status" aria-live="polite">
      {{ 'mockup.waiting' | t }}
    </span>
  </div>
  <div class="splash-mockup__canvas" data-mockup-canvas>
    <img data-mockup-image alt="{{ block.settings.image_alt | escape }}" hidden width="1200" height="800">
    <p data-mockup-empty>{{ block.settings.empty_text | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Mockup preview",
  "target": "section",
  "enabled_on": { "templates": ["product", "page"] },
  "stylesheet": "splash-storefront.css",
  "javascript": "splash-storefront.js",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Phone mockup" },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "Add artwork to generate a mockup." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Generated phone case sticker mockup" }
  ]
}
{% endschema %}
