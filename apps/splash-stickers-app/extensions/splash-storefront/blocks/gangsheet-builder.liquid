{%- liquid
  assign builder_product = block.settings.product | default: product
  assign selected_variant = builder_product.selected_or_first_available_variant
-%}

<section class="splash-app-surface splash-builder-launcher" {{ block.shopify_attributes }}>
  <div>
    <h2>{{ block.settings.heading | escape }}</h2>
    {% if block.settings.body != blank %}<p>{{ block.settings.body | escape }}</p>{% endif %}
  </div>
  {% if builder_product != blank and selected_variant != blank %}
    <form action="{{ routes.root_url }}apps/splash-stickers/builder" method="get">
      {% if builder_product.has_only_default_variant == false %}
        <label>
          <span>{{ block.settings.option_label | escape }}</span>
          <select name="variant">
            {% for variant in builder_product.variants %}
              <option value="{{ variant.id }}" {% if variant.id == selected_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title | escape }} · {{ variant.price | money_with_currency }}
              </option>
            {% endfor %}
          </select>
        </label>
      {% else %}
        <input type="hidden" name="variant" value="{{ selected_variant.id }}">
      {% endif %}
      <button class="splash-app-button" type="submit" {% unless selected_variant.available %}disabled{% endunless %}>
        {{ block.settings.button_text | escape }}
      </button>
    </form>
  {% else %}
    <p role="status">{{ block.settings.missing_product_text | escape }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Gangsheet builder",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "splash-storefront.css",
  "settings": [
    { "type": "product", "id": "product", "label": "Gangsheet product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your gangsheet" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Arrange your artwork, review the sheet and add the saved design to Shopify cart." },
    { "type": "text", "id": "option_label", "label": "Option label", "default": "Sheet option" },
    { "type": "text", "id": "button_text", "label": "Button", "default": "Open Splash Gangsheet Builder" },
    { "type": "text", "id": "missing_product_text", "label": "Missing product message", "default": "Select a gangsheet product in this app block." }
  ]
}
{% endschema %}
