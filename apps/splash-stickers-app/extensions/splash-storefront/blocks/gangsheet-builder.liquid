{%- liquid
  assign builder_product = block.settings.product | default: product
  assign selected_variant = builder_product.selected_or_first_available_variant
-%}

<section class="splash-app-surface splash-builder-embed" {{ block.shopify_attributes }}>
  {% if builder_product != blank and selected_variant != blank %}
    <iframe
      class="splash-builder-frame"
      src="{{ routes.root_url }}apps/splash-stickers/builder?variant={{ selected_variant.id }}&amp;embedded=1"
      title="{{ block.settings.heading | escape }}"
      loading="eager"
      allow="clipboard-write"
    ></iframe>
    <noscript>
      <a class="splash-app-button" href="{{ routes.root_url }}apps/splash-stickers/builder?variant={{ selected_variant.id }}">
        {{ block.settings.fallback_link_text | escape }}
      </a>
    </noscript>
  {% else %}
    <p role="status">{{ block.settings.missing_product_text | escape }}</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Gangsheet builder",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "splash-storefront.css",
  "settings": [
    { "type": "product", "id": "product", "label": "Gangsheet product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your gangsheet" },
    { "type": "text", "id": "fallback_link_text", "label": "No-JavaScript link", "default": "Open gangsheet builder" },
    { "type": "text", "id": "missing_product_text", "label": "Missing product message", "default": "Select a gangsheet product in this app block." }
  ]
}
{% endschema %}
