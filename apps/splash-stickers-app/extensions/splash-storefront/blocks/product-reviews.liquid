{%- assign review_product = block.settings.product | default: product -%}
<section
  class="splash-app-surface splash-reviews"
  data-splash-reviews
  data-product-id="{{ review_product.id }}"
  data-proxy-base="{{ routes.root_url }}apps/splash-stickers/"
  data-form-enabled="{{ block.settings.show_form }}"
  {{ block.shopify_attributes }}
>
  <div class="splash-app-heading-row">
    <h2 class="splash-app-heading">{{ block.settings.heading | escape }}</h2>
    <span class="splash-review-summary" data-review-summary role="status" aria-live="polite">
      {{ 'reviews.loading' | t }}
    </span>
  </div>
  <div data-review-list></div>

  {% if block.settings.show_form %}
    <form class="splash-review-form" data-review-form>
      <h3>{{ block.settings.form_heading | escape }}</h3>
      <label>
        <span>{{ 'reviews.rating' | t }}</span>
        <select name="rating" required>
          <option value="">{{ 'reviews.choose_rating' | t }}</option>
          <option value="5">5</option>
          <option value="4">4</option>
          <option value="3">3</option>
          <option value="2">2</option>
          <option value="1">1</option>
        </select>
      </label>
      <label>
        <span>{{ 'reviews.name' | t }}</span>
        <input name="authorName" type="text" maxlength="80" autocomplete="name">
      </label>
      <label>
        <span>{{ 'reviews.title' | t }}</span>
        <input name="title" type="text" maxlength="120">
      </label>
      <label>
        <span>{{ 'reviews.body' | t }}</span>
        <textarea name="body" minlength="3" maxlength="2000" required></textarea>
      </label>
      <button class="splash-app-button" type="submit">{{ 'reviews.submit' | t }}</button>
      <p data-review-form-status role="status" aria-live="polite"></p>
    </form>
  {% endif %}
</section>

{% schema %}
{
  "name": "Product reviews",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "stylesheet": "splash-storefront.css",
  "javascript": "product-reviews.js",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "checkbox", "id": "show_form", "label": "Show review form", "default": true },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Share your experience" }
  ]
}
{% endschema %}
