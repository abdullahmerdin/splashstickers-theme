{% doc %}
  Renders the global light/dark mode control.

  @param {boolean} [floating] - Fixes the control to the viewport for layouts without the main header.
{% enddoc %}

{% liquid
  assign dark_mode_label = 'Switch to dark mode'
  assign light_mode_label = 'Switch to light mode'
  if request.locale.iso_code == 'tr'
    assign dark_mode_label = 'Koyu moda geç'
    assign light_mode_label = 'Açık moda geç'
  endif
%}

<button
  type="button"
  class="theme-mode-toggle button-unstyled{% if floating %} theme-mode-toggle--floating{% else %} header-actions__action{% endif %}"
  data-theme-mode-toggle
  data-label-dark="{{ dark_mode_label }}"
  data-label-light="{{ light_mode_label }}"
  aria-label="{{ dark_mode_label }}"
  title="{{ dark_mode_label }}"
>
  <span class="theme-mode-toggle__icon theme-mode-toggle__icon--moon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <path d="M20.3 15.2A8.5 8.5 0 0 1 8.8 3.7 8.5 8.5 0 1 0 20.3 15.2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </span>
  <span class="theme-mode-toggle__icon theme-mode-toggle__icon--sun" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="3.75" stroke="currentColor" stroke-width="1.8"/>
      <path d="M12 2.25v2M12 19.75v2M21.75 12h-2M4.25 12h-2M18.9 5.1l-1.4 1.4M6.5 17.5l-1.4 1.4M18.9 18.9l-1.4-1.4M6.5 6.5 5.1 5.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </span>
</button>
