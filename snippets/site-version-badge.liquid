{% liquid
  assign site_version_number = '1.1'
  assign site_version_label = 'v' | append: site_version_number
%}

<span
  class="site-version-badge"
  data-version="{{ site_version_number }}"
  aria-label="Site version {{ site_version_label }}"
  title="Site version {{ site_version_label }}"
>
  {{ site_version_label }}
</span>
